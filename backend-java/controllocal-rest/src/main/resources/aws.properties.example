# ============================================================
# Configuracion AWS S3 para la capa REST (controllocal-rest)
# ------------------------------------------------------------
# Copia este archivo a "aws.properties" (mismo directorio) y completa
# tus credenciales. NUNCA subas aws.properties a git: esta ignorado
# en .gitignore (**/aws.properties).
#
# Para credenciales temporales (STS, accessKeyId que empieza con "ASIA")
# completa tambien aws.sessionToken. Para credenciales permanentes
# (accessKeyId que empieza con "AKIA") deja aws.sessionToken vacio.
# ============================================================

aws.accessKeyId=TU_ACCESS_KEY_ID
aws.secretAccessKey=TU_SECRET_ACCESS_KEY
aws.sessionToken=
aws.region=us-east-1
aws.s3.bucket=controllocal-archivos
# Prefijo (carpeta logica) dentro del bucket. Por defecto "documentos", asi los
# archivos quedan en s3://controllocal-archivos/documentos/<solicitud>/... Vacio = raiz.
aws.s3.prefix=documentos

# ------------------------------------------------------------
# Selector del almacen de documentos (implementacion hibrida S3 / disco local).
# El backend sube y sirve los archivos del expediente; el frontend solo envia bytes.
#
#   AUTO  -> usa S3 si las credenciales responden (HeadBucket OK); si no, disco local.
#   S3    -> fuerza S3 (cae a local solo si faltan accessKeyId/secret/bucket).
#   LOCAL -> siempre disco local (no requiere credenciales AWS).
# ------------------------------------------------------------
almacen.proveedor=AUTO
# Carpeta del almacen local (respaldo). RELATIVA = se resuelve contra el home del usuario
# en cada equipo (portable, sin atar a un usuario). Absoluta = se usa tal cual. Vacio = igual
# que la relativa de abajo. No se expanden variables (%USERPROFILE%/${...}).
almacen.local.ruta=controllocal/almacen-documentos

# El cliente S3 confia en el truststore del propio JDK (java.home/lib/security/cacerts),
# no en el de GlassFish, para evitar "PKIX path building failed" con la CA de Amazon.
# Si aun asi falla el TLS (p. ej. un proxy corporativo intercepta HTTPS), puedes
# desactivar la verificacion: SOLO desarrollo local, nunca en un entorno real.
almacen.s3.tlsInseguro=false
