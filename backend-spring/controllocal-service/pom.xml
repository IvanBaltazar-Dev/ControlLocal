<?xml version="1.0" encoding="UTF-8"?>
<!-- Casos de uso @Transactional, reglas de negocio y alcance por rol. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.controllocal</groupId>
        <artifactId>controllocal-spring</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>controllocal-service</artifactId>
    <name>ControlLocal v2 - servicios</name>

    <dependencies>
        <dependency>
            <groupId>com.controllocal</groupId>
            <artifactId>controllocal-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
            Serializador de verdad para la capa de servicio.

            Tres tablas guardan JSON como texto — `evento_dominio.carga_util`
            (V53), `borrador_captura.datos_conocidos` (V56) y
            `comando_idempotente.resultado` (V57) — y las tres lo hacen porque
            `controllocal-domain` depende SOLO de `jakarta.persistence-api`:
            mapear jsonb exigiria `@JdbcTypeCode`, que es de Hibernate, y meter
            el ORM en el dominio por una columna es mal negocio.

            La consecuencia es que el JSON lo tiene que fabricar ESTA capa. Y
            fabricarlo a mano — como todavia hace `EventosSeguridad`, que solo
            escribe mapas de cadena a cadena — se rompe con la primera comilla
            en el nombre de una calle, que en una direccion peruana llega
            pronto. `spring-boot-starter-json` es la parte de Jackson que ya
            entra por `spring-boot-starter-web` en el modulo web: no anade nada
            nuevo al artefacto final, solo lo hace visible aqui.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
