<?xml version="1.0" encoding="UTF-8"?>
<!--
  ControlLocal backend v2 (Spring Boot) - reactor del Strangler.
  Capas estrictas (Doc 5 arquitectura-objetivo): web -> service -> persistence -> domain,
  blindadas por ArchUnit en controllocal-app. El contrato REST se mantiene CONGELADO
  respecto del backend Jakarta (backend-java) hasta el corte de cada modulo.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.controllocal</groupId>
    <artifactId>controllocal-spring</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ControlLocal Spring (backend v2)</name>

    <modules>
        <module>controllocal-domain</module>
        <module>controllocal-persistence</module>
        <module>controllocal-service</module>
        <module>controllocal-web</module>
        <module>controllocal-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <archunit.version>1.4.0</archunit.version>
        <springdoc.version>2.8.9</springdoc.version>
        <!--
          Cliente S3 GENERICO, no "el SDK de AWS porque vayamos a AWS". El
          informe de tecnologias deja la eleccion de servidor abierta (depende
          del entorno de despliegue, que decide el Bloque 9) y este SDK habla
          con todos los candidatos por igual: MinIO, SeaweedFS, Garage, Ceph
          RGW y S3. Elegir el cliente ahora NO compromete el servidor.
        -->
        <awssdk.version>2.32.14</awssdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.controllocal</groupId>
                <artifactId>controllocal-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.controllocal</groupId>
                <artifactId>controllocal-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.controllocal</groupId>
                <artifactId>controllocal-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.controllocal</groupId>
                <artifactId>controllocal-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
