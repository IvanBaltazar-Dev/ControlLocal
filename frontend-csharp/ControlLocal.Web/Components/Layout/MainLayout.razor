@inherits LayoutComponentBase
@inject RoleState RoleState
@implements IDisposable

<div class="cl-app-shell">
    <aside class="cl-sidebar">
        <div class="cl-brand">
            <div class="cl-brand-mark">CL</div>
            <div>
                <div class="cl-brand-name">ControlLocal</div>
                <div class="cl-brand-sub">Corretaje comercial</div>
            </div>
        </div>

        <nav class="cl-nav">
            @foreach (var section in Sections)
            {
                <div class="cl-nav-section">@(section.Title)</div>
                @foreach (var item in section.Items)
                {
                    <NavLink class="cl-nav-link" href="@item.Href" Match="@item.Match">@item.Label</NavLink>
                }
            }
        </nav>

        <div class="cl-sidebar-footer">
            <div class="cl-avatar">@UserInitials</div>
            <div>
                <div class="cl-user-name">@UserName</div>
                <div class="cl-user-role">@RoleState.CurrentRole</div>
            </div>
        </div>
    </aside>

    <div class="cl-main">
        <header class="cl-topbar">
            <div>
                <div class="cl-topbar-title">@TopbarTitle</div>
                <div class="cl-topbar-subtitle">@TopbarSubtitle</div>
            </div>
            <div class="cl-topbar-actions">
                @if (RoleState.CurrentRole == Roles.BrokerAdministrador)
                {
                    <span class="badge text-bg-light border">Lun - 25 May 2026</span>
                    <span class="badge text-bg-primary">Cmd K</span>
                }
                <select class="form-select form-select-sm cl-role-select" value="@RoleState.CurrentRole" @onchange="ChangeRole">
                    <option value="@Roles.BrokerAdministrador">Broker administrador</option>
                    <option value="@Roles.Broker">Broker</option>
                    <option value="@Roles.Agente">Agente inmobiliario</option>
                </select>
                <span class="badge text-bg-light border">MVP academico</span>
                <a class="btn btn-outline-secondary btn-sm" href="/login">Cerrar sesion</a>
            </div>
        </header>

        <main class="cl-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private IReadOnlyList<NavSection> Sections => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador =>
        [
            new("Principal",
            [
                new("Dashboard global", "/dashboard"),
                new("Reportes globales", "/admin/reportes-globales")
            ]),
            new("Administracion",
            [
                new("Brokers", "/admin/brokers"),
                new("Reasignar agentes", "/admin/reasignar-agentes"),
                new("Catalogos del sistema", "/admin/catalogos")
            ]),
            new("Auditoria",
            [
                new("Auditoria global", "/admin/auditoria-global")
            ])
        ],
        Roles.Broker =>
        [
            new("Principal",
            [
                new("Dashboard de equipo", "/dashboard"),
                new("Reportes de equipo", "/broker/reportes")
            ]),
            new("Mi equipo",
            [
                new("Mis agentes", "/broker/agentes")
            ]),
            new("Bandejas de revision",
            [
                new("Captaciones por revisar", "/broker/captaciones"),
                new("Solicitudes por evaluar", "/broker/solicitudes")
            ]),
            new("Seguimiento",
            [
                new("Operaciones del equipo", "/broker/operaciones")
            ])
        ],
        _ =>
        [
            new("Principal",
            [
                new("Dashboard", "/dashboard")
            ]),
            new("Captacion",
            [
                new("Propietarios", "/propietarios"),
                new("Locales comerciales", "/locales-comerciales"),
                new("Captaciones", "/captaciones")
            ]),
            new("Comercial",
            [
                new("Clientes interesados", "/agente/clientes"),
                new("Oportunidades comerciales", "/oportunidades-comerciales"),
                new("Interacciones", "/agente/interacciones"),
                new("Visitas", "/agente/visitas"),
                new("Solicitudes de alquiler", "/agente/solicitudes")
            ]),
            new("Cuenta",
            [
                new("Mi perfil", "/agente/perfil")
            ])
        ]
    };

    private string UserName => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Alejandro Tellez",
        Roles.Broker => "Ricardo Salas",
        _ => "Valentina Mora"
    };

    private string UserInitials => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "AT",
        Roles.Broker => "RS",
        _ => "VM"
    };

    private string TopbarTitle => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Panel administrativo global",
        Roles.Broker => "Panel de supervision del equipo",
        _ => "Panel operativo del agente"
    };

    private string TopbarSubtitle => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Brokers, auditoria global e intervenciones administrativas",
        Roles.Broker => "Agentes bajo responsabilidad, captaciones y solicitudes por revisar",
        _ => "Propietarios, locales, captaciones y oportunidades comerciales"
    };

    protected override void OnInitialized()
    {
        RoleState.OnChange += StateHasChanged;
    }

    private void ChangeRole(ChangeEventArgs args)
    {
        if (args.Value is string value)
        {
            RoleState.SetRole(value);
        }
    }

    public void Dispose()
    {
        RoleState.OnChange -= StateHasChanged;
    }

    private sealed record NavSection(string Title, IReadOnlyList<NavItem> Items);
    private sealed record NavItem(string Label, string Href, NavLinkMatch Match = NavLinkMatch.Prefix);
}
