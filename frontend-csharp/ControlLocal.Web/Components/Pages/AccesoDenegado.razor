@page "/acceso-denegado"
@inject AppState App

<PageTitle>Acceso denegado - ControlLocal</PageTitle>

<div class="cl-card" style="max-width:560px;margin:48px auto;">
    <div class="cl-card-body" style="padding:32px;text-align:center;">
        <Icon Name="lock" Size="34" />
        <h1 style="font-size:22px;margin:16px 0 8px;">Acceso denegado</h1>
        <p class="cl-muted">Tu usuario no tiene permisos para realizar esta operacion.</p>
        <button class="cl-btn primary" style="margin-top:14px;" @onclick="@(() => App.Navigate("dashboard"))">
            Volver al dashboard
        </button>
    </div>
</div>
