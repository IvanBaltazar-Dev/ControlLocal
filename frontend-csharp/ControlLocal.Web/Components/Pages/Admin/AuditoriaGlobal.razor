@page "/admin/auditoria-global"
@rendermode InteractiveServer
@inject RoleState RoleState

<PageTitle>Auditoria global - ControlLocal</PageTitle>

<div class="cl-page-hero cl-admin-hero">
    <div>
        <div class="cl-page-kicker">Broker administrador</div>
        <div class="cl-page-title">Auditoria global</div>
        <div class="cl-page-subtitle">Registro central de acciones sensibles de todos los brokers y agentes.</div>
    </div>
    <button class="btn btn-primary cl-btn-primary">Exportar registro</button>
</div>

<div class="card cl-card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-2"><select class="form-select"><option>Modulo</option><option>Captacion</option><option>Oportunidad</option><option>Solicitud</option><option>Documentos</option></select></div>
            <div class="col-md-2"><select class="form-select"><option>Accion</option><option>Creacion</option><option>Aprobacion</option><option>Rechazo</option><option>Edicion</option></select></div>
            <div class="col-md-3"><input class="form-control" placeholder="Usuario" /></div>
            <div class="col-md-2"><select class="form-select"><option>Periodo</option><option>Hoy</option><option>Ultimos 7 dias</option><option>Ultimos 30 dias</option></select></div>
            <div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-secondary w-100">Mas filtros</button><button class="btn btn-outline-secondary w-100">Exportar</button></div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Modulo</th><th>Referencia</th><th>Estado anterior</th><th>Estado nuevo</th><th>Observacion</th></tr></thead>
            <tbody>
                <tr><td>25/05/2026 11:42</td><td><strong>Ricardo Salas</strong><div class="text-secondary small">Broker</div></td><td>Captacion</td><td>CAP-0218</td><td>Pendiente de revision</td><td><StatusBadge Label="Activa" /></td><td>Documentacion verificada.</td></tr>
                <tr><td>25/05/2026 09:14</td><td><strong>Valentina Mora</strong><div class="text-secondary small">Agente</div></td><td>Oportunidad</td><td>OP-1083</td><td>Solicitud creada</td><td><StatusBadge Label="Finalizada exitosa" /></td><td>Contrato firmado - USD 2 750.</td></tr>
                <tr><td>24/05/2026 17:36</td><td><strong>Alejandro Tellez</strong><div class="text-secondary small">Admin</div></td><td>BrokerAgente</td><td>BA-0442</td><td>Mariana Quintero</td><td>Ricardo Salas</td><td>Reasignacion administrativa.</td></tr>
                <tr><td>24/05/2026 15:20</td><td><strong>Carolina Vega</strong><div class="text-secondary small">Agente</div></td><td>Interaccion</td><td>OP-1098</td><td>-</td><td>Registrada</td><td>Llamada de seguimiento.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.BrokerAdministrador);
}
