@page "/admin/catalogos"
@rendermode InteractiveServer
@inject RoleState RoleState

<PageTitle>Catalogos del sistema - ControlLocal</PageTitle>

<div class="cl-page-hero cl-admin-hero">
    <div>
        <div class="cl-page-kicker">Broker administrador</div>
        <div class="cl-page-title">Catalogos del sistema</div>
        <div class="cl-page-subtitle">Valores maestros utilizados por los modulos comerciales. Edicion restringida al rol administrador.</div>
    </div>
    <button class="btn btn-primary cl-btn-primary">Agregar valor</button>
</div>

<div class="row g-3">
    <div class="col-lg-3">
        <div class="list-group cl-card">
            <button class="list-group-item list-group-item-action active">Estados</button>
            <button class="list-group-item list-group-item-action">Canales de contacto</button>
            <button class="list-group-item list-group-item-action">Tipos de documento</button>
            <button class="list-group-item list-group-item-action">Resultados de interaccion</button>
            <button class="list-group-item list-group-item-action">Evaluacion de solicitudes</button>
            <button class="list-group-item list-group-item-action">Motivos de no continuidad</button>
        </div>
    </div>
    <div class="col-lg-9">
        <div class="row g-3">
            <div class="col-md-6">
                <CatalogCard Title="Estados de captacion" Items="@CaptacionEstados" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Estados de oportunidad" Items="@OportunidadEstados" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Estados de solicitud" Items="@SolicitudEstados" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Estados de documento" Items="@DocumentoEstados" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Canales de contacto" Items="@CanalesContacto" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Motivos de no continuidad" Items="@MotivosNoContinuidad" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Estado operativo de agentes" Items="@EstadosOperativoAgente" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Resultados de evaluacion" Items="@ResultadosEvaluacion" />
            </div>
            <div class="col-md-6">
                <CatalogCard Title="Resultados de revision documental" Items="@ResultadosRevisionDocumento" />
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.BrokerAdministrador);

    private static readonly string[] CaptacionEstados = EnumCatalog.EstadosCaptacion.Select(x => x.Label).ToArray();
    private static readonly string[] OportunidadEstados = EnumCatalog.EstadosOportunidad.Select(x => x.Label).ToArray();
    private static readonly string[] SolicitudEstados = EnumCatalog.EstadosSolicitudAlquiler.Select(x => x.Label).ToArray();
    private static readonly string[] DocumentoEstados = EnumCatalog.EstadosDocumentoSolicitud.Select(x => x.Label).ToArray();
    private static readonly string[] CanalesContacto = EnumCatalog.CanalesContacto.Select(x => x.Label).ToArray();
    private static readonly string[] MotivosNoContinuidad = EnumCatalog.MotivosNoContinuidad.Select(x => x.Label).ToArray();
    private static readonly string[] EstadosOperativoAgente = EnumCatalog.EstadosOperativoAgente.Select(x => x.Label).ToArray();
    private static readonly string[] ResultadosEvaluacion = EnumCatalog.ResultadosEvaluacionSolicitud.Select(x => x.Label).ToArray();
    private static readonly string[] ResultadosRevisionDocumento = EnumCatalog.ResultadosRevisionDocumento.Select(x => x.Label).ToArray();
}
