@page "/admin/reasignar-agentes"
@rendermode InteractiveServer
@inject RoleState RoleState

<PageTitle>Reasignacion de agentes - ControlLocal</PageTitle>

<div class="cl-page-hero cl-admin-hero">
    <div>
        <div class="cl-page-kicker">Broker administrador</div>
        <div class="cl-page-title">Reasignacion de agentes entre brokers</div>
        <div class="cl-page-subtitle">Accion de intervencion. Cada movimiento queda registrado en auditoria global.</div>
    </div>
    <button class="btn btn-outline-secondary">Ver historico</button>
</div>

<div class="alert alert-warning">Accion excepcional: usar solo por cese, ausencia o redistribucion autorizada de supervision.</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card cl-card h-100">
            <div class="card-header bg-white fw-semibold">1. Selecciona el agente a reasignar</div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-5"><select class="form-select"><option>Broker actual</option><option>Ricardo Salas</option><option>Mariana Quintero</option></select></div>
                    <div class="col-md-4"><select class="form-select"><option>Zona</option><option>Lima Centro</option><option>Lima Este</option></select></div>
                    <div class="col-md-3"><button class="btn btn-outline-secondary w-100">Exportar</button></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Agente</th><th>Broker actual</th><th>Supervision desde</th><th>Operaciones abiertas</th><th>Estado</th></tr></thead>
                        <tbody>
                            <tr class="table-primary"><td><div class="fw-semibold">Daniel Romero</div><div class="text-secondary small">DNI 72114488</div></td><td>M. Quintero</td><td>22/02/2024</td><td>7 op. / 3 cap.</td><td><StatusBadge Label="Activo" /></td></tr>
                            <tr><td><div class="fw-semibold">Matias Leon</div><div class="text-secondary small">DNI 73321904</div></td><td>F. Andrade</td><td>06/05/2024</td><td>4 op. / 2 cap.</td><td><StatusBadge Label="Activo" /></td></tr>
                            <tr><td><div class="fw-semibold">Jorge Marin</div><div class="text-secondary small">DNI 71239077</div></td><td>R. Salas</td><td>03/09/2024</td><td>3 op. / 1 cap.</td><td><StatusBadge Label="Activo" /></td></tr>
                            <tr><td><div class="fw-semibold">Andrea Torres</div><div class="text-secondary small">DNI 70981240</div></td><td>S. Rios</td><td>18/01/2025</td><td>5 op. / 2 cap.</td><td><StatusBadge Label="Activo" /></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card cl-card h-100">
            <div class="card-header bg-white fw-semibold">Destino y motivo</div>
            <div class="card-body">
                <p class="text-secondary">La reasignacion actualiza la relacion de supervision y mueve las operaciones abiertas al nuevo broker.</p>
                <div class="mb-3">
                    <label class="form-label">Broker destino</label>
                    <select class="form-select">
                        <option>Ricardo Salas - Lima Centro / Sur</option>
                        <option>Felipe Andrade - Lima Este</option>
                        <option>Sandra Rios - Callao / Norte</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Fecha efectiva</label>
                    <input class="form-control" type="date" value="2026-05-25" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Tipo de intervencion</label>
                    <select class="form-select"><option>Cese del broker origen</option><option>Redistribucion de carga</option><option>Ausencia temporal</option></select>
                </div>
                <div class="mb-4">
                    <label class="form-label">Justificacion</label>
                    <textarea class="form-control" rows="4">Reasignacion administrativa autorizada por broker administrador.</textarea>
                </div>
                <button class="btn btn-primary cl-btn-primary w-100">Confirmar reasignacion</button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.BrokerAdministrador);
}
