@page "/agente/oportunidades/cierre"
@inject RoleState RoleState

<PageTitle>Cierre de oportunidad - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">OP-1098</div>
        <div class="cl-page-title">Cierre de oportunidad</div>
        <div class="cl-page-subtitle">Cierra la oportunidad segun las reglas de negocio del backend.</div>
    </div>
    <a class="btn btn-outline-secondary" href="/agente/oportunidades/detalle">Volver al detalle</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card cl-card">
            <div class="card-body">
                <div class="alert alert-info mb-3">
                    El motivo solo aplica cuando la oportunidad termina como No continua o Finalizada no favorable. Un cierre exitoso requiere solicitud aprobada y no registra motivo de no continuidad.
                </div>
                <div class="cl-form-section">
                    <div class="cl-form-section-title">Resultado de cierre</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="resultado-cierre">Resultado</label>
                            <select id="resultado-cierre" class="form-select" @bind="_resultadoCierre">
                                @foreach (var estado in EstadosDeCierre)
                                {
                                    <option value="@estado.Label">@estado.Label</option>
                                }
                            </select>
                        </div>
                        @if (RequiereMotivo)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Motivo de no continuidad</label>
                                <select class="form-select">
                                    @foreach (var motivo in EnumCatalog.MotivosNoContinuidad)
                                    {
                                        <option value="@motivo.Label">@motivo.Label</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label class="form-label">Condicion requerida</label>
                                <input class="form-control" value="Solicitud de alquiler aprobada" disabled />
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label">@SustentoLabel</label>
                            <textarea class="form-control" rows="5">@SustentoEjemplo</textarea>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" href="/agente/oportunidades/detalle">Cancelar</a>
                    <button class="btn btn-primary cl-btn-primary">Registrar cierre</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card cl-card h-100">
            <div class="card-body">
                <div class="cl-form-section-title">Estados de oportunidad</div>
                @foreach (var estado in EnumCatalog.EstadosOportunidad)
                {
                    <div class="cl-funnel-row">
                        <span>@estado.Label</span>
                        <small class="text-secondary">@DescripcionEstado(estado.Label)</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _resultadoCierre = "No continua";

    private static IReadOnlyList<EnumOption> EstadosDeCierre => EnumCatalog.EstadosOportunidad
        .Where(x => x.Label is "No continua" or "Finalizada exitosa" or "Finalizada no favorable")
        .ToArray();

    private bool RequiereMotivo => _resultadoCierre is "No continua" or "Finalizada no favorable";

    private string SustentoLabel => RequiereMotivo ? "Sustento del motivo" : "Observaciones de cierre";

    private string SustentoEjemplo => _resultadoCierre switch
    {
        "Finalizada exitosa" => "Solicitud aprobada y condiciones aceptadas por el cliente.",
        "Finalizada no favorable" => "Evaluacion final rechazada por el broker. Registrar sustento del rechazo.",
        _ => "Cliente posterga expansion y solicita retomar contacto en el siguiente trimestre."
    };

    protected override void OnInitialized() => RoleState.SetRole(Roles.Agente);

    private static string DescripcionEstado(string estado) => estado switch
    {
        "Abierta" => "Estado inicial, no es cierre.",
        "Solicitud creada" => "Intermedio, existe solicitud asociada.",
        "No continua" => "Requiere motivo.",
        "Finalizada exitosa" => "Requiere solicitud aprobada.",
        "Finalizada no favorable" => "Requiere evaluacion final rechazada y motivo.",
        _ => string.Empty
    };
}
