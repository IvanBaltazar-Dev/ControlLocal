@page "/agente/interacciones"
@inject RoleState RoleState

<PageTitle>Interacciones - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">OP-1098</div>
        <div class="cl-page-title">Interacciones comerciales</div>
        <div class="cl-page-subtitle">Registro de comunicaciones con el cliente, vinculadas a una oportunidad.</div>
    </div>
    <button class="btn btn-primary cl-btn-primary">Nueva interaccion</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><MetricCard Label="Total interacciones" Value="18" Footer="Ultimos 30 dias" Icon="IN" Tone="blue" /></div>
    <div class="col-md-3"><MetricCard Label="Llamadas" Value="8" Footer="Canal principal" Icon="LL" Tone="info" /></div>
    <div class="col-md-3"><MetricCard Label="Correos" Value="5" Footer="Seguimiento formal" Icon="CO" Tone="amber" /></div>
    <div class="col-md-3"><MetricCard Label="Positivas" Value="11" Footer="Resultado interesado" Icon="OK" Tone="green" /></div>
</div>

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-3">
                <select class="form-select"><option>Canal</option>@foreach (var canal in EnumCatalog.CanalesContacto) { <option value="@canal.Label">@canal.Label</option> }</select>
            </div>
            <div class="col-lg-3">
                <select class="form-select"><option>Resultado</option>@foreach (var resultado in EnumCatalog.ResultadosInteraccion) { <option value="@resultado.Label">@resultado.Label</option> }</select>
            </div>
            <div class="col-lg-4"><input class="form-control" placeholder="Oportunidad o cliente" /></div>
            <div class="col-lg-2"><button class="btn btn-outline-secondary w-100">Exportar</button></div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead><tr><th>Fecha</th><th>Cliente</th><th>Canal</th><th>Resultado</th><th>Agente</th><th>Observaciones</th></tr></thead>
            <tbody>
                <tr><td>24 May</td><td>Inversiones Trebol</td><td>Llamada</td><td><StatusBadge Label="Interesado" /></td><td>V. Mora</td><td>Confirma visita 16:00, pide plano.</td></tr>
                <tr><td>24 May</td><td>Cafe Lima</td><td>WhatsApp</td><td><StatusBadge Label="Seguimiento" /></td><td>V. Mora</td><td>Quiere comparar dos locales similares.</td></tr>
                <tr><td>23 May</td><td>Boutique Lila</td><td>Email</td><td><StatusBadge Label="Interesado" /></td><td>V. Mora</td><td>Confirma datos para solicitud.</td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Agente);
}
