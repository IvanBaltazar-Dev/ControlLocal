@page "/agente/perfil"
@inject RoleState RoleState

<PageTitle>Mi perfil - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">Cuenta operativa</div>
        <div class="cl-page-title">Mi perfil</div>
        <div class="cl-page-subtitle">Consulta de datos del agente autenticado y broker supervisor activo.</div>
    </div>
    <span class="badge text-bg-light border">Solo lectura</span>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card cl-card h-100">
            <div class="card-body text-center">
                <div class="cl-avatar mx-auto mb-3" style="width:72px;height:72px;font-size:1.2rem;">VM</div>
                <h2 class="h5 mb-1">Valentina Mora</h2>
                <div class="text-secondary mb-3">Agente inmobiliario</div>
                <StatusBadge Label="Activo" />
                <div class="cl-detail mt-3"><span>Broker supervisor</span><strong>Ricardo Salas</strong></div>
                <div class="cl-detail mt-2"><span>Estado operativo</span><strong>Disponible</strong></div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card cl-card">
            <div class="card-body">
                <div class="alert alert-info mb-3">
                    Tu perfil es de consulta. La modificacion de datos, estado administrativo y estado operativo la realiza el broker normal que tiene tu supervision activa.
                </div>
                <div class="cl-form-section">
                    <div class="cl-form-section-title">Informacion personal</div>
                    <div class="row g-3">
                        <div class="col-md-6"><div class="cl-detail"><span>Nombres</span><strong>Valentina</strong></div></div>
                        <div class="col-md-6"><div class="cl-detail"><span>Apellidos</span><strong>Mora</strong></div></div>
                        <div class="col-md-4"><div class="cl-detail"><span>Tipo de documento</span><strong>DNI</strong></div></div>
                        <div class="col-md-4"><div class="cl-detail"><span>Numero de documento</span><strong>72014588</strong></div></div>
                        <div class="col-md-4"><div class="cl-detail"><span>Estado administrativo</span><strong>Activo</strong></div></div>
                        <div class="col-md-4"><div class="cl-detail"><span>Estado operativo</span><strong>Disponible</strong></div></div>
                    </div>
                </div>
                <div class="cl-form-section">
                    <div class="cl-form-section-title">Contacto</div>
                    <div class="row g-3">
                        <div class="col-md-6"><div class="cl-detail"><span>Correo</span><strong>vmora@controllocal.pe</strong></div></div>
                        <div class="col-md-6"><div class="cl-detail"><span>Telefono</span><strong>987654321</strong></div></div>
                    </div>
                </div>
                <div class="text-secondary small">Los codigos internos de enums se usan solo como contrato tecnico con backend y base de datos.</div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Agente);
}
