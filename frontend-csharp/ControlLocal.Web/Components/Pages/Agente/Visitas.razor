@page "/agente/visitas"
@inject RoleState RoleState

<PageTitle>Visitas - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">Agente inmobiliario</div>
        <div class="cl-page-title">Visitas</div>
        <div class="cl-page-subtitle">Visitas programadas a locales, vinculadas a oportunidades comerciales.</div>
    </div>
    <div class="d-flex gap-2"><button class="btn btn-outline-secondary">Sincronizar</button><button class="btn btn-primary cl-btn-primary">Programar visita</button></div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md"><MetricCard Label="Programadas" Value="5" Footer="Mayo 2026" Icon="PR" Tone="blue" /></div>
    <div class="col-md"><MetricCard Label="Realizadas" Value="12" Footer="Este mes" Icon="RE" Tone="green" /></div>
    <div class="col-md"><MetricCard Label="Reprogramadas" Value="2" Footer="Pendientes" Icon="RP" Tone="amber" /></div>
    <div class="col-md"><MetricCard Label="Canceladas" Value="1" Footer="Ultimos 30 dias" Icon="CA" Tone="red" /></div>
</div>

<div class="card cl-card">
    <div class="card-body d-flex gap-2 flex-wrap">
        <button class="btn btn-primary cl-btn-primary">Hoy</button>
        <button class="btn btn-outline-secondary">Mes</button>
        <button class="btn btn-outline-secondary">Semana</button>
        <button class="btn btn-outline-secondary">Dia</button>
        <select class="form-select w-auto">
            <option>Estado</option>
            @foreach (var estado in EnumCatalog.EstadosVisita)
            {
                <option value="@estado.Label">@estado.Label</option>
            }
        </select>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead><tr><th>Fecha y hora</th><th>Oportunidad</th><th>Cliente</th><th>Local</th><th>Estado</th><th>Resultado</th></tr></thead>
            <tbody>
                <tr><td>25 May 2026 16:00</td><td>OP-1098</td><td>Inversiones Trebol</td><td>Av. La Marina 245, San Miguel</td><td><StatusBadge Label="Programada" /></td><td>-</td></tr>
                <tr><td>25 May 2026 11:00</td><td>OP-1085</td><td>Cafe Lima</td><td>Jr. Berlin 230, Miraflores</td><td><StatusBadge Label="Realizada" /></td><td>Cliente interesado</td></tr>
                <tr><td>26 May 2026 10:30</td><td>OP-1094</td><td>Boutique Lila</td><td>Calle Schell 412, Miraflores</td><td><StatusBadge Label="Reprogramada" /></td><td>-</td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Agente);
}
