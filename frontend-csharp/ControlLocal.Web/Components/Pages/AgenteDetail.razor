@page "/agente-detail/{IdParam?}"
@inject AppState App
@inject IAgenteService AgenteSvc

<PageTitle>@_a.Nombre · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mi equipo", "Agentes", _a.Nombre })"
          Title="@_a.Nombre"
          Subtitle="@($"Agente inmobiliario · {_a.Zona}")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("agents"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate($"agente-form/{_a.Id}"))"><Icon Name="edit" Size="13" /> Editar agente</button>
    </Actions>
    <ChildContent>
        <div style="max-width:880px;">
            <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Datos del agente</div></div>
                        <div class="cl-card-body">
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                                <div>
                                    <div class="cl-def-k">Nombre completo</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.Nombre</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Correo</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.Email</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Número de documento</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.NumeroDocumento</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Zona</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.Zona</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Supervisión desde</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.FechaIngresoTexto</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Actividad</div></div>
                        <div class="cl-card-body">
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                                <div>
                                    <div class="cl-def-k">Captaciones activas</div>
                                    <div style="font-size:20px;font-weight:650;margin-top:4px;">@_a.CaptacionesActivas</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Operaciones activas</div>
                                    <div style="font-size:20px;font-weight:650;margin-top:4px;">@_a.OportunidadesActivas</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="cl-stack">
                    <div class="cl-card" style="text-align:center;padding:24px;">
                        <div class="cl-avatar" style="width:64px;height:64px;font-size:22px;margin:0 auto;background:@(string.IsNullOrEmpty(_a.Color) ? "#005BFF" : _a.Color);">@_a.Iniciales</div>
                        <div style="font-size:15px;font-weight:650;margin-top:12px;">@_a.Nombre</div>
                        <div class="cl-muted" style="font-size:12px;margin-top:2px;">@_a.Email</div>
                    </div>
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Estado</div></div>
                        <div class="cl-card-body">
                            <div style="display:flex;flex-direction:column;gap:10px;">
                                <div>
                                    <div class="cl-def-k" style="margin-bottom:6px;">Administrativo</div>
                                    <StatusBadge Label="@_a.EstadoAdministrativo" />
                                </div>
                                @if (!string.IsNullOrEmpty(_a.EstadoOperativo))
                                {
                                    <div>
                                        <div class="cl-def-k" style="margin-bottom:6px;">Operativo</div>
                                        <StatusBadge Label="@_a.EstadoOperativo" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? IdParam { get; set; }

    private AgenteDto _a = new();

    protected override void OnParametersSet()
    {
        _a = (long.TryParse(IdParam, out var id) ? AgenteSvc.ById(id) : null)
             ?? AgenteSvc.All().FirstOrDefault()
             ?? new AgenteDto { Nombre = "Agente no encontrado" };
    }
}
