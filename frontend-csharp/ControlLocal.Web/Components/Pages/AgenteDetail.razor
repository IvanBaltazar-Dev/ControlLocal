@page "/agente-detail/{IdParam?}"
@using ControlLocal.Web.Models.Oportunidades
@inject AppState App
@inject IAgenteService AgenteSvc
@inject ICaptacionService CaptacionSvc
@inject IInteraccionService InteraccionSvc
@inject IVisitaService VisitaSvc
@inject IOportunidadService OportunidadSvc

<PageTitle>@_a.Nombre · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mi equipo", "Agentes", _a.Nombre })"
          Title="@_a.Nombre"
          Subtitle="@($"Agente inmobiliario · {_a.Zona}")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("agents"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate($"agente-form/{_a.Id}"))"><Icon Name="edit" Size="13" /> Editar agente</button>
    </Actions>
    <ChildContent>
        @if (_cargando)
        {
            <div class="cl-card"><div class="cl-card-body" style="padding:48px;text-align:center;color:#7E8794;">Cargando información del agente…</div></div>
        }
        else
        {
        <div>
            <div style="display:grid;grid-template-columns:1fr 320px;gap:14px;align-items:start;">
                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Datos del agente</div></div>
                        <div class="cl-card-body">
                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                                <div>
                                    <div class="cl-def-k">Nombre completo</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.Nombre</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Correo</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.Email</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Número de documento</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.NumeroDocumento</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Zona</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.Zona</div>
                                </div>
                                <div>
                                    <div class="cl-def-k">Supervisión desde</div>
                                    <div style="font-weight:600;margin-top:4px;">@_a.FechaIngresoTexto</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <PagedPanel TItem="CaptacionDto" Title="Captaciones del agente"
                                Items="_capsActivas" Coincide="CoincideCaptacion"
                                Placeholder="Buscar captación por código, dirección o distrito…"
                                Vacio="Este agente no tiene captaciones en cartera.">
                        <Cuerpo Context="items">
                            <table class="cl-table">
                                <thead><tr><th>Captación</th><th>Dirección</th><th>Distrito</th><th>Estado</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var c in items)
                                    {
                                        <tr>
                                            <td><span class="mono">@c.CodigoCaptacion</span></td>
                                            <td style="font-weight:600;">@c.DireccionLocal</td>
                                            <td>@c.DistritoLocal</td>
                                            <td><StatusBadge Label="@c.Estado" /></td>
                                            <td><button class="cl-btn sm" @onclick="@(() => App.Navigate($"ficha-propiedad/{c.CodigoCaptacion}"))">Ficha</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </Cuerpo>
                    </PagedPanel>

                    <PagedPanel TItem="ActividadItem" Title="Actividad reciente"
                                Items="_actividadUnificada" Coincide="CoincideActividad"
                                Placeholder="Buscar en la actividad…"
                                Vacio="Sin interacciones ni visitas programadas registradas por este agente.">
                        <Cuerpo Context="items">
                            <Timeline Items="@(items.Select(a => new Timeline.TimelineItem(a.Tiempo, a.Titulo, a.Subtitulo)).ToArray())" />
                        </Cuerpo>
                    </PagedPanel>

                    <PagedPanel TItem="OportunidadComercialDto" Title="Oportunidades comerciales"
                                Items="_oportunidades" Coincide="CoincideOportunidad"
                                Placeholder="Buscar por operación, cliente o propiedad…"
                                Vacio="Este agente no tiene oportunidades comerciales registradas.">
                        <Cuerpo Context="items">
                            <table class="cl-table">
                                <thead><tr><th>Operación</th><th>Cliente</th><th>Propiedad</th><th>Etapa</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var o in items)
                                    {
                                        <tr>
                                            <td><span class="mono">@o.CodigoOportunidad</span></td>
                                            <td style="font-weight:600;">@(string.IsNullOrWhiteSpace(o.ClienteNombre) ? "—" : o.ClienteNombre)</td>
                                            <td>
                                                @o.DireccionLocal
                                                @if (!string.IsNullOrWhiteSpace(o.CaptacionCodigo))
                                                {
                                                    <span class="cl-muted" style="font-size:11.5px;"> · @o.CaptacionCodigo</span>
                                                }
                                            </td>
                                            <td><StatusBadge Label="@o.Estado" /></td>
                                            <td><button class="cl-btn sm" @onclick="@(() => App.Navigate($"oportunidad-detail/{o.Id}"))">Ver</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </Cuerpo>
                    </PagedPanel>
                </div>

                <div class="cl-stack">
                    <div class="cl-card" style="text-align:center;padding:24px;">
                        <div class="cl-avatar" style="width:64px;height:64px;font-size:22px;margin:0 auto;background:@(string.IsNullOrEmpty(_a.Color) ? "#005BFF" : _a.Color);">@_a.Iniciales</div>
                        <div style="font-size:15px;font-weight:650;margin-top:12px;">@_a.Nombre</div>
                        <div class="cl-muted" style="font-size:12px;margin-top:2px;">@_a.Email</div>
                    </div>
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Estado</div></div>
                        <div class="cl-card-body">
                            <div style="display:flex;flex-direction:column;gap:10px;">
                                <div>
                                    <div class="cl-def-k" style="margin-bottom:6px;">Administrativo</div>
                                    <StatusBadge Label="@_a.EstadoAdministrativo" />
                                </div>
                                @if (!string.IsNullOrEmpty(_a.EstadoOperativo))
                                {
                                    <div>
                                        <div class="cl-def-k" style="margin-bottom:6px;">Operativo</div>
                                        <StatusBadge Label="@_a.EstadoOperativo" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? IdParam { get; set; }

    private bool _cargando = true;
    private AgenteDto _a = new();
    private List<CaptacionDto> _capsActivas = new();
    private List<InteraccionComercialDto> _actividad = new();
    private List<VisitaDto> _visitas = new();
    private List<OportunidadComercialDto> _oportunidades = new();

    private record ActividadItem(string Tiempo, string Titulo, string Subtitulo);

    // Actividad reciente = visitas programadas + interacciones del agente (las visitas
    // próximas primero, como acciones por venir; las interacciones a continuación).
    private List<ActividadItem> _actividadUnificada
    {
        get
        {
            var visitas = _visitas.Select(v => new ActividadItem(
                $"{v.FechaTexto} · {v.HoraTexto}",
                string.IsNullOrWhiteSpace(v.ClienteNombre) ? "Visita programada" : v.ClienteNombre,
                $"Visita {(EsReprogramada(v.Estado) ? "reprogramada" : "programada")} · {v.DireccionLocal}"));
            var interacciones = _actividad.Select(i => new ActividadItem(
                i.FechaHoraTexto,
                string.IsNullOrWhiteSpace(i.ClienteNombre) ? "Interacción" : i.ClienteNombre,
                $"{EnumCatalog.LabelFor(EnumCatalog.CanalesContacto, i.CanalContacto)} · {EnumCatalog.LabelFor(EnumCatalog.ResultadosInteraccion, i.Resultado)}"));
            return visitas.Concat(interacciones).ToList();
        }
    }

    private static bool CoincideCaptacion(CaptacionDto c, string q) =>
        TextoFiltro.Contiene(c.CodigoCaptacion, q)
        || TextoFiltro.Contiene(c.DireccionLocal, q)
        || TextoFiltro.Contiene(c.DistritoLocal, q);

    private static bool CoincideOportunidad(OportunidadComercialDto o, string q) =>
        TextoFiltro.Contiene(o.CodigoOportunidad, q)
        || TextoFiltro.Contiene(o.ClienteNombre, q)
        || TextoFiltro.Contiene(o.DireccionLocal, q)
        || TextoFiltro.Contiene(o.CaptacionCodigo, q);

    private static bool CoincideActividad(ActividadItem a, string q) =>
        TextoFiltro.Contiene(a.Titulo, q) || TextoFiltro.Contiene(a.Subtitulo, q);

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        try
        {
            await AgenteSvc.RefrescarAsync();
            _a = (long.TryParse(IdParam, out var id) ? AgenteSvc.ById(id) : null)
                 ?? AgenteSvc.All().FirstOrDefault()
                 ?? new AgenteDto { Nombre = "Agente no encontrado" };

            // Los conteos (captaciones en cartera + operaciones en curso) llegan calculados del
            // backend en _a. Aquí se cargan las listas individuales del agente: captaciones,
            // visitas programadas, oportunidades comerciales e interacciones (del equipo del broker).
            if (_a.Id > 0)
            {
                try
                {
                    var captaciones = await CaptacionSvc.RefrescarAsync();
                    _capsActivas = captaciones
                        .Where(c => c.AgenteResponsableId == _a.Id && CaptacionEnCartera(c.Estado))
                        .OrderBy(c => c.FechaFinVigencia ?? DateOnly.MaxValue)
                        .ToList();
                }
                catch { /* El detalle se muestra aunque la lista no cargue. */ }

                try
                {
                    var visitas = await VisitaSvc.RefrescarAsync();
                    _visitas = visitas
                        .Where(v => MismoAgente(v.NombreAgente, _a.Nombre) && EsProgramada(v.Estado))
                        .Take(8)
                        .ToList();
                }
                catch { _visitas = new(); }

                try
                {
                    var oportunidades = await OportunidadSvc.RefrescarAsync();
                    _oportunidades = oportunidades
                        .Where(o => o.AgenteResponsableId == _a.Id)
                        .ToList();
                }
                catch { _oportunidades = new(); }

                try
                {
                    _actividad = InteraccionSvc.All()
                        .Where(i => MismoAgente(i.NombreAgenteResponsable, _a.Nombre))
                        .Take(6)
                        .ToList();
                }
                catch { _actividad = new(); }
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    // Visita "activa" para la agenda: programada (P) o reprogramada (G); no cancelada/realizada.
    private static bool EsProgramada(string estado)
    {
        var e = (estado ?? "").Trim().ToUpperInvariant();
        return e is "P" or "G" or "PROGRAMADA" or "REPROGRAMADA";
    }

    private static bool EsReprogramada(string estado)
    {
        var e = (estado ?? "").Trim().ToUpperInvariant();
        return e is "G" or "REPROGRAMADA";
    }

    // Cartera = captaciones en curso (pendiente/observada/activa), igual que el conteo del backend.
    private static bool CaptacionEnCartera(string estado)
    {
        var e = (estado ?? "").Trim().ToUpperInvariant();
        return e is "PENDIENTE DE REVISION" or "P" or "OBSERVADA" or "O" or "ACTIVA" or "A";
    }

    private static bool MismoAgente(string? nombreOperacion, string? nombreAgente) =>
        !string.IsNullOrWhiteSpace(nombreOperacion)
        && string.Equals(nombreOperacion.Trim(), (nombreAgente ?? "").Trim(), StringComparison.OrdinalIgnoreCase);
}
