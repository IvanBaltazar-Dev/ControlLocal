@page "/agents"
@inherits SafeComponentBase
@inject AppState App
@inject IAgenteService AgenteSvc
@inject ExportacionService Exportar

<PageTitle>Mis agentes · ControlLocal</PageTitle>

<AppShell Active="Mis agentes" Crumbs="@(new[] { "ControlLocal", "Mi equipo", "Mis agentes" })"
          Title="Mis agentes inmobiliarios"
          Subtitle="@($"Equipo bajo tu supervisión directa · {CuentaActivos} activos · {CuentaInactivos} inactivos")">
    <Actions>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("agente-form"))"><Icon Name="plus" Size="13" /> Registrar agente</button>
    </Actions>
    <ChildContent>
        <div class="cl-alert blue" style="margin-bottom:14px;">
            <Icon Name="info" Size="15" />
            <span>Al registrar un agente se crea automáticamente una <b>relación activa de supervisión</b> entre tú y el agente. Solo el broker administrador puede reasignar agentes a otro broker.</span>
        </div>

        @if (_cargando)
        {
            <div class="cl-card"><div class="cl-card-body" style="padding:44px;text-align:center;color:#7E8794;">Cargando agentes…</div></div>
        }
        else
        {
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="users" Label="Total" Value="@Todos.Count.ToString()" Tone="gray"
                        Active="@(_tab == "Todos")" OnClick="@(() => SetTab("Todos"))" />
            <MetricCard Icon="checkCircle" Label="Activos" Value="@CuentaActivos.ToString()" Tone="green"
                        Active="@(_tab == "Activos")" OnClick="@(() => SetTab("Activos"))" />
            <MetricCard Icon="x" Label="Inactivos" Value="@CuentaInactivos.ToString()" Tone="red"
                        Active="@(_tab == "Inactivos")" OnClick="@(() => SetTab("Inactivos"))" />
            <MetricCard Icon="layers" Label="Con cartera" Value="@CuentaConCaptaciones.ToString()" Tone="blue"
                        Footer="Con captaciones activas"
                        Active="@(_tab == "ConCaptaciones")" OnClick="@(() => SetTab("ConCaptaciones"))" />
            <MetricCard Icon="alert" Label="Sin carga" Value="@CuentaSinCarga.ToString()" Tone="amber"
                        Footer="Disponibles para asignar"
                        Active="@(_tab == "SinCarga")" OnClick="@(() => SetTab("SinCarga"))" />
        </div>

        var filtrados = Filtrados().ToList();
        var visibles = Paginador.Pagina(filtrados, ref _pagina);

        <FilterBar Search="Buscar agente por nombre, DNI o correo…"
                   @bind-Value="_query" ResultCount="filtrados.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros"
                   OnExport="@(() => ExportarCsv(filtrados))">
            <FilterSelect Placeholder="Todos los estados" Options="_estados" @bind-Value="_estado" />
            <FilterSelect Placeholder="Todas las zonas" Options="_zonas" @bind-Value="_zona" />
        </FilterBar>
        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Agente</th><th>Documento</th><th>Zona</th><th>Supervisión desde</th>
                            <th>Captaciones</th><th>Operaciones activas</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in visibles)
                        {
                            <tr>
                                <td>
                                    <div class="cl-flex">
                                        <span class="cl-avatar" style="width:28px;height:28px;font-size:11px;background:@a.Color;">@a.Iniciales</span>
                                        <div>
                                            <div style="font-weight:600;">@a.Nombre</div>
                                            <div class="cl-muted" style="font-size:11px;">@a.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="mono">@a.NumeroDocumento</span></td>
                                <td>@a.Zona</td>
                                <td><span class="cl-muted" style="font-size:12px;">@a.FechaIngresoTexto</span></td>
                                <td><span><b>@a.CaptacionesActivas</b></span></td>
                                <td><span><b>@a.OportunidadesActivas</b></span></td>
                                <td><StatusBadge Label="@a.EstadoAdministrativo" /></td>
                                <td>
                                    <div class="cl-row-actions">
                                        <button title="Ver" @onclick="@(() => App.Navigate($"agente-detail/{a.Id}"))"><Icon Name="eye" Size="14" /></button>
                                        <button title="Editar" @onclick="@(() => App.Navigate($"agente-form/{a.Id}"))"><Icon Name="edit" Size="13" /></button>
                                        @if (a.EstadoAdministrativo == "Activo")
                                        {
                                            <button class="danger" title="Desactivar" @onclick="@(() => PrepararDesactivacion(a))"><Icon Name="x" Size="13" /></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (filtrados.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="users" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin agentes en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtrados.Count" @bind-Page="_pagina" />
        }

        <ConfirmDialog Open="@(_deactivate is not null)" Tone="red" Icon="alert"
                       Title="¿Desactivar agente?"
                       Desc="@($"Se desactivará a {_deactivate}. No podrá ingresar al sistema ni registrar nuevas operaciones. Sus captaciones activas deberán reasignarse. La acción queda en la auditoría global.")"
                       ConfirmLabel="Desactivar agente" CancelLabel="Cancelar"
                       OnClose="@(() => _deactivate = null)"
                       OnConfirm="@OnDeactivate" />
        <Toast Show="@(_toast is not null)" Tone="blue" IconName="alert">@_toast</Toast>
    </ChildContent>
</AppShell>

@code {
    private string? _deactivate;
    private long? _deactivateId;
    private string? _toast;

    private string _query = "", _estado = "", _zona = "";
    private string _tab = "Todos";
    private int _pagina = 1;

    private bool _cargando = true;
    private IReadOnlyList<AgenteDto> _agentes = [];
    private IReadOnlyList<AgenteDto> Todos => _agentes;

    // Los conteos por agente (captaciones en cartera + operaciones en curso) llegan ya
    // calculados del backend en AgenteResponse.captacionesActivas/operacionesActivas.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _agentes = await AgenteSvc.RefrescarAsync(DisposedToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // La lista de agentes se muestra aunque no pueda refrescarse.
        }
        finally
        {
            _cargando = false;
        }
    }

    // KPIs clickeables que filtran la lista (mismo patrón que Solicitudes/Captaciones).
    private int CuentaActivos => Todos.Count(a => a.EstadoAdministrativo == "Activo");
    private int CuentaInactivos => Todos.Count(a => a.EstadoAdministrativo == "Inactivo");
    private int CuentaConCaptaciones => Todos.Count(a => a.CaptacionesActivas > 0);
    private int CuentaSinCarga => Todos.Count(a => a.CaptacionesActivas == 0 && a.OportunidadesActivas == 0);

    private void SetTab(string tab) { _tab = _tab == tab ? "Todos" : tab; _pagina = 1; }

    private bool CoincideTab(AgenteDto a) => _tab switch
    {
        "Activos" => a.EstadoAdministrativo == "Activo",
        "Inactivos" => a.EstadoAdministrativo == "Inactivo",
        "ConCaptaciones" => a.CaptacionesActivas > 0,
        "SinCarga" => a.CaptacionesActivas == 0 && a.OportunidadesActivas == 0,
        _ => true,
    };

    private readonly IReadOnlyList<string> _estados = new[] { "Activo", "Inactivo" };
    private IReadOnlyList<string> _zonas => Todos.Select(a => a.Zona)
        .Where(z => !string.IsNullOrWhiteSpace(z)).Distinct().OrderBy(x => x).ToList();

    private bool HayFiltros => _tab != "Todos" || new[] { _query, _estado, _zona }.Any(s => !string.IsNullOrEmpty(s));

    private void LimpiarFiltros() { _query = _estado = _zona = ""; _tab = "Todos"; _pagina = 1; }

    private async Task ExportarCsv(IReadOnlyList<AgenteDto> filtrados)
    {
        await Exportar.DescargarCsvAsync("agentes",
            new[] { "Agente", "Correo", "Documento", "Zona", "Supervisión desde", "Captaciones", "Operaciones activas", "Estado" },
            filtrados.Select(a => (IReadOnlyList<string?>)new[]
            {
                a.Nombre, a.Email, a.NumeroDocumento, a.Zona, a.FechaIngresoTexto,
                a.CaptacionesActivas.ToString(), a.OportunidadesActivas.ToString(), a.EstadoAdministrativo,
            }));
    }

    private IEnumerable<AgenteDto> Filtrados() => Todos.Where(a =>
        CoincideTab(a) &&
        (string.IsNullOrEmpty(_estado) || a.EstadoAdministrativo == _estado) &&
        (string.IsNullOrEmpty(_zona) || a.Zona == _zona) &&
        (string.IsNullOrEmpty(_query) || Coincide(a, _query)));

    private static bool Coincide(AgenteDto a, string q) =>
        TextoFiltro.Contiene(a.Nombre, q)
        || TextoFiltro.Contiene(a.NumeroDocumento, q)
        || TextoFiltro.Contiene(a.Email, q);

    private async Task OnDeactivate()
    {
        var n = _deactivate;
        if (_deactivateId is long id)
        {
            await AgenteSvc.DesactivarAsync(id);
            try { _agentes = await AgenteSvc.RefrescarAsync(DisposedToken); } catch { }
        }
        _deactivate = null;
        _deactivateId = null;
        _toast = $"{n} fue desactivado";
        await RenderIfAliveAsync();
        await DelayThenRenderAsync(2200, () => _toast = null);
    }

    private void PrepararDesactivacion(AgenteDto agente)
    {
        _deactivateId = agente.Id;
        _deactivate = agente.Nombre;
    }
}
