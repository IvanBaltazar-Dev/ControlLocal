@page "/login"
@layout AuthLayout
@rendermode InteractiveServer

<PageTitle>Login - ControlLocal</PageTitle>

<div class="card cl-login-card cl-login-premium">
    <div class="row g-0 min-vh-75">
        <div class="col-lg-5 cl-login-brand p-5 d-flex flex-column">
            <div class="d-flex align-items-center gap-3">
                <div class="cl-brand-mark">CL</div>
                <div>
                    <h1 class="h5 mb-0">ControlLocal</h1>
                    <div class="small text-white-50 text-uppercase">Sistema de Corretaje Comercial</div>
                </div>
            </div>
            <div class="cl-login-claim mt-5">
                <h2 class="h2 fw-bold">Gestion integral del proceso de alquiler comercial.</h2>
                <p>Captaciones, oportunidades, visitas, solicitudes y evaluaciones desde un panel interno para brokers y agentes.</p>
            </div>
            <div class="row g-3 mt-auto">
                <div class="col-4">
                    <div class="cl-login-stat"><strong>128</strong><span>Locales activos</span></div>
                </div>
                <div class="col-4">
                    <div class="cl-login-stat"><strong>46</strong><span>Oportunidades</span></div>
                </div>
                <div class="col-4">
                    <div class="cl-login-stat"><strong>12</strong><span>Cierres este mes</span></div>
                </div>
            </div>
        </div>
        <div class="col-lg-7 bg-white p-5 d-flex align-items-center">
            <div class="w-100">
                <div class="text-uppercase small text-secondary fw-semibold">Bienvenido</div>
                <h2 class="h3 fw-bold mb-2">Inicio de sesion</h2>
                <p class="text-secondary">Ingresa con tus credenciales de la corredora para acceder al panel.</p>

                <EditForm Model="_login" OnValidSubmit="Ingresar">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Usuario o correo corporativo</label>
                        <InputText class="form-control form-control-lg" @bind-Value="_login.Usuario" />
                        <ValidationMessage For="@(() => _login.Usuario)" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Contrasena</label>
                        <InputText type="password" class="form-control form-control-lg" @bind-Value="_login.Contrasena" />
                        <ValidationMessage For="@(() => _login.Contrasena)" />
                    </div>
                    <div class="mb-4">
                        <a href="/restablecimiento-administrado" class="small fw-semibold text-decoration-none">
                            Solicita un restablecimiento al equipo de soporte interno.
                        </a>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Ingresar como - perfil de prueba</label>
                        <InputSelect class="form-select form-select-lg" @bind-Value="_login.Rol">
                            <option value="@Roles.BrokerAdministrador">Broker administrador</option>
                            <option value="@Roles.Broker">Broker</option>
                            <option value="@Roles.Agente">Agente inmobiliario</option>
                        </InputSelect>
                        <div class="cl-role-hint mt-3">
                            <div><strong>Broker administrador</strong><span>Administra brokers, audita y reasigna agentes entre brokers.</span></div>
                            <div><strong>Broker</strong><span>Supervisa a sus agentes, revisa captaciones y evalua solicitudes.</span></div>
                            <div><strong>Agente inmobiliario</strong><span>Operacion comercial, captaciones, oportunidades y cierres.</span></div>
                        </div>
                    </div>
                    <button class="btn btn-primary cl-btn-primary btn-lg w-100" type="submit">Ingresar</button>
                    <div class="row g-2 mt-3">
                        <div class="col-md-4">
                            <button class="btn btn-outline-secondary w-100" type="button" @onclick="() => IngresarComo(Roles.BrokerAdministrador)">Probar admin</button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-secondary w-100" type="button" @onclick="() => IngresarComo(Roles.Broker)">Probar broker</button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-secondary w-100" type="button" @onclick="() => IngresarComo(Roles.Agente)">Probar agente</button>
                        </div>
                    </div>
                    <div class="cl-login-footnote mt-4">
                        Acceso restringido. Todas las acciones quedan registradas en la auditoria global.
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private RoleState RoleState { get; set; } = default!;

    private LoginModel _login = new() { Usuario = "admin@controllocal.pe", Contrasena = "demo123", Rol = Roles.BrokerAdministrador };

    private void Ingresar()
    {
        RoleState.SetRole(_login.Rol);
        Navigation.NavigateTo("/dashboard");
    }

    private void IngresarComo(string rol)
    {
        _login.Rol = rol;
        RoleState.SetRole(rol);
        Navigation.NavigateTo("/dashboard");
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingrese el usuario.")]
        public string Usuario { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingrese la contrasena.")]
        public string Contrasena { get; set; } = string.Empty;

        public string Rol { get; set; } = Roles.Agente;
    }
}
