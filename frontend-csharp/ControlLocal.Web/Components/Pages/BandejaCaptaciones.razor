@page "/bandeja-captaciones"
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject ExportacionService Exportar

<PageTitle>Captaciones por revisar · ControlLocal</PageTitle>

<AppShell Active="Captaciones por revisar" Crumbs="@(new[] { "ControlLocal", "Supervisión", "Captaciones por revisar" })"
          Title="Captaciones por revisar"
          Subtitle="Expedientes enviados por tus agentes · aprueba, observa o rechaza cada captación">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCsv"><Icon Name="download" Size="13" /> Exportar</button>
        <button class="cl-btn" @onclick="@(() => App.Navigate("oportunidades"))"><Icon Name="briefcase" Size="13" /> Operaciones del equipo</button>
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <div style="display:grid;grid-template-columns:repeat(@(_estados.Length + 2),1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="layers" Label="Total" Value="@Todas.Count.ToString()" Tone="gray"
                        Active="@(_tab == "Todas")" OnClick="@(() => _tab = "Todas")" />
            @foreach (var e in _estados)
            {
                <MetricCard Icon="@IconoEstado(e)" Label="@e" Value="@CuentaEstado(e).ToString()" Tone="@TonoEstado(e)"
                            Active="@(_tab == e)" OnClick="@(() => _tab = e)" />
            }
            <MetricCard Icon="users" Label="Agentes con envíos" Value="@_agentes.Count.ToString()" Tone="info" />
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

        <FilterBar Search="Buscar por código, agente, dirección…"
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Todos los agentes" Options="_agentes" @bind-Value="_agente" />
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Código</th><th>Local</th><th>Distrito</th><th>Área</th><th>Rubro</th>
                            <th>Propietario</th><th>Agente</th><th>Enviada</th><th>Comisión</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in visibles)
                        {
                            <tr>
                                <td><span class="mono">@c.CodigoCaptacion</span></td>
                                <td style="font-weight:600;">@c.DireccionLocal</td>
                                <td>@c.DistritoLocal</td>
                                <td><span><b>@c.AreaM2</b> m²</span></td>
                                <td><StatusBadge Label="@c.Rubro" ToneOverride="blue" Plain="true" /></td>
                                <td>@c.PropietarioNombre</td>
                                <td>@c.NombreAgenteResponsable</td>
                                <td>
                                    <div style="font-size:12px;">@c.FechaEnvioTexto</div>
                                    <div class="cl-muted" style="font-size:11px;">@c.AntiguedadTexto</div>
                                </td>
                                <td><span class="mono">@c.ComisionPactadaTexto</span></td>
                                <td><StatusBadge Label="@c.Estado" /></td>
                                <td><button class="cl-btn sm primary" @onclick="@(() => App.Navigate($"captacion-review/{c.CodigoCaptacion}"))">Revisar</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Actualizando bandeja…</div>
                }
                else if (_error is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="pin" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin captaciones en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />

        <div class="cl-alert blue" style="margin-top:14px;">
            <Icon Name="info" Size="15" />
            <span>Al <b>aprobar</b> una captación, esta queda activa y disponible para que el agente inicie el proceso comercial con sus clientes interesados.</span>
        </div>
    </ChildContent>
</AppShell>

@code {
    private string _tab = "Todas";
    private string _query = "", _agente = "", _distrito = "";
    private int _pagina = 1;
    private bool _cargando = true;
    private string? _error;

    private IReadOnlyList<BandejaCaptacionDto> Todas = [];

    // Recarga la bandeja fresca en cada navegacion: el broker ve de inmediato las
    // captaciones que el agente acaba de enviar a revision.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Todas = await CaptacionSvc.RefrescarBandejaAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private string[] _estados => Todas.Select(c => c.Estado).Distinct().OrderBy(x => x).ToArray();
    private IReadOnlyList<string> _agentes => Todas.Select(c => c.NombreAgenteResponsable)
        .Where(a => !string.IsNullOrWhiteSpace(a)).Distinct().OrderBy(x => x).ToList();
    private IReadOnlyList<string> _distritos => Todas.Select(c => c.DistritoLocal)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();

    private int CuentaEstado(string e) => Todas.Count(c => c.Estado == e);

    private Tabs.TabItem[] _tabs => new[] { new Tabs.TabItem("Todas", Todas.Count) }
        .Concat(_estados.Select(e => new Tabs.TabItem(e, CuentaEstado(e))))
        .ToArray();

    private bool HayFiltros => _tab != "Todas" || !string.IsNullOrEmpty(_query)
                               || !string.IsNullOrEmpty(_agente) || !string.IsNullOrEmpty(_distrito);

    private void LimpiarFiltros() { _tab = "Todas"; _query = ""; _agente = ""; _distrito = ""; _pagina = 1; }

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("bandeja_captaciones",
            new[] { "Código", "Local", "Distrito", "Área m²", "Rubro", "Propietario", "Agente", "Enviada", "Comisión %", "Estado" },
            Filtradas().Select(c => (IReadOnlyList<string?>)new[]
            {
                c.CodigoCaptacion, c.DireccionLocal, c.DistritoLocal, c.AreaM2.ToString(), c.Rubro,
                c.PropietarioNombre, c.NombreAgenteResponsable, c.FechaEnvioTexto, c.ComisionPactadaTexto, c.Estado,
            }));
    }

    private IEnumerable<BandejaCaptacionDto> Filtradas() => Todas.Where(c =>
        (_tab == "Todas" || c.Estado == _tab) &&
        (string.IsNullOrEmpty(_agente) || c.NombreAgenteResponsable == _agente) &&
        (string.IsNullOrEmpty(_distrito) || c.DistritoLocal == _distrito) &&
        (string.IsNullOrEmpty(_query) || Coincide(c, _query)));

    private static bool Coincide(BandejaCaptacionDto c, string q) =>
        (c.CodigoCaptacion?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (c.NombreAgenteResponsable?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (c.DireccionLocal?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);

    private static string TonoEstado(string e) => e switch
    {
        "Activa" => "green",
        "Observada" => "info",
        "Rechazada" => "red",
        _ => "blue",
    };

    private static string IconoEstado(string e) => e switch
    {
        "Observada" => "alert",
        "Activa" => "check",
        "Rechazada" => "x",
        _ => "clock",
    };
}
