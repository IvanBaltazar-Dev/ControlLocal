@page "/broker/captaciones"
@inject RoleState RoleState

<PageTitle>Captaciones por revisar - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">Broker</div>
        <div class="cl-page-title">Captaciones por revisar</div>
        <div class="cl-page-subtitle">Solo se muestran captaciones de agentes bajo tu supervision activa.</div>
    </div>
    <button class="btn btn-outline-secondary">Exportar</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><MetricCard Label="Pendientes de aprobacion" Value="9" Footer="3 ingresadas hoy" Icon="PE" Tone="amber" /></div>
    <div class="col-md-3"><MetricCard Label="Observadas" Value="4" Footer="Esperan ajuste del agente" Icon="OB" Tone="red" /></div>
    <div class="col-md-3"><MetricCard Label="Activas" Value="38" Footer="Mis agentes" Icon="AC" Tone="green" /></div>
    <div class="col-md-3"><MetricCard Label="Agentes activos" Value="7" Footer="BrokerAgente activo" Icon="AG" Tone="blue" /></div>
</div>

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-3">
                <select class="form-select">
                    <option>Estado</option>
                    @foreach (var estado in EnumCatalog.EstadosCaptacion)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </select>
            </div>
            <div class="col-lg-3"><select class="form-select"><option>Agente (mi equipo)</option><option>Valentina Mora</option><option>Carolina Vega</option><option>Andrea Torres</option></select></div>
            <div class="col-lg-2"><select class="form-select"><option>Antiguedad</option><option>Hoy</option><option>+24h</option><option>+48h</option></select></div>
            <div class="col-lg-2"><input class="form-control" placeholder="Distrito" /></div>
            <div class="col-lg-2"><button class="btn btn-outline-secondary w-100">Mas filtros</button></div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead><tr><th>Codigo</th><th>Local</th><th>Propietario</th><th>Agente del equipo</th><th>Enviada</th><th>Comision</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Captaciones)
                {
                    <tr>
                        <td><strong>@item.Codigo</strong></td>
                        <td><div>@item.Local</div><div class="text-secondary small">@item.Distrito · @item.Area m2 · @item.Rubro</div></td>
                        <td>@item.Propietario</td>
                        <td><div class="cl-avatar small">@item.Iniciales</div></td>
                        <td><div>@item.Enviada</div><div class="text-secondary small">@item.Antiguedad</div></td>
                        <td>@item.Comision</td>
                        <td><StatusBadge Label="@item.Estado" /></td>
                        <td class="text-end"><a class="btn btn-sm btn-primary cl-btn-primary" href="/broker/captaciones/revision">Revisar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Broker);

    private static readonly CaptacionReviewRow[] Captaciones =
    [
        new("CAP-0231", "Av. Petit Thouars 1875", "Jesus Maria", 95, "Servicios", "Grupo Bermudez", "CV", "22 May 14:08", "hace 2d", "5.0%", "Pendiente de revision"),
        new("CAP-0233", "Av. Caminos del Inca 1820", "Surco", 120, "Restaurante", "A. Pereyra", "VM", "23 May 11:30", "hace 1d", "6.0%", "Pendiente de revision"),
        new("CAP-0236", "Av. Pardo 2120", "Miraflores", 80, "Moda", "Inmobiliaria Pacifico", "AT", "25 May 09:05", "hoy", "5.5%", "Observada")
    ];

    private sealed record CaptacionReviewRow(string Codigo, string Local, string Distrito, int Area, string Rubro, string Propietario, string Iniciales, string Enviada, string Antiguedad, string Comision, string Estado);
}
