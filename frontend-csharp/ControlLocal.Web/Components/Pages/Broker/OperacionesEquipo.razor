@page "/broker/operaciones"
@inject RoleState RoleState

<PageTitle>Operaciones del equipo - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">Broker</div>
        <div class="cl-page-title">Operaciones del equipo</div>
        <div class="cl-page-subtitle">Seguimiento de oportunidades abiertas por los agentes bajo tu supervision.</div>
    </div>
    <button class="btn btn-outline-secondary">Exportar</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md"><MetricCard Label="Abiertas" Value="46" Footer="Mis agentes" Icon="OP" Tone="blue" /></div>
    <div class="col-md"><MetricCard Label="Con seguimiento" Value="31" Footer="Con actividad reciente" Icon="SG" Tone="info" /></div>
    <div class="col-md"><MetricCard Label="Solicitud creada" Value="18" Footer="En evaluacion" Icon="SO" Tone="amber" /></div>
    <div class="col-md"><MetricCard Label="Finalizadas exitosas" Value="12" Footer="Este mes" Icon="FE" Tone="green" /></div>
</div>

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-2"><select class="form-select"><option>Todas</option><option>Mis oportunidades</option><option>Sin actividad</option><option>Por cerrar</option></select></div>
            <div class="col-lg-2">
                <select class="form-select">
                    <option>Estado</option>
                    @foreach (var estado in EnumCatalog.EstadosOportunidad)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </select>
            </div>
            <div class="col-lg-2"><select class="form-select"><option>Agente</option><option>Valentina Mora</option><option>Daniel Romero</option></select></div>
            <div class="col-lg-2"><input class="form-control" placeholder="Captacion" /></div>
            <div class="col-lg-2"><select class="form-select"><option>Ultima actividad</option><option>Hoy</option><option>Esta semana</option><option>Sin actividad 7d+</option></select></div>
            <div class="col-lg-2"><button class="btn btn-outline-secondary w-100">Mas filtros</button></div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead><tr><th>Oportunidad</th><th>Cliente interesado</th><th>Captacion / local</th><th>Agente</th><th>Ultima interaccion</th><th>Proxima visita</th><th></th></tr></thead>
            <tbody>
                <tr><td><strong>OP-1098</strong><div class="text-secondary small">Creada 20 May</div></td><td>Inversiones Trebol<br /><span class="text-secondary small">Restaurante</span></td><td>Av. La Marina 245<br /><span class="text-secondary small">CAP-0218</span></td><td>VM Valentina Mora</td><td>Llamada · interesado<br /><span class="text-secondary small">Hoy 11:00</span></td><td>Visita guiada<br /><span class="text-secondary small">Hoy 16:00</span></td><td><button class="btn btn-sm btn-outline-secondary">Detalle 360</button></td></tr>
                <tr><td><strong>OP-1094</strong><div class="text-secondary small">Creada 18 May</div></td><td>Boutique Lila<br /><span class="text-secondary small">Moda</span></td><td>Calle Schell 412<br /><span class="text-secondary small">CAP-0226</span></td><td>CV Carolina Vega</td><td>Solicitud registrada<br /><span class="text-secondary small">Ayer 17:30</span></td><td>-</td><td><button class="btn btn-sm btn-outline-secondary">Detalle 360</button></td></tr>
                <tr><td><strong>OP-1089</strong><div class="text-secondary small">Creada 16 May</div></td><td>Bodegas del Norte<br /><span class="text-secondary small">Retail</span></td><td>Av. Petit Thouars 1875<br /><span class="text-secondary small">CAP-0231</span></td><td>DR Daniel Romero</td><td>Correo enviado<br /><span class="text-secondary small">Hace 2 dias</span></td><td>Por programar</td><td><button class="btn btn-sm btn-outline-secondary">Detalle 360</button></td></tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Broker);
}
