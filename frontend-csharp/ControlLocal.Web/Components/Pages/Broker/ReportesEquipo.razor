@page "/broker/reportes"
@inject RoleState RoleState

<PageTitle>Reportes de equipo - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">Broker</div>
        <div class="cl-page-title">Reportes de equipo</div>
        <div class="cl-page-subtitle">Desempeno de los agentes bajo tu supervision. Ultimos 90 dias.</div>
    </div>
    <div class="d-flex gap-2"><button class="btn btn-outline-secondary">Exportar Excel</button><button class="btn btn-primary cl-btn-primary">Exportar PDF</button></div>
</div>

<div class="card cl-card mb-3">
    <div class="card-body d-flex gap-2 flex-wrap">
        <button class="btn btn-primary cl-btn-primary">Ultimos 90 dias</button>
        <button class="btn btn-outline-secondary">Este mes</button>
        <button class="btn btn-outline-secondary">Este ano</button>
    </div>
</div>

<div class="cl-report-preview">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="cl-page-kicker">ControlLocal</div>
            <h2>Reporte de equipo - Ricardo Salas</h2>
            <p>Generado el 25 May 2026. Periodo 24 Feb - 25 May 2026. 7 agentes bajo supervision.</p>
        </div>
        <span class="badge text-bg-light border">Vista previa de exportacion</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md"><MetricCard Label="Oportunidades abiertas" Value="46" Footer="+8% vs periodo ant." Icon="OP" Tone="blue" /></div>
        <div class="col-md"><MetricCard Label="Con solicitud creada" Value="28" Footer="+12%" Icon="SO" Tone="info" /></div>
        <div class="col-md"><MetricCard Label="Finalizadas exitosas" Value="12" Footer="+4 resultados" Icon="FE" Tone="green" /></div>
        <div class="col-md"><MetricCard Label="No favorables" Value="5" Footer="-2" Icon="NF" Tone="red" /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card cl-card h-100">
                <div class="card-header bg-white fw-semibold">Evolucion de oportunidades (12 semanas)</div>
                <div class="card-body">
                    <div class="cl-bars">
                        @foreach (var value in new[] { 34, 48, 44, 62, 58, 73, 67, 76, 72, 86, 91, 84 })
                        {
                            <span style="height:@value%"></span>
                        }
                    </div>
                    <div class="d-flex justify-content-between text-secondary small mt-2">
                        <span>S1</span><span>S2</span><span>S3</span><span>S4</span><span>S5</span><span>S6</span><span>S7</span><span>S8</span><span>S9</span><span>S10</span><span>S11</span><span>S12</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card cl-card h-100">
                <div class="card-header bg-white fw-semibold">Embudo de conversion</div>
                <div class="card-body">
                    <div class="cl-funnel-row"><span>Oportunidades creadas</span><strong>100%</strong></div>
                    <div class="cl-funnel-row"><span>Con visita realizada</span><strong>71%</strong></div>
                    <div class="cl-funnel-row"><span>Con solicitud creada</span><strong>47%</strong></div>
                    <div class="cl-funnel-row"><span>Aprobadas</span><strong>29%</strong></div>
                    <div class="cl-funnel-row"><span>Finalizadas exitosas</span><strong>20%</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Broker);
}
