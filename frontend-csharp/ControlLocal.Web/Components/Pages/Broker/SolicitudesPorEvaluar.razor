@page "/broker/solicitudes"
@inject RoleState RoleState

<PageTitle>Solicitudes por evaluar - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">Broker</div>
        <div class="cl-page-title">Solicitudes por evaluar</div>
        <div class="cl-page-subtitle">Solicitudes presentadas por agentes bajo tu supervision. Esperan decision del broker.</div>
    </div>
    <button class="btn btn-outline-secondary">Exportar</button>
</div>

<div class="alert alert-info">
    Como broker puedes aprobar, observar, rechazar o cerrar solicitudes; nunca crearlas. El registro lo hace el agente desde una oportunidad con interes confirmado.
</div>

<div class="row g-3 mb-4">
    <div class="col-md"><MetricCard Label="Registradas" Value="6" Footer="Nuevas de mis agentes" Icon="RG" Tone="blue" /></div>
    <div class="col-md"><MetricCard Label="En revision" Value="4" Footer="Pendientes de decision" Icon="RV" Tone="amber" /></div>
    <div class="col-md"><MetricCard Label="Observadas" Value="3" Footer="Con ajustes solicitados" Icon="OB" Tone="red" /></div>
    <div class="col-md"><MetricCard Label="Aprobadas" Value="11" Footer="Este mes" Icon="AP" Tone="green" /></div>
</div>

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-3">
                <select class="form-select">
                    <option>Estado</option>
                    @foreach (var estado in EnumCatalog.EstadosSolicitudAlquiler)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </select>
            </div>
            <div class="col-lg-3"><select class="form-select"><option>Agente</option><option>Valentina Mora</option><option>Carolina Vega</option></select></div>
            <div class="col-lg-3"><input class="form-control" placeholder="Rango de monto" /></div>
            <div class="col-lg-3"><button class="btn btn-outline-secondary w-100">Mas filtros</button></div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead><tr><th>Codigo</th><th>Cliente</th><th>Local</th><th>Monto propuesto</th><th>Plazo</th><th>Documentos</th><th>Registrada</th><th>Estado</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Solicitudes)
                {
                    <tr>
                        <td><strong>@item.Codigo</strong><div class="text-secondary small">@item.Oportunidad</div></td>
                        <td>@item.Cliente</td>
                        <td><div>@item.Local</div><div class="text-secondary small">@item.Distrito</div></td>
                        <td>USD @item.Monto / mes</td>
                        <td>@item.Plazo meses</td>
                        <td>@item.Documentos</td>
                        <td>@item.Fecha</td>
                        <td><StatusBadge Label="@item.Estado" /></td>
                        <td class="text-end"><a class="btn btn-sm btn-primary cl-btn-primary" href="/broker/solicitudes/evaluacion">Evaluar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    protected override void OnInitialized() => RoleState.SetRole(Roles.Broker);

    private static readonly SolicitudRow[] Solicitudes =
    [
        new("SOL-0425", "OP-1094", "Boutique Lila", "Calle Schell 412", "Miraflores", "1 850", 24, "6/6", "23 May", "En revision"),
        new("SOL-0428", "OP-1083", "Inversiones Trebol", "Av. La Marina 245", "San Miguel", "2 750", 36, "5/6", "22 May", "Observada"),
        new("SOL-0430", "OP-1085", "Cafe Lima", "Jr. Berlin 230", "Miraflores", "1 400", 24, "4/6", "21 May", "Registrada"),
        new("SOL-0421", "OP-1077", "Carla Espinoza", "Av. Salaverry 2120", "Jesus Maria", "1 950", 24, "6/6", "19 May", "En revision")
    ];

    private sealed record SolicitudRow(string Codigo, string Oportunidad, string Cliente, string Local, string Distrito, string Monto, int Plazo, string Documentos, string Fecha, string Estado);
}
