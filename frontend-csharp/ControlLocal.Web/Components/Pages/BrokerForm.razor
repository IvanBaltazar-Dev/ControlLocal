@page "/broker-form"
@page "/broker-form/{CodigoParam}"
@inherits SafeComponentBase
@inject AppState App
@inject IBrokerService Brokers

<PageTitle>Editar broker · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Brokers", _nombre, "Editar" })"
          Title="Editar datos del broker"
          Subtitle="Actualiza contacto, zona y estado. La identidad y estructura del broker no se pueden modificar.">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("brokers"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Identificación" Sub="Datos fijados al crear el broker">
                    <div class="cl-grid c2">
                        <Field Label="Nombre completo" Required="true">
                            <input @bind="_nombre" disabled />
                        </Field>

                        <Field Label="Usuario" Required="true">
                            <input @bind="_usuario" disabled />
                            <div class="cl-muted" style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:6px;"><Icon Name="lock" Size="11" /> El usuario de acceso no se puede modificar.</div>
                        </Field>

                        <Field Label="Tipo de documento" Required="true">
                            <select @bind="_tipoDocumento" disabled>
                                @foreach (var opcion in EnumCatalog.TiposDocumentoIdentidad)
                                {
                                    <option value="@opcion.Code">@opcion.Label</option>
                                }
                            </select>
                        </Field>

                        <Field Label="Número de documento" Required="true">
                            <input @bind="_numeroDocumento" disabled />
                            <div class="cl-muted" style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:6px;"><Icon Name="lock" Size="11" /> El documento no se puede modificar.</div>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="2" Title="Contacto y estado" Sub="Medios de contacto y estado administrativo">
                    <div class="cl-grid c2">
                        <Field Label="Teléfono" Required="true"><input value="@_telefono" inputmode="numeric" maxlength="9" @oninput="OnTelefonoInput" /></Field>
                        <Field Label="Correo" Required="true"><input type="email" @bind="_correo" @bind:event="oninput" /></Field>
                        <Field Label="Zona o ámbito" Required="true"><input @bind="_zona" @bind:event="oninput" /></Field>
                        <Field Label="Estado" Required="true">
                            <select @bind="_estado">
                                @foreach (var opcion in EnumCatalog.EstadosActivoInactivo)
                                {
                                    <option value="@opcion.Label">@opcion.Label</option>
                                }
                            </select>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Datos estructurales" Sub="Solo lectura · se gestionan por administración">
                    <div class="cl-grid c2">
                        <Field Label="Tipo de broker"><input @bind="_tipoBroker" disabled /></Field>
                        <Field Label="Código de broker"><input @bind="_codigoBroker" disabled /></Field>
                        <Field Label="Fecha de designación"><input @bind="_fechaDesignacion" disabled /></Field>
                        <Field Label="Agentes a cargo"><input value="@_agentesACargo" disabled /></Field>
                    </div>
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;">
                        <Icon Name="alert" Size="15" /><span>@_err</span>
                    </div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("brokers"))" OnSave="@TryConfirm" SaveLabel="Guardar cambios" />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>El tipo de broker, el código interno, la fecha de designación y la identidad se mantienen bloqueados.</span>
                </div>
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="briefcase"
                       Title="Confirmar actualización del broker"
                       Desc="Se actualizarán datos de contacto, zona y estado. Esta acción no modificará identidad ni estructura del broker."
                       ConfirmLabel="Confirmar cambios" CancelLabel="Cancelar"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">Los datos del broker fueron actualizados correctamente.</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private bool _confirm;
    private bool _toast;
    private string? _err;

    private string _codigoBroker = "";
    private string _nombre = "";
    private string _usuario = "";
    private string _tipoDocumento = "";
    private string _numeroDocumento = "";
    private string _telefono = "";
    private string _correo = "";
    private string _zona = "";
    private string _estado = "Activo";
    private string _tipoBroker = "";
    private string _fechaDesignacion = "";
    private int _agentesACargo;

    private bool IsStep1Complete => !string.IsNullOrWhiteSpace(_nombre) && !string.IsNullOrWhiteSpace(_numeroDocumento);
    private bool IsStep2Complete => !string.IsNullOrWhiteSpace(_telefono) && !string.IsNullOrWhiteSpace(_correo)
                                    && !string.IsNullOrWhiteSpace(_zona) && !string.IsNullOrWhiteSpace(_estado);
    private bool IsStep3Complete => !string.IsNullOrWhiteSpace(_codigoBroker) && !string.IsNullOrWhiteSpace(_tipoBroker);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Identificación", "Bloqueada", IsStep1Complete),
        new FormStepsSidebar.Step("Contacto", "Teléfono, correo, estado", IsStep2Complete),
        new FormStepsSidebar.Step("Estructura", "Solo lectura", IsStep3Complete),
    };

    protected override async Task OnParametersSetAsync()
    {
        var broker = (string.IsNullOrWhiteSpace(CodigoParam) ? null : await Brokers.ByCodigoAsync(CodigoParam, DisposedToken))
                     ?? (await Brokers.AllAsync(DisposedToken)).FirstOrDefault() ?? new();

        _codigoBroker = broker.CodigoBroker;
        _nombre = broker.Nombre;
        _usuario = broker.Usuario;
        _tipoDocumento = NormalizarTipoDocumento(broker.TipoDocumento);
        _numeroDocumento = broker.NumeroDocumento;
        _telefono = PeruInputRules.Telefono(broker.Telefono);
        _correo = broker.Email;
        _zona = broker.Zona;
        _estado = string.IsNullOrWhiteSpace(broker.EstadoAdministrativo) ? "Activo" : broker.EstadoAdministrativo;
        _tipoBroker = broker.TipoBroker;
        _fechaDesignacion = broker.FechaDesignacionTexto;
        _agentesACargo = broker.AgentesACargo;
    }

    private void TryConfirm()
    {
        if (string.IsNullOrWhiteSpace(_telefono)) { _err = "El teléfono es obligatorio."; return; }
        if (PeruInputRules.ValidarTelefono(_telefono) is { } telefonoError) { _err = telefonoError; return; }
        if (string.IsNullOrWhiteSpace(_correo)) { _err = "El correo es obligatorio."; return; }
        if (string.IsNullOrWhiteSpace(_zona)) { _err = "La zona o ámbito es obligatorio."; return; }

        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        _confirm = false;
        var anterior = await Brokers.ByCodigoAsync(_codigoBroker, DisposedToken)
            ?? throw new InvalidOperationException("Broker no encontrado.");
        await Brokers.ActualizarAsync(new BrokerDto
        {
            Id = anterior.Id,
            CodigoBroker = anterior.CodigoBroker,
            Iniciales = anterior.Iniciales,
            Nombre = anterior.Nombre,
            TipoPersona = anterior.TipoPersona,
            TipoDocumento = _tipoDocumento,
            NumeroDocumento = anterior.NumeroDocumento,
            Telefono = PeruInputRules.Telefono(_telefono),
            Email = _correo.Trim(),
            Usuario = anterior.Usuario,
            ContrasenaTemporal = anterior.ContrasenaTemporal,
            Zona = _zona.Trim(),
            TipoBroker = anterior.TipoBroker,
            FechaDesignacion = anterior.FechaDesignacion,
            FechaDesignacionTexto = anterior.FechaDesignacionTexto,
            AgentesACargo = anterior.AgentesACargo,
            CaptacionesActivas = anterior.CaptacionesActivas,
            EstadoAdministrativo = _estado,
            EsAdministrador = anterior.EsAdministrador,
        }, DisposedToken);
        _toast = true;
        await RenderIfAliveAsync();
        try
        {
            await Task.Delay(300, DisposedToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        App.Navigate("brokers");
    }

    private static string NormalizarTipoDocumento(string valor) => valor switch
    {
        "DNI" => "D",
        "RUC" => "R",
        "CE" => "C",
        "PAS" => "P",
        _ => valor,
    };

    private void OnTelefonoInput(ChangeEventArgs e)
    {
        _telefono = PeruInputRules.Telefono(e.Value?.ToString());
        _err = null;
    }
}
