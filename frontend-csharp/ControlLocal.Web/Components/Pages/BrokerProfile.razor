@page "/broker-profile/{CodigoParam?}"
@inject AppState App
@inject IBrokerService Brokers
@inject ISolicitudService SolicitudSvc
@inject IInteraccionService InteraccionSvc
@inject IVisitaService VisitaSvc
@inject HttpAgenteService AgentesSvc

<PageTitle>Perfil de broker · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Brokers", b.Nombre })"
          Title="@b.Nombre"
          Subtitle="Perfil del broker · solicitudes y actividad de su equipo">
    <Actions>
        <button class="cl-btn" @onclick="@(() => App.Navigate("brokers"))">
            <Icon Name="chevronLeft" Size="13" /> Volver
        </button>

        @if (App.Role != Roles.Admin)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate($"broker-form/{b.CodigoBroker}"))">
                <Icon Name="edit" Size="13" /> Editar broker
            </button>
        }
    </Actions>
    <ChildContent>
        @if (_cargando)
        {
            <div class="cl-card"><div class="cl-card-body" style="padding:48px;text-align:center;color:#7E8794;">Cargando información del broker…</div></div>
        }
        else
        {
        <div style="display:grid;grid-template-columns:300px 1fr;gap:14px;align-items:start;">
            <div class="cl-stack">
                <div class="cl-card" style="text-align:center;padding:24px;">
                    <div class="cl-avatar" style="width:78px;height:78px;font-size:26px;margin:0 auto;">@b.Iniciales</div>
                    <div style="font-size:16px;font-weight:650;margin-top:12px;">@b.Nombre</div>
                    <div class="cl-muted" style="font-size:12px;margin-top:2px;">@b.Usuario</div>
                    <div style="margin-top:10px;display:flex;gap:6px;justify-content:center;flex-wrap:wrap;">
                        <StatusBadge Label="@b.TipoBroker" />
                        <StatusBadge Label="@b.EstadoAdministrativo" />
                    </div>
                </div>
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Supervisión</div></div>
                    <div class="cl-card-body">
                        <dl class="cl-kv" style="grid-template-columns:1fr auto;">
                            <dt>Agentes supervisados</dt><dd>@b.AgentesACargo</dd>
                            <dt>Zona o ámbito</dt><dd>@b.Zona</dd>
                            <dt>Captaciones del mes</dt><dd>@b.CaptacionesActivas</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="cl-card">
                <div class="cl-card-head"><div class="cl-card-title">Datos del broker</div><span class="cl-muted" style="font-size:11.5px;">Solo lectura</span></div>
                <div class="cl-card-body">
                    <div style="font-size:11px;color:var(--c-text-3);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:4px;">Identificación y contacto</div>
                    <div class="cl-def">
                        <Def K="Nombre completo" V="@b.Nombre" />
                        <Def K="Usuario" V="@b.Usuario" />
                        <Def K="Tipo de documento" V="@DocLabel(b.TipoDocumento)" />
                        <Def K="Número de documento" V="@b.NumeroDocumento" />
                        <Def K="Teléfono" V="@b.Telefono" />
                        <Def K="Correo" V="@b.Email" />
                    </div>
                    <div class="cl-divider"></div>
                    <div style="font-size:11px;color:var(--c-text-3);text-transform:uppercase;letter-spacing:0.05em;font-weight:600;margin-bottom:4px;">Información estructural <span style="text-transform:none;font-weight:500;color:var(--c-text-3);">· no editable</span></div>
                    <div class="cl-def">
                        <Def K="Tipo de broker" V="@b.TipoBroker" />
                        <Def K="Código de broker" V="@b.CodigoBroker" />
                        <Def K="Fecha de designación" V="@b.FechaDesignacionTexto" />
                        <Def K="Estado" V="@b.EstadoAdministrativo" />
                    </div>
                </div>
            </div>
        </div>

        <div style="margin-top:14px;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start;">
            <PagedPanel TItem="SolicitudAlquilerDto" Title="Últimas solicitudes creadas"
                        Items="_solicitudes" Coincide="CoincideSolicitud"
                        Placeholder="Buscar por código, cliente o local…"
                        Vacio="Este broker no tiene solicitudes registradas por su equipo.">
                <Cuerpo Context="items">
                    <table class="cl-table">
                        <thead><tr><th>Solicitud</th><th>Cliente</th><th>Local</th><th>Estado</th><th>Monto/mes</th></tr></thead>
                        <tbody>
                            @foreach (var s in items)
                            {
                                <tr>
                                    <td><span class="mono">@s.CodigoSolicitud</span></td>
                                    <td style="font-weight:600;">@(string.IsNullOrWhiteSpace(s.ClienteNombre) ? "—" : s.ClienteNombre)</td>
                                    <td>@s.DireccionLocal</td>
                                    <td><StatusBadge Label="@s.Estado" /></td>
                                    <td>@(s.MontoMensual > 0 ? $"USD {s.MontoMensualTexto}" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </Cuerpo>
            </PagedPanel>

            <PagedPanel TItem="ActividadItem" Title="Última actividad del equipo"
                        Items="_actividad" Coincide="CoincideActividad"
                        Placeholder="Buscar en la actividad…"
                        Vacio="Sin interacciones ni visitas programadas del equipo.">
                <Cuerpo Context="items">
                    <Timeline Items="@(items.Select(a => new Timeline.TimelineItem(a.Tiempo, a.Titulo, a.Subtitulo)).ToArray())" />
                </Cuerpo>
            </PagedPanel>
        </div>
        }
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private bool _cargando = true;
    private BrokerDto b = new();
    private List<SolicitudAlquilerDto> _solicitudes = new();
    private List<ActividadItem> _actividad = new();

    private record ActividadItem(string Tiempo, string Titulo, string Subtitulo);

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        try
        {
            b = (string.IsNullOrEmpty(CodigoParam) ? null : await Brokers.ByCodigoAsync(CodigoParam))
                ?? (await Brokers.AllAsync()).FirstOrDefault()
                ?? new();

            if (b.Id > 0)
            {
                var agentes = await AgentesSvc.AgentesDelBrokerAsync(b.Id);
                var idsAgentes = agentes.Select(a => a.Id).ToHashSet();
                var nombresAgentes = agentes
                    .Select(a => (a.Nombre ?? "").Trim())
                    .Where(n => n.Length > 0)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

                try
                {
                    var sols = await SolicitudSvc.RefrescarAsync();
                    _solicitudes = sols
                        .Where(s => idsAgentes.Contains(s.AgenteResponsableId))
                        .OrderByDescending(s => s.Id)
                        .ToList();
                }
                catch { _solicitudes = new(); }

                var actividad = new List<ActividadItem>();
                try
                {
                    var visitas = await VisitaSvc.RefrescarAsync();
                    actividad.AddRange(visitas
                        .Where(v => EsProgramada(v.Estado) && nombresAgentes.Contains((v.NombreAgente ?? "").Trim()))
                        .Select(v => new ActividadItem(
                            $"{v.FechaTexto} · {v.HoraTexto}",
                            string.IsNullOrWhiteSpace(v.ClienteNombre) ? "Visita programada" : v.ClienteNombre,
                            $"Visita programada · {v.DireccionLocal} · {v.NombreAgente}")));
                }
                catch { }

                try
                {
                    actividad.AddRange((await InteraccionSvc.AllAsync())
                        .Where(i => nombresAgentes.Contains((i.NombreAgenteResponsable ?? "").Trim()))
                        .Select(i => new ActividadItem(
                            i.FechaHoraTexto,
                            string.IsNullOrWhiteSpace(i.ClienteNombre) ? "Interacción" : i.ClienteNombre,
                            $"{EnumCatalog.LabelFor(EnumCatalog.CanalesContacto, i.CanalContacto)} · {i.NombreAgenteResponsable}")));
                }
                catch { }

                _actividad = actividad;
            }
        }
        finally
        {
            _cargando = false;
        }
    }

    private static bool EsProgramada(string estado)
    {
        var e = (estado ?? "").Trim().ToUpperInvariant();
        return e is "P" or "G" or "PROGRAMADA" or "REPROGRAMADA";
    }

    private static bool CoincideSolicitud(SolicitudAlquilerDto s, string q) =>
        TextoFiltro.Contiene(s.CodigoSolicitud, q)
        || TextoFiltro.Contiene(s.ClienteNombre, q)
        || TextoFiltro.Contiene(s.DireccionLocal, q);

    private static bool CoincideActividad(ActividadItem a, string q) =>
        TextoFiltro.Contiene(a.Titulo, q) || TextoFiltro.Contiene(a.Subtitulo, q);

    private static string DocLabel(string valor) => valor switch
    {
        "DNI" => "DNI",
        "RUC" => "RUC",
        "CE" => "Carnet de extranjeria",
        "PAS" => "Pasaporte",
        _ => EnumCatalog.LabelFor(EnumCatalog.TiposDocumentoIdentidad, valor),
    };
}
