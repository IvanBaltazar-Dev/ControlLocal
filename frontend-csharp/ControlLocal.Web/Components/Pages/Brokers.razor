@page "/brokers"
@inject AppState App
@inject IBrokerService BrokerSvc

<PageTitle>Gestión de brokers · ControlLocal</PageTitle>

<AppShell Active="Brokers" Crumbs="@(new[] { "ControlLocal", "Administración", "Brokers" })"
          Title="Gestión de brokers"
          Subtitle="6 brokers · 5 activos · 1 inactivo — busca, revisa y edita los datos de cada broker">
    <Actions>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("broker-nuevo"))"><Icon Name="plus" Size="13" /> Nuevo broker</button>
    </Actions>
    <ChildContent>
        @{ var filtrados = Filtrados().ToList(); }
        <FilterBar Search="Buscar broker por nombre o correo…" ShowTail="false"
                   @bind-Value="_query" ResultCount="filtrados.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Todos los estados" Options="_estados" @bind-Value="_estado" />
            <FilterSelect Placeholder="Todas las zonas" Options="_zonas" @bind-Value="_zona" />
        </FilterBar>
        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Broker</th><th>Tipo</th><th>Documento</th>
                            <th>Zona o ámbito</th><th>Agentes a cargo</th><th>Estado</th><th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in filtrados)
                        {
                            <tr>
                                <td>
                                    <div class="cl-flex">
                                        <span class="cl-avatar" style="width:30px;height:30px;font-size:11px;">@b.Iniciales</span>
                                        <div>
                                            <div style="font-weight:600;">@b.Nombre</div>
                                            <div class="cl-muted" style="font-size:11px;">@b.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td><StatusBadge Label="@b.TipoBroker" /></td>
                                <td><span class="mono">@b.TipoDocumento @b.NumeroDocumento</span></td>
                                <td>@b.Zona</td>
                                <td><span><b>@b.AgentesACargo</b> <span class="cl-muted">supervisados</span></span></td>
                                <td><StatusBadge Label="@b.EstadoAdministrativo" /></td>
                                <td>
                                    <div class="cl-row-actions">
                                        <button title="Ver perfil" @onclick="@(() => App.Navigate($"broker-profile/{b.CodigoBroker}"))"><Icon Name="eye" Size="15" /></button>
                                        <button title="Editar broker" @onclick="@(() => App.Navigate($"broker-form/{b.CodigoBroker}"))"><Icon Name="edit" Size="14" /></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (filtrados.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="briefcase" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin brokers en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtrados.Count" />
    </ChildContent>
</AppShell>

@code {
    private string _query = "", _estado = "", _zona = "";

    // Los brokers administradores no se listan en esta gestión.
    private IReadOnlyList<BrokerDto> Todos => BrokerSvc.All().Where(b => !b.EsAdministrador).ToList();

    private readonly IReadOnlyList<string> _estados = new[] { "Activo", "Inactivo" };
    private IReadOnlyList<string> _zonas => Todos.Select(b => b.Zona)
        .Where(z => !string.IsNullOrWhiteSpace(z)).Distinct().OrderBy(x => x).ToList();

    private bool HayFiltros => new[] { _query, _estado, _zona }.Any(s => !string.IsNullOrEmpty(s));

    private void LimpiarFiltros() { _query = _estado = _zona = ""; }

    private IEnumerable<BrokerDto> Filtrados() => Todos.Where(b =>
        (string.IsNullOrEmpty(_estado) || b.EstadoAdministrativo == _estado) &&
        (string.IsNullOrEmpty(_zona) || b.Zona == _zona) &&
        (string.IsNullOrEmpty(_query) || Coincide(b, _query)));

    private static bool Coincide(BrokerDto b, string q) =>
        (b.Nombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (b.Email?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
}
