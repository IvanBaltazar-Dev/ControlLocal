@page "/captacion-detail/{CodigoParam?}"
@inherits SafeComponentBase
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject IOportunidadService OportunidadSvc
@inject ISolicitudService SolicitudSvc
@inject ILocalService LocalSvc
@inject IProspeccionService ProspeccionSvc
@inject IInteraccionService InteraccionSvc
@inject ICoincidenciaCarteraService CoincidenciaSvc
@inject IReportePropietarioService ReporteSvc
@inject ExportacionService Exportar

<PageTitle>Expediente @_cap.CodigoCaptacion - ControlLocal</PageTitle>

@if (_cargando)
{
    <AppShell Title="Expediente de la propiedad" Crumbs="@(new[] { "ControlLocal", "Captaciones" })">
        <ChildContent>
            <LoadingBlock Title="Cargando expediente..." Subtitle="Preparando propiedad, solicitudes y seguimiento asociado." />
        </ChildContent>
    </AppShell>
}
else
{
<AppShell Crumbs="@_crumbs"
          Title="@($"{_cap.CodigoCaptacion} - {_cap.DireccionLocal}")"
          Subtitle="@($"Expediente comercial - {_cap.DistritoLocal}")">
    <Actions>
        <a class="cl-btn ghost" href="@(_readOnly ? "/seguimiento-comercial" : "/captaciones")"><Icon Name="chevronLeft" Size="13" /> Volver</a>
        @if (App.Role == Roles.Broker && !string.IsNullOrWhiteSpace(RutaRevisionBroker))
        {
            <a class="cl-btn primary" href="@RutaRevisionBroker"><Icon Name="checkCircle" Size="13" /> Revisar ahora</a>
        }
        @if (_readOnly)
        {
            <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
        else if (_cap.Estado is "Activa" or "A")
        {
            <a class="cl-btn primary" href="@($"/oportunidad-form/{_cap.CodigoCaptacion}")"><Icon Name="plus" Size="13" /> Nueva oportunidad</a>
        }
    </Actions>
    <ChildContent>
        <div class="cl-stage" style="margin-bottom:6px;">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var cls = i < _current ? "done" : (i == _current ? "active" : "");
                <div class="cl-stage-step @cls">
                    <div class="cl-stage-k"><span class="cl-stage-dot"></span> Etapa @(i + 1)</div>
                    <div class="cl-stage-v">@_stages[i]</div>
                </div>
            }
        </div>
        <div class="cl-muted" style="font-size:12px;margin-bottom:14px;">
            @_ops.Count cliente(s) interesado(s) - @_solicitudes.Count con solicitud - etapa mas avanzada: <b>@_stages[_current]</b>
        </div>

        <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,360px);gap:16px;align-items:start;">
            <div>
                <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

                @if (_tab == "Resumen")
                {
                    <div class="cl-stack">
                        <div class="cl-card">
                            <div class="cl-card-head">
                                <div>
                                    <div class="cl-card-title">La propiedad</div>
                                    <div class="cl-card-sub">Resumen comercial del inmueble captado</div>
                                </div>
                                <div class="cl-flex" style="gap:8px;justify-content:flex-end;">
                                    <FichaLink Kind="owner" Id="@PropietarioId" Text="Ver propietario" Variant="button" />
                                    <StatusBadge Label="@_cap.Estado" />
                                </div>
                            </div>
                            <div class="cl-card-body">
                                <div class="cl-specs">
                                    <Spec Icon="mapPin" K="Direccion" V="@_cap.DireccionLocal" />
                                    <Spec Icon="map" K="Distrito" V="@_cap.DistritoLocal" />
                                    <Spec Icon="building" K="Area" V="@($"{_cap.AreaM2} m2")" />
                                    <Spec Icon="briefcase" K="Rubro" V="@_cap.Rubro" />
                                    <Spec Icon="user" K="Propietario" V="@_cap.PropietarioNombre" />
                                    <Spec Icon="calendar" K="Captacion" V="@FechaCaptacionTexto" />
                                    <Spec Icon="target" K="Comision" V="@($"{_cap.ComisionPactadaTexto}%")" />
                                    <Spec Icon="lock" K="Exclusividad" V="@ExclusividadTexto" />
                                </div>
                            </div>
                        </div>

                        @* Ficha comercial: condiciones pactadas (izquierda) con estado y continuidad al costado (derecha). *@
                        <div style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:14px;align-items:start;">
                            <div class="cl-card">
                                <div class="cl-card-head">
                                    <div>
                                        <div class="cl-card-title">Condiciones comerciales</div>
                                        <div class="cl-card-sub">Terminos pactados del encargo</div>
                                    </div>
                                </div>
                                <div class="cl-card-body">
                                    <div class="cl-specs">
                                        <Spec Icon="target" K="Comision" V="@($"{_cap.ComisionPactadaTexto}%")" />
                                        <Spec Icon="flag" K="Urgencia" V="@UrgenciaTexto" />
                                        <Spec Icon="lock" K="Exclusividad" V="@ExclusividadTexto" />
                                        <Spec Icon="calendar" K="Vigencia" V="@_cap.VigenciaTexto" />
                                    </div>
                                </div>
                            </div>
                            <div class="cl-stack">
                                <div class="cl-card">
                                    <div class="cl-card-head"><div class="cl-card-title">Estado de la propiedad</div></div>
                                    <div class="cl-card-body">
                                        <dl class="cl-kv" style="grid-template-columns:1fr auto;">
                                            <dt>Captacion</dt><dd><StatusBadge Label="@_cap.Estado" /></dd>
                                            <dt>Clientes interesados</dt><dd>@_ops.Count</dd>
                                            <dt>Con solicitud</dt><dd>@_solicitudes.Count</dd>
                                            <dt>Etapa mas avanzada</dt><dd>@_stages[_current]</dd>
                                        </dl>
                                    </div>
                                </div>
                                <div class="cl-card">
                                    <div class="cl-card-head"><div class="cl-card-title">Continuidad comercial</div></div>
                                    <div class="cl-card-body cl-stack">
                                        <FilaExpediente Icon="store" Titulo="Local prospectado" Estado="@TextoLocal">
                                            <Accion>
                                                @if (_cap.LocalId > 0)
                                                {
                                                    <a class="cl-btn sm" href="@($"/local-detail/{_cap.LocalId}")"><Icon Name="eye" Size="12" /> Ver</a>
                                                }
                                            </Accion>
                                        </FilaExpediente>
                                        @if (_prospeccion is not null)
                                        {
                                            <FilaExpediente Icon="history" Titulo="Seguimiento del propietario" Estado="@EstadoProspeccionTexto">
                                                <Accion>
                                                    <a class="cl-btn sm" href="@($"/prospeccion-detail/{_prospeccion.Id}")"><Icon Name="activity" Size="12" /> Seguimiento</a>
                                                </Accion>
                                            </FilaExpediente>
                                        }
                                        <div class="cl-alert blue" style="margin:0;">
                                            <Icon Name="flag" Size="15" />
                                            <span><b>@ProximoPasoTitulo</b><br />@ProximoPasoDetalle</span>
                                        </div>
                                        @if (!_readOnly && !string.IsNullOrWhiteSpace(ProximoPasoRuta))
                                        {
                                            <a class="cl-btn sm" href="@ProximoPasoRuta"><Icon Name="arrowRight" Size="12" /> Continuar</a>
                                        }
                                        else if (App.Role == Roles.Broker && !string.IsNullOrWhiteSpace(RutaRevisionBroker))
                                        {
                                            <a class="cl-btn sm primary" href="@RutaRevisionBroker"><Icon Name="checkCircle" Size="12" /> Revisar ahora</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                            <div class="cl-card">
                                <div class="cl-card-head">
                                    <div>
                                        <div class="cl-card-title">Interacciones con propietario</div>
                                        <div class="cl-card-sub">Comunicacion registrada durante la captacion</div>
                                    </div>
                                    <div class="cl-flex" style="gap:8px;">
                                        <span class="cl-badge blue">@_interaccionesCaptacion.Count</span>
                                        @if (!_readOnly && _cap.Estado is "Activa" or "A" && _cap.Id > 0)
                                        {
                                            <button class="cl-btn sm primary" @onclick="AbrirInteraccion"><Icon Name="plus" Size="12" /> Registrar interaccion</button>
                                        }
                                    </div>
                                </div>
                                <div class="cl-card-body" style="padding:0;">
                                    @if (_interaccionesCaptacion.Count == 0)
                                    {
                                        <div style="padding:28px;text-align:center;color:#7E8794;font-size:12.5px;">
                                            Aun no hay interacciones de captacion con el propietario.
                                        </div>
                                    }
                                    else
                                    {
                                        <table class="cl-table">
                                            <thead>
                                                <tr>
                                                    <th>Fecha</th>
                                                    <th>Canal</th>
                                                    <th>Resultado</th>
                                                    <th>Observaciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var interaccion in _interaccionesCaptacion)
                                                {
                                                    <tr>
                                                        <td style="font-size:12px;color:#7E8794;">@interaccion.FechaHoraTexto</td>
                                                        <td><CanalBadge Canal="@interaccion.CanalContacto" /></td>
                                                        <td><ResultadoBadge Resultado="@interaccion.Resultado" Contexto="@interaccion.Contexto" /></td>
                                                        <td>@Texto(interaccion.Observaciones)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </div>

                        <div class="cl-card">
                            <div class="cl-card-head">
                                <div>
                                    <div class="cl-card-title">Reporte al propietario</div>
                                    <div class="cl-card-sub">Consultas, visitas, objeciones y recomendaciones reportadas durante la captación</div>
                                </div>
                                <span class="cl-badge blue">@_reportes.Count</span>
                            </div>
                            <div class="cl-card-body" style="padding:0;">
                                @if (_reportes.Count == 0)
                                {
                                    <div style="padding:28px;text-align:center;color:#7E8794;font-size:12.5px;">
                                        Aún no se ha reportado al propietario.@(!_readOnly && _cap.Estado is "Activa" or "A" ? " Registra el primer avance del periodo." : "")
                                    </div>
                                }
                                else
                                {
                                    <table class="cl-table">
                                        <thead><tr><th>Reporte</th><th>Periodo</th><th>Consultas</th><th>Visitas</th><th>Canal</th><th>Recomendaciones</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var r in _reportes)
                                            {
                                                <tr>
                                                    <td style="font-size:12px;color:#7E8794;">@r.FechaReporteTexto</td>
                                                    <td style="font-size:12px;">@r.PeriodoTexto</td>
                                                    <td>@(r.ConsultasReportadas?.ToString() ?? "-")</td>
                                                    <td>@(r.VisitasReportadas?.ToString() ?? "-")</td>
                                                    <td><CanalBadge Canal="@r.CanalEnvio" /></td>
                                                    <td>@Texto(r.AjustesRecomendados)</td>
                                                    <td style="text-align:right;">
                                                        <button class="cl-btn sm" @onclick="@(() => DescargarReporte(r))" title="Exportar ficha de avance en PDF"><Icon Name="download" Size="12" /> PDF</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>

                        <div class="cl-card">
                            <div class="cl-card-head">
                                <div class="cl-card-title">Clientes interesados</div>
                                <span class="cl-badge blue">@_ops.Count</span>
                            </div>
                            <div class="cl-card-body" style="display:flex;flex-direction:column;gap:8px;">
                                @foreach (var o in _ops)
                                {
                                    <div style="display:flex;gap:11px;align-items:center;padding:11px 12px;border:1.5px solid var(--c-border);border-radius:11px;background:#fff;">
                                        <span class="cl-avatar" style="width:32px;height:32px;font-size:11px;flex:0 0 32px;background:#005BFF;">@Iniciales(o.ClienteNombre)</span>
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-weight:600;font-size:13px;">@o.ClienteNombre</div>
                                            <div class="cl-muted" style="font-size:11px;">@o.CodigoOportunidad - desde @o.FechaRegistroTexto</div>
                                        </div>
                                        <StatusBadge Label="@o.Estado" />
                                        <FichaLink Kind="cliente" Id="@o.ClienteId" Text="Ficha cliente" Variant="button" />
                                        <a class="cl-btn sm" href="@($"/oportunidad-detail/{o.Id}")"><Icon Name="arrowRight" Size="12" /> Seguimiento</a>
                                    </div>
                                }
                                @if (_ops.Count == 0)
                                {
                                    <div class="cl-muted" style="font-size:12px;">Aun no hay clientes interesados en esta propiedad.</div>
                                }
                            </div>
                        </div>

                        @if (_cap.Estado is "Activa" or "A")
                        {
                            @if (!_coincidenciasOpen)
                            {
                                <div class="cl-card">
                                    <div class="cl-card-head">
                                        <div>
                                            <div class="cl-card-title"><Icon Name="users" Size="14" /> Clientes interesados compatibles</div>
                                            <div class="cl-card-sub">Clientes con requerimiento activo compatible con esta propiedad.</div>
                                        </div>
                                        <button class="cl-btn sm" @onclick="AbrirCoincidencias"><Icon Name="chevronRight" Size="12" /> Ver clientes</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <PanelCoincidencias Titulo="Clientes interesados compatibles"
                                                    Icono="users"
                                                    Descripcion="Clientes de tu cartera cuyo requerimiento activo encaja con esta propiedad. Proponer abre la oportunidad prellenada."
                                                    Items="_coincidencias?.Items"
                                                    Total="@(_coincidencias?.Total ?? 0)"
                                                    Page="@_coinPage"
                                                    PageSize="@_coinPageSize"
                                                    PageChanged="CambiarPaginaCoincidencias"
                                                    Cargando="_cargandoCoin"
                                                    Error="@_errCoin"
                                                    TextoVacio="Ningun cliente de tu cartera tiene un requerimiento activo que coincida por ahora." />
                                <button class="cl-btn sm ghost" @onclick="CerrarCoincidencias"><Icon Name="chevronLeft" Size="12" /> Ocultar clientes</button>
                            }
                        }
                    </div>
                }
                else if (_tab == "Solicitudes")
                {
                    <div class="cl-card">
                        <div class="cl-card-body" style="padding:0;">
                            <table class="cl-table">
                                <thead><tr><th>Solicitud</th><th>Cliente</th><th>Monto/mes</th><th>Docs</th><th>Estado</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var s in _solicitudes)
                                    {
                                        <tr>
                                            <td><span class="mono">@s.CodigoSolicitud</span></td>
                                            <td style="font-weight:600;">@s.ClienteNombre</td>
                                            <td>USD @s.MontoMensualTexto</td>
                                            <td><span class="cl-muted" style="font-size:12px;">@s.DocumentosTexto</span></td>
                                            <td><StatusBadge Label="@s.Estado" /></td>
                                            <td><a class="cl-btn sm" href="@($"/solicitud-detail/{s.CodigoSolicitud}")"><Icon Name="eye" Size="12" /> Ver</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_solicitudes.Count == 0)
                            {
                                <div style="padding:40px 20px;text-align:center;color:#7E8794;">
                                    <div style="margin-bottom:8px;"><Icon Name="fileText" Size="26" /></div>
                                    <div style="font-weight:600;margin-bottom:4px;">Sin solicitudes en esta propiedad</div>
                                    <div class="cl-muted" style="font-size:12.5px;">Cuando un cliente decida alquilar, su solicitud aparecera aqui.</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div>
                                <div class="cl-card-title">Expediente comercial</div>
                                <div class="cl-card-sub">Fichas y documentos generados desde datos reales</div>
                            </div>
                        </div>
                        <div class="cl-card-body cl-stack">
                            <FilaExpediente Icon="store" Titulo="Ficha de propiedad" Estado="@_cap.CodigoCaptacion">
                                <Accion>
                                    <a class="cl-btn sm" href="@($"/ficha-propiedad/{_cap.CodigoCaptacion}")"><Icon Name="eye" Size="12" /> Abrir</a>
                                </Accion>
                            </FilaExpediente>
                            <FilaExpediente Icon="fileText" Titulo="Ficha de captacion" Estado="@_cap.Estado">
                                <Accion>
                                    <button class="cl-btn sm" @onclick="DescargarFichaCaptacion"><Icon Name="download" Size="12" /> PDF</button>
                                </Accion>
                            </FilaExpediente>
                            <FilaExpediente Icon="lock" Titulo="Contrato de exclusividad" Estado="@ExclusividadTexto">
                                <Accion>
                                    <button class="cl-btn sm" @onclick="DescargarContratoExclusividad"><Icon Name="download" Size="12" /> PDF</button>
                                </Accion>
                            </FilaExpediente>
                            @foreach (var s in _solicitudes)
                            {
                                <FilaExpediente Icon="fileText" Titulo="@($"Solicitud {s.CodigoSolicitud}")" Estado="@s.DocumentosTexto">
                                    <Accion>
                                        <a class="cl-btn sm" href="@($"/solicitud-detail/{s.CodigoSolicitud}")"><Icon Name="eye" Size="12" /> Ver</a>
                                    </Accion>
                                </FilaExpediente>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="cl-stack">
                @if (!_readOnly && _cap.Estado is "Activa" or "A" && _cap.Id > 0)
                {
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Acciones de captacion</div></div>
                        <div class="cl-card-body">
                            <div style="display:flex;flex-direction:column;gap:8px;">
                                <button class="cl-btn primary" @onclick="AbrirInteraccion"><Icon Name="activity" Size="13" /> Registrar interaccion</button>
                                <a class="cl-btn success" href="@($"/oportunidad-form/{_cap.CodigoCaptacion}")"><Icon Name="plus" Size="13" /> Crear oportunidad</a>
                                <button class="cl-btn" @onclick="AbrirReporte"><Icon Name="fileText" Size="13" /> Registrar reporte</button>
                            </div>
                        </div>
                    </div>
                }
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Este expediente consolida la propiedad, sus etapas previas, clientes interesados, solicitudes y documentos reales.</span>
                </div>
            </div>
        </div>

        @* Registro rápido de interacción con el propietario sin salir del expediente (mismo cuerpo que /interaccion-form). *@
        <Modal Open="_modalInteraccion" Tone="blue" Icon="activity"
               Title="Registrar interacción con el propietario"
               Desc="@($"Contacto con {_cap.PropietarioNombre} sobre {_cap.DireccionLocal}")"
               OnClose="CerrarInteraccion">
            <ChildContent>
                @if (_errInteraccion is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;"><Icon Name="alert" Size="15" /><span>@_errInteraccion</span></div>
                }
                <InteraccionEditor @key="_interaccionEditorKey" @ref="_interaccionEditor" Contexto="CAPTACION" EntidadId="_cap.Id"
                                   Compacto="true" NumContacto="1" NumDetalle="2" OnCambio="StateHasChanged" />
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" disabled="@_guardandoInteraccion" @onclick="CerrarInteraccion">Cancelar</button>
                <button class="cl-btn primary" disabled="@_guardandoInteraccion" @onclick="GuardarInteraccion">
                    @(_guardandoInteraccion ? "Registrando..." : "Registrar interacción")
                </button>
            </Footer>
        </Modal>

        <Modal Open="_modalReporte" Icon="fileText" Tone="blue"
               Title="Registrar reporte al propietario"
               Desc="@($"Avances de {_cap.CodigoCaptacion} para {_cap.PropietarioNombre}")"
               OnClose="CerrarReporte">
            <ChildContent>
                @if (_errReporte is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:12px;"><Icon Name="alert" Size="15" /><span>@_errReporte</span></div>
                }
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <Field Label="Periodo desde"><input type="date" @bind="_rPeriodoInicio" @bind:after="RecalcularPreview" /></Field>
                    <Field Label="Periodo hasta"><input type="date" @bind="_rPeriodoFin" @bind:after="RecalcularPreview" /></Field>
                    <Field Label="Consultas recibidas (automático)">
                        <div style="padding:8px 10px;border:1.5px solid var(--c-border);border-radius:9px;background:#F6F8FB;color:#384150;font-size:13px;">@(_previewCargando ? "Calculando…" : _rConsultas.ToString())</div>
                    </Field>
                    <Field Label="Visitas realizadas (automático)">
                        <div style="padding:8px 10px;border:1.5px solid var(--c-border);border-radius:9px;background:#F6F8FB;color:#384150;font-size:13px;">@(_previewCargando ? "Calculando…" : _rVisitas.ToString())</div>
                    </Field>
                </div>
                <div class="cl-muted" style="font-size:11.5px;margin:-4px 0 4px;">
                    Consultas y visitas se calculan de las interacciones y visitas reales de la propiedad en el periodo seleccionado.
                </div>
                <Field Label="Canal de envío al propietario">
                    <select @bind="_rCanal">
                        @foreach (var c in EnumCatalog.CanalesContacto)
                        {
                            <option value="@c.Code">@c.Label</option>
                        }
                    </select>
                </Field>
                <Field Label="Objeciones frecuentes (automático)">
                    <div style="padding:8px 10px;border:1.5px solid var(--c-border);border-radius:9px;background:#F6F8FB;color:#384150;font-size:13px;min-height:18px;">@(_previewCargando ? "Calculando…" : (string.IsNullOrWhiteSpace(_rObjeciones) ? "Sin objeciones registradas en el periodo (se jalan de los motivos de no continuidad)." : _rObjeciones))</div>
                </Field>
                <Field Label="Ajustes recomendados (opcional)">
                    <textarea rows="2" @bind="_rAjustes" placeholder="Recomendaciones al propietario: precio, acondicionamiento, condiciones..."></textarea>
                </Field>
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" disabled="@_guardandoReporte" @onclick="CerrarReporte">Cancelar</button>
                <button class="cl-btn primary" disabled="@_guardandoReporte" @onclick="GuardarReporte">
                    @(_guardandoReporte ? "Guardando..." : "Registrar reporte")
                </button>
            </Footer>
        </Modal>
    </ChildContent>
</AppShell>
}

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private bool _cargando = true;
    private CaptacionDto _cap = new();
    private LocalComercialDto? _local;
    private ProspeccionDto? _prospeccion;
    private IReadOnlyList<OportunidadComercialDto> _ops = new List<OportunidadComercialDto>();
    private IReadOnlyList<SolicitudAlquilerDto> _solicitudes = new List<SolicitudAlquilerDto>();
    private IReadOnlyList<InteraccionComercialDto> _interaccionesCaptacion = new List<InteraccionComercialDto>();
    private CoincidenciasDto? _coincidencias;
    private bool _cargandoCoin;
    private string? _errCoin;
    private bool _coincidenciasOpen;
    private int _coinPage = 1;
    private readonly int _coinPageSize = 6;

    // Reporte al propietario (Etapa 8): historial + formulario de registro.
    private IReadOnlyList<ReportePropietarioDto> _reportes = new List<ReportePropietarioDto>();
    private bool _modalReporte;
    private bool _guardandoReporte;
    private bool _previewCargando;
    private string? _errReporte;
    private DateTime? _rPeriodoInicio;
    private DateTime? _rPeriodoFin;
    private int _rConsultas;
    private int _rVisitas;
    private string _rObjeciones = "";
    private string _rAjustes = "";
    private string _rCanal = "E";

    // Registro rápido de interacción con el propietario (reutiliza InteraccionEditor en contexto CAPTACION).
    private bool _modalInteraccion;
    private bool _guardandoInteraccion;
    private int _interaccionEditorKey;
    private InteraccionEditor? _interaccionEditor;
    private string? _errInteraccion;

    private bool _readOnly => App.Role == Roles.Broker || App.Role == Roles.Admin;
    private string _tab = "Resumen";

    private string UrgenciaTexto => _cap.Urgencia is int nivel ? $"{nivel} / 5" : "-";
    private string FechaCaptacionTexto => _cap.FechaCaptacion?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
    private string ExclusividadTexto => _cap.Exclusividad == true ? "Encargo exclusivo" : _cap.Exclusividad == false ? "No exclusivo" : "-";
    private string TextoLocal => _local is null ? _cap.DireccionLocal : $"{_local.CodigoLocal} - {_local.Estado}";
    private long? PropietarioId => _local?.PropietarioId;
    private bool CaptacionPendienteRevision => _cap.Estado is "Pendiente de revision" or "Pendiente de revisión" or "P";
    private SolicitudAlquilerDto? SolicitudPorEvaluar =>
        _solicitudes.FirstOrDefault(s => s.Estado is "En revision" or "En revisión");
    private string? RutaRevisionBroker
    {
        get
        {
            if (App.Role != Roles.Broker) return null;
            if (CaptacionPendienteRevision && !string.IsNullOrWhiteSpace(_cap.CodigoCaptacion))
                return $"/captacion-review/{_cap.CodigoCaptacion}";
            if (SolicitudPorEvaluar is { } solicitud)
                return $"/evaluacion/{solicitud.CodigoSolicitud}";
            return null;
        }
    }
    private string EstadoProspeccionTexto => _prospeccion is null ? "Sin datos de prospeccion" : _prospeccion.Estado switch
    {
        "T" => "La propiedad ya fue captada",
        "S" => "En seguimiento",
        "E" => "Propuesta entregada",
        "R" => "Reunion registrada",
        "C" => "Contactado",
        "D" => "Descartado",
        _ => "Prospecto",
    };

    private string ProximoPasoTitulo => _current switch
    {
        >= 4 => "Propiedad alquilada",
        3 => "Preparar decision comercial",
        2 => "Ordenar evaluacion",
        1 => "Convertir interes en solicitud",
        _ => CaptacionPendienteRevision ? "Resolver revision de captacion" : "Activar demanda",
    };

    private string ProximoPasoDetalle
    {
        get
        {
            var texto = _current switch
            {
                >= 4 => "El expediente queda como consulta del cierre, la trazabilidad y los documentos de la operacion.",
                3 => "La informacion reunida debe permitir resolver documentos, condiciones y observaciones sin perder trazabilidad.",
                2 => "El siguiente foco es validar documentos y condiciones para que la evaluacion avance con evidencia completa.",
                1 => "Conviene revisar interacciones y visitas para identificar si el cliente puede avanzar a solicitud.",
                _ when CaptacionPendienteRevision => "La aprobacion del broker habilita la propiedad para iniciar oportunidades con clientes interesados.",
                _ => "Estamos a la espera de clientes interesados; usa esta ficha para sostener la promocion y preparar el primer seguimiento.",
            };
            return texto;
        }
