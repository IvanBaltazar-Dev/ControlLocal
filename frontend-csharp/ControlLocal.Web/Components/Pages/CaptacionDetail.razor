    private string? ProximoPasoRuta
    {
        get
        {
            if (_readOnly) return null;
            if (_current >= 2 && _solicitudes.FirstOrDefault() is { } solicitud)
                return $"/solicitud-detail/{solicitud.CodigoSolicitud}";
            if (_ops.FirstOrDefault() is { } oportunidad)
                return $"/oportunidad-detail/{oportunidad.Id}";
            if (_cap.Estado == "Activa" || _cap.Estado == "A")
                return $"/oportunidad-form/{_cap.CodigoCaptacion}";
            return null;
        }
    }

    private readonly string[] _stages = { "Captacion activa", "Clientes interesados", "Con solicitud", "En evaluacion", "Alquilada" };
    private int _current;

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        try
        {
            _cap = !string.IsNullOrEmpty(CodigoParam)
                ? await CaptacionSvc.ObtenerPorCodigoAsync(CodigoParam, DisposedToken) ?? new()
                : (await CaptacionSvc.RefrescarAsync(DisposedToken)).FirstOrDefault() ?? new();
            // El local y las listas dependientes de la captación se piden en paralelo (un solo
            // viaje de ida y vuelta) en vez de esperar el local antes de lanzar el resto.
            var localTask = _cap.LocalId > 0
                ? LocalSvc.ObtenerAsync(_cap.LocalId, DisposedToken)
                : Task.FromResult<LocalComercialDto?>(null);

            var oportunidadesTask = _cap.Id > 0
                ? OportunidadSvc.ListarPorCaptacionAsync(_cap.Id, DisposedToken)
                : Task.FromResult<IReadOnlyList<OportunidadComercialDto>>([]);
            var solicitudesTask = _cap.Id > 0
                ? SolicitudSvc.ListarPorCaptacionAsync(_cap.Id, DisposedToken)
                : Task.FromResult<IReadOnlyList<SolicitudAlquilerDto>>([]);
            var prospeccionTask = _cap.Id > 0
                ? ProspeccionSvc.ListarPaginaAsync(1, 1, ct: DisposedToken, idCaptacion: _cap.Id)
                : Task.FromResult(new PageResult<ProspeccionDto>([], 0, 1, 1));
            var interaccionesTask = _cap.Id > 0
                ? InteraccionSvc.ListarPorCaptacionAsync(_cap.Id, DisposedToken)
                : Task.FromResult<IReadOnlyList<InteraccionComercialDto>>([]);
            var reportesTask = _cap.Id > 0
                ? ReporteSvc.ListarPorCaptacionAsync(_cap.Id, DisposedToken)
                : Task.FromResult<IReadOnlyList<ReportePropietarioDto>>([]);

            _local = await localTask;
            _ops = await oportunidadesTask;
            _solicitudes = await solicitudesTask;
            _interaccionesCaptacion = await interaccionesTask;
            _reportes = await reportesTask;
            _prospeccion = (await prospeccionTask).Items.FirstOrDefault();
            if (_prospeccion is null && _cap.LocalId > 0)
            {
                _prospeccion = (await ProspeccionSvc.ListarPaginaAsync(1, 1, ct: DisposedToken, idLocal: _cap.LocalId))
                    .Items.FirstOrDefault();
            }
            _current = EtapaPropiedad();
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _cargando = false;
        }

        _coincidenciasOpen = false;
        _coincidencias = null;
        _coinPage = 1;
    }

    private async Task AbrirCoincidencias()
    {
        _coincidenciasOpen = true;
        await CargarCoincidencias(1);
    }

    private void CerrarCoincidencias() => _coincidenciasOpen = false;

    private Task CambiarPaginaCoincidencias(int page) => CargarCoincidencias(page);

    private async Task CargarCoincidencias(int page)
    {
        if (_cap.Id <= 0 || !(_cap.Estado is "Activa" or "A"))
        {
            _coincidencias = null;
            return;
        }
        _coinPage = Math.Max(1, page);
        _cargandoCoin = true;
        _errCoin = null;
        try
        {
            _coincidencias = await CoincidenciaSvc.ClientesParaCaptacionAsync(
                _cap.Id.ToString(System.Globalization.CultureInfo.InvariantCulture), _coinPage, _coinPageSize, DisposedToken);
            _coinPage = _coincidencias.Page;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errCoin = ex.Message;
        }
        finally
        {
            _cargandoCoin = false;
        }
    }

    private int EtapaPropiedad()
    {
        var max = 0;
        foreach (var o in _ops)
        {
            max = Math.Max(max, o.Estado switch
            {
                "Abierta" or "En seguimiento" => 1,
                "Solicitud creada" => 2,
                "En evaluacion" or "En revisión" => 3,
                "Alquilada" or "Finalizada exitosa" or "Cerrada exitosa" => 4,
                _ => 0,
            });
        }
        if (_solicitudes.Any(s => s.Estado is "En revision" or "Observada")) max = Math.Max(max, 3);
        if (_solicitudes.Any(s => s.Estado is "Aprobada" or "Cerrada")) max = 4;
        return max;
    }

