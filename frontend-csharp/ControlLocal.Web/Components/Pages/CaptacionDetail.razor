    // Exporta un reporte de avance ya registrado (persistido en el backend) como PDF descargable.
    private async Task DescargarReporte(ReportePropietarioDto r)
    {
        var canal = EnumCatalog.LabelFor(EnumCatalog.CanalesContacto, r.CanalEnvio);
        var pdf = CaptacionDocumentosPdf.FichaAvancePropietario(_cap, _local, r, canal);
        var sufijo = r.FechaReporte?.ToString("yyyyMMdd", System.Globalization.CultureInfo.InvariantCulture)
                     ?? r.Id.ToString(System.Globalization.CultureInfo.InvariantCulture);
        await Exportar.DescargarPdfAsync($"Reporte_propietario_{_cap.CodigoCaptacion}_{sufijo}", pdf);
    }

    private void AbrirInteraccion()
    {
        _errInteraccion = null;
        _interaccionEditorKey++;
        _modalInteraccion = true;
    }

    private void CerrarInteraccion()
    {
        if (_guardandoInteraccion)
            return;
        _errInteraccion = null;
        _interaccionEditor?.Reiniciar();
        _modalInteraccion = false;
    }

    private async Task GuardarInteraccion()
    {
        if (_cap.Id <= 0 || _interaccionEditor is null || _guardandoInteraccion)
            return;
        _guardandoInteraccion = true;
        _errInteraccion = null;
        try
        {
            var ok = await _interaccionEditor.GuardarAsync(DisposedToken);
            if (!ok)
            {
                _errInteraccion = _interaccionEditor.Error ?? "No se pudo registrar la interaccion. Revisa los datos.";
                return;
            }
            _interaccionesCaptacion = await InteraccionSvc.ListarPorCaptacionAsync(_cap.Id, DisposedToken);
            _interaccionEditor.Reiniciar();
            _modalInteraccion = false;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errInteraccion = ex.Message;
        }
        finally
        {
            _guardandoInteraccion = false;
        }
    }

    private async Task AbrirReporte()
    {
        _errReporte = null;
        var hoy = DateTime.Today;
        _rPeriodoInicio = hoy.AddDays(-15);
        _rPeriodoFin = hoy;
        _rConsultas = 0;
        _rVisitas = 0;
        _rObjeciones = "";
        _rAjustes = "";
        _rCanal = "E";
        _modalReporte = true;
        await RecalcularPreview();
    }

    private void CerrarReporte() => _modalReporte = false;

    // Consultas, visitas y objeciones son derivadas: las recalcula el backend para el periodo
    // seleccionado y el formulario solo las muestra (no se editan a mano).
    private async Task RecalcularPreview()
    {
        if (!_modalReporte || _cap.Id <= 0) return;
        _previewCargando = true;
        try
        {
            var preview = await ReporteSvc.PreviewAsync(_cap.Id, _rPeriodoInicio, _rPeriodoFin, DisposedToken);
            _rConsultas = preview.Consultas;
            _rVisitas = preview.Visitas;
            _rObjeciones = preview.Objeciones;
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            // Si el preview falla, dejamos los valores actuales; el usuario puede reintentar al cambiar el periodo.
        }
        finally
        {
            _previewCargando = false;
        }
    }

    private async Task GuardarReporte()
    {
        if (_cap.Id <= 0) return;
        if (_rPeriodoInicio is not null && _rPeriodoFin is not null && _rPeriodoFin < _rPeriodoInicio)
        {
            _errReporte = "El fin del periodo no puede ser anterior al inicio.";
            return;
        }
        _guardandoReporte = true;
        _errReporte = null;
        try
        {
            await ReporteSvc.CrearAsync(_cap.Id, new ReportePropietarioDto
            {
                PeriodoInicio = _rPeriodoInicio,
                PeriodoFin = _rPeriodoFin,
                ConsultasReportadas = _rConsultas,
                VisitasReportadas = _rVisitas,
                ObjecionesFrecuentes = string.IsNullOrWhiteSpace(_rObjeciones) ? null : _rObjeciones,
                AjustesRecomendados = string.IsNullOrWhiteSpace(_rAjustes) ? null : _rAjustes,
                CanalEnvio = _rCanal,
            }, DisposedToken);
            _reportes = await ReporteSvc.ListarPorCaptacionAsync(_cap.Id, DisposedToken);
            _modalReporte = false;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errReporte = ex.Message;
        }
        finally
        {
            _guardandoReporte = false;
        }
    }

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        return partes.Length == 1
            ? partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant()
            : $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
    }

    private static string Texto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "-" : valor;
}
