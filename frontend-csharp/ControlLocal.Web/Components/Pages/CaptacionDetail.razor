@page "/captacion-detail/{CodigoParam?}"
@inherits SafeComponentBase
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject IOportunidadService OportunidadSvc
@inject ISolicitudService SolicitudSvc

<PageTitle>Expediente @_cap.CodigoCaptacion · ControlLocal</PageTitle>

@if (_cargando)
{
    <AppShell Title="Expediente de la propiedad" Crumbs="@(new[] { "ControlLocal", "Captaciones" })">
        <ChildContent>
            <div class="cl-card"><div class="cl-card-body" style="padding:40px;text-align:center;color:#7E8794;">Cargando expediente…</div></div>
        </ChildContent>
    </AppShell>
}
else
{
<AppShell Crumbs="@_crumbs"
          Title="@($"{_cap.CodigoCaptacion} · {_cap.DireccionLocal}")"
          Subtitle="@($"Expediente de la propiedad · {_cap.DistritoLocal}")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate(_readOnly ? "oportunidades" : "captaciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        @if (_readOnly)
        {
            <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
            @if (_cap.Estado == "Activa")
            {
                <button class="cl-btn danger" @onclick="@(() => App.Navigate($"cierre/{_cap.Id}"))"><Icon Name="x" Size="13" /> Cerrar captacion</button>
            }
        }
        else if (_cap.Estado is "Activa" or "A")
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate($"oportunidad-form/{_cap.CodigoCaptacion}"))"><Icon Name="plus" Size="13" /> Nueva oportunidad</button>
        }
    </Actions>
    <ChildContent>
        @* ----- Etapa de la PROPIEDAD (resumen del avance entre sus clientes) ----- *@
        <div class="cl-stage" style="margin-bottom:6px;">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var cls = i < _current ? "done" : (i == _current ? "active" : "");
                <div class="cl-stage-step @cls">
                    <div class="cl-stage-k"><span class="cl-stage-dot"></span> Etapa @(i + 1)</div>
                    <div class="cl-stage-v">@_stages[i]</div>
                </div>
            }
        </div>
        <div class="cl-muted" style="font-size:12px;margin-bottom:14px;">
            @_ops.Count cliente(s) interesado(s) · @_solicitudes.Count con solicitud · etapa más avanzada: <b>@_stages[_current]</b>
        </div>

        <div style="display:grid;grid-template-columns:1fr 320px;gap:14px;">
            <div>
                <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

                @if (_tab == "Resumen")
                {
                    <div class="cl-stack">
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                            <div class="cl-card">
                                <div class="cl-card-head"><div class="cl-card-title">Datos del local</div></div>
                                <div class="cl-card-body">
                                    <dl class="cl-kv">
                                        <dt>Dirección</dt><dd>@_cap.DireccionLocal</dd>
                                        <dt>Distrito</dt><dd>@_cap.DistritoLocal</dd>
                                        <dt>Área</dt><dd>@_cap.AreaM2 m²</dd>
                                        <dt>Propietario</dt><dd>@_cap.PropietarioNombre</dd>
                                    </dl>
                                </div>
                            </div>
                            <div class="cl-card">
                                <div class="cl-card-head"><div class="cl-card-title">Condiciones comerciales</div></div>
                                <div class="cl-card-body">
                                    <dl class="cl-kv">
                                        <dt>Comisión</dt><dd>@_cap.ComisionPactadaTexto%</dd>
                                        <dt>Urgencia</dt><dd>@UrgenciaTexto</dd>
                                        <dt>Exclusividad</dt><dd>@(_cap.Exclusividad == true ? "Encargo exclusivo" : "No exclusivo")</dd>
                                        <dt>Vigencia</dt><dd>@_cap.VigenciaTexto</dd>
                                        <dt>Estado captación</dt><dd>@_cap.Estado</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        @* ----- Clientes interesados → cada uno abre su seguimiento ----- *@
                        <div class="cl-card">
                            <div class="cl-card-head">
                                <div class="cl-card-title">Clientes interesados</div>
                                <span class="cl-badge blue">@_ops.Count</span>
                            </div>
                            <div class="cl-card-body" style="display:flex;flex-direction:column;gap:8px;">
                                @foreach (var o in _ops)
                                {
                                    <button @onclick="@(() => App.Navigate($"oportunidad-detail/{o.Id}"))"
                                            style="text-align:left;display:flex;gap:11px;align-items:center;padding:11px 12px;border:1.5px solid var(--c-border);border-radius:11px;background:#fff;cursor:pointer;">
                                        <span class="cl-avatar" style="width:32px;height:32px;font-size:11px;flex:0 0 32px;background:#005BFF;">@Iniciales(o.ClienteNombre)</span>
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-weight:600;font-size:13px;">@o.ClienteNombre</div>
                                            <div class="cl-muted" style="font-size:11px;">@o.CodigoOportunidad · desde @o.FechaRegistroTexto</div>
                                        </div>
                                        <StatusBadge Label="@o.Estado" />
                                        <span class="cl-flex" style="gap:4px;color:var(--c-primary);font-size:12px;font-weight:600;">Ver seguimiento <Icon Name="arrowRight" Size="13" /></span>
                                    </button>
                                }
                                @if (_ops.Count == 0)
                                {
                                    <div class="cl-muted" style="font-size:12px;">Aún no hay clientes interesados en esta propiedad.</div>
                                }
                                <div class="cl-help">Cada cliente es una oportunidad independiente con su propio seguimiento (interacciones, visitas y solicitud).</div>
                            </div>
                        </div>
                    </div>
                }
                else if (_tab == "Solicitudes")
                {
                    <div class="cl-card">
                        <div class="cl-card-body" style="padding:0;">
                            <table class="cl-table">
                                <thead><tr><th>Solicitud</th><th>Cliente</th><th>Monto/mes</th><th>Docs</th><th>Estado</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var s in _solicitudes)
                                    {
                                        <tr>
                                            <td><span class="mono">@s.CodigoSolicitud</span></td>
                                            <td style="font-weight:600;">@s.ClienteNombre</td>
                                            <td>USD @s.MontoMensualTexto</td>
                                            <td><span class="cl-muted" style="font-size:12px;">@s.DocumentosTexto</span></td>
                                            <td><StatusBadge Label="@s.Estado" /></td>
                                            <td><button class="cl-btn sm" @onclick="@(() => App.Navigate($"solicitud-detail/{s.CodigoSolicitud}"))"><Icon Name="eye" Size="12" /> Ver</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_solicitudes.Count == 0)
                            {
                                <div style="padding:40px 20px;text-align:center;color:#7E8794;">
                                    <div style="margin-bottom:8px;"><Icon Name="fileText" Size="26" /></div>
                                    <div style="font-weight:600;margin-bottom:4px;">Sin solicitudes en esta propiedad</div>
                                    <div class="cl-muted" style="font-size:12.5px;">Cuando un cliente decida alquilar, su solicitud aparecerá aquí.</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="cl-card">
                        <div class="cl-card-body" style="padding:0;">
                            @for (var i = 0; i < _docs.Length; i++)
                            {
                                var top = i == 0 ? "0" : "1px solid #E2E6EC";
                                var doc = _docs[i];
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-top:@top;">
                                    <div class="cl-flex"><Icon Name="fileText" Size="16" /> <span style="font-size:12.5px;">@doc</span></div>
                                    <button class="cl-btn sm" @onclick="@(() => _docVer = doc)"><Icon Name="eye" Size="13" /> Ver</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Estado de la propiedad</div></div>
                    <div class="cl-card-body">
                        <dl class="cl-kv" style="grid-template-columns:1fr auto;">
                            <dt>Captación</dt><dd><StatusBadge Label="@_cap.Estado" /></dd>
                            <dt>Clientes interesados</dt><dd>@_ops.Count</dd>
                            <dt>Con solicitud</dt><dd>@_solicitudes.Count</dd>
                            <dt>Vigencia</dt><dd>@_cap.VigenciaTexto</dd>
                        </dl>
                    </div>
                </div>
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Este expediente es la <b>propiedad</b>. Las interacciones, visitas y solicitudes se gestionan dentro del <b>seguimiento de cada cliente</b>.</span>
                </div>
            </div>
        </div>

        <DocViewerModal Open="@(_docVer is not null)" Nombre="@(_docVer ?? "")"
                        Estado="Registrado" Expediente="@_cap.CodigoCaptacion" Actualizado="@_cap.VigenciaTexto"
                        OnClose="@(() => _docVer = null)" />
    </ChildContent>
</AppShell>
}

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private string? _docVer;
    private bool _cargando = true;
    private CaptacionDto _cap = new();
    private IReadOnlyList<OportunidadComercialDto> _ops = new List<OportunidadComercialDto>();
    private IReadOnlyList<SolicitudAlquilerDto> _solicitudes = new List<SolicitudAlquilerDto>();

    private bool _readOnly => App.Role == Roles.Broker || App.Role == Roles.Admin;
    private string _tab = "Resumen";

    private string UrgenciaTexto => _cap.Urgencia is int nivel ? $"{nivel} / 5" : "—";

    private readonly string[] _stages = { "Captación activa", "Clientes interesados", "Con solicitud", "En evaluación", "Alquilada" };
    private int _current;

    // Refresca primero (evita el crash de .First() con cache fria, p.ej. al abrir
    // desde una notificacion recien logueado) y luego arma el expediente.
    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        try
        {
            var caps = await CaptacionSvc.RefrescarAsync(DisposedToken);
            await OportunidadSvc.RefrescarAsync(DisposedToken);
            await SolicitudSvc.RefrescarAsync(DisposedToken);

            _cap = (string.IsNullOrEmpty(CodigoParam) ? null : CaptacionSvc.ByCodigo(CodigoParam))
                   ?? caps.FirstOrDefault() ?? new();
            _ops = OportunidadSvc.ByCaptacion(_cap.CodigoCaptacion);
            // Solicitudes de los clientes de esta propiedad (match tolerante por nombre).
            _solicitudes = SolicitudSvc.All().Where(s =>
                _ops.Any(o => o.ClienteNombre.Contains(s.ClienteNombre) || s.ClienteNombre.Contains(o.ClienteNombre))).ToList();
            _current = EtapaPropiedad();
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _cargando = false;
        }
    }

    // Etapa de la propiedad = avance del cliente más adelantado (rollup honesto).
    private int EtapaPropiedad()
    {
        var max = 0;
        foreach (var o in _ops)
        {
            max = Math.Max(max, o.Estado switch
            {
                "Abierta" or "En seguimiento" => 1,
                "Solicitud creada" => 2,
                "En evaluación" => 3,
                "Alquilada" or "Finalizada exitosa" or "Cerrada exitosa" => 4,
                _ => 0,
            });
        }
        if (_solicitudes.Any(s => s.Estado is "En revision" or "Observada")) max = Math.Max(max, 3);
        if (_solicitudes.Any(s => s.Estado == "Aprobada")) max = 4;
        return max;
    }

    private Tabs.TabItem[] _tabs => new[]
    {
        new Tabs.TabItem("Resumen"),
        new Tabs.TabItem("Solicitudes", _solicitudes.Count > 0 ? _solicitudes.Count : (int?)null),
        new Tabs.TabItem("Documentos"),
    };

    private string[] _crumbs => _readOnly
        ? new[] { "ControlLocal", "Operaciones del equipo", _cap.CodigoCaptacion }
        : new[] { "ControlLocal", "Mis captaciones", _cap.CodigoCaptacion };

    private readonly string[] _docs =
    {
        "Ficha_de_captacion.pdf",
        "Contrato_de_exclusividad.pdf",
        "Fotos_del_local.zip",
    };

    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "?";
        return partes.Length == 1
            ? partes[0][..Math.Min(2, partes[0].Length)].ToUpper()
            : $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }
}
