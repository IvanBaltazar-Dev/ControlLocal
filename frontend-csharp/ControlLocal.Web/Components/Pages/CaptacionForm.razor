@page "/captacion-form"
@page "/captacion-form/{CodigoParam}"
@page "/captacion-form/local/{LocalId:long}"
@page "/captacion-form/captar/{ProspeccionId:long}"
@inherits SafeComponentBase
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject IProspeccionService ProspeccionSvc
@inject ILocalService LocalSvc

<PageTitle>@_tituloPagina · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mis captaciones", _crumbFinal })"
          Title="@_titulo"
          Subtitle="@_subtitulo">
    <Actions>
        <button class="cl-btn ghost" @onclick="OnCancelar">Cancelar</button>
        <button class="cl-btn primary" @onclick="Guardar">
            <Icon Name="arrowRight" Size="13" />
            @(_esEdicion ? "Guardar y reenviar a revisión" : "Crear y enviar a revisión")
        </button>
    </Actions>
    <ChildContent>
        @if (_err is not null)
        {
            <div class="cl-alert red" style="margin-bottom:14px;">
                <Icon Name="alert" Size="15" /><span>@_err</span>
            </div>
        }

        <div style="display:grid;grid-template-columns:1fr 280px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Local comercial" Sub="Inmueble asociado a la captación">
                    <div class="cl-grid c2">
                        <Field Label="Local" Required="true">
                            @if (_esNuevoLibre)
                            {
                                <select @bind="_localId" @bind:after="CargarLocalSeleccionado">
                                    <option value="0">— Seleccionar local —</option>
                                    @foreach (var local in LocalSvc.All().Where(item => item.Estado == "Disponible"))
                                    {
                                        <option value="@local.Id">@local.CodigoLocal · @local.Direccion (@local.Distrito)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input value="@DescripcionLocal" disabled />
                            }
                        </Field>
                        <Field Label="Código del local"><input value="@(_local?.CodigoLocal ?? "")" disabled /></Field>
                        <Field Label="Propietario"><input value="@(_local?.PropietarioNombre ?? "")" disabled /></Field>
                        <Field Label="Área registrada"><input value="@AreaLocal" disabled /></Field>
                        <Field Label="Precio referencial"><input value="@PrecioLocal" disabled /></Field>
                        <Field Label="Rubro permitido"><input value="@(_local?.Rubro ?? "")" disabled /></Field>
                    </div>
                </FormSection>

                <FormSection Num="2" Title="Condiciones del encargo" Sub="Datos persistidos en la captación">
                    <div class="cl-grid c3">
                        <Field Label="Operación" Required="true">
                            <select @bind="_motivoOperacion">
                                @foreach (var opcion in EnumCatalog.OperacionesRequerimiento)
                                {
                                    <option value="@opcion.Code">@opcion.Label</option>
                                }
                            </select>
                        </Field>
                        <Field Label="Urgencia" Hint="Escala de 1 a 5">
                            <select @bind="_urgencia">
                                @for (var nivel = 1; nivel <= 5; nivel++)
                                {
                                    <option value="@nivel">@nivel</option>
                                }
                            </select>
                        </Field>
                        <Field Label="Exclusividad">
                            <label style="display:flex;align-items:center;gap:8px;min-height:38px;">
                                <input type="checkbox" @bind="_exclusividad" style="width:auto;" />
                                Encargo exclusivo
                            </label>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Vigencia y comisión" Sub="Periodo y comisión pactada con el propietario">
                    <div class="cl-grid c2">
                        <Field Label="Fecha de captación" Required="true"><input type="date" @bind="_fechaCaptacion" /></Field>
                        <Field Label="Comisión (%)" Required="true"><input type="number" min="0" step="0.1" @bind="_comision" /></Field>
                        <Field Label="Inicio de vigencia" Required="true"><input type="date" @bind="_inicioVigencia" /></Field>
                        <Field Label="Fin de vigencia" Required="true"><input type="date" @bind="_finVigencia" /></Field>
                    </div>
                </FormSection>

                <FormSection Num="4" Title="Observaciones" Sub="Notas que revisará el broker">
                    <Field Label="Observaciones">
                        <textarea rows="4" @bind="_observaciones" @bind:event="oninput"></textarea>
                    </Field>
                </FormSection>
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>La captación se registra en estado <b>Pendiente de revisión</b>. El broker podrá aprobarla, observarla o rechazarla.</span>
                </div>
            </div>
        </div>

        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CodigoParam { get; set; }
    [Parameter] public long ProspeccionId { get; set; }
    [Parameter] public long LocalId { get; set; }

    private CaptacionDto _captacion = new();
    private LocalComercialDto? _local;
    private long _localId;
    private DateOnly? _fechaCaptacion = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _inicioVigencia = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _finVigencia = DateOnly.FromDateTime(DateTime.Today.AddMonths(6));
    private decimal? _comision;
    private string _motivoOperacion = "A";
    private int _urgencia = 3;
    private bool _exclusividad;
    private string _observaciones = "";
    private bool _toast;
    private string _toastMsg = "";
    private string? _err;
    private string? _claveCargada;

    private bool _esCaptar => ProspeccionId > 0;
    private bool _esEdicion => !_esCaptar && !string.IsNullOrWhiteSpace(CodigoParam);
    private bool _esNuevoLibre => !_esCaptar && !_esEdicion && LocalId <= 0;

    private string DescripcionLocal => _local is null
        ? ""
        : $"{_local.CodigoLocal} · {_local.Direccion} ({_local.Distrito})";
    private string AreaLocal => _local is { AreaM2: > 0 } ? $"{_local.AreaM2} m²" : "";
    private string PrecioLocal => _local is null ? "" : $"USD {_local.PrecioReferencial:N0} / mes";

    private string _tituloPagina => _esCaptar ? "Captar local" : _esEdicion ? "Editar captación" : "Nueva captación";
    private string _titulo => _esCaptar ? $"Captar local · {_local?.CodigoLocal}"
                            : _esEdicion ? $"Editar captación · {_captacion.CodigoCaptacion}"
                            : "Nueva captación";
    private string _crumbFinal => _esCaptar ? $"Captar {_local?.CodigoLocal}"
                                : _esEdicion ? $"{_captacion.CodigoCaptacion} · Editar"
                                : "Nueva captación";
    private string _subtitulo => _esEdicion
        ? "Actualiza las condiciones observadas y reenvía el expediente al broker"
        : "Registra las condiciones del encargo para enviarlas a revisión";

    private bool IsStep1Complete => _localId > 0;
    private bool IsStep2Complete => !string.IsNullOrWhiteSpace(_motivoOperacion) && _urgencia is >= 1 and <= 5;
    private bool IsStep3Complete => _fechaCaptacion is not null && _inicioVigencia is not null
        && _finVigencia is not null && _comision is >= 0;
    private bool IsStep4Complete => true;

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Local", "Inmueble asociado", IsStep1Complete),
        new FormStepsSidebar.Step("Condiciones", "Operación y urgencia", IsStep2Complete),
        new FormStepsSidebar.Step("Vigencia y comisión", "Periodo del encargo", IsStep3Complete),
        new FormStepsSidebar.Step("Observaciones", "Notas para revisión", IsStep4Complete),
    };

    protected override void OnParametersSet()
    {
        var clave = $"{CodigoParam}|{ProspeccionId}|{LocalId}";
        if (_claveCargada == clave) return;
        _claveCargada = clave;

        if (_esCaptar)
        {
            var prospeccion = ProspeccionSvc.ById(ProspeccionId);
            if (prospeccion is null)
            {
                _err = "No se encontró la prospección seleccionada.";
                return;
            }
            if (prospeccion.Estado is not ("E" or "S"))
                _err = "La prospección debe tener propuesta entregada o estar en seguimiento.";
            _localId = prospeccion.LocalId;
            _local = LocalSvc.ById(_localId) ?? new LocalComercialDto
            {
                Id = prospeccion.LocalId,
                CodigoLocal = prospeccion.LocalCodigo,
                Direccion = prospeccion.Direccion,
                Distrito = prospeccion.Distrito,
                AreaM2 = prospeccion.AreaM2,
                Rubro = prospeccion.Rubro,
                PropietarioNombre = prospeccion.PropietarioNombre,
            };
            return;
        }

        if (_esEdicion)
        {
            _captacion = CaptacionSvc.ByCodigo(CodigoParam!) ?? new CaptacionDto();
            if (_captacion.Id <= 0)
            {
                _err = "No se encontró la captación seleccionada.";
                return;
            }
            _localId = _captacion.LocalId;
            _local = LocalSvc.ById(_localId) ?? new LocalComercialDto
            {
                Id = _localId,
                Direccion = _captacion.DireccionLocal,
                Distrito = _captacion.DistritoLocal,
                AreaM2 = _captacion.AreaM2,
                Rubro = _captacion.Rubro,
                PropietarioNombre = _captacion.PropietarioNombre,
            };
            _fechaCaptacion = _captacion.FechaCaptacion;
            _inicioVigencia = _captacion.FechaInicioVigencia;
            _finVigencia = _captacion.FechaFinVigencia;
            _comision = _captacion.ComisionPactada;
            _motivoOperacion = string.IsNullOrWhiteSpace(_captacion.MotivoOperacion) ? "A" : _captacion.MotivoOperacion;
            _urgencia = _captacion.Urgencia ?? 3;
            _exclusividad = _captacion.Exclusividad ?? false;
            _observaciones = _captacion.Observaciones;
            return;
        }

        if (LocalId > 0)
        {
            _localId = LocalId;
            CargarLocalSeleccionado();
        }
    }

    private void CargarLocalSeleccionado()
    {
        _local = _localId > 0 ? LocalSvc.ById(_localId) : null;
        _err = _localId > 0 && _local is null ? "No se encontró el local seleccionado." : null;
    }

    private void OnCancelar() => App.Navigate(_esCaptar ? "locales" : "captaciones");

    private async Task Guardar()
    {
        if (_localId <= 0 || _local is null) { _err = "Selecciona un local comercial."; return; }
        if (_fechaCaptacion is null) { _err = "La fecha de captación es obligatoria."; return; }
        if (_inicioVigencia is null || _finVigencia is null) { _err = "La vigencia es obligatoria."; return; }
        if (_finVigencia < _inicioVigencia) { _err = "El fin de vigencia no puede ser anterior al inicio."; return; }
        if (_comision is null || _comision < 0) { _err = "La comisión debe ser un número no negativo."; return; }
        if (!EnumCatalog.OperacionesRequerimiento.Any(item => item.Code == _motivoOperacion))
        {
            _err = "Selecciona una operación válida.";
            return;
        }

        try
        {
            var dto = new CaptacionDto
            {
                Id = _captacion.Id,
                CodigoCaptacion = _esEdicion
                    ? _captacion.CodigoCaptacion
                    : $"CAP-{DateTime.UtcNow:yyMMddHHmmss}",
                LocalId = _localId,
                DireccionLocal = _local.Direccion,
                DistritoLocal = _local.Distrito,
                AreaM2 = _local.AreaM2,
                Rubro = _local.Rubro,
                PropietarioNombre = _local.PropietarioNombre,
                NombreAgenteResponsable = App.CurrentUser?.Nombre ?? "Agente en sesion",
                FechaCaptacion = _fechaCaptacion,
                FechaInicioVigencia = _inicioVigencia,
                FechaFinVigencia = _finVigencia,
                ComisionPactada = _comision.Value,
                Estado = "Pendiente de revision",
                MotivoOperacion = _motivoOperacion,
                Urgencia = _urgencia,
                Exclusividad = _exclusividad,
                Observaciones = _observaciones.Trim(),
            };
            var guardada = _esEdicion ? CaptacionSvc.Actualizar(dto) : CaptacionSvc.Agregar(dto);
            if (_esCaptar)
                ProspeccionSvc.MarcarCaptado(ProspeccionId, guardada.CodigoCaptacion);

            _err = null;
            _toastMsg = _esEdicion ? "Captación actualizada y reenviada a revisión." : "Captación creada y enviada a revisión.";
            _toast = true;
            await RenderIfAliveAsync();
            await Task.Delay(900, DisposedToken);
            App.Navigate("captaciones");
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception error)
        {
            _err = error.Message;
        }
    }
}
