@page "/captacion-form"
@page "/captacion-form/{CodigoParam}"
@page "/captacion-form/captar/{ProspeccionId:long}"
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject IProspeccionService ProspeccionSvc

<PageTitle>@_tituloPagina · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mis captaciones", _crumbFinal })"
          Title="@_titulo"
          Subtitle="@_subtitulo">
    <Actions>
        <button class="cl-btn ghost" @onclick="OnCancelar">Cancelar</button>
        @if (!_esCaptar)
        {
            <button class="cl-btn" @onclick="@(() => App.Navigate("captaciones"))"><Icon Name="save" Size="13" /> Guardar borrador</button>
        }
        <button class="cl-btn primary" @onclick="OnPrimary"><Icon Name="arrowRight" Size="13" /> @(_esCaptar ? "Captar y enviar a revisión" : "Enviar a revisión")</button>
    </Actions>
    <ChildContent>
        @if (_err is not null)
        {
            <div class="cl-alert red" style="margin-bottom:14px;">
                <Icon Name="alert" Size="15" /><span>@_err</span>
            </div>
        }
        <div style="display:grid;grid-template-columns:1fr 280px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Datos del local" Sub="@(_esNuevo ? "Local comercial sobre el que se crea la captación" : "Datos del inmueble ya registrados · no editables")">
                    <div class="cl-grid c2">
                        <Field Label="Local" Required="true">
                            <div style="position:relative;">
                                <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#7E8794;"><Icon Name="search" Size="14" /></span>
                                <input @bind="_local" @bind:event="oninput" disabled="@(!_esNuevo)" placeholder="Busca el local por dirección o código" style="padding-left:30px;" />
                            </div>
                        </Field>
                        <Field Label="Código del local"><input value="@_codigoLocal" placeholder="—" disabled /></Field>
                        <Field Label="Propietario"><input value="@_propietario" placeholder="—" disabled /></Field>
                        <Field Label="Área registrada"><input value="@_area" placeholder="—" disabled /></Field>
                    </div>
                </FormSection>

                <FormSection Num="2" Title="Condiciones comerciales" Sub="Precio y términos que se ofrecerán a los clientes">
                    <div class="cl-grid c3">
                        <Field Label="Precio de alquiler (USD/mes)" Required="true"><input placeholder="1 800" @bind="_precioAlquiler" @bind:event="oninput" /></Field>
                        <Field Label="Garantía (meses)"><input placeholder="2" @bind="_garantia" /></Field>
                        <Field Label="Adelanto (meses)"><input placeholder="1" @bind="_adelanto" /></Field>
                        <Field Label="Rubro objetivo"><select @bind="_rubro"><option>Restaurante / Café</option><option>Moda / Boutique</option><option>Servicios</option><option>Retail</option></select></Field>
                        <Field Label="Plazo de contrato"><select @bind="_plazo"><option>12 meses</option><option>24 meses</option><option>36 meses</option></select></Field>
                        <Field Label="Disponibilidad"><input placeholder="Inmediata" @bind="_disponibilidad" /></Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Vigencia y comisión" Sub="Periodo de la captación y comisión acordada con el propietario">
                    <div class="cl-grid c3">
                        <Field Label="Inicio de vigencia" Required="true"><input placeholder="dd/mm/aaaa" @bind="_inicioVigencia" @bind:event="oninput" /></Field>
                        <Field Label="Fin de vigencia" Required="true"><input placeholder="dd/mm/aaaa" @bind="_finVigencia" @bind:event="oninput" /></Field>
                        <Field Label="Comisión (%)" Required="true"><input placeholder="5" @bind="_comision" @bind:event="oninput" /></Field>
                    </div>
                </FormSection>

                <FormSection Num="4" Title="Observaciones y documentos" Sub="Notas para el broker y respaldo documental de la captación">
                    <Field Label="Observaciones" Hint="Contexto, condiciones especiales, acuerdos con el propietario">
                        <textarea rows="3" placeholder="Notas para el broker que revisará la captación…" @bind="_observaciones" @bind:event="oninput"></textarea>
                    </Field>
                    <div style="margin-top:14px;">
                        <Field Label="Documentos de respaldo">
                            <div class="cl-ph" style="height:90px;">
                                <Icon Name="upload" Size="18" /> <span style="margin-left:8px;">Arrastra archivos aquí o haz clic para seleccionar</span>
                            </div>
                        </Field>
                    </div>
                </FormSection>
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Al enviar a revisión, la captación pasa a la <b>bandeja del broker</b>. Podrá aprobarla, observarla o rechazarla.</span>
                </div>
            </div>
        </div>

        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    // Sin parámetro          = captación nueva (formulario en blanco).
    // {CodigoParam}           = edición de una captación existente (precarga su expediente).
    // captar/{ProspeccionId}  = captar un local prospectado: datos del local bloqueados,
    //                           solo se completan las condiciones comerciales faltantes.
    [Parameter] public string? CodigoParam { get; set; }
    [Parameter] public long ProspeccionId { get; set; }

    private bool _esCaptar => ProspeccionId > 0;
    private bool _esEdicion => !_esCaptar && !string.IsNullOrWhiteSpace(CodigoParam);
    private bool _esNuevo => !_esCaptar && !_esEdicion;

    // Datos del local (solo lectura: provienen del local captado).
    private string _codigo = "";
    private string _local = "";
    private string _codigoLocal = "";
    private string _propietario = "";
    private string _area = "";

    // Condiciones comerciales.
    private string _precioAlquiler = "";
    private string _garantia = "";
    private string _adelanto = "";
    private string _rubro = "Restaurante / Café";
    private string _plazo = "12 meses";
    private string _disponibilidad = "";

    // Vigencia, comisión y notas.
    private string _inicioVigencia = "";
    private string _finVigencia = "";
    private string _comision = "";
    private string _observaciones = "";

    private bool _toast;
    private string _toastMsg = "";
    private string? _err;

    protected override void OnParametersSet()
    {
        if (_esCaptar)
        {
            var pros = ProspeccionSvc.ById(ProspeccionId);
            if (pros is null) { _err = "No se encontró el local en prospección."; return; }
            if (pros.Estado is not ("E" or "S"))
                _err = "Este local no está en una etapa donde se pueda captar.";

            _codigoLocal = pros.LocalCodigo;
            _local = string.IsNullOrWhiteSpace(pros.Distrito) ? pros.Direccion : $"{pros.Direccion}, {pros.Distrito}";
            _propietario = pros.PropietarioNombre;
            _area = pros.AreaM2 > 0 ? $"{pros.AreaM2} m²" : "";
            return;
        }

        if (_esEdicion)
        {
            var cap = CaptacionSvc.ByCodigo(CodigoParam!);
            if (cap is null) return;

            _codigo = cap.CodigoCaptacion;
            _local = string.IsNullOrWhiteSpace(cap.DistritoLocal) ? cap.DireccionLocal : $"{cap.DireccionLocal}, {cap.DistritoLocal}";
            _propietario = cap.PropietarioNombre;
            _area = cap.AreaM2 > 0 ? $"{cap.AreaM2} m²" : "";
            _comision = cap.ComisionPactadaTexto is { Length: > 0 } t && t != "—" ? t : "";
            _inicioVigencia = cap.FechaInicioVigencia?.ToString("dd/MM/yyyy") ?? "";
            _finVigencia = cap.FechaFinVigencia?.ToString("dd/MM/yyyy") ?? "";
            _observaciones = cap.Observaciones ?? "";
        }
        // _esNuevo: el formulario permanece en blanco.
    }

    // ---- Encabezado dependiente del modo ----
    private string _tituloPagina => _esCaptar ? "Captar local" : _esEdicion ? "Editar captación" : "Nueva captación";
    private string _titulo => _esCaptar ? $"Captar local · {_codigoLocal}"
                            : _esEdicion ? $"Editar captación · {_codigo}"
                            : "Nueva captación";
    private string _crumbFinal => _esCaptar ? $"Captar {_codigoLocal}"
                                : _esEdicion ? $"{_codigo} · Editar"
                                : "Nueva captación";
    private string _subtitulo => _esCaptar
        ? "Completa las condiciones comerciales para captar el local · los datos del inmueble ya están registrados"
        : _esEdicion
            ? "Actualiza las condiciones comerciales de la captación · al enviarla, el broker la revisará"
            : "Condiciones comerciales del local · al enviarla, el broker la revisará para activarla";

    // ---- Acciones del encabezado ----
    private void OnCancelar() => App.Navigate(_esCaptar ? "locales" : "captaciones");

    private async Task OnPrimary()
    {
        if (_esCaptar)
        {
            await CaptarLocal();
            return;
        }
        App.Navigate("captaciones");
    }

    // Captar = crear la captación a partir de la prospección. Espeja la regla de
    // negocio: la captación nace en estado Pendiente de revisión del broker.
    private async Task CaptarLocal()
    {
        var comision = ParseComision(_comision);
        if (comision is null) { _err = "Indica una comisión válida (porcentaje)."; return; }

        try
        {
            var p = ProspeccionSvc.Captar(ProspeccionId, comision.Value);
            _err = null;
            _toastMsg = $"¡Local captado! Se creó la captación {p.CaptacionCodigo} (pendiente de revisión).";
            _toast = true;
            StateHasChanged();
            await Task.Delay(1100);
            App.Navigate("captaciones");
        }
        catch (InvalidOperationException ex)
        {
            _err = ex.Message;
        }
    }

    private static decimal? ParseComision(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var limpio = raw.Replace("%", "").Trim();
        return decimal.TryParse(limpio, System.Globalization.NumberStyles.Any,
                   System.Globalization.CultureInfo.InvariantCulture, out var v) && v >= 0
            ? v : null;
    }

    // ---- Progreso interactivo de las secciones del formulario ----
    private bool IsStep1Complete => !string.IsNullOrWhiteSpace(_local);
    private bool IsStep2Complete => !string.IsNullOrWhiteSpace(_precioAlquiler);
    private bool IsStep3Complete => !string.IsNullOrWhiteSpace(_inicioVigencia)
                                    && !string.IsNullOrWhiteSpace(_finVigencia)
                                    && !string.IsNullOrWhiteSpace(_comision);
    private bool IsStep4Complete => !string.IsNullOrWhiteSpace(_observaciones);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Datos del local", "Local de la captación", IsStep1Complete),
        new FormStepsSidebar.Step("Condiciones", "Precio y términos", IsStep2Complete),
        new FormStepsSidebar.Step("Vigencia y comisión", "Periodo y comisión", IsStep3Complete),
        new FormStepsSidebar.Step("Observaciones", "Notas y documentos", IsStep4Complete),
    };
}
