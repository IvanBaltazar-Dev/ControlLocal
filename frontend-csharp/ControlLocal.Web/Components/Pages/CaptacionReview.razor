@page "/captacion-review/{CodigoParam?}"
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject ILocalService LocalSvc
@inject IProspeccionService ProspeccionSvc
@inject IInteraccionService InteraccionSvc
@inject ControlLocal.Web.Services.Api.HttpAgenteService AgenteSvc
@inject INotificacionService Notificaciones

<PageTitle>Revisar captacion - ControlLocal</PageTitle>

@if (_cargando)
{
    <div class="cl-card"><div class="cl-card-body" style="display:flex;align-items:center;gap:12px;padding:22px;">
        <Icon Name="refresh" Size="20" />
        <div>
            <div style="font-weight:600;font-size:13px;">Cargando expediente@(string.IsNullOrWhiteSpace(CodigoParam) ? "" : $" {CodigoParam}")…</div>
            <div style="font-size:12px;color:var(--c-text-2);">Recuperando la captación, su prospección de origen y el seguimiento del propietario.</div>
        </div>
    </div></div>
}
else if (_captacion is null)
{
    <div class="cl-card">
        <div class="cl-card-body">
            <div class="cl-alert red"><Icon Name="alert" Size="15" /><span>@(_error ?? "Captacion no encontrada.")</span></div>
            <button class="cl-btn" style="margin-top:12px;" @onclick="@(() => App.Navigate("bandeja-captaciones"))">Volver a la bandeja</button>
        </div>
    </div>
}
else
{
    <AppShell Crumbs="@(new[] { "ControlLocal", "Captaciones por revisar", $"{_captacion.CodigoCaptacion} - Revision" })"
              Title="@($"{_captacion.CodigoCaptacion} - {_captacion.DireccionLocal}")"
              Subtitle="@($"Captacion enviada por {_captacion.NombreAgenteResponsable} - estado actual: {_captacion.Estado}")">
        <Actions>
            <button class="cl-btn ghost" @onclick="@(() => App.Navigate("bandeja-captaciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
            @if (EstadoPermiteRevision)
            {
                <button class="cl-btn" disabled="@_procesando" @onclick="@(() => AbrirModal("reasignar"))"><Icon Name="swap" Size="13" /> Reasignar</button>
                <button class="cl-btn danger" disabled="@_procesando" @onclick="@(() => AbrirModal("rechazar"))"><Icon Name="x" Size="13" /> Rechazar</button>
                <button class="cl-btn amber" disabled="@_procesando" @onclick="@(() => AbrirModal("observar"))"><Icon Name="alert" Size="13" /> Observar</button>
                <button class="cl-btn success" disabled="@_procesando" @onclick="@(() => AbrirModal("aprobar"))"><Icon Name="check" Size="13" /> Aprobar</button>
            }
        </Actions>
        <ChildContent>
            @if (_mensajeRevision is not null)
            {
                <div class="cl-alert @_mensajeRevision.Tone" style="margin-bottom:14px;">
                    <Icon Name="@_mensajeRevision.Icon" Size="15" />
                    <span>@_mensajeRevision.Text</span>
                </div>
            }
            @if (_error is not null)
            {
                <div class="cl-alert red" style="margin-bottom:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
            }

            <div style="display:grid;grid-template-columns:1fr 320px;gap:14px;">
                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div class="cl-card-title">Resumen de la captacion</div>
                            <FichaLink Kind="owner" Id="@_local?.PropietarioId" Text="Ver propietario" Variant="button" />
                        </div>
                        <div class="cl-card-body">
                            <div class="cl-specs">
                                <Spec Icon="folder" K="Codigo" V="@_captacion.CodigoCaptacion" />
                                <Spec Icon="mapPin" K="Direccion" V="@($"{_captacion.DireccionLocal}, {_captacion.DistritoLocal}")" />
                                <Spec Icon="user" K="Propietario" V="@Texto(_captacion.PropietarioNombre)" />
                                <Spec Icon="layers" K="Area" V="@($"{_captacion.AreaM2} m2")" />
                                <Spec Icon="store" K="Rubro" V="@Texto(_captacion.Rubro)" />
                                <Spec Icon="calendar" K="Vigencia" V="@Vigencia" />
                                <Spec Icon="activity" K="Comision" V="@($"{_captacion.ComisionPactadaTexto}%")" />
                                <Spec Icon="briefcase" K="Agente" V="@Texto(_captacion.NombreAgenteResponsable)" />
                            </div>
                            <div style="margin-top:12px;">
                                <StatusBadge Label="@_captacion.Estado" />
                            </div>
                        </div>
                    </div>

                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Condiciones comerciales</div></div>
                        <div class="cl-card-body">
                            <dl class="cl-kv">
                                <dt>Operacion</dt><dd>@OperacionTexto</dd>
                                <dt>Exclusividad</dt><dd>@(_captacion.Exclusividad is null ? "No registrada" : _captacion.Exclusividad.Value ? "Si" : "No")</dd>
                                <dt>Urgencia</dt><dd>@UrgenciaTexto</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Observaciones del agente</div></div>
                        <div class="cl-card-body">
                            <p style="font-size:12.5px;color:var(--c-text-2);margin:0;">@Texto(_captacion.Observaciones)</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_captacion.ObservacionRevision))
                    {
                        <div class="cl-card">
                            <div class="cl-card-head"><div class="cl-card-title">Ultima observacion del broker</div></div>
                            <div class="cl-card-body">@_captacion.ObservacionRevision</div>
                        </div>
                    }

                    @* Etapa 7: seguimiento del propietario via la prospeccion que origino la captacion. *@
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div class="cl-card-title">Seguimiento del propietario</div>
                            @if (_prospeccion is not null)
                            {
                                <span class="cl-badge gray">@_prospeccion.CodigoProspeccion</span>
                            }
                        </div>
                        <div class="cl-card-body">
                            @if (_prospeccion is null)
                            {
                                <p style="font-size:12.5px;color:var(--c-text-2);margin:0;">Esta captación no tiene una prospección de origen registrada; no hay historial de seguimiento del propietario.</p>
                            }
                            else
                            {
                                <div class="cl-specs">
                                    <Spec Icon="activity" K="Contactos" V="@_interacciones.Count.ToString()" />
                                    <Spec Icon="users" K="Reuniones" V="@_nReuniones.ToString()" />
                                    <Spec Icon="fileText" K="Propuestas" V="@_nPropuestas.ToString()" />
                                    <Spec Icon="clock" K="Última acción" V="@Texto(_prospeccion.FechaRecontactoTexto)" />
                                    <Spec Icon="calendar" K="Días sin contacto" V="@DiasSinContactoTexto" />
                                    <Spec Icon="alert" K="Recontacto" V="@EstadoRecontactoTexto" />
                                </div>
                                <div style="margin-top:14px;">
                                    <div style="font-size:12px;font-weight:600;color:var(--c-text-2);margin-bottom:8px;">Línea de tiempo</div>
                                    @if (_interacciones.Count == 0)
                                    {
                                        <p style="font-size:12px;color:var(--c-text-2);margin:0;">Sin interacciones registradas en la prospección.</p>
                                    }
                                    else
                                    {
                                        @foreach (var it in _interacciones)
                                        {
                                            <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--c-border);">
                                                <Icon Name="activity" Size="14" />
                                                <div style="min-width:0;">
                                                    <div style="font-size:12px;font-weight:600;">@it.FechaHoraTexto</div>
                                                    <div style="display:flex;gap:6px;align-items:center;margin-top:2px;"><CanalBadge Canal="@it.CanalContacto" /><ResultadoBadge Resultado="@it.Resultado" Contexto="@it.Contexto" /></div>
                                                    @if (!string.IsNullOrWhiteSpace(it.Observaciones))
                                                    {
                                                        <div style="font-size:11.5px;color:var(--c-text-2);margin-top:3px;">@it.Observaciones</div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="cl-stack">
                    <div class="cl-alert blue">
                        <Icon Name="info" Size="15" />
                        <span>Revisa el expediente y registra una decision. La captacion solo cambiara de estado cuando confirmes la accion.</span>
                    </div>
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Datos de trazabilidad</div></div>
                        <div class="cl-card-body">
                            <dl class="cl-kv">
                                <dt>Registrada</dt><dd>@(_captacion.FechaCaptacion?.ToString("dd/MM/yyyy") ?? "Sin fecha")</dd>
                                <dt>Revisada</dt><dd>@(_captacion.FechaRevision?.ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")</dd>
                                <dt>ID interno</dt><dd><span class="mono">@_captacion.Id</span></dd>
                            </dl>
                        </div>
                    </div>
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Estado de revision</div></div>
                        <div class="cl-card-body">
                            @if (EstadoPermiteRevision)
                            {
                                <div style="display:flex;flex-direction:column;gap:8px;">
                                    <button class="cl-btn success" disabled="@_procesando" @onclick="@(() => AbrirModal("aprobar"))"><Icon Name="check" Size="13" /> Aprobar captacion</button>
                                    <button class="cl-btn amber" disabled="@_procesando" @onclick="@(() => AbrirModal("observar"))"><Icon Name="alert" Size="13" /> Observar y devolver</button>
                                    <button class="cl-btn danger" disabled="@_procesando" @onclick="@(() => AbrirModal("rechazar"))"><Icon Name="x" Size="13" /> Rechazar</button>
                                    <button class="cl-btn" disabled="@_procesando" @onclick="@(() => AbrirModal("reasignar"))"><Icon Name="swap" Size="13" /> Reasignar agente</button>
                                </div>
                            }
                            else
                            {
                                <div class="cl-alert @PanelRevision.Tone">
                                    <Icon Name="@PanelRevision.Icon" Size="15" />
                                    <span>@PanelRevision.Text</span>
                                </div>
                                <button class="cl-btn ghost" style="width:100%;margin-top:10px;justify-content:center;color:var(--c-text-2);" @onclick="@(() => App.Navigate("bandeja-captaciones"))">Volver a la bandeja</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <ConfirmDialog Open="@(_modal == "aprobar")" Tone="green" Icon="check"
                           Title="Aprobar esta captacion"
                           Desc="La captacion quedara activa y disponible para el proceso comercial."
                           ConfirmLabel="Aprobar captacion" CancelLabel="Cancelar"
                           Busy="@_procesando"
                           OnClose="@CerrarModal"
                           OnConfirm="@(() => ResolverAsync("APROBAR", "Captacion aprobada"))">
                <Field Label="Nota opcional">
                    <textarea rows="3" @bind="_motivo"></textarea>
                </Field>
            </ConfirmDialog>

            <ConfirmDialog Open="@(_modal == "observar")" Tone="amber" Icon="alert"
                           Title="Observar y devolver al agente"
                           Desc="Indica que debe corregir el agente antes de reenviar."
                           ConfirmLabel="Enviar observaciones" CancelLabel="Cancelar"
                           Busy="@_procesando"
                           OnClose="@CerrarModal"
                           OnConfirm="@(() => ResolverAsync("OBSERVAR", "Captacion observada"))">
                <Field Label="Motivo de la observacion" Required="true">
                    <textarea rows="3" @bind="_motivo"></textarea>
                </Field>
            </ConfirmDialog>

            <ConfirmDialog Open="@(_modal == "rechazar")" Tone="red" Icon="x"
                           Title="Rechazar esta captacion"
                           Desc="El expediente quedara rechazado y la causa se registrara en la trazabilidad."
                           ConfirmLabel="Rechazar captacion" CancelLabel="Cancelar"
                           Busy="@_procesando"
                           OnClose="@CerrarModal"
                           OnConfirm="@(() => ResolverAsync("RECHAZAR", "Captacion rechazada"))">
                <Field Label="Motivo del rechazo" Required="true">
                    <textarea rows="3" @bind="_motivo"></textarea>
                </Field>
            </ConfirmDialog>

            <ConfirmDialog Open="@(_modal == "reasignar")" Tone="blue" Icon="users"
                           Title="Reasignar captacion"
                           Desc="Selecciona al agente que continuara el expediente e indica el motivo."
                           ConfirmLabel="Reasignar" CancelLabel="Cancelar"
                           Busy="@_procesando"
                           OnClose="@CerrarModal"
                           OnConfirm="@ReasignarAsync">
                <Field Label="Nuevo agente" Required="true">
                    <select @bind="_nuevoAgenteId">
                        <option value="0">Selecciona un agente</option>
                        @foreach (var agente in _agentes.Where(a => a.Id != _captacion.AgenteResponsableId))
                        {
                            <option value="@agente.Id">@agente.Nombre</option>
                        }
                    </select>
                </Field>
                <Field Label="Motivo" Required="true">
                    <textarea rows="3" @bind="_motivo"></textarea>
                </Field>
            </ConfirmDialog>

            <Toast Show="@(_toast is not null)">@_toast</Toast>
        </ChildContent>
    </AppShell>
}

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private CaptacionDto? _captacion;
    private LocalComercialDto? _local;
    private bool _cargando;
    private string? _modal;
    private string? _toast;
    private string? _error;
    private string _motivo = "";
    private long _nuevoAgenteId;
    private bool _procesando;
    private IReadOnlyList<AgenteDto> _agentes = [];
    private RevisionMessage? _mensajeRevision;

    // Etapa 7: seguimiento del propietario (prospeccion de origen + sus interacciones).
    private ProspeccionDto? _prospeccion;
    private IReadOnlyList<InteraccionComercialDto> _interacciones = [];
    private int _nReuniones, _nPropuestas;

    private string Vigencia => _captacion?.FechaInicioVigencia is { } inicio
        && _captacion.FechaFinVigencia is { } fin
        ? $"{inicio:dd/MM/yyyy} - {fin:dd/MM/yyyy}"
        : Texto(_captacion?.VigenciaTexto);

    private bool EsEstadoFinal => _captacion?.Estado is "Activa" or "Rechazada" or "Cerrada" or "Vencida" or "A" or "R" or "C" or "V";

    private bool EstadoPermiteRevision => _captacion?.Estado is "Pendiente de revision" or "Observada" or "P" or "O";

    private bool PuedeRevisar => !_procesando && EstadoPermiteRevision;

    private string OperacionTexto =>
        string.IsNullOrWhiteSpace(_captacion?.MotivoOperacion)
            ? "No registrada"
            : EnumCatalog.LabelFor(EnumCatalog.OperacionesRequerimiento, _captacion.MotivoOperacion);

    private string UrgenciaTexto => _captacion?.Urgencia switch
    {
        1 => "Muy baja (1/5)",
        2 => "Baja (2/5)",
        3 => "Media (3/5)",
        4 => "Alta (4/5)",
        5 => "Muy alta (5/5)",
        _ => "No registrada",
    };

    private RevisionMessage PanelRevision =>
        MensajeParaEstado(_captacion?.Estado)
        ?? new RevisionMessage("blue", "info", "La revision de esta captacion ya fue registrada.");

    // Dias sin contacto / estado de recontacto: misma convencion de 7 dias de la prospeccion.
    private string DiasSinContactoTexto
    {
        get
        {
            if (_prospeccion?.FechaRecontacto is not { } f) return "Sin registro";
            var dias = DateOnly.FromDateTime(DateTime.Today).DayNumber - f.DayNumber;
            return dias <= 0 ? "Hoy" : $"{dias} día(s)";
        }
    }

    private string EstadoRecontactoTexto
    {
        get
        {
            if (_prospeccion?.FechaRecontacto is not { } f) return "No aplica";
            var dias = DateOnly.FromDateTime(DateTime.Today).DayNumber - f.DayNumber;
            return dias >= 7 ? "Recontacto pendiente" : "Al día";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            var captacionTask = string.IsNullOrWhiteSpace(CodigoParam)
                ? Task.FromResult<CaptacionDto?>(null)
                : CaptacionSvc.ObtenerPorCodigoAsync(CodigoParam);
            var agentesTask = AgenteSvc.RefrescarAsync();

            _captacion = await captacionTask;
            _agentes = await agentesTask;
            if (_captacion is null)
            {
                _error = "No se encontro la captacion solicitada.";
                _local = null;
            }
            else
            {
                _local = _captacion.LocalId > 0
                    ? await LocalSvc.ObtenerAsync(_captacion.LocalId)
                    : null;
                if (EsEstadoFinal)
                    _mensajeRevision ??= MensajeParaEstado(_captacion.Estado);

                // Prospeccion que origino la captacion (1 sola) + sus interacciones, para el panel.
                var prospPage = await ProspeccionSvc.ListarPaginaAsync(1, 1, ct: default, idCaptacion: _captacion.Id);
                _prospeccion = prospPage.Items.FirstOrDefault();
                if (_prospeccion is not null)
                {
                    _interacciones = await InteraccionSvc.ListarPorProspeccionAsync(_prospeccion.Id);
                    _nReuniones = string.IsNullOrWhiteSpace(_prospeccion.FechaReunionTexto) ? 0 : 1;
                    _nPropuestas = string.IsNullOrWhiteSpace(_prospeccion.FechaPropuestaTexto) ? 0 : 1;
                }
            }
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AbrirModal(string modal)
    {
        _modal = modal;
        _motivo = "";
        _nuevoAgenteId = 0;
        _error = null;
    }

    private void CerrarModal() => _modal = null;

    private async Task ResolverAsync(string decision, string mensaje)
    {
        if (_captacion is null || _procesando)
            return;
        if (!PuedeRevisar)
        {
            _error = "La captacion ya no esta pendiente de revision u observada. Recarga la bandeja para ver su estado actual.";
            _modal = null;
            return;
        }
        try
        {
            _procesando = true;
            _error = null;
            StateHasChanged();
            await CaptacionSvc.ResolverBandejaAsync(_captacion.CodigoCaptacion, decision, _motivo);
            NotificarAgente(decision);
            await FinalizarAsync(mensaje);
        }
        catch (Exception error)
        {
            if (await ConfirmarDecisionAplicadaAsync(decision, mensaje))
                return;

            _error = error.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task ReasignarAsync()
    {
        if (_captacion is null || _procesando)
            return;
        if (!PuedeRevisar)
        {
            _error = "La captacion ya no se puede reasignar porque su revision ya fue registrada.";
            _modal = null;
            return;
        }
        if (_nuevoAgenteId <= 0)
        {
            _error = "Selecciona el agente que recibira la captacion.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _error = "Ingresa el motivo de la reasignacion.";
            return;
        }
        try
        {
            _procesando = true;
            _error = null;
            StateHasChanged();
            await CaptacionSvc.ReasignarBandejaAsync(
                _captacion.CodigoCaptacion,
                _nuevoAgenteId,
                _motivo);
            await FinalizarAsync("Captacion reasignada");
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    // Avisa al agente captador el resultado de la revision de su captacion.
    private void NotificarAgente(string decision)
    {
        if (_captacion is null) return;
        var (estado, severidad, icono) = decision.Trim().ToUpperInvariant() switch
        {
            "APROBAR" => ("aprobada", "MEDIA", "check"),
            "OBSERVAR" => ("observada", "ALTA", "alert"),
            "RECHAZAR" => ("rechazada", "ALTA", "x"),
            _ => ("revisada", "MEDIA", "fileText"),
        };
        var ruta = estado == "observada"
            ? $"captacion-form/{_captacion.CodigoCaptacion}"
            : $"captacion-detail/{_captacion.CodigoCaptacion}";
        Notificaciones.Crear(new NotificacionDto
        {
            // Tipo + EntidadRef (id numérico) alineados con la alerta real CAPTACION_REVISADA
            // del backend para deduplicar en la campana; el resultado va en el mensaje.
            Tipo = "Captación revisada",
            Mensaje = $"Tu captación {_captacion.CodigoCaptacion} ({_captacion.DireccionLocal}) fue {estado} por el broker.",
            Severidad = severidad,
            Icono = icono,
            EntidadTipo = "Captacion",
            EntidadRef = _captacion.Id.ToString(),
            Ruta = ruta,
            DestinatarioRol = Roles.Agente,
            Fecha = DateTime.Now,
        });
    }

    private async Task FinalizarAsync(string mensaje)
    {
        _modal = null;
        await RefrescarCaptacionAsync();
        _mensajeRevision = MensajeParaEstado(_captacion?.Estado, mensaje);
        _toast = _mensajeRevision?.Text ?? mensaje;
        StateHasChanged();
        // Igual que la evaluacion de solicitud (que navega a "solicitudes"), volvemos a la
        // bandeja tras registrar la decision para que la pagina no se quede "pegada"
        // esperando un refresco manual. El agente ya fue notificado del resultado.
        await Task.Delay(900);
        App.Navigate("bandeja-captaciones");
    }

    private async Task<bool> ConfirmarDecisionAplicadaAsync(string decision, string mensaje)
    {
        try
        {
            await RefrescarCaptacionAsync();
            if (_captacion is not null && EstadoCoincide(decision, _captacion.Estado))
            {
                await FinalizarAsync(mensaje);
                return true;
            }
        }
        catch
        {
            // Si tampoco se puede refrescar, dejamos visible el error original.
        }
        return false;
    }

    private async Task RefrescarCaptacionAsync()
    {
        if (string.IsNullOrWhiteSpace(CodigoParam)) return;
        var actualizada = await CaptacionSvc.ObtenerPorCodigoAsync(CodigoParam);
        if (actualizada is not null)
            _captacion = actualizada;
    }

    private static bool EstadoCoincide(string decision, string estado) =>
        decision.Trim().ToUpperInvariant() switch
        {
            "APROBAR" or "A" => estado is "Activa" or "A",
            "OBSERVAR" or "O" => estado is "Observada" or "O",
            "RECHAZAR" or "R" => estado is "Rechazada" or "R",
            _ => false,
        };

    private static RevisionMessage? MensajeParaEstado(string? estado, string? fallback = null) => estado switch
    {
        "Activa" or "A" => new("green", "checkCircle", "Captacion aprobada. Ya esta activa y disponible para el proceso comercial."),
        "Observada" or "O" => new("blue", "alert", "Captacion observada. El agente debe corregirla y reenviarla a revision."),
        "Rechazada" or "R" => new("red", "x", "Captacion rechazada. La decision quedo registrada."),
        _ when fallback is not null => new("green", "checkCircle", fallback),
        _ => null,
    };

    private static string Texto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "No registrado" : valor;

    private sealed record RevisionMessage(string Tone, string Icon, string Text);
}
