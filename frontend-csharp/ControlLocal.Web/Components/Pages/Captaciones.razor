@page "/captaciones"
@inject AppState App
@inject ICaptacionService CaptacionSvc

<PageTitle>Mis captaciones · ControlLocal</PageTitle>

<AppShell Active="Captaciones" Crumbs="@(new[] { "ControlLocal", "Operación", "Captaciones" })"
          Title="Mis captaciones"
          Subtitle="Expedientes de captación que registré · seguimiento del proceso comercial">
    <Actions>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("local-form"))"><Icon Name="plus" Size="13" /> Nueva captación</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="fileText" Label="Borradores" Value="2" Tone="blue" />
            <MetricCard Icon="clock" Label="En revisión" Value="3" Tone="blue" />
            <MetricCard Icon="check" Label="Activas" Value="8" Tone="green" />
            <MetricCard Icon="alert" Label="Observadas" Value="1" Tone="blue" />
            <MetricCard Icon="x" Label="Rechazadas" Value="1" Tone="red" />
            <MetricCard Icon="flag" Label="Cerradas" Value="1" Tone="navy" />
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

        <FilterBar Search="Buscar por código, dirección, propietario…">
            <select class="cl-select"><option>Distrito</option><option>Miraflores</option><option>San Isidro</option><option>Surco</option></select>
            <select class="cl-select"><option>Estado</option><option>Borrador</option><option>En revisión</option><option>Activa</option><option>Observada</option></select>
            <select class="cl-select"><option>Vigencia</option><option>Por vencer</option><option>Vigente</option></select>
        </FilterBar>

        <div class="cl-gallery-grid">
            @foreach (var c in CaptacionSvc.All())
            {
                <div class="cl-prop-card">
                    <div class="cl-prop-photo">
                        <div class="ph-label">foto del local</div>
                        <div class="top-l"><StatusBadge Label="@c.Estado" /></div>
                        <div class="top-r">@c.CodigoCaptacion</div>
                    </div>
                    <div class="cl-prop-body">
                        <div style="font-weight:600;font-size:13.5px;">@c.DireccionLocal</div>
                        <div style="font-size:11.5px;color:var(--c-text-3);display:flex;gap:6px;align-items:center;">
                            <Icon Name="mapPin" Size="12" /> @c.DistritoLocal
                        </div>
                        <div style="display:flex;gap:10px;font-size:11.5px;color:var(--c-text-2);margin-top:2px;">
                            <span><b>@c.AreaM2</b> m²</span>
                            <span>·</span>
                            <span>Comisión <b>@c.ComisionPactadaTexto@(c.ComisionPactadaTexto == "—" ? "" : "%")</b></span>
                        </div>
                        <div style="border-top:1px solid var(--c-border-2);margin-top:6px;padding-top:8px;font-size:11.5px;color:var(--c-text-2);">
                            <div style="display:flex;align-items:center;gap:6px;"><Icon Name="calendar" Size="12" /> @c.VigenciaTexto</div>
                            <div class="cl-muted" style="font-size:11px;margin-top:2px;">@c.DiasRestantesTexto</div>
                        </div>
                        <div style="font-size:11.5px;color:var(--c-text-2);">Propietario · <b>@c.PropietarioNombre</b></div>

                        <div class="cl-prop-foot">
                            @if (c.Estado == "Observada")
                            {
                                <button class="cl-btn sm primary cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate("captacion-form"))">Subsanar</button>
                            }
                            else if (c.Estado is "Pendiente" or "Borrador")
                            {
                                <button class="cl-btn sm cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate("captacion-form"))">Continuar</button>
                            }
                            else
                            {
                                <button class="cl-btn sm primary cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate($"ficha-propiedad/{c.CodigoCaptacion}"))"><Icon Name="store" Size="13" /> Ver ficha</button>
                                <button class="cl-btn sm" @onclick="@(() => App.Navigate($"captacion-detail/{c.CodigoCaptacion}"))" title="Abrir expediente"><Icon Name="folder" Size="13" /></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <Pagination Total="14" />
    </ChildContent>
</AppShell>

@code {
    private string _tab = "Todas";

    private readonly Tabs.TabItem[] _tabs = new[]
    {
        new Tabs.TabItem("Todas", 14),
        new Tabs.TabItem("Borradores", 2),
        new Tabs.TabItem("En revisión", 3),
        new Tabs.TabItem("Observadas", 1),
        new Tabs.TabItem("Activas", 8),
    };
}
