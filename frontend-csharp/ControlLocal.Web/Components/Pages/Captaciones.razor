@page "/captaciones"
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject ExportacionService Exportar

<PageTitle>Mis captaciones · ControlLocal</PageTitle>

<AppShell Active="Captaciones" Crumbs="@(new[] { "ControlLocal", "Operación", "Captaciones" })"
          Title="Mis captaciones"
          Subtitle="Expedientes de captación que registré · seguimiento del proceso comercial">
    <Actions>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("captacion-form"))"><Icon Name="plus" Size="13" /> Nueva captación</button>
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <div style="display:grid;grid-template-columns:repeat(@(_estados.Length + 1),1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="layers" Label="Total" Value="@Todas.Count.ToString()" Tone="gray"
                        Active="@(_tab == "Todas")" OnClick="@(() => _tab = "Todas")" />
            @foreach (var e in _estados)
            {
                <MetricCard Icon="@IconoEstado(e)" Label="@e" Value="@CuentaEstado(e).ToString()" Tone="@TonoEstado(e)"
                            Active="@(_tab == e)" OnClick="@(() => _tab = e)" />
            }
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

        <FilterBar Search="Buscar por código, dirección, propietario…"
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros"
                   OnExport="@(() => ExportarCsv(filtradas))">
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
            <FilterSelect Placeholder="Vigencia" Options="_vigencias" @bind-Value="_vigencia" />
        </FilterBar>

        <div class="cl-gallery-grid">
            @foreach (var c in visibles)
            {
                <div class="cl-prop-card">
                    <div class="cl-prop-photo">
                        <div class="ph-label">foto del local</div>
                        <div class="top-l"><StatusBadge Label="@c.Estado" /></div>
                        <div class="top-r">@c.CodigoCaptacion</div>
                    </div>
                    <div class="cl-prop-body">
                        <div style="font-weight:600;font-size:13.5px;">@c.DireccionLocal</div>
                        <div style="font-size:11.5px;color:var(--c-text-3);display:flex;gap:6px;align-items:center;">
                            <Icon Name="mapPin" Size="12" /> @c.DistritoLocal
                        </div>
                        <div style="display:flex;gap:10px;font-size:11.5px;color:var(--c-text-2);margin-top:2px;">
                            <span><b>@c.AreaM2</b> m²</span>
                            <span>·</span>
                            <span>Comisión <b>@c.ComisionPactadaTexto@(c.ComisionPactadaTexto == "—" ? "" : "%")</b></span>
                        </div>
                        <div style="border-top:1px solid var(--c-border-2);margin-top:6px;padding-top:8px;font-size:11.5px;color:var(--c-text-2);">
                            <div style="display:flex;align-items:center;gap:6px;"><Icon Name="calendar" Size="12" /> @c.VigenciaTexto</div>
                            <div class="cl-muted" style="font-size:11px;margin-top:2px;">@c.DiasRestantesTexto</div>
                        </div>
                        <div style="font-size:11.5px;color:var(--c-text-2);">Propietario · <b>@c.PropietarioNombre</b></div>

                        <div class="cl-prop-foot">
                            @if (c.Estado == "Observada")
                            {
                                <button class="cl-btn sm primary cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate($"captacion-form/{c.CodigoCaptacion}"))">Subsanar</button>
                            }
                            else if (c.Estado is "Pendiente de revision" or "Borrador")
                            {
                                <button class="cl-btn sm cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate($"captacion-form/{c.CodigoCaptacion}"))">Continuar</button>
                            }
                            else
                            {
                                <button class="cl-btn sm primary cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate($"ficha-propiedad/{c.CodigoCaptacion}"))"><Icon Name="store" Size="13" /> Ver ficha</button>
                                <button class="cl-btn sm" @onclick="@(() => App.Navigate($"captacion-detail/{c.CodigoCaptacion}"))" title="Abrir expediente"><Icon Name="folder" Size="13" /></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (_cargando)
        {
            <div class="cl-card"><div style="padding:40px;text-align:center;color:#7E8794;">Actualizando captaciones…</div></div>
        }
        else if (_error is not null)
        {
            <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
        }
        else if (filtradas.Count == 0)
        {
            <div class="cl-card"><div style="padding:40px;text-align:center;color:#7E8794;">
                <Icon Name="pin" Size="28" style="margin-bottom:10px;" />
                <div style="font-weight:600;margin-bottom:4px;">Sin captaciones en este filtro</div>
                <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
            </div></div>
        }
        else
        {
            <Pagination Total="filtradas.Count" @bind-Page="_pagina" />
        }
    </ChildContent>
</AppShell>

@code {
    private string _tab = "Todas";
    private string _query = "";
    private string _distrito = "";
    private string _vigencia = "";
    private int _pagina = 1;
    private bool _cargando = true;
    private string? _error;

    private IReadOnlyList<CaptacionDto> Todas = [];

    // Recarga fresca desde el backend en cada navegacion: asi el agente ve el
    // estado real (aprobada/observada/rechazada por el broker) sin reconectar.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Todas = await CaptacionSvc.RefrescarAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    // Dimensiones derivadas de los datos (sin valores hardcodeados).
    private string[] _estados => Todas.Select(c => c.Estado).Distinct().OrderBy(x => x).ToArray();
    private IReadOnlyList<string> _distritos => Todas.Select(c => c.DistritoLocal).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();
    private readonly IReadOnlyList<string> _vigencias = new[] { "Por vencer", "Vigente" };

    private int CuentaEstado(string e) => Todas.Count(c => c.Estado == e);

    private Tabs.TabItem[] _tabs => new[] { new Tabs.TabItem("Todas", Todas.Count) }
        .Concat(_estados.Select(e => new Tabs.TabItem(e, CuentaEstado(e))))
        .ToArray();

    private bool HayFiltros => _tab != "Todas" || !string.IsNullOrEmpty(_query)
                               || !string.IsNullOrEmpty(_distrito) || !string.IsNullOrEmpty(_vigencia);

    private void LimpiarFiltros()
    {
        _tab = "Todas"; _query = ""; _distrito = ""; _vigencia = ""; _pagina = 1;
    }

    private async Task ExportarCsv(IReadOnlyList<CaptacionDto> filtradas)
    {
        await Exportar.DescargarCsvAsync("captaciones",
            new[] { "Código", "Dirección", "Distrito", "Área m²", "Propietario", "Agente", "Vigencia", "Comisión %", "Estado" },
            filtradas.Select(c => (IReadOnlyList<string?>)new[]
            {
                c.CodigoCaptacion, c.DireccionLocal, c.DistritoLocal, c.AreaM2.ToString(),
                c.PropietarioNombre, c.NombreAgenteResponsable, c.VigenciaTexto,
                c.ComisionPactadaTexto, c.Estado,
            }));
    }

    private IEnumerable<CaptacionDto> Filtradas() => Todas.Where(c =>
        (_tab == "Todas" || c.Estado == _tab) &&
        (string.IsNullOrEmpty(_distrito) || c.DistritoLocal == _distrito) &&
        (string.IsNullOrEmpty(_vigencia) || VigenciaCat(c) == _vigencia) &&
        (string.IsNullOrEmpty(_query) || Coincide(c, _query)));

    private static bool Coincide(CaptacionDto c, string q) =>
        (c.CodigoCaptacion?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (c.DireccionLocal?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (c.PropietarioNombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);

    // Vigencia solo aplica a captaciones activas; se deriva de los días restantes.
    private static string? VigenciaCat(CaptacionDto c)
    {
        if (c.Estado != "Activa") return null;
        var dias = ParseDias(c.DiasRestantesTexto);
        return dias is <= 60 ? "Por vencer" : "Vigente";
    }

    private static int? ParseDias(string? texto)
    {
        if (string.IsNullOrEmpty(texto)) return null;
        var m = System.Text.RegularExpressions.Regex.Match(texto, @"\d+");
        return m.Success ? int.Parse(m.Value) : (int?)null;
    }

    private static string TonoEstado(string e) => e switch
    {
        "Activa" => "green",
        "Observada" => "info",
        "Rechazada" => "red",
        "Vencida" => "red",
        "Cerrada" => "navy",
        _ => "blue",
    };

    private static string IconoEstado(string e) => e switch
    {
        "Activa" => "check",
        "Observada" => "alert",
        "Rechazada" => "x",
        "Cerrada" => "flag",
        "Vencida" => "clock",
        _ => "clock",
    };
}
