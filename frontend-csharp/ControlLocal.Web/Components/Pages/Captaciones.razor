@page "/captaciones"
@inject AppState App
@inject ICaptacionService CaptacionSvc

<PageTitle>Mis captaciones · ControlLocal</PageTitle>

<AppShell Active="Captaciones" Crumbs="@(new[] { "ControlLocal", "Operación", "Captaciones" })"
          Title="Mis captaciones"
          Subtitle="Expedientes de captación que registré · seguimiento del proceso comercial">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCaptaciones"><Icon Name="download" Size="13" /> Exportar</button>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("captacion-form"))"><Icon Name="plus" Size="13" /> Nueva captación</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="fileText" Label="Borradores" Value="2" Tone="amber" OnClick="@(() => FiltrarPorEstado("Borradores"))" />
            <MetricCard Icon="clock" Label="En revisión" Value="3" Tone="amber" OnClick="@(() => FiltrarPorEstado("En revisión"))" />
            <MetricCard Icon="check" Label="Activas" Value="8" Tone="green" OnClick="@(() => FiltrarPorEstado("Activas"))" />
            <MetricCard Icon="alert" Label="Observadas" Value="1" Tone="amber" OnClick="@(() => FiltrarPorEstado("Observadas"))" />
            <MetricCard Icon="x" Label="Rechazadas" Value="1" Tone="red" OnClick="@(() => FiltrarPorEstado("Rechazadas"))" />
            <MetricCard Icon="flag" Label="Cerradas" Value="1" Tone="navy" OnClick="@(() => FiltrarPorEstado("Cerradas"))" />
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => { _tab = t; _filtroDistrito = ""; _filtroEstado = ""; })" Items="_tabs" />

        <FilterBar Search="Buscar por código, dirección, propietario…">
            <select class="cl-select" @bind="_filtroDistrito">
                <option value="">Distrito</option>
                <option>Miraflores</option>
                <option>San Isidro</option>
                <option>Surco</option>
                <option>San Miguel</option>
                <option>Jesús María</option>
                <option>San Martín</option>
                <option>Magdalena</option>
            </select>
            <select class="cl-select" @bind="_filtroEstado">
                <option value="">Estado</option>
                <option>Pendiente</option>
                <option>Activa</option>
                <option>Observada</option>
                <option>Rechazada</option>
            </select>
            <select class="cl-select"><option>Vigencia</option><option>Por vencer</option><option>Vigente</option></select>
            <button class="cl-btn sm" @onclick="MasFiltros"><Icon Name="filter" Size="12" /> Más filtros</button>
        </FilterBar>

        @if (_toastMsg is not null)
        {
            <div class="cl-alert blue" style="margin-bottom:10px;">
                <Icon Name="check" Size="15" />
                <span>@_toastMsg</span>
            </div>
        }

        <div class="cl-gallery-grid">
            @foreach (var c in CaptacionesFiltradas)
            {
                <div class="cl-prop-card">
                    <div class="cl-prop-photo">
                        <div class="ph-label">foto del local</div>
                        <div class="top-l"><StatusBadge Label="@c.Estado" /></div>
                        <div class="top-r">@c.CodigoCaptacion</div>
                    </div>
                    <div class="cl-prop-body">
                        <div style="font-weight:600;font-size:13.5px;">@c.DireccionLocal</div>
                        <div style="font-size:11.5px;color:var(--c-text-3);display:flex;gap:6px;align-items:center;">
                            <Icon Name="mapPin" Size="12" /> @c.DistritoLocal
                        </div>
                        <div style="display:flex;gap:10px;font-size:11.5px;color:var(--c-text-2);margin-top:2px;">
                            <span><b>@c.AreaM2</b> m²</span>
                            <span>·</span>
                            <span>Comisión <b>@c.ComisionPactadaTexto@(c.ComisionPactadaTexto == "—" ? "" : "%")</b></span>
                        </div>
                        <div style="border-top:1px solid var(--c-border-2);margin-top:6px;padding-top:8px;font-size:11.5px;color:var(--c-text-2);">
                            <div style="display:flex;align-items:center;gap:6px;"><Icon Name="calendar" Size="12" /> @c.VigenciaTexto</div>
                            <div class="cl-muted" style="font-size:11px;margin-top:2px;">@c.DiasRestantesTexto</div>
                        </div>
                        <div style="font-size:11.5px;color:var(--c-text-2);">Propietario · <b>@c.PropietarioNombre</b></div>

                        <div class="cl-prop-foot">
                            @if (c.Estado == "Observada")
                            {
                                <button class="cl-btn sm warn cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate("captacion-form"))">Subsanar</button>
                            }
                            else if (c.Estado is "Pendiente" or "Borrador")
                            {
                                <button class="cl-btn sm cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate("captacion-form"))">Continuar</button>
                            }
                            else
                            {
                                <button class="cl-btn sm primary cl-grow" style="justify-content:center;" @onclick="@(() => App.Navigate($"ficha-propiedad/{c.CodigoCaptacion}"))"><Icon Name="store" Size="13" /> Ver ficha</button>
                                <button class="cl-btn sm" @onclick="@(() => App.Navigate($"captacion-detail/{c.CodigoCaptacion}"))" title="Abrir expediente"><Icon Name="folder" Size="13" /></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        <Pagination Total="14" />
    </ChildContent>
</AppShell>

@code {
    private string _tab = "Todas";
    private string _filtroDistrito = "";
    private string _filtroEstado = "";
    private string? _toastMsg;

    private readonly Tabs.TabItem[] _tabs = new[]
    {
        new Tabs.TabItem("Todas", 14),
        new Tabs.TabItem("Borradores", 2),
        new Tabs.TabItem("En revisión", 3),
        new Tabs.TabItem("Observadas", 1),
        new Tabs.TabItem("Activas", 8),
    };

    private IEnumerable<CaptacionDto> CaptacionesFiltradas
    {
        get
        {
            var lista = CaptacionSvc.All().AsEnumerable();

            lista = _tab switch
            {
                "Borradores"  => lista.Where(c => c.Estado is "Borrador" or "Pendiente"),
                "En revisión" => lista.Where(c => c.Estado == "En revisión"),
                "Observadas"  => lista.Where(c => c.Estado == "Observada"),
                "Activas"     => lista.Where(c => c.Estado == "Activa"),
                "Rechazadas"  => lista.Where(c => c.Estado == "Rechazada"),
                "Cerradas"    => lista.Where(c => c.Estado is "Cerrada" or "Cerradas"),
                _             => lista
            };

            if (!string.IsNullOrEmpty(_filtroDistrito))
                lista = lista.Where(c => c.DistritoLocal.Contains(_filtroDistrito, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrEmpty(_filtroEstado))
                lista = lista.Where(c => c.Estado == _filtroEstado);

            return lista;
        }
    }

    private void FiltrarPorEstado(string tab)
    {
        _tab = tab;
        _filtroDistrito = "";
        _filtroEstado = "";
    }

    private void ExportarCaptaciones()
    {
        _toastMsg = "Exportación generada correctamente";
        _ = OcultarToastAsync();
    }

    private void MasFiltros()
    {
        _toastMsg = "Filtros avanzados disponibles próximamente";
        _ = OcultarToastAsync();
    }

    private async Task OcultarToastAsync()
    {
        await Task.Delay(2500);
        _toastMsg = null;
        await InvokeAsync(StateHasChanged);
    }
}
