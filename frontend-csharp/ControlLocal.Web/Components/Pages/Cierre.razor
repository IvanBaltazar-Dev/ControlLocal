@page "/cierre"
@page "/cierre/{CaptacionId:long}"
@inherits SafeComponentBase
@inject AppState App
@inject ICaptacionService CaptacionSvc
@inject INotificacionService Notificaciones

<PageTitle>Cerrar captacion · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Captaciones", "Cerrar captacion" })"
          Title="Cerrar captacion"
          Subtitle="Registra el motivo y cambia una captacion activa al estado Cerrada">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("captaciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        @if (!PuedeCerrar)
        {
            <div class="cl-alert red">
                <Icon Name="alert" Size="15" />
                <span>Solo un broker supervisor o administrador puede cerrar captaciones.</span>
            </div>
        }
        else
        {
            <div style="max-width:760px;">
                <div class="cl-alert blue" style="margin-bottom:14px;">
                    <Icon Name="info" Size="15" />
                    <span>Cerrar una captacion la retira del seguimiento activo. Indica un motivo claro para dejar trazabilidad.</span>
                </div>

                <FormSection Num="1" Title="Captacion activa" Sub="Selecciona el expediente que se cerrara">
                    <Field Label="Captacion" Required="true">
                        <select @bind="_captacionId" disabled="@_cargandoLista">
                            <option value="0">@(_cargandoLista ? "Cargando captaciones…" : "— Seleccionar —")</option>
                            @foreach (var captacion in CaptacionesActivas)
                            {
                                <option value="@captacion.Id">@captacion.CodigoCaptacion · @captacion.DireccionLocal · @captacion.PropietarioNombre</option>
                            }
                        </select>
                    </Field>
                </FormSection>

                <FormSection Num="2" Title="Motivo de cierre" Sub="Texto obligatorio persistido como observacion de revision">
                    <Field Label="Motivo" Required="true">
                        <textarea rows="4" @bind="_motivo" placeholder="Explica por que se cierra la captacion..."></textarea>
                    </Field>
                </FormSection>

                @if (_error is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;">
                        <Icon Name="alert" Size="15" />
                        <span>@_error</span>
                    </div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("captaciones"))"
                               OnSave="PrepararCierre"
                               SaveLabel="Cerrar captacion"
                               Busy="@_procesando"
                               BusyLabel="Cerrando..." />
            </div>

            <ConfirmDialog Open="_confirm" Tone="red" Icon="alert"
                           Title="¿Cerrar la captacion?"
                           Desc="El expediente cambiara al estado Cerrada y dejara de admitir operaciones activas."
                           ConfirmLabel="Cerrar captacion" CancelLabel="Cancelar"
                           Busy="@_procesando"
                           OnClose="@(() => _confirm = false)"
                           OnConfirm="ConfirmarCierreAsync" />
        }

        <CierreExitosoOverlay Open="_cerrada"
                              Icon="checkCircle"
                              Eyebrow="Cierre registrado"
                              Title="¡Captación cerrada!"
                              Subtitle="@_subtituloCierre"
                              Resumen="_resumenCierre">
            <Acciones>
                <button class="cl-btn primary" @onclick="VerFicha"><Icon Name="store" Size="13" /> Ver ficha</button>
                <button class="cl-btn" @onclick="CerrarOtra"><Icon Name="plus" Size="13" /> Cerrar otra</button>
                <button class="cl-btn ghost" @onclick="@(() => App.Navigate("captaciones"))">Ir a captaciones</button>
            </Acciones>
        </CierreExitosoOverlay>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public long? CaptacionId { get; set; }

    private long _captacionId;
    private string _motivo = "";
    private string? _error;
    private bool _confirm;
    private bool _procesando;
    private bool _cerrada;
    private CaptacionDto? _captacionCerrada;
    private string _subtituloCierre = "";
    private IReadOnlyList<CierreExitosoOverlay.Fila> _resumenCierre = [];

    private bool PuedeCerrar => App.Role is Roles.Broker or Roles.Admin;
    private IReadOnlyList<CaptacionDto> CaptacionesActivas = [];
    private bool _cargandoLista = true;

    // Recarga las captaciones frescas para que el desplegable muestre solo las que
    // realmente estan Activas tras la revision del broker.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var todas = await CaptacionSvc.RefrescarAsync(DisposedToken);
            CaptacionesActivas = todas.Where(item => item.Estado == "Activa").ToList();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargandoLista = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (CaptacionId is > 0)
            _captacionId = CaptacionId.Value;
    }

    private void PrepararCierre()
    {
        if (_procesando) return;
        _error = null;
        _cerrada = false;
        if (_captacionId <= 0)
        {
            _error = "Selecciona una captacion activa.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _error = "El motivo de cierre es obligatorio.";
            return;
        }
        _confirm = true;
    }

    private async Task ConfirmarCierreAsync()
    {
        if (_procesando) return;
        try
        {
            _procesando = true;
            await RenderIfAliveAsync();
            // Captura la captacion (aun activa) antes de cerrarla, para el resumen.
            var cerrada = CaptacionesActivas.FirstOrDefault(item => item.Id == _captacionId);
            var motivo = _motivo.Trim();
            await CaptacionSvc.CerrarAsync(_captacionId, motivo, DisposedToken);
            _confirm = false;
            var todas = await CaptacionSvc.RefrescarAsync(DisposedToken);
            cerrada ??= todas.FirstOrDefault(item => item.Id == _captacionId);
            CaptacionesActivas = todas.Where(item => item.Estado == "Activa").ToList();

            _captacionCerrada = cerrada;
            ConstruirResumen(cerrada, motivo);
            NotificarAgente(cerrada, motivo);
            _cerrada = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }

    // Arma el resumen premium del cierre con los datos del expediente cerrado.
    private void ConstruirResumen(CaptacionDto? cap, string motivo)
    {
        var codigo = cap?.CodigoCaptacion ?? "la captación";
        _subtituloCierre =
            $"{codigo} quedó cerrada y fuera del seguimiento activo. Queda registrada con su motivo para trazabilidad.";

        var filas = new List<CierreExitosoOverlay.Fila>();
        if (cap is not null)
        {
            filas.Add(new("Captación", cap.CodigoCaptacion, "folder"));
            filas.Add(new("Local", $"{cap.DireccionLocal} · {cap.DistritoLocal}", "mapPin"));
            if (!string.IsNullOrWhiteSpace(cap.PropietarioNombre))
                filas.Add(new("Propietario", cap.PropietarioNombre, "user"));
            if (!string.IsNullOrWhiteSpace(cap.NombreAgenteResponsable))
                filas.Add(new("Agente captador", cap.NombreAgenteResponsable, "briefcase"));
            if (!string.IsNullOrWhiteSpace(cap.ComisionPactadaTexto) && cap.ComisionPactadaTexto != "—")
                filas.Add(new("Comisión pactada", $"{cap.ComisionPactadaTexto}%", "activity", true));
            if (!string.IsNullOrWhiteSpace(cap.VigenciaTexto))
                filas.Add(new("Vigencia", cap.VigenciaTexto, "calendar"));
        }
        if (!string.IsNullOrWhiteSpace(motivo))
            filas.Add(new("Motivo de cierre", motivo, "flag"));
        _resumenCierre = filas;
    }

    // Avisa al agente captador que el broker cerró su captación.
    private void NotificarAgente(CaptacionDto? cap, string motivo)
    {
        var codigo = cap?.CodigoCaptacion ?? "";
        Notificaciones.Crear(new NotificacionDto
        {
            Tipo = "Captación cerrada",
            Mensaje = string.IsNullOrEmpty(codigo)
                ? $"El broker cerró una captación. Motivo: {motivo}"
                : $"El broker cerró la captación {codigo} ({cap?.DireccionLocal}). Motivo: {motivo}",
            Severidad = "MEDIA",
            Icono = "flag",
            EntidadTipo = "Captacion",
            EntidadRef = codigo,
            Ruta = string.IsNullOrEmpty(codigo) ? null : $"captacion-detail/{codigo}",
            DestinatarioRol = Roles.Agente,
            Fecha = DateTime.Now,
        });
    }

    private void VerFicha()
    {
        if (_captacionCerrada is { } cap)
            App.Navigate($"ficha-propiedad/{cap.CodigoCaptacion}");
        else
            App.Navigate("captaciones");
    }

    private void CerrarOtra()
    {
        _cerrada = false;
        _captacionId = 0;
        _motivo = "";
        _captacionCerrada = null;
        _resumenCierre = [];
    }
}
