@page "/cierre"
@inject AppState App

<PageTitle>Cierre de operación · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mis captaciones", "OP-1094 · Cierre" })"
          Title="Cierre de operación · OP-1094"
          Subtitle="Solicitud aprobada · registra el contrato para marcar el local como alquilado">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("oportunidades"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div class="cl-alert green" style="margin-bottom:14px;">
            <Icon Name="check" Size="15" />
            <span>La solicitud <b>SOL-0425</b> fue aprobada por el broker. Completa los datos del contrato para cerrar la operación.</span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Datos del contrato" Sub="Información del contrato de alquiler firmado entre las partes">
                    <div class="cl-grid c2">
                        <Field Label="N.° de contrato" Required="true"><input placeholder="CT-2026-0094" /></Field>
                        <Field Label="Fecha de firma" Required="true"><input placeholder="dd/mm/aaaa" /></Field>
                        <Field Label="Inicio de vigencia" Required="true"><input placeholder="dd/mm/aaaa" /></Field>
                        <Field Label="Fin de vigencia" Required="true"><input placeholder="dd/mm/aaaa" /></Field>
                        <Field Label="Monto mensual (USD)"><input value="1 850" disabled /></Field>
                        <Field Label="Plazo"><input value="24 meses" disabled /></Field>
                    </div>
                </FormSection>

                <FormSection Num="2" Title="Comisión y pagos" Sub="Liquidación de la comisión acordada con el propietario">
                    <div class="cl-grid c3">
                        <Field Label="Comisión (%)"><input value="4.5%" disabled /></Field>
                        <Field Label="Monto de comisión (USD)"><input value="1 998" disabled /></Field>
                        <Field Label="Estado del pago"><select><option>Pendiente</option><option>Parcial</option><option>Pagado</option></select></Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Documentos del cierre" Sub="Contrato firmado y respaldo de la operación">
                    <div class="cl-ph" style="height:100px;">
                        <Icon Name="upload" Size="20" /> <span style="margin-left:8px;">Adjunta el contrato firmado y anexos</span>
                    </div>
                    <div style="margin-top:12px;display:flex;flex-direction:column;gap:8px;">
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border:1px solid #C9CED6;border-radius:8px;background:#fff;">
                            <div class="cl-flex"><Icon Name="fileText" Size="15" /> <span style="font-size:12.5px;">Contrato_de_alquiler_firmado.pdf</span></div>
                            <StatusBadge Label="Cargado" />
                        </div>
                    </div>
                </FormSection>

                <FormFooterBar OnCancel="@(() => App.Navigate("oportunidades"))" OnSave="@(() => _confirm = true)" SaveLabel="Registrar alquiler cerrado" />
            </div>

            <div class="cl-stack">
                <div class="cl-card" style="position:sticky;top:14px;">
                    <div class="cl-card-head"><div class="cl-card-title">Resumen de la operación</div></div>
                    <div class="cl-card-body">
                        <dl class="cl-kv">
                            <dt>Operación</dt><dd><span class="mono">OP-1094</span></dd>
                            <dt>Captación</dt><dd><span class="mono">CAP-0226</span></dd>
                            <dt>Cliente</dt><dd>Boutique Lila</dd>
                            <dt>Local</dt><dd>Calle Schell 412</dd>
                            <dt>Propietario</dt><dd>Carlos Mendoza Rivera</dd>
                            <dt>Agente</dt><dd>Valentina Mora</dd>
                        </dl>
                    </div>
                </div>
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Al registrar el cierre, el local pasa a estado <b>Alquilada</b> y la operación se marca como completada en la auditoría.</span>
                </div>
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="green" Icon="check"
                       Title="¿Registrar el alquiler como cerrado?"
                       Desc="El local quedará marcado como alquilado y la operación se completará. Esta acción cierra el expediente comercial."
                       ConfirmLabel="Registrar cierre" CancelLabel="Revisar datos"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">Operación cerrada · local alquilado</Toast>
    </ChildContent>
</AppShell>

@code {
    private bool _confirm;
    private bool _toast;

    private async Task OnConfirm()
    {
        _confirm = false;
        _toast = true;
        StateHasChanged();
        await Task.Delay(900);
        App.Navigate("oportunidades");
    }
}
