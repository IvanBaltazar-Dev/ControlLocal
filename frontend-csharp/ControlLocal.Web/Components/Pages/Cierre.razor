@page "/cierre"
@page "/cierre/{CaptacionId:long}"
@inherits SafeComponentBase
@inject AppState App
@inject ICaptacionService CaptacionSvc

<PageTitle>Cerrar captacion · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Captaciones", "Cerrar captacion" })"
          Title="Cerrar captacion"
          Subtitle="Registra el motivo y cambia una captacion activa al estado Cerrada">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("captaciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        @if (!PuedeCerrar)
        {
            <div class="cl-alert red">
                <Icon Name="alert" Size="15" />
                <span>Solo un broker supervisor o administrador puede cerrar captaciones.</span>
            </div>
        }
        else
        {
            <div style="max-width:760px;">
                <div class="cl-alert blue" style="margin-bottom:14px;">
                    <Icon Name="info" Size="15" />
                    <span>Cerrar una captacion la retira del seguimiento activo. Indica un motivo claro para dejar trazabilidad.</span>
                </div>

                @if (_cerrada)
                {
                    <div class="cl-alert green" style="margin-bottom:14px;">
                        <Icon Name="check" Size="15" />
                        <span>Captacion cerrada correctamente. Ya no admite operaciones activas.</span>
                    </div>
                }

                <FormSection Num="1" Title="Captacion activa" Sub="Selecciona el expediente que se cerrara">
                    <Field Label="Captacion" Required="true">
                        <select @bind="_captacionId">
                            <option value="0">— Seleccionar —</option>
                            @foreach (var captacion in CaptacionesActivas)
                            {
                                <option value="@captacion.Id">@captacion.CodigoCaptacion · @captacion.DireccionLocal · @captacion.PropietarioNombre</option>
                            }
                        </select>
                    </Field>
                </FormSection>

                <FormSection Num="2" Title="Motivo de cierre" Sub="Texto obligatorio persistido como observacion de revision">
                    <Field Label="Motivo" Required="true">
                        <textarea rows="4" @bind="_motivo" placeholder="Explica por que se cierra la captacion..."></textarea>
                    </Field>
                </FormSection>

                @if (_error is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;">
                        <Icon Name="alert" Size="15" />
                        <span>@_error</span>
                    </div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("captaciones"))"
                               OnSave="PrepararCierre"
                               SaveLabel="Cerrar captacion"
                               Busy="@_procesando"
                               BusyLabel="Cerrando..." />
            </div>

            <ConfirmDialog Open="_confirm" Tone="red" Icon="alert"
                           Title="¿Cerrar la captacion?"
                           Desc="El expediente cambiara al estado Cerrada y dejara de admitir operaciones activas."
                           ConfirmLabel="Cerrar captacion" CancelLabel="Cancelar"
                           Busy="@_procesando"
                           OnClose="@(() => _confirm = false)"
                           OnConfirm="ConfirmarCierreAsync" />
            <Toast Show="@(_toast is not null)">@_toast</Toast>
        }
    </ChildContent>
</AppShell>

@code {
    [Parameter] public long? CaptacionId { get; set; }

    private long _captacionId;
    private string _motivo = "";
    private string? _error;
    private string? _toast;
    private bool _confirm;
    private bool _procesando;
    private bool _cerrada;

    private bool PuedeCerrar => App.Role is Roles.Broker or Roles.Admin;
    private IReadOnlyList<CaptacionDto> CaptacionesActivas = [];

    // Recarga las captaciones frescas para que el desplegable muestre solo las que
    // realmente estan Activas tras la revision del broker.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var todas = await CaptacionSvc.RefrescarAsync(DisposedToken);
            CaptacionesActivas = todas.Where(item => item.Estado == "Activa").ToList();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    protected override void OnParametersSet()
    {
        if (CaptacionId is > 0)
            _captacionId = CaptacionId.Value;
    }

    private void PrepararCierre()
    {
        if (_procesando) return;
        _error = null;
        _cerrada = false;
        if (_captacionId <= 0)
        {
            _error = "Selecciona una captacion activa.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _error = "El motivo de cierre es obligatorio.";
            return;
        }
        _confirm = true;
    }

    private async Task ConfirmarCierreAsync()
    {
        if (_procesando) return;
        try
        {
            _procesando = true;
            await RenderIfAliveAsync();
            await CaptacionSvc.CerrarAsync(_captacionId, _motivo, DisposedToken);
            _confirm = false;
            var todas = await CaptacionSvc.RefrescarAsync(DisposedToken);
            CaptacionesActivas = todas.Where(item => item.Estado == "Activa").ToList();
            _toast = "Captacion cerrada correctamente.";
            _cerrada = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception error)
        {
            _error = error.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }
}
