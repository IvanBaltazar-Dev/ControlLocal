@page "/cliente-form"
@page "/cliente-form/{ClienteId:long}"
@inherits SafeComponentBase
@inject AppState App
@inject IClienteService ClienteSvc

<PageTitle>@(_isEdit ? "Editar cliente" : "Registrar cliente") · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Clientes interesados", _isEdit ? _nombreMostrar : "Nuevo cliente" })"
          Title="@(_isEdit ? "Editar cliente interesado" : "Registrar cliente interesado")"
          Subtitle="@(_isEdit
                            ? "Actualiza contacto, rubro, consentimientos y estado. La identidad no se puede modificar."
                            : "Prospecto comercial · podrás vincularlo a una captación activa para iniciar el seguimiento")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("clientes"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Tipo de cliente" Sub="@(_isEdit ? "No se puede cambiar tras el registro" : "Determina los campos de identificación requeridos")">
                    <div class="cl-seg" role="tablist">
                        <button class="@(_tipo == "juridica" ? "active" : "")" disabled="@_isEdit" @onclick="@(() => SetTipo("juridica"))">Persona jurídica</button>
                        <button class="@(_tipo == "natural" ? "active" : "")" disabled="@_isEdit" @onclick="@(() => SetTipo("natural"))">Persona natural</button>
                    </div>
                    @if (_isEdit)
                    {
                        <div class="cl-muted" style="font-size:11px;margin-top:8px;display:flex;align-items:center;gap:6px;">
                            <Icon Name="lock" Size="12" /> El tipo de cliente quedó fijado al registrarlo.
                        </div>
                    }
                </FormSection>

                <FormSection Num="2" Title="Identificación" Sub="@(_tipo == "juridica" ? "Datos de la empresa" : "Datos personales del cliente")">
                    @if (_tipo == "juridica")
                    {
                        <div class="cl-grid c2">
                            <Field Label="Razón social" Required="true"><input @bind="_razonSocial" @bind:event="oninput" placeholder="Ej. Inversiones Trébol S.A.C." /></Field>
                            <Field Label="RUC" Required="true">
                                <input @bind="_documento" @bind:event="oninput" placeholder="20XXXXXXXX" disabled="@_isEdit" />
                                @if (_isEdit)
                                {
                                    <div class="cl-muted" style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:6px;"><Icon Name="lock" Size="11" /> El RUC no se puede modificar.</div>
                                }
                            </Field>
                        </div>
                    }
                    else
                    {
                        <div class="cl-grid c2">
                            <Field Label="Nombre completo" Required="true"><input @bind="_nombreNatural" @bind:event="oninput" placeholder="Nombres y apellidos" /></Field>
                            <DocumentTypeSelector PersonType="natural" SelectedDocType="@_tipoDoc" OnChange="OnTipoDocChange" Disabled="@_isEdit" />
                            <Field Label="Número de documento" Required="true">
                                <input @bind="_documento" @bind:event="oninput" placeholder="XXXXXXXX" disabled="@_isEdit" />
                                @if (_isEdit)
                                {
                                    <div class="cl-muted" style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:6px;"><Icon Name="lock" Size="11" /> El documento de identidad no se puede modificar.</div>
                                }
                            </Field>
                        </div>
                    }
                </FormSection>

                <FormSection Num="3" Title="Contacto" Sub="Datos para coordinar interacciones y visitas">
                    <div class="cl-grid c2">
                        <Field Label="Teléfono principal" Required="true">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span style="color:var(--cl-text-muted); font-weight:500;">+51</span>
                                <input type="tel" @bind="_telefono" @bind:event="oninput" maxlength="9" placeholder="999 999 999" style="width: 100%;" />
                            </div>
                        </Field>
                        <Field Label="Correo electrónico" Required="true"><input @bind="_correo" @bind:event="oninput" placeholder="cliente@correo.com" /></Field>
                    </div>
                </FormSection>

                <FormSection Num="4" Title="Perfil comercial y consentimientos" Sub="Datos disponibles en el registro del cliente interesado">
                    <div class="cl-grid c2">
                        <Field Label="Rubro de interés" Required="true">
                            <select @bind="_rubro">
                                @foreach (var rubro in Rubros)
                                {
                                    <option value="@rubro">@rubro</option>
                                }
                            </select>
                        </Field>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:10px;margin-top:14px;">
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;">
                            <input type="checkbox" @bind="_consentimientoContacto" style="width:auto;" />
                            Autoriza recibir comunicaciones comerciales.
                        </label>
                        <label style="display:flex;align-items:center;gap:8px;font-size:13px;">
                            <input type="checkbox" @bind="_consentimientoUsoDato" style="width:auto;" />
                            Autoriza el uso de sus datos para la gestión inmobiliaria.
                        </label>
                    </div>
                </FormSection>

                @if (_isEdit)
                {
                    <FormSection Num="5" Title="Estado" Sub="Un cliente inactivo no aparece disponible para nuevas operaciones">
                        <div class="cl-seg" role="tablist">
                            <button class="@(_estado == "Activo" ? "active" : "")" @onclick="@(() => { _estado = "Activo"; _err = null; })">Activo</button>
                            <button class="@(_estado == "Inactivo" ? "active" : "")" @onclick="@(() => { _estado = "Inactivo"; _err = null; })">Inactivo</button>
                        </div>
                    </FormSection>
                }

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;">
                        <Icon Name="alert" Size="15" /><span>@_err</span>
                    </div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("clientes"))" OnSave="@TryConfirm"
                               SaveLabel="@(_isEdit ? "Guardar cambios" : "Registrar cliente")"
                               Busy="@_procesando" BusyLabel="Guardando..." />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Solo el <b>agente</b> registra clientes. Al vincular el cliente a una captación activa, esa captación inicia su etapa comercial.</span>
                </div>
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="users"
                       Title="@(_isEdit ? "¿Guardar cambios?" : "¿Registrar cliente interesado?")"
                       Desc="@(_isEdit ? "Se actualizarán contacto, rubro, consentimientos y estado. La identidad permanece sin cambios." : "Se creará el cliente en tu cartera. Quedará disponible para vincular a oportunidades comerciales.")"
                       ConfirmLabel="@(_isEdit ? "Guardar" : "Registrar")" CancelLabel="Revisar datos"
                       Busy="@_procesando"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">@(_isEdit ? "Cliente actualizado correctamente" : "Cliente registrado correctamente")</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public long ClienteId { get; set; }

    private bool _isEdit => ClienteId > 0;
    private string _tipo = "juridica";
    private bool _confirm;
    private bool _toast;
    private bool _procesando;

    private string _razonSocial = "";
    private string _nombreNatural = "";
    private string _tipoDoc = "R";
    private string _documento = "";
    private string _telefono = "";
    private string _correo = "";
    private string _rubro = EnumCatalog.RubrosComerciales[0];
    private bool _consentimientoContacto = true;
    private bool _consentimientoUsoDato = true;
    private string _estado = "Activo";
    private string? _err;

    private string _nombreMostrar => _tipo == "juridica" ? _razonSocial : _nombreNatural;
    private IReadOnlyList<string> Rubros => OpcionConValorActual(EnumCatalog.RubrosComerciales, _rubro);

    private bool IsStep1Complete => !string.IsNullOrEmpty(_tipo);
    private bool IsStep2Complete => _tipo == "juridica"
        ? !string.IsNullOrWhiteSpace(_razonSocial) && !string.IsNullOrWhiteSpace(_documento)
        : !string.IsNullOrWhiteSpace(_nombreNatural) && !string.IsNullOrWhiteSpace(_tipoDoc) && !string.IsNullOrWhiteSpace(_documento);
    private bool IsStep3Complete => !string.IsNullOrWhiteSpace(_telefono) && _telefono.Length == 9 && !string.IsNullOrWhiteSpace(_correo);
    private bool IsStep4Complete => !string.IsNullOrWhiteSpace(_rubro);
    private bool IsStep5Complete => !_isEdit || !string.IsNullOrEmpty(_estado);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos
    {
        get
        {
            var pasos = new List<FormStepsSidebar.Step>
            {
                new("Tipo de cliente", "Natural o jurídica", IsStep1Complete),
                new("Identificación", "Documento y nombre", IsStep2Complete),
                new("Contacto", "Teléfono y correo", IsStep3Complete),
                new("Perfil comercial", "Rubro y consentimientos", IsStep4Complete),
            };
            if (_isEdit)
            {
                pasos.Add(new FormStepsSidebar.Step("Estado", "Activo o inactivo", IsStep5Complete));
            }
            return pasos;
        }
    }

    private void SetTipo(string tipo)
    {
        if (_isEdit) return;

        _tipo = tipo;
        _tipoDoc = tipo == "juridica" ? "R" : "";
        _documento = "";
        _err = null;
    }

    private void OnTipoDocChange(string val)
    {
        _tipoDoc = val;
        _err = null;
    }

    protected override void OnParametersSet()
    {
        if (!_isEdit) return;

        var c = ClienteSvc.ById(ClienteId);
        if (c is null)
        {
            _err = "No se encontró el cliente seleccionado.";
            return;
        }

        _tipo = c.TipoPersona.Contains("natural", StringComparison.OrdinalIgnoreCase) ? "natural" : "juridica";
        _tipoDoc = string.IsNullOrWhiteSpace(c.TipoDocumento)
            ? ResolveTipoDocumento(c.TipoPersona)
            : c.TipoDocumento;
        _documento = c.NumeroDocumento;
        
        // Limpiamos el "+51" al editar para que solo se muestren los 9 dígitos en el input
        _telefono = string.IsNullOrWhiteSpace(c.Telefono) ? "" : c.Telefono.Replace("+51 ", "").Trim();
        
        _correo = c.Correo;
        _rubro = string.IsNullOrWhiteSpace(c.RubroInteres) ? _rubro : c.RubroInteres;
        _consentimientoContacto = c.ConsentimientoContacto ?? false;
        _consentimientoUsoDato = c.ConsentimientoUsoDato ?? false;
        _estado = string.IsNullOrWhiteSpace(c.Estado) ? "Activo" : c.Estado;

        if (_tipo == "juridica")
        {
            _razonSocial = c.Nombre;
            _nombreNatural = "";
        }
        else
        {
            _nombreNatural = c.Nombre;
            _razonSocial = "";
        }
    }

    private void TryConfirm()
    {
        if (_tipo == "juridica" && string.IsNullOrWhiteSpace(_razonSocial)) { _err = "La razón social es obligatoria."; return; }
        if (_tipo == "natural" && string.IsNullOrWhiteSpace(_nombreNatural)) { _err = "El nombre completo es obligatorio."; return; }
        if (_tipo == "natural" && string.IsNullOrWhiteSpace(_tipoDoc)) { _err = "Debes seleccionar un tipo de documento."; return; }
        if (string.IsNullOrWhiteSpace(_documento)) { _err = "El número de documento es obligatorio."; return; }
        
        // Nueva validación estricta de 9 dígitos para el teléfono
        if (string.IsNullOrWhiteSpace(_telefono) || _telefono.Trim().Length != 9 || !_telefono.All(char.IsDigit))
        {
            _err = "El teléfono debe contener exactamente 9 números.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_correo)) { _err = "El correo es obligatorio."; return; }

        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        if (_procesando) return;
        _confirm = false;
        try
        {
            _procesando = true;
            _err = null;
            await RenderIfAliveAsync();
            var cliente = new Models.Clientes.ClienteInteresadoDto
            {
                Id = ClienteId,
                Nombre = _nombreMostrar.Trim(),
                TipoPersona = _tipo == "juridica" ? "Persona juridica" : "Persona natural",
                TipoDocumento = _tipo == "juridica" ? "R" : _tipoDoc,
                NumeroDocumento = _documento.Trim(),
                // Se guarda en la BD con el código +51 incluido
                Telefono = $"+51 {_telefono.Trim()}",
                Correo = _correo.Trim(),
                RubroInteres = _rubro,
                Estado = _estado,
                ConsentimientoContacto = _consentimientoContacto,
                ConsentimientoUsoDato = _consentimientoUsoDato,
            };
            if (_isEdit) await ClienteSvc.ActualizarAsync(cliente, DisposedToken);
            else await ClienteSvc.AgregarAsync(cliente, DisposedToken);

            _toast = true;
            await RenderIfAliveAsync();
            await Task.Delay(300, DisposedToken);
            App.Navigate("clientes");
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception error)
        {
            _err = error.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }

    private static string ResolveTipoDocumento(string tipoPersona)
    {
        if (tipoPersona.Contains("RUC", StringComparison.OrdinalIgnoreCase)) return "R";
        if (tipoPersona.Contains("Carn", StringComparison.OrdinalIgnoreCase) || tipoPersona.Contains("extranjer", StringComparison.OrdinalIgnoreCase)) return "C";
        if (tipoPersona.Contains("Pasaporte", StringComparison.OrdinalIgnoreCase)) return "P";
        return "D";
    }

    private static IReadOnlyList<string> OpcionConValorActual(IReadOnlyList<string> opciones, string valorActual)
    {
        if (string.IsNullOrWhiteSpace(valorActual) || opciones.Contains(valorActual))
            return opciones;
        return opciones.Concat([valorActual]).ToList();
    }
}