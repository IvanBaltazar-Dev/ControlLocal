@page "/clientes"
@inject AppState App
@inject IClienteService ClienteSvc
@inject ExportacionService Exportar

<PageTitle>Clientes interesados · ControlLocal</PageTitle>

<AppShell Active="Clientes interesados" Crumbs="@(new[] { "ControlLocal", "Registro", "Clientes interesados" })"
          Title="Clientes interesados"
          Subtitle="Prospectos comerciales que registro para vincular a una captación">
    <Actions>
        @if (App.Role == Roles.Agente)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("cliente-form"))"><Icon Name="plus" Size="13" /> Registrar cliente</button>
        }
        else
        {
            <span class="cl-badge blue"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
    </Actions>
    <ChildContent>
        @if (_cargando)
        {
            <LoadingBlock Title="Cargando clientes..."
                          Subtitle="Preparando la lista de clientes interesados y sus filtros." />
        }
        else
        {
            var filtrados = Filtrados().ToList();
            var visibles = Paginador.Pagina(filtrados, ref _pagina);
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="users" Label="Clientes registrados" Value="@Todos.Count.ToString()" Tone="blue"
                        Active="true" />
            <MetricCard Icon="phone" Label="Contacto autorizado" Value="@ContactoAutorizado.ToString()" Tone="info" />
            <MetricCard Icon="lock" Label="Uso de datos autorizado" Value="@UsoDatoAutorizado.ToString()" Tone="blue" />
            <MetricCard Icon="check" Label="Activos" Value="@Activos.ToString()" Tone="green" />
        </div>
        <FilterBar Search="Buscar por nombre, razón social, documento, rubro…"
                   @bind-Value="_query" ResultCount="filtrados.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros"
                   OnExport="@(() => ExportarCsv(filtrados))">
            <FilterSelect Placeholder="Tipo de persona" Options="_tipos" @bind-Value="_tipo" />
            <FilterSelect Placeholder="Rubro comercial" Options="_rubros" @bind-Value="_rubro" />
            <FilterSelect Placeholder="Estado" Options="_estadosCli" @bind-Value="_estado" />
        </FilterBar>
        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Cliente</th><th>Documento</th><th>Teléfono</th><th>Correo</th>
                            <th>Rubro de interés</th><th>Contacto autorizado</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in visibles)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600;">@c.Nombre</div>
                                    <div class="cl-muted" style="font-size:11px;">@c.TipoPersona</div>
                                </td>
                                <td><span class="mono">@c.NumeroDocumento</span></td>
                                <td><span class="mono" style="font-size:12px;">@c.Telefono</span></td>
                                <td style="font-size:12px;color:var(--c-text-2);">@c.Correo</td>
                                <td><StatusBadge Label="@c.RubroInteres" ToneOverride="blue" Plain="true" /></td>
                                <td>@(c.ConsentimientoContacto == true ? "Sí" : "No")</td>
                                <td><StatusBadge Label="@c.Estado" /></td>
                                <td>
                                    @if (App.Role == Roles.Agente)
                                    {
                                        var acciones = c.Estado == "Activo"
                                            ? new[] { "view", "edit", "disable" }
                                            : new[] { "view", "edit", "enable" };
                                        <RowActions Items="@acciones"
                                                    DisableTitle="Desactivar cliente"
                                                    EnableTitle="Reactivar cliente"
                                                    OnView="@(() => App.Navigate($"cliente-detail/{c.Id}"))"
                                                    OnEdit="@(() => App.Navigate($"cliente-form/{c.Id}"))"
                                                    OnDisable="@(() => SolicitarDesactivar(c))"
                                                    OnEnable="@(() => SolicitarReactivar(c))" />
                                    }
                                    else
                                    {
                                        <RowActions Items="@(new[] { "view" })"
                                                    OnView="@(() => App.Navigate($"cliente-detail/{c.Id}"))" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (filtrados.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="users" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin clientes en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtrados.Count" @bind-Page="_pagina" />
        }

        <ConfirmDialog Open="_confirmDesactivar" Tone="red" Icon="lock"
                       Title="Desactivar cliente interesado"
                       Desc="@($"Estás por desactivar a {_accion?.Nombre}. No aparecerá disponible para nuevas oportunidades comerciales. Sus oportunidades en curso seguirán visibles.")"
                       ConfirmLabel="Desactivar" CancelLabel="Cancelar"
                       Busy="@_procesandoEstado"
                       OnClose="@(() => _confirmDesactivar = false)"
                       OnConfirm="@(() => EjecutarCambioEstadoAsync("Inactivo"))" />

        <ConfirmDialog Open="_confirmReactivar" Tone="green" Icon="check"
                       Title="Reactivar cliente interesado"
                       Desc="@($"Vas a reactivar a {_accion?.Nombre}. Volverá a estar disponible para asociar nuevas oportunidades.")"
                       ConfirmLabel="Reactivar" CancelLabel="Cancelar"
                       Busy="@_procesandoEstado"
                       OnClose="@(() => _confirmReactivar = false)"
                       OnConfirm="@(() => EjecutarCambioEstadoAsync("Activo"))" />

        <Toast Show="_toast" Tone="@_toastTone">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    private string _query = "", _tipo = "", _rubro = "", _estado = "";
    private int _pagina = 1;
    private bool _cargando = true;

    private IReadOnlyList<ClienteInteresadoDto> Todos = new List<ClienteInteresadoDto>();

    // Recarga fresca al volver del formulario y muestra lo más reciente primero (id desc),
    // así el cliente recién registrado aparece al inicio de la lista.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Todos = (await ClienteSvc.RefrescarAsync()).OrderByDescending(c => c.Id).ToList();
        }
        finally
        {
            _cargando = false;
        }
    }

    private int ContactoAutorizado => Todos.Count(c => c.ConsentimientoContacto == true);
    private int UsoDatoAutorizado => Todos.Count(c => c.ConsentimientoUsoDato == true);
    private int Activos => Todos.Count(c => c.Estado == "Activo");

    private readonly IReadOnlyList<string> _tipos = new[] { "Natural", "Jurídica" };
    private readonly IReadOnlyList<string> _estadosCli = new[] { "Activo", "Inactivo" };
    private IReadOnlyList<string> _rubros => Todos.Select(c => c.RubroInteres)
        .Where(r => !string.IsNullOrWhiteSpace(r)).Distinct().OrderBy(x => x).ToList();

    private bool HayFiltros => new[] { _query, _tipo, _rubro, _estado }.Any(s => !string.IsNullOrEmpty(s));

    private void LimpiarFiltros() { _query = _tipo = _rubro = _estado = ""; _pagina = 1; }

    private async Task ExportarCsv(IReadOnlyList<ClienteInteresadoDto> filtrados)
    {
        await Exportar.DescargarCsvAsync("clientes_interesados",
            new[] { "Cliente", "Tipo de persona", "Documento", "Teléfono", "Correo", "Rubro de interés", "Contacto autorizado", "Uso de datos autorizado", "Estado" },
            filtrados.Select(c => (IReadOnlyList<string?>)new[]
            {
                c.Nombre, c.TipoPersona, c.NumeroDocumento, c.Telefono, c.Correo, c.RubroInteres,
                c.ConsentimientoContacto == true ? "Sí" : "No",
                c.ConsentimientoUsoDato == true ? "Sí" : "No", c.Estado,
            }));
    }

    private IEnumerable<ClienteInteresadoDto> Filtrados() => Todos.Where(c =>
        TextoFiltro.Contiene(c.TipoPersona, _tipo) &&
        (string.IsNullOrEmpty(_rubro) || c.RubroInteres == _rubro) &&
        (string.IsNullOrEmpty(_estado) || c.Estado == _estado) &&
        (string.IsNullOrEmpty(_query) || Coincide(c, _query)));

    private static bool Coincide(ClienteInteresadoDto c, string q) =>
        TextoFiltro.Contiene(c.Nombre, q)
        || TextoFiltro.Contiene(c.NumeroDocumento, q)
        || TextoFiltro.Contiene(c.RubroInteres, q);

    private ClienteInteresadoDto? _accion;
    private bool _confirmDesactivar;
    private bool _confirmReactivar;
    private bool _procesandoEstado;
    private bool _toast;
    private string _toastTone = "green";
    private string _toastMsg = "";

    private void SolicitarDesactivar(ClienteInteresadoDto cliente)
    {
        _accion = cliente;
        _confirmDesactivar = true;
    }

    private void SolicitarReactivar(ClienteInteresadoDto cliente)
    {
        _accion = cliente;
        _confirmReactivar = true;
    }

    private async Task EjecutarCambioEstadoAsync(string nuevoEstado)
    {
        if (_accion is null || _procesandoEstado) return;
        var objetivo = _accion;
        _procesandoEstado = true;
        try
        {
            StateHasChanged();
            var dto = ClonarConEstado(objetivo, nuevoEstado);
            await ClienteSvc.ActualizarAsync(dto);

            _toastMsg = nuevoEstado == "Activo"
                ? $"Cliente {objetivo.Nombre} reactivado correctamente."
                : $"Cliente {objetivo.Nombre} desactivado correctamente.";
            _toastTone = nuevoEstado == "Activo" ? "green" : "blue";
            _toast = true;

            Todos = await ClienteSvc.RefrescarAsync();
        }
        catch (Exception ex)
        {
            _toastMsg = $"No se pudo cambiar el estado: {ex.Message}";
            _toastTone = "red";
            _toast = true;
        }
        finally
        {
            _procesandoEstado = false;
            _confirmDesactivar = false;
            _confirmReactivar = false;
            _accion = null;
            StateHasChanged();
            _ = OcultarToastAsync();
        }
    }

    private async Task OcultarToastAsync()
    {
        await Task.Delay(2800);
        _toast = false;
        await InvokeAsync(StateHasChanged);
    }

    private static ClienteInteresadoDto ClonarConEstado(ClienteInteresadoDto origen, string estado) => new()
    {
        Id = origen.Id,
        Nombre = origen.Nombre,
        TipoPersona = origen.TipoPersona,
        TipoDocumento = origen.TipoDocumento,
        NumeroDocumento = origen.NumeroDocumento,
        Telefono = origen.Telefono,
        Correo = origen.Correo,
        RubroInteres = origen.RubroInteres,
        Estado = estado,
        ConsentimientoContacto = origen.ConsentimientoContacto,
        ConsentimientoUsoDato = origen.ConsentimientoUsoDato,
        FechaCreacion = origen.FechaCreacion,
    };
}
