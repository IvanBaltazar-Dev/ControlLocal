@page "/dashboard"
@inherits SafeComponentBase
@using QuestPDF.Fluent
@inject AppState App
@inject IIndicadorService Indicadores
@inject ICaptacionService CaptacionSvc
@inject ExportacionService Exportar

<PageTitle>@Title · ControlLocal</PageTitle>

<AppShell Active="@SideActive" Crumbs="@(new[] { "ControlLocal", Title })">
    <ChildContent>
        @* ---------- Hero premium diferenciado por rol ---------- *@
        <div class="cl-hero cl-dash-hero @RoleClass">
            <div class="cl-hero-top">
                <div style="min-width:0;">
                    <div class="cl-hero-eyebrow"><Icon Name="@HeroIcon" Size="13" /> @HeroEyebrow</div>
                    <div class="cl-hero-title">@Title</div>
                    <div class="cl-hero-sub">@Subtitle</div>
                </div>
                <div class="cl-hero-actions">
                    <button class="cl-btn on-dark" disabled="@_exportando" @onclick="ExportarPdf">
                        <Icon Name="download" Size="13" /> @(_exportando ? "Generando…" : "Exportar PDF")
                    </button>
                    @if (IsAdmin)
                    {
                        <button class="cl-btn on-light" @onclick="@(() => App.Navigate("brokers"))"><Icon Name="briefcase" Size="13" /> Gestión de brokers</button>
                    }
                    else if (IsBroker)
                    {
                        <button class="cl-btn on-light" @onclick="@(() => App.Navigate("bandeja-captaciones"))"><Icon Name="pin" Size="13" /> Bandeja de captaciones</button>
                    }
                    else
                    {
                        <button class="cl-btn on-light" @onclick="@(() => App.Navigate("captacion-form"))"><Icon Name="plus" Size="13" /> Nueva captación</button>
                    }
                </div>
            </div>

            @if (!_cargando)
            {
                <div class="cl-hero-stats">
                    @if (IsAdmin)
                    {
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("brokers"))">
                            <div class="cl-hero-stat-k">Brokers activos</div><div class="cl-hero-stat-v">@_ind.BrokersActivos</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("agents"))">
                            <div class="cl-hero-stat-k">Agentes activos</div><div class="cl-hero-stat-v">@_ind.AgentesActivos</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Captaciones activas</div><div class="cl-hero-stat-v">@_ind.CaptacionesActivas</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Operaciones activas</div><div class="cl-hero-stat-v">@_ind.OportunidadesActivas</div>
                        </div>
                    }
                    else if (IsBroker)
                    {
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("bandeja-captaciones"))">
                            <div class="cl-hero-stat-k">Captaciones por revisar</div><div class="cl-hero-stat-v">@_ind.CaptacionesPorRevisar</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("solicitudes"))">
                            <div class="cl-hero-stat-k">Solicitudes por evaluar</div><div class="cl-hero-stat-v">@_ind.SolicitudesPorEvaluar</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Operaciones activas</div><div class="cl-hero-stat-v">@_ind.OportunidadesActivas</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Cierres del equipo</div><div class="cl-hero-stat-v">@_ind.Cierres</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("propiedades-equipo"))">
                            <div class="cl-hero-stat-k">Propiedades del equipo</div><div class="cl-hero-stat-v">@_propiedadesEquipo</div>
                            <div class="cl-hero-stat-foot">Inmuebles captados · ver detalle</div>
                        </div>
                    }
                    else
                    {
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("captaciones"))">
                            <div class="cl-hero-stat-k">Mis captaciones</div><div class="cl-hero-stat-v">@_ind.CaptacionesTotales</div>
                            <div class="cl-hero-stat-foot">@_ind.CaptacionesActivas activas · @_ind.CaptacionesObservadas observadas</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("oportunidades"))">
                            <div class="cl-hero-stat-k">Operaciones</div><div class="cl-hero-stat-v">@_ind.OportunidadesActivas</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("visitas"))">
                            <div class="cl-hero-stat-k">Visitas</div><div class="cl-hero-stat-v">@_ind.Visitas</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("interacciones"))">
                            <div class="cl-hero-stat-k">Interacciones</div><div class="cl-hero-stat-v">@_ind.Interacciones</div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (_cargando)
        {
            <div class="cl-card"><div class="cl-card-body" style="padding:40px;text-align:center;color:#7E8794;">Cargando indicadores…</div></div>
        }
        else
        {

            @* ---------- Vista OPERATIVA ("ahora"): estado actual + acciones. Las
               tendencias históricas, el embudo y los comparativos viven en Reportes. ---------- *@
            <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;">
                <div class="cl-card">
                    <div class="cl-card-head">
                        <div>
                            <div class="cl-card-title">Pipeline actual</div>
                            <div class="cl-card-sub">Estado de las captaciones por etapa, ahora mismo</div>
                        </div>
                    </div>
                    <div class="cl-card-body" style="display:flex;gap:16px;align-items:center;">
                        <DonutChart Segments="_donut" />
                        <div style="flex:1;font-size:12px;">
                            @for (var i = 0; i < _ind.Etapas.Count; i++)
                            {
                                var etapa = _ind.Etapas[i];
                                <div style="display:flex;align-items:center;gap:8px;padding:5px 0;">
                                    <span style="width:9px;height:9px;border-radius:2px;background:@ColoresEstado.PorEtapa(etapa.Nombre, i);"></span>
                                    <span style="flex:1;">@etapa.Nombre</span>
                                    <b>@etapa.Valor</b>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">@(IsAdmin || IsBroker ? "Carga del equipo" : "Mi rendimiento")</div></div>
                    @if (IsAdmin || IsBroker)
                    {
                        @* Foto operativa: quién carga cuántas captaciones/cierres ahora (sin la
                           conversión histórica, que se analiza en Reportes). *@
                        <div class="cl-card-body" style="padding:0;">
                            @if (_ind.Desempeno.Count == 0)
                            {
                                <div style="padding:24px;text-align:center;color:#7E8794;font-size:12.5px;">Sin actividad registrada todavía.</div>
                            }
                            else
                            {
                                <table class="cl-table">
                                    <thead><tr><th>@(IsAdmin ? "Broker" : "Agente")</th><th>Captac.</th><th>Cierres</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in _ind.Desempeno)
                                        {
                                            <tr>
                                                <td><div class="cl-flex"><span class="cl-avatar" style="width:24px;height:24px;font-size:10px;">@Initials(d.Nombre)</span>@d.Nombre</div></td>
                                                <td><b>@d.Captaciones</b></td><td>@d.Cierres</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                    else
                    {
                        @* Panel personal del agente: su propia conversión + KPIs (la tabla comparativa
                           no tiene sentido cuando solo se ve a sí mismo). *@
                        <div class="cl-perf">
                            <div>
                                <div class="cl-perf-top">
                                    <span class="cl-perf-big">@MiConversion%</span>
                                    <span class="cl-perf-cap">de conversión<br />captación → cierre</span>
                                </div>
                                <div class="cl-perf-bar" style="margin-top:12px;"><i style="width:@(Math.Clamp(MiConversion, 0, 100))%;"></i></div>
                            </div>
                            <div class="cl-perf-grid">
                                <div class="cl-perf-cell"><div class="k">Captaciones</div><div class="v">@_ind.CaptacionesTotales</div></div>
                                <div class="cl-perf-cell"><div class="k">Cierres</div><div class="v">@_ind.Cierres</div></div>
                                <div class="cl-perf-cell"><div class="k">Operaciones</div><div class="v">@_ind.OportunidadesActivas</div></div>
                            </div>
                            <div class="cl-muted" style="font-size:11.5px;">
                                @(_ind.Cierres == 0
                                    ? "Aún sin cierres registrados. Cada visita y solicitud te acerca al primero."
                                    : $"Llevas {_ind.Cierres} cierre(s) sobre {_ind.CaptacionesTotales} captación(es).")
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (IsAdmin || IsBroker)
            {
                <div class="cl-alert blue" style="margin-top:14px;">
                    <Icon Name="activity" Size="15" />
                    <span>Las <b>tendencias históricas</b>, el embudo de conversión y los comparativos de desempeño están en Reportes.</span>
                    <button class="cl-btn sm" style="margin-left:auto;" @onclick="@(() => App.Navigate("reportes"))">Ver reportes <Icon Name="arrowRight" Size="12" /></button>
                </div>
            }
        }
    </ChildContent>
</AppShell>

@code {
    private bool IsAdmin => App.Role == Roles.Admin;
    private bool IsBroker => App.Role == Roles.Broker;
    private bool _cargando = true;
    private bool _exportando;
    private IndicadoresDto _ind = IndicadoresDto.Vacio;
    // Propiedades (inmuebles distintos) captadas por el equipo del broker.
    private int _propiedadesEquipo;

    // Identidad visual del hero por rol.
    private string RoleClass => IsAdmin ? "admin" : IsBroker ? "broker" : "agente";
    private string HeroIcon => IsAdmin ? "briefcase" : IsBroker ? "users" : "activity";
    private string HeroEyebrow => IsAdmin ? "Corredora · visión global" : IsBroker ? "Equipo · supervisión" : "Mi actividad comercial";

    // Conversión propia del agente (su fila de desempeño, o derivada de cierres/captaciones).
    private int MiConversion => _ind.Desempeno.FirstOrDefault()?.Conversion
        ?? (_ind.CaptacionesTotales > 0 ? (int)Math.Round(_ind.Cierres * 100.0 / _ind.CaptacionesTotales) : 0);

    private string Title => IsAdmin ? "Panel administrativo global" : IsBroker ? "Panel del broker" : $"Buen día, {Nombre}";

    private string Nombre => App.CurrentUser?.Nombre?.Split(' ').FirstOrDefault() ?? "agente";

    private string Subtitle => IsAdmin
        ? "Gestión de brokers, auditoría e indicadores de toda la corredora"
        : IsBroker
            ? "Supervisión de los agentes a tu cargo · revisión de captaciones y solicitudes"
            : "Tu actividad comercial real";

    private string SideActive => IsAdmin ? "Dashboard global" : IsBroker ? "Dashboard de equipo" : "Dashboard";

    private double[] Cierres => _ind.CierresPorMes.Select(v => (double)v).ToArray();
    private string[] Meses => _ind.MesesEtiquetas.ToArray();

    private DonutChart.Segment[] _donut => _ind.Etapas
        .Select((e, i) => new DonutChart.Segment(e.Valor, ColoresEstado.PorEtapa(e.Nombre, i)))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ind = await Indicadores.ObtenerAsync(DisposedToken);

            // El broker ve el total de propiedades (inmuebles distintos) captadas por su equipo.
            if (IsBroker)
            {
                var caps = await CaptacionSvc.RefrescarAsync(DisposedToken);
                _propiedadesEquipo = caps
                    .Select(c => c.LocalId > 0 ? c.LocalId : (long)(c.DireccionLocal ?? "").GetHashCode())
                    .Distinct().Count();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _cargando = false;
        }
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));

    private static string ConvTone(int pct) => pct >= 22 ? "green" : pct >= 18 ? "blue" : "red";

    private async Task ExportarPdf()
    {
        if (_exportando) return;
        try
        {
            _exportando = true;
            var datos = ReporteIndicadores.Desde(_ind, IsAdmin);
            var titulo = IsAdmin ? "Panel administrativo · últimos 6 meses"
                : IsBroker ? "Panel del broker · últimos 6 meses" : "Mi actividad · últimos 6 meses";
            var pdf = new ReporteIndicadoresDocument(datos, titulo).GeneratePdf();
            await Exportar.DescargarPdfAsync(IsAdmin ? "panel_administrativo" : IsBroker ? "panel_broker" : "panel_agente", pdf);
        }
        finally
        {
            _exportando = false;
        }
    }
}
