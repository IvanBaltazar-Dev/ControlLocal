@page "/dashboard"
@inherits SafeComponentBase
@inject AppState App
@inject IIndicadorService Indicadores
@inject ITareaService TareaSvc

<PageTitle>@Title · ControlLocal</PageTitle>

<AppShell Active="@SideActive" Crumbs="@(new[] { "ControlLocal", Title })">
    <ChildContent>
        @* ---------- Hero premium diferenciado por rol ---------- *@
        <div class="cl-hero cl-dash-hero @RoleClass">
            <div class="cl-hero-top">
                <div style="min-width:0;">
                    <div class="cl-hero-eyebrow"><Icon Name="@HeroIcon" Size="13" /> @HeroEyebrow</div>
                    <div class="cl-hero-title">@Title</div>
                    <div class="cl-hero-sub">@Subtitle</div>
                </div>
                <div class="cl-hero-actions">
                    @if (IsAdmin)
                    {
                        <button class="cl-btn on-light" @onclick="@(() => App.Navigate("brokers"))"><Icon Name="briefcase" Size="13" /> Gestión de brokers</button>
                    }
                    else if (IsBroker)
                    {
                        <button class="cl-btn on-light" @onclick="@(() => App.Navigate("bandeja-captaciones"))"><Icon Name="pin" Size="13" /> Bandeja de captaciones</button>
                    }
                    else
                    {
                        <button class="cl-btn on-light" @onclick="@(() => App.Navigate("captacion-form"))"><Icon Name="plus" Size="13" /> Nueva captación</button>
                    }
                </div>
            </div>

            @if (!_cargando)
            {
                <div class="cl-hero-stats">
                    @if (IsAdmin)
                    {
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("brokers"))">
                            <div class="cl-hero-stat-k">Brokers activos</div><div class="cl-hero-stat-v">@_ind.BrokersActivos</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("reasignar"))">
                            <div class="cl-hero-stat-k">Agentes activos</div><div class="cl-hero-stat-v">@_ind.AgentesActivos</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Captaciones activas</div><div class="cl-hero-stat-v">@_ind.CaptacionesActivas</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Operaciones activas</div><div class="cl-hero-stat-v">@_ind.OportunidadesActivas</div>
                        </div>
                    }
                    else if (IsBroker)
                    {
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("bandeja-captaciones"))">
                            <div class="cl-hero-stat-k">Captaciones por revisar</div><div class="cl-hero-stat-v">@_ind.CaptacionesPorRevisar</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("solicitudes-revisar"))">
                            <div class="cl-hero-stat-k">Solicitudes por revisar</div><div class="cl-hero-stat-v">@_ind.SolicitudesPorEvaluar</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Operaciones activas</div><div class="cl-hero-stat-v">@_ind.OportunidadesActivas</div>
                        </div>
                        <div class="cl-hero-stat">
                            <div class="cl-hero-stat-k">Cierres del equipo</div><div class="cl-hero-stat-v">@_ind.Cierres</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("propiedades-equipo"))">
                            <div class="cl-hero-stat-k">Propiedades del equipo</div><div class="cl-hero-stat-v">@_propiedadesEquipo</div>
                            <div class="cl-hero-stat-foot">Inmuebles captados · ver detalle</div>
                        </div>
                    }
                    else
                    {
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("captaciones"))">
                            <div class="cl-hero-stat-k">Mis captaciones</div><div class="cl-hero-stat-v">@_ind.CaptacionesTotales</div>
                            <div class="cl-hero-stat-foot">@_ind.CaptacionesActivas activas · @_ind.CaptacionesObservadas observadas</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("oportunidades"))">
                            <div class="cl-hero-stat-k">Operaciones</div><div class="cl-hero-stat-v">@_ind.OportunidadesActivas</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("visitas"))">
                            <div class="cl-hero-stat-k">Visitas</div><div class="cl-hero-stat-v">@_ind.Visitas</div>
                        </div>
                        <div class="cl-hero-stat clickable" @onclick="@(() => App.Navigate("interacciones"))">
                            <div class="cl-hero-stat-k">Interacciones</div><div class="cl-hero-stat-v">@_ind.Interacciones</div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (_cargando)
        {
            <div class="cl-card"><div class="cl-card-body" style="padding:40px;text-align:center;color:#7E8794;">Cargando indicadores…</div></div>
        }
        else
        {
            @* ---------- Vista OPERATIVA ("ahora"): estado actual + acciones. Las
               tendencias históricas, el embudo y los comparativos viven en Reportes. ---------- *@
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;margin-bottom:14px;">
                <div class="cl-card">
                    <div class="cl-card-head">
                        <div>
                            <div class="cl-card-title">@WorkTitle</div>
                            <div class="cl-card-sub">@WorkSubtitle</div>
                        </div>
                        @if (!IsAdmin && !IsBroker && _bandejaTotal > 5)
                        {
                            <button class="cl-btn sm" @onclick="AbrirBandejaCompletaAsync">Ver todas (@_bandejaTotal)</button>
                        }
                    </div>
                    <div class="cl-card-body">
                        @if (!IsAdmin && !IsBroker)
                        {
                            @if (_bandejaCargando)
                            {
                                <div style="padding:22px;text-align:center;color:#7E8794;font-size:12.5px;">Cargando tus acciones pendientes…</div>
                            }
                            else if (_bandejaError)
                            {
                                <div style="padding:22px;text-align:center;color:#5B6472;">
                                    <div style="font-weight:700;font-size:14px;color:#B91C1C;">No se pudo cargar tu bandeja</div>
                                    <div style="font-size:12px;margin:4px 0 12px;">El servicio tardó demasiado en responder. Tus indicadores de seguimiento sí cargaron; reintenta para ver tus acciones pendientes.</div>
                                    <button class="cl-btn sm primary" @onclick="ReintentarBandejaAsync"><Icon Name="refresh" Size="12" /> Reintentar</button>
                                </div>
                            }
                            else
                            {
                                <BandejaAcciones Tareas="_topBandeja" OnCancelar="CancelarTareaAsync" />
                            }
                        }
                        else if (PrioridadesDashboard.Count == 0)
                        {
                            <div style="padding:26px;text-align:center;color:#5B6472;">
                                <div style="font-weight:700;font-size:14px;color:var(--c-text);">@(IsAdmin ? "Sin focos de auditoria en este momento" : "Sin bloqueos criticos en este momento")</div>
                                <div style="font-size:12px;margin-top:4px;">@(IsAdmin ? "La lectura global no muestra desviaciones urgentes para revisar." : "El equipo no tiene focos vencidos ni aprobaciones pendientes dentro del tablero operativo.")</div>
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;flex-direction:column;gap:8px;">
                                @foreach (var p in PrioridadesDashboard)
                                {
                                    <div style="display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--c-border);border-radius:10px;background:linear-gradient(180deg,#fff,#F8FAFD);">
                                        <span class="cl-badge @p.Tone" style="flex:0 0 auto;">@p.Valor</span>
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-weight:650;">@p.Titulo</div>
                                            <div class="cl-flex cl-muted" style="font-size:12px;gap:8px;flex-wrap:wrap;">
                                                <span>@p.Descripcion</span>
                                                <span>· @p.DiasTexto</span>
                                                <span class="cl-badge gray" style="font-size:11px;">@p.Vencimiento</span>
                                            </div>
                                        </div>
                                        <button class="cl-btn sm primary" @onclick="@(() => App.Navigate(p.Ruta))"><Icon Name="arrowDownRight" Size="12" /> @(IsAdmin ? "Revisar" : "Resolver")</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head">
                        <div>
                            <div class="cl-card-title">@DecisionTitle</div>
                            <div class="cl-card-sub">@DecisionSubtitle</div>
                        </div>
                    </div>
                    <div class="cl-card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        @foreach (var s in SenalesDashboard)
                        {
                            <MetricCard Icon="@s.Icon" Label="@s.Label" Value="@s.Value" Tone="@s.Tone" Footer="@s.Footer" />
                        }
                    </div>
                </div>
            </div>

            @if (!IsAdmin && !IsBroker)
            {
                <Modal Open="_verTodas" Icon="checkCircle"
                       Title="Tus acciones pendientes"
                       Desc="Todo lo que requiere tu atención, priorizado."
                       OnClose="@(() => _verTodas = false)">
                    <ChildContent>
                        <BandejaAcciones Tareas="_bandeja" OnCancelar="CancelarTareaAsync" />
                    </ChildContent>
                </Modal>
            }

            <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;">
                <div class="cl-card">
                    <div class="cl-card-head">
                        <div>
                            <div class="cl-card-title">Salud de captaciones</div>
                            <div class="cl-card-sub">En qué punto del proceso está cada captación</div>
                        </div>
                    </div>
                    <div class="cl-card-body" style="display:flex;gap:18px;align-items:center;">
                        <DonutChart Segments="SaludSegmentos" Size="140" Thickness="22"
                                    CenterValue="@($"{PctActivasSalud}%")" CenterLabel="activas" />
                        <div style="flex:1;font-size:12px;">
                            @for (var i = 0; i < CaptacionesSalud.Count; i++)
                            {
                                var etapa = CaptacionesSalud[i];
                                <div style="display:flex;align-items:center;gap:8px;padding:5px 0;">
                                    <span style="width:10px;height:10px;border-radius:3px;background:@ColoresEstado.PorIndiceSaludCaptacion(i);"></span>
                                    <span style="flex:1;">@etapa.Nombre</span>
                                    <b>@etapa.Valor</b>
                                    <span class="cl-muted" style="min-width:38px;text-align:right;">@PctSalud(etapa.Valor)%</span>
                                </div>
                            }
                            <div style="display:flex;align-items:center;gap:8px;margin-top:6px;padding-top:8px;border-top:1px solid var(--c-border);">
                                <span style="flex:1;color:#515B6B;">Total captaciones</span>
                                <b style="color:#243043;">@TotalSalud</b>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">@(IsAdmin || IsBroker ? "Carga del equipo" : "Mi rendimiento")</div></div>
                    @if (IsAdmin || IsBroker)
                    {
                        @* Foto operativa: quién carga cuántas captaciones/cierres ahora (sin la
                           conversión histórica, que se analiza en Reportes). *@
                        <div class="cl-card-body" style="padding:0;">
                            @if (_ind.Desempeno.Count == 0)
                            {
                                <div style="padding:24px;text-align:center;color:#7E8794;font-size:12.5px;">Sin actividad registrada todavía.</div>
                            }
                            else
                            {
                                <table class="cl-table">
                                    <thead><tr><th>@(IsAdmin ? "Broker" : "Agente")</th><th>Captac.</th><th>Cierres</th></tr></thead>
                                    <tbody>
                                        @foreach (var d in DesempenoVisible)
                                        {
                                            <tr>
                                                <td><div class="cl-flex"><span class="cl-avatar" style="width:24px;height:24px;font-size:10px;">@Initials(d.Nombre)</span>@d.Nombre</div></td>
                                                <td><b>@d.Captaciones</b></td><td>@d.Cierres</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (_ind.Desempeno.Count > DesempenoPageSize)
                                {
                                    <div style="padding:0 12px 12px;">
                                        <Pagination Total="_ind.Desempeno.Count" PageSize="DesempenoPageSize" @bind-Page="_desempenoPage" />
                                    </div>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        @* Panel personal del agente: su propia conversión + KPIs (la tabla comparativa
                           no tiene sentido cuando solo se ve a sí mismo). *@
                        <div class="cl-perf">
                            <div>
                                <div class="cl-perf-top">
                                    <span class="cl-perf-big">@MiConversion%</span>
                                    <span class="cl-perf-cap">de conversión<br />captación → cierre</span>
                                </div>
                                <div class="cl-perf-bar" style="margin-top:12px;"><i style="width:@(Math.Clamp(MiConversion, 0, 100))%;"></i></div>
                            </div>
                            <div class="cl-perf-grid">
                                <div class="cl-perf-cell"><div class="k">Captaciones</div><div class="v">@_ind.CaptacionesTotales</div></div>
                                <div class="cl-perf-cell"><div class="k">Cierres</div><div class="v">@_ind.Cierres</div></div>
                                <div class="cl-perf-cell"><div class="k">Operaciones</div><div class="v">@_ind.OportunidadesActivas</div></div>
                            </div>
                            <div class="cl-muted" style="font-size:11.5px;">
                                @(_ind.Cierres == 0
                                    ? "Aún sin cierres registrados. Cada visita y solicitud te acerca al primero."
                                    : $"Llevas {_ind.Cierres} cierre(s) sobre {_ind.CaptacionesTotales} captación(es).")
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (IsAdmin || IsBroker)
            {
                <div class="cl-alert blue" style="margin-top:14px;">
                    <Icon Name="activity" Size="15" />
                    <span>Las <b>tendencias históricas</b>, el embudo de conversión y los comparativos de desempeño están en Reportes.</span>
                    <button class="cl-btn sm" style="margin-left:auto;" @onclick="@(() => App.Navigate("reportes"))">Ver reportes <Icon Name="arrowRight" Size="12" /></button>
                </div>
            }

        }
    </ChildContent>
</AppShell>

@code {
    private bool IsAdmin => App.Role == Roles.Admin;
    private bool IsBroker => App.Role == Roles.Broker;
    private bool _cargando = true;
    private IndicadoresDto _ind = IndicadoresDto.Vacio;
    // Propiedades (inmuebles distintos) captadas por el equipo del broker.
    private int _propiedadesEquipo;

    // Bandeja de acciones del agente (Etapa 5): superficie principal, alimentada por el motor abstracto.
    private IReadOnlyList<TareaDto> _bandeja = [];
    private IReadOnlyList<TareaDto> _topBandeja => _bandeja.Take(5).ToList();
    private int _bandejaTotal;
    private bool _verTodas;
    // Distingue "bandeja vacia confirmada" de "no se pudo cargar /tareas": si la carga falla
    // (timeout/red), NO se pinta "¡Todo al dia!" sino un estado de error con reintento.
    private bool _bandejaError;
    // La bandeja carga aparte del resto del dashboard (su panel mas lento no bloquea el tablero).
    private bool _bandejaCargando;
    private const int DesempenoPageSize = 5;
    private int _desempenoPage = 1;
    private IReadOnlyList<IndicadorDesempenoDto> DesempenoVisible =>
        Paginador.Pagina(_ind.Desempeno, ref _desempenoPage, DesempenoPageSize);

    // Identidad visual del hero por rol.
    private string RoleClass => IsAdmin ? "admin" : IsBroker ? "broker" : "agente";
    private string HeroIcon => IsAdmin ? "briefcase" : IsBroker ? "users" : "activity";
    private string HeroEyebrow => IsAdmin ? "Corredora · visión global" : IsBroker ? "Equipo · supervisión" : "Mi actividad comercial";

    // Conversión propia del agente por COHORTE (captaciones del periodo que ya cerraron): el
    // backend ya entrega el % correcto (<=100). Si no llegó, cae a la fila de desempeño.
    private int MiConversion => _ind.ConversionPropia > 0
        ? _ind.ConversionPropia
        : (_ind.Desempeno.FirstOrDefault()?.Conversion ?? 0);

    private IndicadorOperativoDto Op => _ind.Operativo ?? IndicadorOperativoDto.Vacio;

    private string Title => IsAdmin ? "Panel administrativo global" : IsBroker ? "Panel del broker" : $"Buen día, {Nombre}";

    private string Nombre => App.CurrentUser?.Nombre?.Split(' ').FirstOrDefault() ?? "agente";

    private string Subtitle => IsAdmin
        ? "Gestión de brokers, auditoría e indicadores de toda la corredora"
        : IsBroker
            ? "Supervisión de los agentes a tu cargo · revisión de captaciones y solicitudes"
            : "Tu actividad comercial real";

    private string SideActive => IsAdmin ? "Dashboard global" : IsBroker ? "Dashboard de equipo" : "Dashboard";

    private string WorkTitle => IsAdmin
        ? "Panel de auditoria"
        : IsBroker
            ? "Centro de control del equipo"
            : "Tu bandeja de trabajo";

    private string WorkSubtitle => IsAdmin
        ? "Lectura de carga, seguimiento y cierres sin cambiar estados"
        : IsBroker
            ? "Aprobaciones, cierres y seguimiento vencido ordenados por urgencia"
            : "Máximo cinco operaciones priorizadas con vencimiento y días sin acción";

    private string DecisionTitle => IsAdmin
        ? "Lectura estratégica"
        : IsBroker
            ? "Salud del equipo"
            : "Disciplina comercial";

    private string DecisionSubtitle => IsAdmin
        ? "Señales para decidir dónde intervenir"
        : IsBroker
            ? "Riesgo operativo y conversión del equipo"
            : "Señales propias para cuidar seguimiento y cierres";

    private IReadOnlyList<DashboardPriority> PrioridadesDashboard
    {
        get
        {
            var items = new List<DashboardPriority>();
            if (IsAdmin)
            {
                AgregarPrioridad(items, Op.RecontactosVencidos, "Seguimiento comercial en riesgo",
                    "Audita recontactos vencidos y equipos con demora", "seguimiento-comercial", "red", "auditoria", Op.DiasPromedioSinSeguimiento, 96);
                AgregarPrioridad(items, Op.SolicitudesSinCierre, "Cierres pendientes de formalizacion",
                    "Solicitudes aprobadas que aun no generan contrato", "propiedades-alquiladas", "amber", "control", Op.DiasPromedioSinSeguimiento, 90);
                AgregarPrioridad(items, _ind.Cierres, "Cierres registrados",
                    "Revisa alquileres formalizados y comisiones brutas", "reportes", "green", "analisis", 0, 78);
                AgregarPrioridad(items, _ind.AgentesActivos, "Carga de agentes",
                    "Supervisa asignaciones y cobertura por broker", "reasignar", "blue", "gestion", 0, 72);
                AgregarPrioridad(items, _ind.BrokersActivos, "Brokers activos",
                    "Gestiona responsables y estructura de supervision", "brokers", "blue", "gestion", 0, 70);
            }
            else if (IsBroker)
            {
                AgregarPrioridad(items, _ind.SolicitudesPorEvaluar, "Solicitudes por revisar",
                    "Revision comercial pendiente", "solicitudes-revisar", "red", "vence hoy", 0, 100);
                AgregarPrioridad(items, _ind.CaptacionesPorRevisar, "Captaciones por revisar",
                    "Expedientes esperando decisión", "bandeja-captaciones", "amber", "vence hoy", 0, 92);
                AgregarPrioridad(items, Op.SolicitudesSinCierre, "Solicitudes aprobadas sin cierre",
                    "Ingreso comprometido sin contrato cerrado", "solicitudes", "amber", "en riesgo", Op.DiasPromedioSinSeguimiento, 86);
                AgregarPrioridad(items, Op.RecontactosVencidos, "Recontactos vencidos",
                    "Propietarios o clientes sin seguimiento a tiempo", "seguimiento-comercial", "red", "vencido", Op.DiasPromedioSinSeguimiento, 84);
                AgregarPrioridad(items, Op.VisitasPendientes, "Visitas pendientes",
                    "Visitas próximas o vencidas que necesitan resultado", "visitas", "blue", "próximo", 0, 72);
            }
            return items
                .OrderByDescending(i => i.Score)
                .ThenByDescending(i => i.ValorNumero)
                .Take(5)
                .ToList();
        }
    }

    private IReadOnlyList<DashboardSignal> SenalesDashboard
    {
        get
        {
            if (IsAdmin)
            {
                return
                [
                    new("alert", "Recontactos vencidos", Op.RecontactosVencidos.ToString(), Op.RecontactosVencidos > 0 ? "red" : "green", "riesgo de enfriamiento"),
                    new("fileText", "Sin cierre", Op.SolicitudesSinCierre.ToString(), Op.SolicitudesSinCierre > 0 ? "amber" : "green", "solicitudes aprobadas"),
                    new("target", "Conversión prosp. → capt.", $"{Op.ConversionProspeccionCaptacion}%", ConvTone(Op.ConversionProspeccionCaptacion), "captación de inventario"),
                    new("users", "Equipo activo", _ind.AgentesActivos.ToString(), "blue", $"{_ind.BrokersActivos} brokers"),
                ];
            }
            if (IsBroker)
            {
                return
                [
                    new("pin", "Por revisar", _ind.CaptacionesPorRevisar.ToString(), _ind.CaptacionesPorRevisar > 0 ? "amber" : "green", "captaciones del equipo"),
                    new("fileText", "Por revisar", _ind.SolicitudesPorEvaluar.ToString(), _ind.SolicitudesPorEvaluar > 0 ? "red" : "green", "solicitudes"),
                    new("alert", "Recontactos vencidos", Op.RecontactosVencidos.ToString(), Op.RecontactosVencidos > 0 ? "red" : "green", "seguimiento del equipo"),
                    new("target", "Conversión prosp. → capt.", $"{Op.ConversionProspeccionCaptacion}%", ConvTone(Op.ConversionProspeccionCaptacion), "disciplina de captación"),
                ];
            }
            return
            [
                new("alert", "Recontactos vencidos", Op.RecontactosVencidos.ToString(), Op.RecontactosVencidos > 0 ? "red" : "green", "atiéndelos primero"),
                new("clock", "Días sin seguimiento", Op.DiasPromedioSinSeguimiento.ToString(), Op.DiasPromedioSinSeguimiento > 7 ? "amber" : "blue", "promedio vencido"),
                new("calendar", "Visitas pendientes", Op.VisitasPendientes.ToString(), "blue", "prepara o cierra resultado"),
                new("fileText", "Solicitudes sin cierre", Op.SolicitudesSinCierre.ToString(), Op.SolicitudesSinCierre > 0 ? "amber" : "green", "contrato pendiente"),
            ];
        }
    }

    private double[] Cierres => _ind.CierresPorMes.Select(v => (double)v).ToArray();
    private string[] Meses => _ind.MesesEtiquetas.ToArray();

    // Dona "Captaciones por etapa": total al centro + una porción por etapa del pipeline.
    private IReadOnlyList<IndicadorConteoDto> CaptacionesSalud =>
        _ind.CaptacionesSalud.Count > 0 ? _ind.CaptacionesSalud : _ind.Etapas;

    private int TotalSalud => CaptacionesSalud.Sum(e => e.Valor);

    private int PctSalud(int valor) => TotalSalud > 0 ? (int)Math.Round(valor * 100.0 / TotalSalud) : 0;

    // % de captaciones Activas sobre el total (al centro de la dona de salud).
    private int PctActivasSalud
    {
        get
        {
            var activas = CaptacionesSalud.FirstOrDefault(
                e => e.Nombre.StartsWith("Activas", StringComparison.OrdinalIgnoreCase));
            return activas != null ? PctSalud(activas.Valor) : 0;
        }
    }

    private DonutChart.Segment[] SaludSegmentos => CaptacionesSalud
        .Select((e, i) => new DonutChart.Segment(e.Valor, ColoresEstado.PorIndiceSaludCaptacion(i)))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ind = await Indicadores.ObtenerAsync("6m", DisposedToken);
        }
        catch (OperationCanceledException) { return; }
        catch { _ind = IndicadoresDto.Vacio; }

        _cargando = false;
        _propiedadesEquipo = _ind.PropiedadesEquipo > 0 ? _ind.PropiedadesEquipo : _ind.CaptacionesActivas;

        // La bandeja del agente reconcilia tareas y puede tardar mas que los KPIs. Se carga
        // aparte para que el dashboard pinte rapido y luego rellene el panel operativo.
        if (!IsAdmin && !IsBroker)
        {
            _bandejaCargando = true;
            _ = CargarBandejaInicialAsync();
        }
        else
            _bandejaCargando = false;

        StateHasChanged();
    }

    private async Task CargarBandejaInicialAsync()
    {
        _bandejaCargando = true;
        _bandejaError = false;
        await InvokeAsync(StateHasChanged);
        try { await CargarBandejaPaginaAsync(5); }
        catch (OperationCanceledException) { }
        catch { _bandejaError = true; }
        finally
        {
            _bandejaCargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Reintenta SOLO la bandeja (el resto del dashboard ya esta pintado).
    private async Task ReintentarBandejaAsync()
    {
        _bandejaError = false;
        _bandejaCargando = true;
        try { await CargarBandejaPaginaAsync(5); }
        catch (OperationCanceledException) { }
        catch { _bandejaError = true; }
        finally { _bandejaCargando = false; }
    }

    private async Task AbrirBandejaCompletaAsync()
    {
        _verTodas = true;

        if (_bandejaTotal <= _bandeja.Count)
            return;

        _bandejaCargando = true;
        try { await CargarBandejaPaginaAsync(Math.Clamp(_bandejaTotal, 5, 100)); }
        catch (OperationCanceledException) { }
        catch { _bandejaError = true; }
        finally { _bandejaCargando = false; }
    }

    private async Task CargarBandejaPaginaAsync(int tamano)
    {
        AplicarBandeja(await TareaSvc.BandejaPaginaAsync(1, tamano, DisposedToken));
    }

    private void AplicarBandeja(PageResult<TareaDto> pagina)
    {
        _bandeja = pagina.Items;
        _bandejaTotal = (int)pagina.TotalRecords;
        _bandejaError = false;
    }

    private async Task CancelarTareaAsync(TareaDto tarea)
    {
        try
        {
            await TareaSvc.CancelarAsync(tarea.Id, DisposedToken);
            await CargarBandejaPaginaAsync(_verTodas ? Math.Clamp(_bandejaTotal, 5, 100) : 5);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            // best-effort: si falla la cancelacion, la bandeja se recargara en la proxima visita.
        }
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));

    private static string ConvTone(int pct) => pct >= 22 ? "green" : pct >= 18 ? "blue" : "red";

    private static void AgregarPrioridad(
        List<DashboardPriority> items,
        int valor,
        string titulo,
        string descripcion,
        string ruta,
        string tone,
        string vencimiento,
        int diasSinAccion,
        int score)
    {
        if (valor <= 0)
            return;

        items.Add(new DashboardPriority(
            titulo,
            descripcion,
            valor,
            ruta,
            tone,
            vencimiento,
            DiasTexto(diasSinAccion),
            score + valor));
    }

    private static string DiasTexto(int dias) => dias switch
    {
        <= 0 => "sin demora",
        1 => "1 día sin acción",
        _ => $"{dias} días sin acción",
    };

    private sealed record DashboardPriority(
        string Titulo,
        string Descripcion,
        int ValorNumero,
        string Ruta,
        string Tone,
        string Vencimiento,
        string DiasTexto,
        int Score)
    {
        public string Valor => ValorNumero.ToString();
    }

    private sealed record DashboardSignal(string Icon, string Label, string Value, string Tone, string Footer);

}
