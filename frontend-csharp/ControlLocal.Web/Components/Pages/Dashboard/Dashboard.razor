@page "/"
@page "/dashboard"
@rendermode InteractiveServer
@inject PropietarioService Propietarios
@inject LocalComercialService Locales
@inject CaptacionService Captaciones
@inject OportunidadComercialService Oportunidades
@inject RoleState RoleState
@implements IDisposable

<PageTitle>Dashboard - ControlLocal</PageTitle>

<div class="cl-page-hero @(RoleState.CurrentRole == Roles.BrokerAdministrador ? "cl-admin-hero" : null)">
    <div>
        <div class="cl-page-kicker">@RoleState.CurrentRole</div>
        <div class="cl-page-title">@HeroTitle</div>
        <div class="cl-page-subtitle">@HeroSubtitle</div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (RoleState.CurrentRole == Roles.Agente)
        {
            <a class="btn btn-primary cl-btn-primary" href="/captaciones">Nueva captacion</a>
            <a class="btn btn-outline-secondary" href="/oportunidades-comerciales">Nueva oportunidad</a>
        }
        else if (RoleState.CurrentRole == Roles.Broker)
        {
            <a class="btn btn-outline-secondary" href="/broker/reportes">Exportar</a>
            <a class="btn btn-primary cl-btn-primary" href="/broker/captaciones">Bandeja de captaciones</a>
        }
        else
        {
            <a class="btn btn-outline-secondary" href="/admin/reportes-globales">Exportar PDF</a>
            <a class="btn btn-primary cl-btn-primary" href="/admin/brokers">Gestion de brokers</a>
        }
    </div>
</div>

@if (RoleState.CurrentRole == Roles.BrokerAdministrador)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3"><MetricCard Label="Brokers activos" Value="8" Footer="+1 vs mes anterior" Icon="BR" Tone="navy" /></div>
        <div class="col-md-3"><MetricCard Label="Agentes activos" Value="42" Footer="+4 vs mes anterior" Icon="AG" Tone="blue" /></div>
        <div class="col-md-3"><MetricCard Label="Captaciones vigentes" Value="128" Footer="+12%" Icon="CA" Tone="info" /></div>
        <div class="col-md-3"><MetricCard Label="Oportunidades abiertas" Value="46" Footer="+8%" Icon="OP" Tone="amber" /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card cl-card">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between">
                    <span>Actividad comercial - ultimos 30 dias</span>
                    <span class="text-secondary small">Volumen por etapa del proceso</span>
                </div>
                <div class="card-body">
                    <div class="cl-bars">
                        @foreach (var value in new[] { 44, 52, 48, 60, 72, 68, 78, 74, 82, 88, 76, 92 })
                        {
                            <span style="height:@value%"></span>
                        }
                    </div>
                    <div class="d-flex justify-content-between text-secondary small mt-2">
                        <span>S1</span><span>S2</span><span>S3</span><span>S4</span><span>S5</span><span>S6</span><span>S7</span><span>S8</span><span>S9</span><span>S10</span><span>S11</span><span>S12</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card cl-card h-100">
                <div class="card-header bg-white fw-semibold">Estados de oportunidad</div>
                <div class="card-body">
                    <div class="cl-funnel-row"><span>Abierta</span><strong>46</strong></div>
                    <div class="cl-funnel-row"><span>Solicitud creada</span><strong>28</strong></div>
                    <div class="cl-funnel-row"><span>Finalizada exitosa</span><strong>12</strong></div>
                    <div class="cl-funnel-row"><span>No favorable</span><strong>5</strong></div>
                    <div class="cl-funnel-row"><span>No continua</span><strong>7</strong></div>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card cl-card">
                <div class="card-header bg-white fw-semibold">Desempeno por broker</div>
                <div class="table-responsive cl-table-card">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Broker</th><th>Agentes</th><th>Captac.</th><th>Cierres</th><th>Conversion</th></tr></thead>
                        <tbody>
                            <tr><td><strong>Ricardo Salas</strong></td><td>7</td><td>38</td><td>9</td><td>24%</td></tr>
                            <tr><td><strong>Mariana Quintero</strong></td><td>6</td><td>31</td><td>8</td><td>26%</td></tr>
                            <tr><td><strong>Felipe Andrade</strong></td><td>5</td><td>27</td><td>5</td><td>19%</td></tr>
                            <tr><td><strong>Sandra Rios</strong></td><td>4</td><td>19</td><td>3</td><td>18%</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card cl-card h-100">
                <div class="card-header bg-white fw-semibold d-flex justify-content-between">
                    <span>Actividad reciente</span>
                    <a href="/admin/auditoria-global" class="small text-decoration-none">Ver todo</a>
                </div>
                <div class="card-body">
                    <div class="cl-timeline-item"><strong>25 May 2026 - Captacion aprobada</strong><span>CAP-0218, local Av. La Marina 245, aprobada por R. Salas.</span></div>
                    <div class="cl-timeline-item"><strong>25 May 2026 - Oportunidad cerrada exitosa</strong><span>OP-1083 finalizo con contrato firmado.</span></div>
                    <div class="cl-timeline-item"><strong>24 May 2026 - Reasignacion registrada</strong><span>Daniel Romero movido por intervencion administrativa.</span></div>
                </div>
            </div>
        </div>
    </div>
}
else if (RoleState.CurrentRole == Roles.Broker)
{
    <div class="row g-3 mb-4">
        <div class="col-md-3"><MetricCard Label="Mis agentes" Value="7" Footer="Relacion activa BrokerAgente" Icon="AG" Tone="blue" /></div>
        <div class="col-md-3"><MetricCard Label="Captaciones por revisar" Value="9" Footer="3 nuevas hoy" Icon="CA" Tone="amber" /></div>
        <div class="col-md-3"><MetricCard Label="Solicitudes por evaluar" Value="6" Footer="2 vencen hoy" Icon="SO" Tone="red" /></div>
        <div class="col-md-3"><MetricCard Label="Oportunidades activas" Value="46" Footer="+3 esta semana" Icon="OP" Tone="info" /></div>
    </div>

    <div class="alert alert-info">
        El broker normal solo opera sobre agentes bajo su responsabilidad. No registra propietarios, locales, clientes ni captaciones.
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card cl-card h-100">
                <div class="card-header bg-white fw-semibold">Pendientes prioritarios</div>
                <div class="table-responsive cl-table-card">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Tipo</th><th>Referencia</th><th>Agente</th><th>Antiguedad</th><th></th></tr></thead>
                        <tbody>
                            <tr><td>Captacion</td><td>CAP-0231</td><td>D. Romero</td><td>2d</td><td><a class="btn btn-sm btn-primary cl-btn-primary" href="/broker/captaciones/revision">Revisar</a></td></tr>
                            <tr><td>Solicitud</td><td>SOL-0428</td><td>C. Vega</td><td>1d</td><td><a class="btn btn-sm btn-outline-secondary" href="/broker/solicitudes/evaluacion">Evaluar</a></td></tr>
                            <tr><td>Captacion</td><td>CAP-0229</td><td>M. Leon</td><td>3h</td><td><a class="btn btn-sm btn-primary cl-btn-primary" href="/broker/captaciones/revision">Revisar</a></td></tr>
                            <tr><td>Solicitud</td><td>SOL-0425</td><td>V. Mora</td><td>5h</td><td><a class="btn btn-sm btn-outline-secondary" href="/broker/solicitudes/evaluacion">Evaluar</a></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card cl-card h-100">
                <div class="card-header bg-white fw-semibold">Conversion del embudo</div>
                <div class="card-body">
                    <div class="cl-funnel-row"><span>Oportunidades abiertas</span><strong>100%</strong></div>
                    <div class="cl-funnel-row"><span>Con visita realizada</span><strong>64%</strong></div>
                    <div class="cl-funnel-row"><span>Con solicitud creada</span><strong>44%</strong></div>
                    <div class="cl-funnel-row"><span>Finalizadas exitosas</span><strong>22%</strong></div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3"><MetricCard Label="Mis propietarios" Value="@_propietarios.Count.ToString()" Footer="Registro operativo" Icon="PR" Tone="blue" /></div>
        <div class="col-md-3"><MetricCard Label="Mis locales" Value="@_locales.Count.ToString()" Footer="Base para captacion" Icon="LC" Tone="info" /></div>
        <div class="col-md-3"><MetricCard Label="Mis captaciones" Value="@_captaciones.Count.ToString()" Footer="Activas, pendientes y observadas" Icon="CA" Tone="amber" /></div>
        <div class="col-md-3"><MetricCard Label="Mis oportunidades" Value="@_oportunidades.Count.ToString()" Footer="Seguimiento comercial" Icon="OP" Tone="green" /></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card cl-card">
                <div class="card-header bg-white fw-semibold">Mis captaciones recientes</div>
                <div class="table-responsive cl-table-card">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Local</th><th>Fecha</th><th>Estado</th><th>Observaciones</th></tr></thead>
                        <tbody>
                            @foreach (var captacion in _captaciones.Take(5))
                            {
                                <tr>
                                    <td>@captacion.DireccionLocal</td>
                                    <td>@captacion.FechaCaptacion.ToString("dd/MM/yyyy")</td>
                                    <td><StatusBadge Label="@captacion.Estado" /></td>
                                    <td class="text-secondary">@captacion.Observaciones</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card cl-card">
                <div class="card-header bg-white fw-semibold">Agenda comercial</div>
                <div class="card-body">
                    <div class="cl-timeline-item"><strong>09:30 - Visita</strong><span>Jr. Berlin 230, Miraflores.</span></div>
                    <div class="cl-timeline-item"><strong>11:00 - Llamada</strong><span>Inversiones Trebol confirma visita.</span></div>
                    <div class="cl-timeline-item"><strong>16:00 - Visita guiada</strong><span>Av. La Marina 245.</span></div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PropietarioDto> _propietarios = [];
    private List<LocalComercialDto> _locales = [];
    private List<CaptacionDto> _captaciones = [];
    private List<OportunidadComercialDto> _oportunidades = [];

    private string HeroTitle => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Panel administrativo global",
        Roles.Broker => "Dashboard de equipo",
        _ => "Buen dia, Valentina"
    };

    private string HeroSubtitle => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Gestion de brokers, auditoria e indicadores de toda la corredora.",
        Roles.Broker => "Supervision de agentes a cargo, captaciones por revisar y solicitudes por evaluar.",
        _ => "Actividad operativa: propietarios, locales, captaciones y oportunidades comerciales."
    };

    protected override async Task OnInitializedAsync()
    {
        RoleState.OnChange += StateHasChanged;
        _propietarios = await Propietarios.GetAllAsync();
        _locales = await Locales.GetAllAsync();
        _captaciones = await Captaciones.GetAllAsync();
        _oportunidades = await Oportunidades.GetAllAsync();
    }

    public void Dispose()
    {
        RoleState.OnChange -= StateHasChanged;
    }
}
