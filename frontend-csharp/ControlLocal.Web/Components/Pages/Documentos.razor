@page "/documentos"
@page "/documentos/{CodigoSolicitud}"
@inherits SafeComponentBase
@inject AppState App
@inject ISolicitudService SolicitudSvc
@inject IDocumentoSolicitudService DocSvc
@inject INotificacionService Notificaciones
@inject IJSRuntime JS

<PageTitle>Documentos @CodigoExpediente · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Solicitudes de alquiler", $"{CodigoExpediente} · Documentos" })"
          Title="@($"Documentos · {CodigoExpediente}")"
          Subtitle="Carga y revisa los documentos requeridos para la evaluacion">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate($"solicitud-detail/{CodigoExpediente}"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        <button class="cl-btn primary" disabled="@(!PuedeReenviar)"
                title="@MotivoBloqueoReenvio"
                @onclick="@(() => _confirm = true)"><Icon Name="arrowRight" Size="13" /> Reenviar a evaluacion</button>
    </Actions>
    <ChildContent>
        @* Banner segun el estado de la solicitud: deja claro si se puede reenviar o no. *@
        @if (EstadoSolicitud == "En revision")
        {
            <div class="cl-alert blue" style="margin-bottom:14px;">
                <Icon Name="clock" Size="15" />
                <span>Esta solicitud está <b>En revisión</b> del broker. No puedes reenviarla mientras la evalúa. Si la devuelve <b>Observada</b>, podrás subsanar los documentos y reenviar a evaluación.</span>
            </div>
        }
        else if (EstadoSolicitud == "Observada")
        {
            <div class="cl-alert amber" style="margin-bottom:14px;">
                <Icon Name="alert" Size="15" />
                <span>El broker <b>observó</b> esta solicitud. Subsana los documentos marcados como <b>Observado</b> (vuelve a cargarlos) y luego pulsa <b>Reenviar a evaluación</b>.</span>
            </div>
        }
        else if (EstadoSolicitud is "Aprobada" or "Rechazada" or "Cerrada" or "Desistida")
        {
            <div class="cl-alert blue" style="margin-bottom:14px;">
                <Icon Name="checkCircle" Size="15" />
                <span>Esta solicitud está <b>@EstadoSolicitud</b>. Ya no se reenvía a evaluación; los documentos quedan como referencia.</span>
            </div>
        }
        else
        {
            <div class="cl-alert blue" style="margin-bottom:14px;">
                <Icon Name="info" Size="15" />
                <span>Un archivo nuevo queda <b>Registrado</b> y con revisión <b>Pendiente</b>. Solo la revisión del broker puede dejarlo <b>Validado</b> u <b>Observado</b>. Cuando estén completos, pulsa <b>Reenviar a evaluación</b>.</span>
            </div>
        }

        @* Leyenda de estados de cada documento, para que el agente los entienda de un vistazo. *@
        <div class="cl-flex" style="gap:14px;flex-wrap:wrap;margin-bottom:14px;font-size:11.5px;color:var(--c-text-2);">
            <span class="cl-flex" style="gap:5px;"><StatusBadge Label="Pendiente de carga" /> sin archivo subido</span>
            <span class="cl-flex" style="gap:5px;"><StatusBadge Label="Registrado" /> subido, espera revisión del broker</span>
            <span class="cl-flex" style="gap:5px;"><StatusBadge Label="Validado" /> aprobado por el broker</span>
            <span class="cl-flex" style="gap:5px;"><StatusBadge Label="Observado" /> el broker pide subsanarlo</span>
        </div>

        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div class="cl-card">
                <div class="cl-card-head">
                    <div class="cl-card-title">Documentos de la solicitud</div>
                    <span class="cl-badge @(PendientesDeSubsanar == 0 ? "green" : "blue")">
                        @(PendientesDeSubsanar == 0 ? "Listo para reenviar" : $"{PendientesDeSubsanar} por subsanar")
                    </span>
                </div>
                <div class="cl-card-body" style="padding:0;">
                    <table class="cl-table">
                        <thead><tr><th>Tipo de documento</th><th>Estado</th><th>Revision</th><th>Actualizado</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var documento in _documentos)
                            {
                                <tr>
                                    <td>
                                        <div class="cl-flex">
                                            @{ var refArch = documento.Clave ?? documento.NombreArchivo; }
                                            @if (!string.IsNullOrWhiteSpace(documento.Clave) && TiposContenido.EsImagen(documento.Clave))
                                            {
                                                <img src="@TiposContenido.UrlContenido(documento.Clave)" alt="@documento.Nombre"
                                                     style="width:26px;height:26px;border-radius:5px;object-fit:cover;border:1px solid var(--c-border);" />
                                            }
                                            else
                                            {
                                                <Icon Name="@(string.IsNullOrWhiteSpace(refArch) ? "fileText" : TiposContenido.IconoPara(refArch))" Size="15" />
                                            }
                                            <span style="font-weight:550;">@documento.Nombre</span>
                                        </div>
                                        @if (documento.Estado == "Observado" && !string.IsNullOrWhiteSpace(documento.Observaciones))
                                        {
                                            <div class="cl-alert amber" style="margin-top:6px;padding:6px 9px;">
                                                <Icon Name="alert" Size="13" />
                                                <span style="font-size:11.5px;"><b>Observado por el broker:</b> @documento.Observaciones · vuelve a cargarlo y reenvía.</span>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(documento.Observaciones))
                                        {
                                            <div class="cl-muted" style="font-size:11px;margin-top:3px;">@documento.Observaciones</div>
                                        }
                                    </td>
                                    <td><StatusBadge Label="@EstadoPantalla(documento)" /></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(documento.ResultadoRevision))
                                        {
                                            <StatusBadge Label="@documento.ResultadoRevision" />
                                        }
                                        else
                                        {
                                            <span class="cl-muted">—</span>
                                        }
                                    </td>
                                    <td><span class="cl-muted" style="font-size:12px;">@documento.Actualizado</span></td>
                                    <td>
                                        <div class="cl-row-actions">
                                            @if (!string.IsNullOrWhiteSpace(documento.Clave))
                                            {
                                                <button title="Ver" @onclick="@(() => AbrirVisor(documento))"><Icon Name="eye" Size="14" /></button>
                                            }
                                            @if (RequiereCarga(documento))
                                            {
                                                <button title="@(string.IsNullOrWhiteSpace(documento.NombreArchivo) ? "Subir" : "Reemplazar")" @onclick="@(() => AbrirSelectorAsync(documento.TipoCodigo))"><Icon Name="upload" Size="13" /></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-head">
                        <div class="cl-card-title">Subir documento</div>
                        @if (_estadoAlmacen is { } estado)
                        {
                            <span class="cl-badge @(estado.Conectado ? "green" : "red")"
                                  title="@estado.Detalle">
                                <Icon Name="@(estado.Conectado ? "checkCircle" : "alert")" Size="12" />
                                @($"Almacén {estado.Proveedor}: {(estado.Conectado ? "conectado" : "sin conexión")}")
                            </span>
                        }
                    </div>
                    <div class="cl-card-body">
                        @if (_estadoAlmacen is { Conectado: false } caido)
                        {
                            <div class="cl-alert red" style="margin-bottom:10px;">
                                <Icon Name="alert" Size="15" />
                                <span>@caido.Detalle Revisa la configuración del almacenamiento antes de subir documentos.</span>
                            </div>
                        }
                        <Field Label="Tipo de documento">
                            <select @bind="_tipoSeleccionado">
                                @foreach (var documento in _documentos.Where(RequiereCarga))
                                {
                                    <option value="@documento.TipoCodigo">@documento.Nombre</option>
                                }
                            </select>
                        </Field>
                        <div style="margin-top:10px;">
                            <InputFile id="doc-file-input" OnChange="SeleccionarArchivo" accept=".pdf,.png,.jpg,.jpeg" class="cl-input" />
                        </div>
                        <div class="cl-help" style="margin-top:6px;">
                            PDF, PNG o JPG de hasta @(ValidadorArchivos.TamanoMaximo / 1024 / 1024) MB. Se guarda solo al confirmar.
                        </div>
                        @if (_archivoEnEspera is { } espera)
                        {
                            <div class="cl-alert blue" style="margin-top:10px;flex-direction:column;align-items:stretch;gap:8px;">
                                <div class="cl-flex" style="gap:8px;">
                                    <Icon Name="fileText" Size="15" />
                                    <span style="font-size:12.5px;">Listo para guardar: <b>@espera.Nombre</b> → @espera.TipoNombre</span>
                                </div>
                                <div class="cl-flex" style="gap:8px;justify-content:flex-end;">
                                    <button class="cl-btn ghost sm" disabled="@_guardando" @onclick="QuitarSeleccion"><Icon Name="x" Size="13" /> Quitar</button>
                                    <button class="cl-btn primary sm" disabled="@_guardando" @onclick="GuardarArchivoEnEsperaAsync"><Icon Name="save" Size="13" /> Guardar</button>
                                </div>
                            </div>
                        }
                        @if (_error is not null)
                        {
                            <div class="cl-alert red" style="margin-top:10px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                        }
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Progreso de carga</div></div>
                    <div class="cl-card-body">
                        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:5px;">
                            <span>Archivos entregados</span><span><b>@Entregados</b> / @_documentos.Count</span>
                        </div>
                        <div style="height:8px;background:#E2E6EC;border-radius:99px;overflow:hidden;">
                            <div style="height:100%;width:@(Porcentaje)%;background:var(--c-primary);"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <DocViewerModal Open="_visorAbierto"
                        Nombre="@(_documentoVisor?.Nombre ?? "Documento")"
                        Estado="@EstadoPantalla(_documentoVisor)"
                        Expediente="@CodigoExpediente"
                        Actualizado="@(_documentoVisor?.Actualizado ?? "—")"
                        Url="@UrlVisor"
                        Incrustable="@IncrustableVisor"
                        Nota="@(_documentoVisor?.Observaciones)"
                        OnClose="@(() => _visorAbierto = false)" />

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="arrowRight"
                       Title="¿Reenviar la solicitud a evaluacion?"
                       Desc="La solicitud volvera al estado En revision y se notificara al broker."
                       ConfirmLabel="Reenviar" CancelLabel="Cancelar"
                       Busy="@_reenviando"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="ReenviarAsync" />
        <Toast Show="@(_toast is not null)">@_toast</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CodigoSolicitud { get; set; }

    private SolicitudAlquilerDto? _solicitud;
    private string _tipoSeleccionado = "";
    private string? _error;
    private string? _toast;
    private bool _confirm;
    private bool _reenviando;
    private bool _visorAbierto;
    private DocumentoItem? _documentoVisor;
    private EstadoAlmacen? _estadoAlmacen;
    private ArchivoEnEspera? _archivoEnEspera;
    private bool _guardando;

    private string CodigoExpediente => _solicitud?.CodigoSolicitud ?? CodigoSolicitud ?? "Solicitud";
    private long IdSolicitud => _solicitud?.Id ?? 0;

    // URL del contenido real del documento abierto en el visor (null si no hay archivo).
    private string? UrlVisor => string.IsNullOrEmpty(_documentoVisor?.Clave)
        ? null
        : $"/documento?clave={Uri.EscapeDataString(_documentoVisor.Clave)}";
    private bool IncrustableVisor =>
        _documentoVisor?.Clave is { } clave && TiposContenido.SePuedeIncrustar(clave);

    // Comprueba al entrar que el almacén (S3 o Local) responde, para avisar de inmediato
    // si está caído antes de que el usuario intente subir o ver un documento.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _estadoAlmacen = await DocSvc.EstadoAlmacenAsync(DisposedToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _estadoAlmacen = EstadoAlmacen.Falla("Almacén", ex.Message);
        }
    }

    private sealed class DocumentoItem
    {
        public required string TipoCodigo { get; init; }
        public required string Nombre { get; init; }
        public string Estado { get; set; } = "";
        public string ResultadoRevision { get; set; } = "";
        public string Actualizado { get; set; } = "—";
        public string? Observaciones { get; set; }
        public string? NombreArchivo { get; set; }
        // Clave del archivo en el almacén (Local/S3). Sin clave no hay archivo que abrir.
        public string? Clave { get; set; }
    }

    // Archivo elegido por el usuario que aún NO se ha persistido. Se confirma con Guardar
    // (lo sube al almacén) o se descarta con Quitar, antes de registrarse como documento.
    private sealed class ArchivoEnEspera
    {
        public required string TipoCodigo { get; init; }
        public required string TipoNombre { get; init; }
        public required string Nombre { get; init; }
        public required byte[] Contenido { get; init; }
    }

    // Checklist de documentos requeridos por la solicitud. Todos inician "Pendiente de
    // carga" (sin archivo, sin revisión); el estado solo cambia cuando el agente sube el
    // archivo o el broker lo revisa. No hay datos de ejemplo: nada figura como validado
    // mientras no exista un archivo real. (Metadatos por persistir en backend; ver flujo S3.)
    private readonly List<DocumentoItem> _documentos =
    [
        new() { TipoCodigo = "I", Nombre = "Documento de identidad" },
        new() { TipoCodigo = "R", Nombre = "Ficha o constancia RUC" },
        new() { TipoCodigo = "V", Nombre = "Vigencia de poder" },
        new() { TipoCodigo = "E", Nombre = "Sustento economico" },
        new() { TipoCodigo = "G", Nombre = "Documento de garantia" },
        new() { TipoCodigo = "D", Nombre = "Declaracion jurada" },
    ];

    private int Entregados => _documentos.Count(item => !string.IsNullOrWhiteSpace(item.NombreArchivo));
    private int Porcentaje => (int)Math.Round(Entregados * 100.0 / _documentos.Count);
    // Bloquea el reenvío hasta que no quede ningún documento sin subir NI observado por el broker.
    private int PendientesDeSubsanar => _documentos.Count(RequiereCarga);

    // Estado actual de la solicitud (texto del backend: Registrada / En revision / Observada / ...).
    private string EstadoSolicitud => _solicitud?.Estado ?? "";

    // Solo se (re)envía a evaluación una solicitud Registrada (primer envío) u Observada
    // (el broker la devolvió para subsanar). En revisión queda bloqueada hasta que el
    // broker responda; aprobada/rechazada/cerrada ya no se reenvía. Espeja la regla del backend.
    private bool EstadoPermiteReenviar => EstadoSolicitud is "Registrada" or "Observada" or "";
    private bool PuedeReenviar => EstadoPermiteReenviar && PendientesDeSubsanar == 0 && !_reenviando;

    private string MotivoBloqueoReenvio =>
        !EstadoPermiteReenviar
            ? (EstadoSolicitud == "En revision"
                ? "La solicitud ya está en evaluación. Espera la respuesta del broker."
                : $"La solicitud está {EstadoSolicitud}: ya no se reenvía a evaluación.")
            : PendientesDeSubsanar > 0
                ? "Completa o subsana los documentos pendientes u observados."
                : "";

    // Documentos que el broker debe (re)revisar: tienen archivo y siguen Registrados (recién
    // subidos o reemplazados, aún sin validar). Es lo que se le detalla al reenviar a evaluación.
    private List<string> DocumentosModificados() => _documentos
        .Where(d => !string.IsNullOrWhiteSpace(d.NombreArchivo) && d.Estado == "Registrado")
        .Select(d => d.Nombre)
        .ToList();

    protected override async Task OnParametersSetAsync()
    {
        // Refresca primero: el bloqueo del botón "Reenviar" depende del estado real de la
        // solicitud (Registrada/Observada habilitan; En revisión la bloquea), y al entrar
        // desde una notificación la caché podría estar desactualizada.
        try { await SolicitudSvc.RefrescarAsync(DisposedToken); }
        catch (OperationCanceledException) { }
        catch { /* se resuelve con la última copia en caché */ }
        // El parámetro puede ser el código (SOL-...) o el id numérico (alerta del backend).
        _solicitud = string.IsNullOrWhiteSpace(CodigoSolicitud)
            ? SolicitudSvc.All().FirstOrDefault()
            : SolicitudSvc.ByCodigo(CodigoSolicitud)
                ?? (long.TryParse(CodigoSolicitud, out var id)
                    ? SolicitudSvc.All().FirstOrDefault(s => s.Id == id)
                    : null);
        await CargarDocumentosAsync();
    }

    // Trae los documentos reales de la solicitud y los superpone sobre el checklist.
    // Sin documentos, cada tipo queda "Pendiente de carga" (nada figura como validado).
    private async Task CargarDocumentosAsync()
    {
        foreach (var item in _documentos)
        {
            item.Estado = "";
            item.ResultadoRevision = "";
            item.Actualizado = "—";
            item.Observaciones = null;
            item.NombreArchivo = null;
            item.Clave = null;
        }

        if (IdSolicitud > 0)
        {
            try
            {
                var reales = await DocSvc.ListarAsync(IdSolicitud, DisposedToken);
                foreach (var item in _documentos)
                {
                    // Si hay varios del mismo tipo (recargas), gana el más reciente.
                    var real = reales.LastOrDefault(r => r.TipoDocumento == item.TipoCodigo);
                    if (real is null) continue;
                    item.Estado = string.IsNullOrWhiteSpace(real.Estado) ? "Registrado" : real.Estado;
                    item.ResultadoRevision = real.ResultadoRevision;
                    item.Actualizado = string.IsNullOrWhiteSpace(real.FechaEntregaTexto) ? "—" : real.FechaEntregaTexto;
                    item.Observaciones = string.IsNullOrWhiteSpace(real.Observaciones) ? null : real.Observaciones;
                    item.NombreArchivo = real.NombreArchivo;
                    item.Clave = real.RutaArchivo;
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception ex)
            {
                _error = $"No se pudieron cargar los documentos: {ex.Message}";
            }
        }

        _tipoSeleccionado = _documentos.FirstOrDefault(RequiereCarga)?.TipoCodigo ?? "";
    }

    private static bool RequiereCarga(DocumentoItem documento) =>
        documento.Estado == "Observado" || string.IsNullOrWhiteSpace(documento.NombreArchivo);

    private static string EstadoPantalla(DocumentoItem? documento) =>
        documento is null || string.IsNullOrWhiteSpace(documento.Estado)
            ? "Pendiente de carga"
            : documento.Estado;

    private void AbrirVisor(DocumentoItem documento)
    {
        _documentoVisor = documento;
        _visorAbierto = true;
    }

    // Abre el explorador de archivos para el tipo de la fila pulsada (el icono "upload").
    private async Task AbrirSelectorAsync(string tipoCodigo)
    {
        _tipoSeleccionado = tipoCodigo;
        _error = null;
        await JS.InvokeVoidAsync("controlLocal.clickElemento", "doc-file-input");
    }

    // Paso 1: el usuario elige un archivo. Se valida pero NO se persiste; queda "en espera"
    // hasta que confirme con Guardar (o lo descarte con Quitar).
    private async Task SeleccionarArchivo(InputFileChangeEventArgs evento)
    {
        _error = null;
        var documento = _documentos.FirstOrDefault(item => item.TipoCodigo == _tipoSeleccionado);
        if (documento is null)
        {
            _error = "Selecciona el tipo de documento.";
            return;
        }

        var archivo = evento.File;
        if (archivo is null)
        {
            _error = "No se recibió ningún archivo.";
            return;
        }

        using var memoria = new MemoryStream();
        try
        {
            await using var stream = archivo.OpenReadStream(ValidadorArchivos.TamanoMaximo);
            await stream.CopyToAsync(memoria);
        }
        catch (IOException)
        {
            _error = $"El archivo supera el maximo de {ValidadorArchivos.TamanoMaximo / 1024 / 1024} MB.";
            return;
        }
        catch (Exception ex)
        {
            // Cualquier otro fallo al leer el archivo del navegador (canal interrumpido,
            // etc.) se muestra en la UI; nunca debe propagarse y tumbar el circuito.
            _error = $"No se pudo leer el archivo: {ex.Message}";
            return;
        }

        var primeros = memoria.GetBuffer().AsSpan(0, (int)Math.Min(8, memoria.Length));
        var validacion = ValidadorArchivos.Validar(
            archivo.Name, archivo.ContentType, memoria.Length, primeros,
            ".pdf", ".png", ".jpg", ".jpeg");
        if (!validacion.EsValido)
        {
            _error = validacion.Error;
            return;
        }

        if (IdSolicitud <= 0)
        {
            _error = "No se pudo identificar la solicitud para registrar el documento.";
            return;
        }

        // Deja el archivo listo, pendiente de confirmación. Aún no toca el almacén.
        _archivoEnEspera = new ArchivoEnEspera
        {
            TipoCodigo = documento.TipoCodigo,
            TipoNombre = documento.Nombre,
            Nombre = archivo.Name,
            Contenido = memoria.ToArray(),
        };
    }

    // Descarta el archivo en espera sin persistirlo.
    private void QuitarSeleccion()
    {
        _archivoEnEspera = null;
        _error = null;
    }

    // Paso 2: confirma la subida. Recién aquí los bytes van al backend, que los guarda en el
    // almacén (S3 o disco) y persiste los metadatos en una sola operación.
    private async Task GuardarArchivoEnEsperaAsync()
    {
        if (_guardando || _archivoEnEspera is not { } espera)
        {
            return;
        }
        var documento = _documentos.FirstOrDefault(item => item.TipoCodigo == espera.TipoCodigo);
        if (documento is null)
        {
            _error = "No se encontró el tipo de documento.";
            return;
        }

        _error = null;
        ControlLocal.Web.Services.CrashLog.Breadcrumb(
            $"GuardarArchivo: solicitud={IdSolicitud} tipo={espera.TipoCodigo} archivo={espera.Nombre} bytes={espera.Contenido.Length}");
        DocumentoSolicitudDto registrado;
        try
        {
            _guardando = true;
            await RenderIfAliveAsync();
            registrado = await DocSvc.SubirAsync(
                IdSolicitud, espera.TipoCodigo, espera.Nombre, espera.Contenido, DisposedToken);
            ControlLocal.Web.Services.CrashLog.Breadcrumb("GuardarArchivo: SubirAsync regreso OK");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo subir el documento: {ex.Message}";
            return;
        }
        finally
        {
            _guardando = false;
        }

        documento.Estado = string.IsNullOrWhiteSpace(registrado.Estado) ? "Registrado" : registrado.Estado;
        documento.ResultadoRevision = registrado.ResultadoRevision;
        documento.Observaciones = string.IsNullOrWhiteSpace(registrado.Observaciones) ? null : registrado.Observaciones;
        documento.Actualizado = string.IsNullOrWhiteSpace(registrado.FechaEntregaTexto)
            ? DateTime.Today.ToString("dd MMM", System.Globalization.CultureInfo.InvariantCulture)
            : registrado.FechaEntregaTexto;
        documento.NombreArchivo = registrado.NombreArchivo;
        documento.Clave = registrado.RutaArchivo;
        _archivoEnEspera = null;
        _tipoSeleccionado = _documentos.FirstOrDefault(RequiereCarga)?.TipoCodigo ?? "";
        _toast = $"Documento \"{documento.Nombre}\" registrado.";
        await OcultarToastAsync();
    }

    private async Task ReenviarAsync()
    {
        if (_reenviando) return;
        if (_solicitud is null)
        {
            _confirm = false;
            _error = "Solicitud no encontrada.";
            return;
        }
        try
        {
            _reenviando = true;
            _error = null;
            await RenderIfAliveAsync();
            // Documentos modificados (subidos/reemplazados) que el broker debe revisar; se le
            // detallan en la alerta para que sepa exactamente qué cambió en este reenvío.
            var modificados = DocumentosModificados();
            var detalleDocs = modificados.Count > 0
                ? $" Documentos a revisar ({modificados.Count}): {string.Join(", ", modificados)}."
                : "";
            await SolicitudSvc.ReenviarAEvaluacionAsync(_solicitud.CodigoSolicitud, DisposedToken);
            Notificaciones.Crear(new NotificacionDto
            {
                Tipo = "Solicitud por evaluar",
                Mensaje = $"La solicitud {_solicitud.CodigoSolicitud} ({_solicitud.ClienteNombre}) volvió a evaluación.{detalleDocs}",
                Severidad = "MEDIA",
                Icono = "fileText",
                EntidadTipo = "Solicitud",
                // Id numérico para deduplicar con la alerta que el backend ya persiste para
                // el broker supervisor (SOLICITUD_REENVIADA, que llega vía broker_agente).
                EntidadRef = _solicitud.Id.ToString(),
                // Lleva al broker directo a evaluar ESTA solicitud, no a la lista genérica.
                Ruta = $"evaluacion/{_solicitud.CodigoSolicitud}",
                DestinatarioRol = Roles.Broker,
                Fecha = DateTime.Now,
            });
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            // Cualquier fallo (estado no reenviable, backend caido, etc.) se muestra en la
            // UI; nunca debe propagarse y tumbar/colgar el circuito de Blazor Server.
            _error = ex.Message;
            await RenderIfAliveAsync();
            return;
        }
        finally
        {
            _reenviando = false;
            _confirm = false;
        }
        _toast = "Solicitud reenviada a evaluación. Se notificó al broker.";
        await RenderIfAliveAsync();
        await Task.Delay(300);
        App.Navigate("solicitudes");
    }

    private async Task OcultarToastAsync()
    {
        await RenderIfAliveAsync();
        await DelayThenRenderAsync(2200, () => _toast = null);
    }

    private static string Texto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "No registrado" : valor;
}
