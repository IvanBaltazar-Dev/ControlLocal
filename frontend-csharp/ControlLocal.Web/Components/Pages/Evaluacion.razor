@page "/evaluacion"
@page "/evaluacion/{CodigoParam}"
@inject AppState App
@inject ISolicitudService SolicitudSvc

<PageTitle>Evaluar solicitud · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Solicitudes por evaluar", _solicitud?.CodigoSolicitud ?? "Evaluación" })"
          Title="@(_solicitud is null ? "Evaluar solicitud" : $"{_solicitud.CodigoSolicitud} · {_solicitud.ClienteNombre}")"
          Subtitle="Registra una evaluación alineada al modelo de solicitudes del backend">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("solicitudes"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        @if (_solicitud is null)
        {
            <div class="cl-alert red"><Icon Name="alert" Size="15" /><span>No se encontró la solicitud seleccionada.</span></div>
        }
        else
        {
            <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Solicitud de alquiler</div></div>
                        <div class="cl-card-body">
                            <dl class="cl-kv">
                                <dt>Operación</dt><dd>@_solicitud.CodigoOperacion</dd>
                                <dt>Cliente</dt><dd>@_solicitud.ClienteNombre</dd>
                                <dt>Local</dt><dd>@_solicitud.DireccionLocal</dd>
                                <dt>Monto propuesto</dt><dd>@_solicitud.MontoMensual.ToString("N2")</dd>
                                <dt>Plazo tentativo</dt><dd>@(_solicitud.PlazoTentativo.Length > 0 ? _solicitud.PlazoTentativo : $"{_solicitud.PlazoMeses} meses")</dd>
                                <dt>Observaciones</dt><dd>@(string.IsNullOrWhiteSpace(_solicitud.Observaciones) ? "—" : _solicitud.Observaciones)</dd>
                                <dt>Estado</dt><dd><StatusBadge Label="@_solicitud.Estado" /></dd>
                            </dl>
                        </div>
                    </div>

                    <FormSection Num="1" Title="Evaluación" Sub="Tipo, resultado y observaciones persistidos por EvaluacionSolicitud">
                        <div class="cl-grid c2">
                            <Field Label="Tipo de evaluación" Required="true">
                                <select @bind="_tipoEvaluacion">
                                    @foreach (var opcion in EnumCatalog.TiposEvaluacionSolicitud)
                                    {
                                        <option value="@opcion.Code">@opcion.Label</option>
                                    }
                                </select>
                            </Field>
                            <Field Label="Resultado" Required="true">
                                <select @bind="_resultado">
                                    @foreach (var opcion in EnumCatalog.ResultadosEvaluacionSolicitud)
                                    {
                                        <option value="@opcion.Code">@opcion.Label</option>
                                    }
                                </select>
                            </Field>
                        </div>
                        <div style="margin-top:12px;">
                            <Field Label="Observaciones" Required="@(_resultado is "R" or "O")">
                                <textarea rows="4" @bind="_observaciones" placeholder="Fundamento de la evaluación..."></textarea>
                            </Field>
                        </div>
                    </FormSection>

                    @if (_err is not null)
                    {
                        <div class="cl-alert red"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                    }

                    <FormFooterBar OnCancel="@(() => App.Navigate("solicitudes"))" OnSave="@TryConfirm" SaveLabel="Registrar evaluación" />
                </div>

                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Resultado seleccionado</div></div>
                        <div class="cl-card-body">
                            <StatusBadge Label="@EnumCatalog.LabelFor(EnumCatalog.ResultadosEvaluacionSolicitud, _resultado)" />
                            <div class="cl-muted" style="font-size:12px;margin-top:10px;">
                                Responsable: @(App.CurrentUser?.Nombre ?? "Broker en sesión")
                            </div>
                        </div>
                    </div>
                    <div class="cl-alert blue">
                        <Icon Name="info" Size="15" />
                        <span>La evaluación guarda únicamente campos existentes en Java y actualiza el estado de la solicitud.</span>
                    </div>
                </div>
            </div>
        }

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="check"
                       Title="¿Registrar la evaluación?"
                       Desc="@($"Resultado: {EnumCatalog.LabelFor(EnumCatalog.ResultadosEvaluacionSolicitud, _resultado)}.")"
                       ConfirmLabel="Confirmar" CancelLabel="Revisar datos"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">Evaluación registrada correctamente.</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private SolicitudAlquilerDto? _solicitud;
    private string _tipoEvaluacion = "P";
    private string _resultado = "O";
    private string _observaciones = "";
    private bool _confirm;
    private bool _toast;
    private string? _err;

    protected override void OnParametersSet()
    {
        _solicitud = string.IsNullOrWhiteSpace(CodigoParam)
            ? SolicitudSvc.All().FirstOrDefault()
            : SolicitudSvc.ByCodigo(CodigoParam);
    }

    private void TryConfirm()
    {
        if (_solicitud is null) { _err = "No se encontró la solicitud seleccionada."; return; }
        if (!EnumCatalog.TiposEvaluacionSolicitud.Any(item => item.Code == _tipoEvaluacion)) { _err = "Selecciona un tipo de evaluación válido."; return; }
        if (!EnumCatalog.ResultadosEvaluacionSolicitud.Any(item => item.Code == _resultado)) { _err = "Selecciona un resultado válido."; return; }
        if (_resultado is "R" or "O" && string.IsNullOrWhiteSpace(_observaciones))
        {
            _err = "Las observaciones son obligatorias al observar o rechazar.";
            return;
        }
        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        _confirm = false;
        if (_solicitud is null)
            return;

        try
        {
            SolicitudSvc.Evaluar(_solicitud.CodigoSolicitud, new EvaluacionSolicitudDto
            {
                TipoEvaluacion = _tipoEvaluacion,
                Resultado = _resultado,
                Observaciones = _observaciones.Trim(),
                ResponsableEvaluacion = App.CurrentUser?.Nombre ?? "Broker en sesión",
            });
        }
        catch (InvalidOperationException error)
        {
            _err = error.Message;
            return;
        }

        _toast = true;
        StateHasChanged();
        await Task.Delay(900);
        App.Navigate("solicitudes");
    }
}
