@page "/historial-reasignaciones"
@inherits SafeComponentBase
@inject AppState App
@inject IReasignacionCaptacionService ReasignacionSvc
@inject ExportacionService Exportar

<PageTitle>Historial de reasignaciones · ControlLocal</PageTitle>

<AppShell Active="@_navActive" Crumbs="@_crumbs"
          Title="Historial de reasignaciones de captaciones"
          Subtitle="@_subtitle">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCsv" disabled="@(_historial.Count == 0)"><Icon Name="download" Size="13" /> Exportar CSV</button>
        @if (_puedeReasignar)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("reasignar-captaciones"))"><Icon Name="swap" Size="13" /> Reasignar captación</button>
        }
    </Actions>
    <ChildContent>
        @if (_errorCarga is not null)
        {
            <div class="cl-alert red" style="margin-bottom:14px;">
                <Icon Name="alert" Size="15" />
                <span>
                    No se pudo cargar el historial de reasignaciones. Detalle: <b>@_errorCarga</b>.
                    <button class="cl-btn small" style="margin-left:8px;" @onclick="CargarAsync">Reintentar</button>
                </span>
            </div>
        }

        <div class="cl-alert blue" style="margin-bottom:14px;">
            <Icon Name="info" Size="15" />
            <span>
                Cada reasignación queda registrada con <b>fecha, agente anterior, agente nuevo, broker responsable y motivo</b>. Esta vista es la fuente única para auditar los movimientos de cartera entre agentes.
            </span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="layers" Label="Reasignaciones totales" Value="@_historial.Count.ToString()" Tone="blue" />
            <MetricCard Icon="calendar" Label="En los últimos 30 días" Value="@_recientes.ToString()" Tone="info" />
            <MetricCard Icon="users" Label="Agentes involucrados" Value="@_agentesUnicos.ToString()" Tone="green" />
            <MetricCard Icon="briefcase" Label="Brokers que autorizaron" Value="@_brokersUnicos.ToString()" Tone="gray" />
        </div>

        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <FilterBar Search="Buscar por código, local, agente o motivo…"
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Cualquier broker" Options="_brokers" @bind-Value="_broker" />
            <FilterSelect Placeholder="Cualquier agente" Options="_agentes" @bind-Value="_agente" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Captación</th>
                            <th>Local</th>
                            <th>Agente anterior</th>
                            <th></th>
                            <th>Agente nuevo</th>
                            <th>Broker responsable</th>
                            <th>Motivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in visibles)
                        {
                            <tr>
                                <td class="muted" style="white-space:nowrap;">@h.FechaCambioTexto</td>
                                <td><span class="mono">@h.CodigoCaptacion</span></td>
                                <td>@h.DireccionLocal</td>
                                <td>@h.AgenteAnteriorNombre</td>
                                <td style="text-align:center;color:#005BFF;"><Icon Name="arrowRight" Size="14" /></td>
                                <td style="font-weight:600;">@h.AgenteNuevoNombre</td>
                                <td class="muted">@h.BrokerResponsableNombre</td>
                                <td style="color:var(--c-text-2);max-width:320px;">@h.Motivo</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Cargando historial…</div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="swap" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">
                            @(_historial.Count == 0 ? "Aún no hay reasignaciones registradas" : "Sin reasignaciones en este filtro")
                        </div>
                        <div style="font-size:12px;">
                            @(_historial.Count == 0
                                ? "Cuando un broker reasigne una captación a otro agente, el movimiento aparecerá aquí."
                                : "Ajusta la búsqueda o limpia los filtros.")
                        </div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />
    </ChildContent>
</AppShell>

@code {
    private bool _cargando = true;
    private string? _errorCarga;
    private IReadOnlyList<ReasignacionCaptacionDto> _historial = Array.Empty<ReasignacionCaptacionDto>();

    private string _query = "", _broker = "", _agente = "";
    private int _pagina = 1;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _cargando = true;
        _errorCarga = null;
        try
        {
            _historial = await Task.Run(() => ReasignacionSvc.Historial(), DisposedToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errorCarga = ex.Message;
            _historial = Array.Empty<ReasignacionCaptacionDto>();
        }
        finally
        {
            _cargando = false;
        }
    }

    private int _recientes => _historial.Count(h => h.FechaCambio.HasValue
        && h.FechaCambio.Value >= DateTime.Now.AddDays(-30));

    private int _agentesUnicos => _historial
        .SelectMany(h => new[] { h.AgenteAnteriorNombre, h.AgenteNuevoNombre })
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private int _brokersUnicos => _historial
        .Select(h => h.BrokerResponsableNombre)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    private IReadOnlyList<string> _brokers => _historial.Select(h => h.BrokerResponsableNombre)
        .Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(x => x).ToList();

    private IReadOnlyList<string> _agentes => _historial
        .SelectMany(h => new[] { h.AgenteAnteriorNombre, h.AgenteNuevoNombre })
        .Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().OrderBy(x => x).ToList();

    private bool HayFiltros => new[] { _query, _broker, _agente }.Any(s => !string.IsNullOrEmpty(s));

    private void LimpiarFiltros() { _query = _broker = _agente = ""; _pagina = 1; }

    private IEnumerable<ReasignacionCaptacionDto> Filtradas() => _historial.Where(h =>
        (string.IsNullOrEmpty(_broker) || h.BrokerResponsableNombre == _broker) &&
        (string.IsNullOrEmpty(_agente) || h.AgenteAnteriorNombre == _agente || h.AgenteNuevoNombre == _agente) &&
        (string.IsNullOrEmpty(_query) || Coincide(h, _query)));

    private static bool Coincide(ReasignacionCaptacionDto h, string q) =>
        TextoFiltro.Contiene(h.CodigoCaptacion, q)
        || TextoFiltro.Contiene(h.DireccionLocal, q)
        || TextoFiltro.Contiene(h.AgenteAnteriorNombre, q)
        || TextoFiltro.Contiene(h.AgenteNuevoNombre, q)
        || TextoFiltro.Contiene(h.BrokerResponsableNombre, q)
        || TextoFiltro.Contiene(h.Motivo, q);

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("historial_reasignaciones_captaciones",
            new[] { "Fecha", "Código captación", "Local", "Agente anterior", "Agente nuevo", "Broker responsable", "Motivo" },
            Filtradas().Select(h => (IReadOnlyList<string?>)new[]
            {
                h.FechaCambioTexto, h.CodigoCaptacion, h.DireccionLocal,
                h.AgenteAnteriorNombre, h.AgenteNuevoNombre, h.BrokerResponsableNombre, h.Motivo,
            }));
    }

    private string _subtitle => _cargando
        ? "Cargando movimientos registrados…"
        : _historial.Count == 0
            ? "Sin reasignaciones registradas todavía"
            : $"{_historial.Count} reasignaciones · {_brokersUnicos} brokers responsables · {_agentesUnicos} agentes involucrados";

    private bool _puedeReasignar => App.CurrentUser?.Role == Roles.Broker;

    private string _navActive => App.CurrentUser?.Role == Roles.Admin
        ? "Historial de reasignaciones"
        : "Historial de reasignaciones";

    private string[] _crumbs => App.CurrentUser?.Role == Roles.Admin
        ? new[] { "ControlLocal", "Administración", "Historial de reasignaciones" }
        : new[] { "ControlLocal", "Mi equipo", "Historial de reasignaciones" };
}
