@page "/interaccion-detail/{InteraccionIdParam}"
@inherits SafeComponentBase
@inject AppState App
@inject IInteraccionService InteraccionSvc
@inject ICaptacionService CaptacionSvc

<PageTitle>Interaccion - @PersonaNombre - ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Operacion", "Interacciones", "Detalle" })"
          Title="@($"Interaccion registrada - {PersonaNombre}")"
          Subtitle="@($"{ContextoTitulo} - {GetCanalLabel(_interaccion?.CanalContacto)}")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("interacciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        @if (!string.IsNullOrWhiteSpace(RutaProceso))
        {
            <a class="cl-btn" href="@RutaProceso"><Icon Name="arrowUpRight" Size="13" /> Abrir proceso</a>
        }
    </Actions>
    <ChildContent>
        @if (_interaccion is null)
        {
            <div class="cl-alert amber"><Icon Name="alert" Size="15" /><span>No se encontro la interaccion solicitada.</span></div>
        }
        else
        {
            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-body">
                        <div style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(260px,.8fr);gap:18px;align-items:start;">
                            <div>
                                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">
                                    <span class="cl-badge @(EsPropietario ? "amber" : "blue") plain">@PersonaTipo</span>
                                    <span class="cl-badge gray">@ContextoTitulo</span>
                                    <ResultadoBadge Resultado="@_interaccion.Resultado" Contexto="@_interaccion.Contexto" />
                                </div>
                                <div style="font-size:24px;font-weight:720;letter-spacing:0;line-height:1.1;">@PersonaNombre</div>
                                <div class="cl-muted" style="font-size:12.5px;margin-top:6px;">@ContextoDescripcion</div>
                            </div>
                            <div class="cl-specs" style="grid-template-columns:1fr;">
                                <Spec Icon="calendar" K="Fecha y hora" V="@_interaccion.FechaHoraTexto" />
                                <Spec Icon="messageSquare" K="Canal" V="@GetCanalLabel(_interaccion.CanalContacto)" />
                                <Spec Icon="users" K="Agente" V="@Txt(_interaccion.NombreAgenteResponsable)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,360px);gap:14px;align-items:start;">
                    <div class="cl-stack">
                        <div class="cl-card">
                            <div class="cl-card-head">
                                <div>
                                    <div class="cl-card-title">Proceso vinculado</div>
                                    <div class="cl-card-sub">Donde se guarda esta parte del historial comercial</div>
                                </div>
                            </div>
                            <div class="cl-card-body">
                                <div class="cl-specs">
                                    <Spec Icon="@ProcesoIcono" K="Tipo de interaccion" V="@ContextoTitulo" />
                                    <Spec Icon="hash" K="Codigo" V="@CodigoProceso" />
                                    <Spec Icon="store" K="Captacion" V="@Txt(_interaccion.CaptacionCodigo)" />
                                    <Spec Icon="user" K="Cliente" V="@Txt(_interaccion.ClienteNombre)" />
                                    <Spec Icon="user" K="Propietario" V="@Txt(_interaccion.PropietarioNombre)" />
                                    <Spec Icon="target" K="Oportunidad" V="@(_interaccion.OportunidadId > 0 ? _interaccion.OportunidadId.ToString() : "-")" />
                                </div>
                            </div>
                        </div>

                        @if (_captacion is not null)
                        {
                            <div class="cl-card">
                                <div class="cl-card-head"><div class="cl-card-title">Propiedad relacionada</div></div>
                                <div class="cl-card-body">
                                    <div class="cl-specs">
                                        <Spec Icon="hash" K="Codigo" V="@_captacion.CodigoCaptacion" />
                                        <Spec Icon="mapPin" K="Direccion" V="@_captacion.DireccionLocal" />
                                        <Spec Icon="map" K="Distrito" V="@_captacion.DistritoLocal" />
                                        <Spec Icon="briefcase" K="Rubro" V="@_captacion.Rubro" />
                                        <Spec Icon="user" K="Propietario" V="@_captacion.PropietarioNombre" />
                                        <Spec Icon="building" K="Area" V="@($"{_captacion.AreaM2} m2")" />
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="cl-card">
                            <div class="cl-card-head">
                                <div class="cl-card-title">Detalle</div>
                                @if (App.Role == Roles.Agente)
                                {
                                    <button class="cl-btn sm" @onclick="@(() => _editModal = true)"><Icon Name="edit" Size="12" /> Editar notas</button>
                                }
                            </div>
                            <div class="cl-card-body">
                                @if (string.IsNullOrWhiteSpace(_interaccion.Observaciones))
                                {
                                    <div class="cl-muted">Sin observaciones registradas.</div>
                                }
                                else
                                {
                                    <div style="color:#4D5461;font-size:13px;line-height:1.7;">@_interaccion.Observaciones</div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_interaccion.TranscripcionNota))
                                {
                                    <div class="cl-divider" style="margin:16px 0;"></div>
                                    <div class="cl-def-k" style="margin-bottom:6px;">Transcripcion / nota</div>
                                    <div style="color:#4D5461;font-size:13px;line-height:1.7;">@_interaccion.TranscripcionNota</div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="cl-stack">
                        <div class="cl-card">
                            <div class="cl-card-head"><div class="cl-card-title">Resultado</div></div>
                            <div class="cl-card-body">
                                <div style="text-align:center;padding:12px 0;margin-bottom:16px;">
                                    <ResultadoBadge Resultado="@_interaccion.Resultado" Contexto="@_interaccion.Contexto" />
                                </div>
                                @if (App.Role == Roles.Agente)
                                {
                                    <div class="cl-divider"></div>
                                    <div style="margin-top:16px;">
                                        <label class="cl-label">Cambiar resultado</label>
                                        <select class="cl-select" @bind="_nuevoResultado" style="width:100%;margin-bottom:10px;">
                                            <option value="">Seleccionar</option>
                                            @foreach (var resultado in ResultadosDisponibles)
                                            {
                                                <option value="@resultado.Code">@resultado.Label</option>
                                            }
                                        </select>
                                        <button class="cl-btn primary" style="width:100%;justify-content:center;" @onclick="ActualizarResultado">
                                            <Icon Name="check" Size="13" /> Actualizar
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (_toastMsg is not null)
                        {
                            <div class="cl-alert blue">
                                <Icon Name="check" Size="15" />
                                <span>@_toastMsg</span>
                            </div>
                        }

                        <div class="cl-alert blue">
                            <Icon Name="info" Size="15" />
                            <span>Esta pantalla muestra el historial dentro de su contexto exacto: prospeccion, captacion, oportunidad o cliente.</span>
                        </div>
                    </div>
                </div>
            </div>

            <Modal Open="@_editModal" Tone="blue" Icon="edit"
                   Title="Editar observaciones"
                   Desc="Actualiza las notas sobre esta interaccion"
                   OnClose="@(() => _editModal = false)">
                <ChildContent>
                    <label class="cl-field">
                        <span>Observaciones</span>
                        <textarea @bind="_obsEditTemp" rows="4" placeholder="Anota los detalles de la interaccion..."></textarea>
                    </label>
                </ChildContent>
                <Footer>
                    <button class="cl-btn ghost" @onclick="@(() => _editModal = false)">Cancelar</button>
                    <button class="cl-btn primary" @onclick="GuardarObservaciones">Guardar observaciones</button>
                </Footer>
            </Modal>
        }
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? InteraccionIdParam { get; set; }

    private InteraccionComercialDto? _interaccion;
    private CaptacionDto? _captacion;
    private string _nuevoResultado = "";
    private string? _toastMsg;
    private bool _editModal;
    private string _obsEditTemp = "";

    protected override void OnParametersSet()
    {
        _interaccion = long.TryParse(InteraccionIdParam, out var id)
            ? InteraccionSvc.ById(id)
            : null;

        if (_interaccion is null)
            return;

        _obsEditTemp = _interaccion.Observaciones;
        _captacion = !string.IsNullOrWhiteSpace(_interaccion.CaptacionCodigo)
            ? CaptacionSvc.ByCodigo(_interaccion.CaptacionCodigo)
            : null;
    }

    private bool EsPropietario => _interaccion?.GrupoContexto == "propietario";
    private string PersonaTipo => _interaccion?.PersonaTipoMostrar ?? "Persona";
    private string PersonaNombre => Txt(_interaccion?.PersonaNombreMostrar);
    private string ContextoTitulo => _interaccion?.ContextoTexto ?? "Interaccion";
    private string ProcesoIcono => _interaccion?.Contexto switch
    {
        "PROSPECCION" => "history",
        "CAPTACION" => "store",
        "CLIENTE" => "user",
        _ => "target",
    };

    private string ContextoDescripcion => _interaccion?.Contexto switch
    {
        "PROSPECCION" => "Propietario antes de captar la propiedad.",
        "CAPTACION" => "Propietario con propiedad ya captada.",
        "CLIENTE" => "Relacion comercial con cliente sin propiedad fija.",
        _ => "Contacto del agente con el cliente sobre una propiedad especifica.",
    };

    private string CodigoProceso => _interaccion is null ? "-" : _interaccion.Contexto switch
    {
        "PROSPECCION" => Txt(_interaccion.CodigoProspeccion),
        "CAPTACION" => Txt(_interaccion.CaptacionCodigo),
        "CLIENTE" => _interaccion.ClienteId > 0 ? _interaccion.ClienteId.ToString() : "-",
        _ => _interaccion.OportunidadId > 0 ? _interaccion.OportunidadId.ToString() : Txt(_interaccion.CaptacionCodigo),
    };

    private string RutaProceso => _interaccion?.Contexto switch
    {
        "PROSPECCION" when _interaccion.ProspeccionId > 0 => $"/prospeccion-detail/{_interaccion.ProspeccionId}",
        "CAPTACION" when !string.IsNullOrWhiteSpace(_interaccion.CaptacionCodigo) => $"/captacion-detail/{_interaccion.CaptacionCodigo}",
        "CLIENTE" when _interaccion.ClienteId > 0 => $"/cliente-detail/{_interaccion.ClienteId}",
        _ when _interaccion?.OportunidadId > 0 => $"/oportunidad-detail/{_interaccion.OportunidadId}",
        _ => "",
    };

    private void ActualizarResultado()
    {
        if (_interaccion is null || string.IsNullOrEmpty(_nuevoResultado))
            return;

        _interaccion = InteraccionSvc.Actualizar(_interaccion.Id, resultado: _nuevoResultado);
        _nuevoResultado = "";
        _toastMsg = "Resultado actualizado correctamente";
        _ = OcultarToastAsync();
    }

    private void GuardarObservaciones()
    {
        if (_interaccion is null)
            return;

        _interaccion = InteraccionSvc.Actualizar(_interaccion.Id, observaciones: _obsEditTemp);
        _editModal = false;
        _toastMsg = "Observaciones guardadas correctamente";
        _ = OcultarToastAsync();
    }

    private async Task OcultarToastAsync()
    {
        await DelayThenRenderAsync(2000, () => _toastMsg = null);
    }

    private static string GetCanalLabel(string? canal) =>
        EnumCatalog.LabelFor(EnumCatalog.CanalesContacto, canal);

    private IReadOnlyList<EnumOption> ResultadosDisponibles =>
        EnumCatalog.ResultadosInteraccionPorContexto(_interaccion?.Contexto ?? "OPORTUNIDAD");

    private static string Txt(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "-" : valor;
}
