@page "/interaccion-form"
@page "/interaccion-form/{OportunidadIdParam:long}"
@inherits SafeComponentBase
@inject AppState App
@inject IOportunidadService OportunidadSvc
@inject IInteraccionService InteraccionSvc
@using ControlLocal.Web.Models.Oportunidades

<PageTitle>Registrar interacción · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Operación", "Nueva interacción" })"
          Title="Registrar interacción comercial"
          Subtitle="Registra el contacto sobre una oportunidad comercial existente">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("interacciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 250px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Oportunidad comercial" Sub="La oportunidad determina la captación y el cliente relacionados">
                    <Field Label="Oportunidad" Required="true">
                        <select @bind="_oportunidadId" disabled="@_cargando">
                            <option value="0">@(_cargando ? "Cargando oportunidades…" : "— Seleccionar —")</option>
                            @foreach (var oportunidad in _oportunidades)
                            {
                                <option value="@oportunidad.Id">@oportunidad.CodigoOportunidad · @oportunidad.CaptacionCodigo · @oportunidad.ClienteNombre</option>
                            }
                        </select>
                    </Field>
                    @if (OportunidadSeleccionada is not null)
                    {
                        <div class="cl-grid c2" style="margin-top:12px;">
                            <Field Label="Local"><input value="@OportunidadSeleccionada.DireccionLocal" disabled /></Field>
                            <Field Label="Cliente"><input value="@OportunidadSeleccionada.ClienteNombre" disabled /></Field>
                        </div>
                    }
                </FormSection>

                <FormSection Num="2" Title="Contacto" Sub="Canal y resultado registrados por el agente">
                    <div class="cl-grid c2">
                        <Field Label="Canal" Required="true">
                            <select @bind="_canalContacto">
                                <option value="">— Seleccionar —</option>
                                @foreach (var opcion in EnumCatalog.CanalesContacto)
                                {
                                    <option value="@opcion.Code">@opcion.Label</option>
                                }
                            </select>
                        </Field>
                        <Field Label="Resultado" Required="true">
                            <select @bind="_resultado">
                                <option value="">— Seleccionar —</option>
                                @foreach (var opcion in EnumCatalog.ResultadosInteraccion)
                                {
                                    <option value="@opcion.Code">@opcion.Label</option>
                                }
                            </select>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Detalle" Sub="Notas del contacto que se conservarán en el historial">
                    <div class="cl-grid c1">
                        <Field Label="Observaciones">
                            <textarea rows="3" @bind="_observaciones" placeholder="Acuerdos, objeciones o siguiente paso..."></textarea>
                        </Field>
                        <Field Label="Transcripción o nota">
                            <textarea rows="3" @bind="_transcripcion" placeholder="Resumen ampliado de la conversación..."></textarea>
                        </Field>
                    </div>
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("interacciones"))"
                               OnSave="@TryConfirm"
                               SaveLabel="Registrar interacción"
                               Busy="@_procesando"
                               BusyLabel="Registrando..." />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="target"
                       Title="¿Registrar interacción comercial?"
                       Desc="Se guardará el contacto en el historial de la oportunidad seleccionada."
                       ConfirmLabel="Confirmar" CancelLabel="Revisar datos"
                       Busy="@_procesando"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">Interacción registrada correctamente</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public long OportunidadIdParam { get; set; }

    private long _oportunidadId;
    private string _canalContacto = "";
    private string _resultado = "";
    private string _observaciones = "";
    private string _transcripcion = "";
    private bool _confirm;
    private bool _toast;
    private bool _procesando;
    private bool _cargando = true;
    private string? _err;
    private IReadOnlyList<OportunidadComercialDto> _oportunidades = [];

    private OportunidadComercialDto? OportunidadSeleccionada =>
        _oportunidades.FirstOrDefault(item => item.Id == _oportunidadId);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Oportunidad", "Cliente y captación", _oportunidadId > 0),
        new FormStepsSidebar.Step("Contacto", "Canal y resultado", _canalContacto.Length > 0 && _resultado.Length > 0),
        new FormStepsSidebar.Step("Detalle", "Notas opcionales", true),
    };

    protected override async Task OnInitializedAsync()
    {
        if (OportunidadIdParam > 0)
            _oportunidadId = OportunidadIdParam;

        try
        {
            _oportunidades = await OportunidadSvc.RefrescarAsync(DisposedToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void TryConfirm()
    {
        if (_procesando) return;
        if (OportunidadSeleccionada is null) { _err = "Debes seleccionar una oportunidad comercial válida."; return; }
        if (!EnumCatalog.CanalesContacto.Any(item => item.Code == _canalContacto)) { _err = "Debes seleccionar un canal de contacto válido."; return; }
        if (!EnumCatalog.ResultadosInteraccion.Any(item => item.Code == _resultado)) { _err = "Debes seleccionar un resultado válido."; return; }
        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        if (_procesando) return;
        _confirm = false;
        try
        {
            _procesando = true;
            await RenderIfAliveAsync();
            InteraccionSvc.Agregar(new InteraccionFormRequest
            {
                OportunidadId = _oportunidadId,
                CanalContacto = _canalContacto,
                Resultado = _resultado,
                Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones.Trim(),
                TranscripcionNota = string.IsNullOrWhiteSpace(_transcripcion) ? null : _transcripcion.Trim(),
            });
        }
        catch (InvalidOperationException error)
        {
            _err = error.Message;
            return;
        }
        finally
        {
            _procesando = false;
        }

        _toast = true;
        App.Navigate("interacciones");
    }
}
