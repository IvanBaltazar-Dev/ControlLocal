@page "/interacciones"
@inherits SafeComponentBase
@inject AppState App
@inject IInteraccionService InteraccionSvc

<PageTitle>Interacciones comerciales - ControlLocal</PageTitle>

<AppShell Active="Interacciones comerciales" Crumbs="@(new[] { "ControlLocal", "Operación", "Interacciones comerciales" })"
          Title="Registro de interacciones comerciales"
          Subtitle="Historial separado por lado de la relación: cliente y propietario">
    <Actions>
        @if (App.Role == Roles.Agente)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("interaccion-form"))"><Icon Name="plus" Size="13" /> Nueva interacción</button>
        }
        else
        {
            <span class="cl-badge blue"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
    </Actions>
    <ChildContent>
        <div class="cl-card">
            <div style="padding:10px 14px 0;">
                <Tabs Active="@_grupo" OnSelect="CambiarGrupo" Items="_grupos" />
            </div>
            <div class="cl-card-body" style="padding-top:12px;">
                <FilterBar Search="Buscar persona, codigo, observación..."
                           Value="@_query"
                           ValueChanged="CambiarBusqueda"
                           ResultCount="@_total"
                           HasActiveFilters="HayFiltros"
                           OnClear="LimpiarFiltros">
                    <select class="cl-select" value="@_filterCanal" @onchange="CambiarCanal">
                        <option value="">Canal</option>
                        @foreach (var opcion in EnumCatalog.CanalesContacto)
                        {
                            <option value="@opcion.Code">@opcion.Label</option>
                        }
                    </select>
                    <select class="cl-select" value="@_filterResultado" @onchange="CambiarResultado">
                        <option value="">Resultado</option>
                        @foreach (var opcion in ResultadosFiltro)
                        {
                            <option value="@opcion.Code">@opcion.Label</option>
                        }
                    </select>
                </FilterBar>
            </div>
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Contexto</th>
                            <th>Cliente/Propietario</th>
                            <th>Canal</th>
                            <th>Resultado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inter in _items)
                        {
                            <tr @onclick="@(() => App.Navigate($"interaccion-detail/{inter.Id}"))">
                                <td style="font-size:12px;color:#7E8794;">@inter.FechaHoraTexto</td>
                                <td><span class="cl-badge gray">@inter.ContextoTexto</span></td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:8px;min-width:0;">
                                        <span class="cl-badge @(inter.GrupoContexto == "propietario" ? "amber" : "blue") plain">@inter.PersonaTipoMostrar</span>
                                        <span style="font-weight:650;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@PersonaNombre(inter)</span>
                                    </div>
                                </td>
                                <td><CanalBadge Canal="@inter.CanalContacto" /></td>
                                <td><ResultadoBadge Resultado="@inter.Resultado" Contexto="@inter.Contexto" /></td>
                                <td><button class="cl-btn sm ghost" @onclick:stopPropagation="true" @onclick="@(() => App.Navigate($"interaccion-detail/{inter.Id}"))"><Icon Name="eye" Size="13" /> Ver</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Cargando interacciones...</div>
                }
                else if (_items.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="target" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin interacciones en este filtro</div>
                        <div style="font-size:12px;">Cambia los filtros o registra un contacto desde el proceso correspondiente.</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="cl-alert amber" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
            </div>
        </div>
        <Pagination Total="@_total" PageSize="@PageSize" Page="@_pagina" PageChanged="CambiarPagina" />
    </ChildContent>
</AppShell>

@code {
    private const int PageSize = 8;
    private string _filterResultado = "";
    private string _filterCanal = "";
    private string _query = "";
    private string _grupo = "Todas";
    private int _pagina = 1;
    private int _total;
    private bool _cargando = true;
    private string? _error;
    private IReadOnlyList<InteraccionComercialDto> _items = [];

    private Tabs.TabItem[] _grupos =>
    [
        new("Todas", _grupo == "Todas" ? _total : null),
        new("Con cliente", _grupo == "Con cliente" ? _total : null),
        new("Con propietario", _grupo == "Con propietario" ? _total : null),
    ];

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task CambiarGrupo(string grupo)
    {
        if (_grupo == grupo)
            return;
        _grupo = grupo;
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarBusqueda(string value)
    {
        _query = value;
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarCanal(ChangeEventArgs e)
    {
        _filterCanal = e.Value?.ToString() ?? "";
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarResultado(ChangeEventArgs e)
    {
        _filterResultado = e.Value?.ToString() ?? "";
        _pagina = 1;
        await Cargar();
    }

    private async Task LimpiarFiltros()
    {
        _query = _filterCanal = _filterResultado = "";
        _pagina = 1;
        await Cargar();
    }

    private async Task CambiarPagina(int page)
    {
        _pagina = page;
        await Cargar();
    }

    private async Task Cargar()
    {
        _cargando = true;
        _error = null;
        try
        {
            var pagina = await InteraccionSvc.ListarPaginaAsync(
                _pagina,
                PageSize,
                _grupo,
                _filterResultado,
                _filterCanal,
                _query,
                DisposedToken);
            _items = pagina.Items;
            _total = (int)Math.Min(int.MaxValue, pagina.TotalRecords);
            _pagina = pagina.Page;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _items = [];
            _total = 0;
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private bool HayFiltros =>
        !string.IsNullOrWhiteSpace(_query)
        || !string.IsNullOrWhiteSpace(_filterCanal)
        || !string.IsNullOrWhiteSpace(_filterResultado);

    private static IReadOnlyList<EnumOption> ResultadosFiltro =>
        EnumCatalog.ResultadosProspeccionInteraccion
            .Concat(EnumCatalog.ResultadosCaptacionInteraccion)
            .Concat(EnumCatalog.ResultadosOportunidadInteraccion)
            .Concat(EnumCatalog.ResultadosClienteInteraccion)
            .GroupBy(item => item.Code)
            .Select(group => group.First())
            .ToList();

    private static string PersonaNombre(InteraccionComercialDto interaccion)
    {
        if (!string.IsNullOrWhiteSpace(interaccion.PersonaNombreMostrar))
            return interaccion.PersonaNombreMostrar;
        return interaccion.GrupoContexto == "propietario" ? "Propietario sin nombre" : "Cliente sin nombre";
    }
}
