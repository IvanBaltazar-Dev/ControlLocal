@page "/local-detail/{IdParam?}"
@inject AppState App
@inject ILocalService LocalSvc
@inject IProspeccionService ProspeccionSvc
@inject IPrecioLocalService PrecioSvc
@inject IPublicacionService PublicacionSvc

<PageTitle>@_l.CodigoLocal - ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Registro", "Locales", _l.CodigoLocal })"
          Title="@($"{_l.CodigoLocal} - {_l.Direccion}")"
          Subtitle="@($"Ficha de prospeccion del local - {_l.Distrito}")">
    <Actions>
        <a class="cl-btn ghost" href="@(_readOnly ? "/seguimiento-comercial" : "/locales")"><Icon Name="chevronLeft" Size="13" /> Volver</a>
        @if (_readOnly)
        {
            <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
        else
        {
            <a class="cl-btn" href="/captacion-form"><Icon Name="pin" Size="13" /> Crear captacion</a>
            <a class="cl-btn primary" href="@($"/local-form/{_l.Id}")"><Icon Name="edit" Size="13" /> Editar local</a>
        }
    </Actions>
    <ChildContent>
        <DetailHero Eyebrow="@($"Ficha de prospeccion - {_l.CodigoLocal}")" EyebrowIcon="store"
                    Title="@_l.Direccion"
                    Subtitle="@($"{_l.Distrito} - {_l.Rubro}")"
                    SubtitleIcon="mapPin"
                    Status="@EtapaMasAvanzada"
                    Stats="@_heroStats" />

        <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,360px);gap:16px;align-items:start;">
            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-head">
                        <div>
                            <div class="cl-card-title">La propiedad</div>
                            <div class="cl-card-sub">Datos comerciales del local prospectado</div>
                        </div>
                        <div class="cl-flex" style="gap:8px;">
                            <FichaLink Kind="owner" Id="@_l.PropietarioId" Text="Ver propietario" Variant="button" />
                            <StatusBadge Label="@_l.Estado" />
                        </div>
                    </div>
                    <div class="cl-card-body">
                        <div class="cl-specs">
                            <Spec Icon="mapPin" K="Direccion" V="@_l.Direccion" />
                            <Spec Icon="map" K="Distrito" V="@_l.Distrito" />
                            <Spec Icon="building" K="Area" V="@($"{_l.AreaM2} m2")" />
                            <Spec Icon="briefcase" K="Rubro" V="@_l.Rubro" />
                            <Spec Icon="user" K="Propietario" V="@_l.PropietarioNombre" />
                            <Spec Icon="calendar" K="Registro" V="@FechaRegistroTexto" />
                            <Spec Icon="pin" K="Captacion" V="@Txt(_prospeccion?.CaptacionCodigo)" />
                            <Spec Icon="chart" K="Precio ref." V="@($"USD {_l.PrecioReferencialTexto}")" />
                        </div>
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head">
                        <div>
                            <div class="cl-card-title">Seguimiento previo a captar</div>
                            <div class="cl-card-sub">Hitos reales registrados para este local</div>
                        </div>
                        <span class="cl-badge blue plain">@EstadoProspeccionTexto</span>
                    </div>
                    <div class="cl-card-body">
                        <div class="cl-timeline">
                            @foreach (var paso in Timeline)
                            {
                                <div class="cl-tl-item">
                                    <div class="cl-tl-dot @(paso.Completado ? "done" : paso.Activo ? "active" : "")"></div>
                                    <div class="cl-tl-time">@paso.Fecha</div>
                                    <div class="cl-tl-title">@paso.Titulo</div>
                                    @if (!string.IsNullOrWhiteSpace(paso.Detalle))
                                    {
                                        <div class="cl-tl-body">@paso.Detalle</div>
                                    }
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_prospeccion?.Observaciones))
                        {
                            <div class="cl-alert blue" style="margin-top:16px;">
                                <Icon Name="info" Size="15" />
                                <span>@_prospeccion.Observaciones</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Ficha tecnica</div></div>
                    <div class="cl-card-body">
                        <div class="cl-specs">
                            <Spec Icon="building" K="Tipo" V="@Etiqueta(EnumCatalog.TiposInmueble, _l.TipoInmueble)" />
                            <Spec Icon="briefcase" K="Uso" V="@Etiqueta(EnumCatalog.UsosInmueble, _l.Uso)" />
                            <Spec Icon="component" K="Ambientes" V="@Num(_l.Ambientes)" />
                            <Spec Icon="history" K="Antiguedad" V="@Num(_l.AntiguedadAnios)" />
                            <Spec Icon="arrowRight" K="Frente" V="@Dec(_l.Frente)" />
                            <Spec Icon="grid" K="Estacionamientos" V="@Num(_l.NumeroEstacionamientos)" />
                            <Spec Icon="activity" K="Carga electrica" V="@Dec(_l.CargaElectricaKw)" />
                            <Spec Icon="checkCircle" K="Licencia" V="@SiNo(_l.AptoLicenciaFuncionamiento)" />
                            <Spec Icon="map" K="Zonificacion" V="@Txt(_l.Zonificacion)" />
                            <Spec Icon="settings" K="Mantenimiento" V="@Dec(_l.CuotaMantenimiento)" />
                        </div>
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Historico de precios</div></div>
                    <div class="cl-card-body">
                        @if (_precios.Count == 0)
                        {
                            <table class="cl-table">
                                <thead><tr><th>Fecha</th><th>Hito</th><th style="text-align:right;">Monto</th></tr></thead>
                                <tbody>
                                    <tr>
                                        <td>@FechaPrecioInicial</td>
                                        <td>Precio inicial</td>
                                        <td style="text-align:right;font-weight:600;">USD @PrecioInicialTexto</td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <table class="cl-table">
                                <thead><tr><th>Fecha</th><th>Hito</th><th style="text-align:right;">Monto</th></tr></thead>
                                <tbody>
                                    @foreach (var precio in _precios)
                                    {
                                        <tr>
                                            <td>@precio.FechaTexto</td>
                                            <td>@precio.HitoTexto</td>
                                            <td style="text-align:right;font-weight:600;">@precio.Moneda @precio.MontoTexto</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Etapa mas avanzada</div></div>
                    <div class="cl-card-body">
                        <div style="font-size:24px;font-weight:700;letter-spacing:-0.02em;">@EtapaMasAvanzada</div>
                        <div class="cl-muted" style="font-size:12px;margin-top:6px;">@EstadoProspeccionTexto</div>
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Seguimiento de prospeccion</div></div>
                    <div class="cl-card-body cl-stack">
                        <FilaExpediente Icon="store" Titulo="Ficha de prospeccion" Estado="@EstadoProspeccionTexto">
                            <Accion>
                                @if (_prospeccion is not null)
                                {
                                    <a class="cl-btn sm" href="@($"/prospeccion-detail/{_prospeccion.Id}")"><Icon Name="activity" Size="12" /> Seguimiento</a>
                                }
                            </Accion>
                        </FilaExpediente>
                        <FilaExpediente Icon="fileText" Titulo="Propuesta al propietario" Estado="@EstadoPropuesta" />
                        @if (!string.IsNullOrWhiteSpace(_prospeccion?.CaptacionCodigo))
                        {
                            <div class="cl-filerow">
                                <div class="cl-fileicon"><Icon Name="pin" Size="15" /></div>
                                <div class="cl-grow">
                                    <div style="font-weight:600;font-size:13px;">Captacion vinculada</div>
                                    <div class="cl-muted" style="font-size:11.5px;">@_prospeccion.CaptacionCodigo</div>
                                </div>
                                <a class="cl-btn sm" href="@($"/captacion-detail/{_prospeccion.CaptacionCodigo}")"><Icon Name="eye" Size="12" /> Ver</a>
                            </div>
                        }
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head">
                        <div class="cl-card-title">Publicaciones</div>
                        @if (!_readOnly)
                        {
                            <button class="cl-btn sm primary" @onclick="NuevaPublicacion"><Icon Name="plus" Size="12" /> Publicar</button>
                        }
                    </div>
                    <div class="cl-card-body">
                        @if (_publicaciones.Count == 0)
                        {
                            <div class="cl-muted" style="font-size:13px;">El local aun no se ha publicado.</div>
                        }
                        else
                        {
                            <div class="cl-stack">
                                @foreach (var pub in _publicaciones)
                                {
                                    <div style="border-bottom:1px solid var(--c-border);padding-bottom:8px;">
                                        <div class="cl-flex" style="justify-content:space-between;gap:10px;align-items:flex-start;">
                                            <div style="min-width:0;">
                                                <div style="font-weight:600;font-size:13px;">@pub.CanalTexto</div>
                                                <div class="cl-muted" style="font-size:11.5px;">@pub.TituloAnuncio - @pub.FechaPublicacionTexto</div>
                                                @if (!string.IsNullOrWhiteSpace(pub.UrlPublicacion))
                                                {
                                                    <a href="@pub.UrlPublicacion" target="_blank" rel="noopener" style="font-size:11.5px;"><Icon Name="arrowUpRight" Size="11" /> Ver anuncio</a>
                                                }
                                            </div>
                                            <StatusBadge Label="@pub.EstadoTexto" />
                                        </div>
                                        @if (!_readOnly)
                                        {
                                            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
                                                <button class="cl-btn sm" disabled="@_pubBusy" @onclick="() => EditarPublicacion(pub)"><Icon Name="edit" Size="11" /> Editar</button>
                                                @if (pub.Estado == "P")
                                                {
                                                    <button class="cl-btn sm ghost" disabled="@_pubBusy" @onclick="() => PausarPub(pub)">Pausar</button>
                                                }
                                                else if (pub.Estado is "S" or "B")
                                                {
                                                    <button class="cl-btn sm ghost" disabled="@_pubBusy" @onclick="() => PublicarPub(pub)">Publicar</button>
                                                }
                                                @if (pub.Estado != "C")
                                                {
                                                    <button class="cl-btn sm ghost" disabled="@_pubBusy" @onclick="() => CerrarPub(pub)">Cerrar</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <PublicacionEditor Open="_pubEditorOpen" IdLocal="_l.Id" Existing="_pubEditing"
                                   OnClose="CerrarEditorPub" OnSaved="OnPubGuardado" />
            </div>
        </div>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? IdParam { get; set; }

    private LocalComercialDto _l = new();
    private ProspeccionDto? _prospeccion;
    private IReadOnlyList<PrecioLocalDto> _precios = [];
    private IReadOnlyList<PublicacionDto> _publicaciones = [];
    private bool _pubEditorOpen;
    private PublicacionDto? _pubEditing;
    private bool _pubBusy;
    private bool _readOnly => App.Role == Roles.Broker || App.Role == Roles.Admin;

    private List<DetailHero.Stat> _heroStats => new()
    {
        new("Area", _l.AreaM2.ToString(System.Globalization.CultureInfo.InvariantCulture), "m2"),
        new("Precio", $"USD {_l.PrecioReferencialTexto}"),
        new("Propietario", Txt(_l.PropietarioNombre)),
        new("Captacion", Txt(_prospeccion?.CaptacionCodigo)),
    };

    protected override async Task OnParametersSetAsync()
    {
        _l = (long.TryParse(IdParam, out var id) ? LocalSvc.ById(id) : null)
             ?? LocalSvc.All().FirstOrDefault() ?? new();

        if (_l.Id > 0)
        {
            try
            {
                var prospecciones = await ProspeccionSvc.RefrescarAsync();
                _prospeccion = prospecciones
                    .Where(p => p.LocalId == _l.Id || Igual(p.Direccion, _l.Direccion))
                    .OrderByDescending(p => RangoEstado(p.Estado))
                    .FirstOrDefault();
                _precios = await PrecioSvc.ListarPorLocalAsync(_l.Id);
                _publicaciones = await PublicacionSvc.ListarPorLocalAsync(_l.Id);
            }
            catch
            {
                _precios = [];
                _publicaciones = [];
            }
        }
    }

    private void NuevaPublicacion()
    {
        _pubEditing = null;
        _pubEditorOpen = true;
    }

    private void EditarPublicacion(PublicacionDto p)
    {
        _pubEditing = p;
        _pubEditorOpen = true;
    }

    private void CerrarEditorPub() => _pubEditorOpen = false;

    private async Task OnPubGuardado()
    {
        _pubEditorOpen = false;
        await RecargarPublicaciones();
    }

    private Task PausarPub(PublicacionDto p) => CambiarEstadoPub(p, "S");

    private Task PublicarPub(PublicacionDto p) => CambiarEstadoPub(p, "P");

    private Task CerrarPub(PublicacionDto p) => CambiarEstadoPub(p, "C");

    private async Task CambiarEstadoPub(PublicacionDto p, string estado)
    {
        if (_pubBusy)
        {
            return;
        }
        _pubBusy = true;
        try
        {
            await PublicacionSvc.CambiarEstadoAsync(_l.Id, p.Id, estado);
            await RecargarPublicaciones();
        }
        finally
        {
            _pubBusy = false;
        }
    }

    private async Task RecargarPublicaciones()
    {
        try
        {
            _publicaciones = await PublicacionSvc.ListarPorLocalAsync(_l.Id);
        }
        catch
        {
            // Conservamos la lista actual si falla el refresco.
        }
    }

    private IEnumerable<PasoProspeccion> Timeline
    {
        get
        {
            yield return new PasoProspeccion("Local registrado", FechaRegistroTexto, _l.PropietarioNombre, true, false);
            yield return new PasoProspeccion("Contacto con propietario", Txt(_prospeccion?.FechaContactoTexto), _prospeccion?.PropietarioNombre, !string.IsNullOrWhiteSpace(_prospeccion?.FechaContactoTexto), _prospeccion?.Estado == "C");
            yield return new PasoProspeccion("Reunion registrada", Txt(_prospeccion?.FechaReunionTexto), _l.Direccion, !string.IsNullOrWhiteSpace(_prospeccion?.FechaReunionTexto), _prospeccion?.Estado == "R");
            yield return new PasoProspeccion("Propuesta entregada", Txt(_prospeccion?.FechaPropuestaTexto), ResultadoPropuestaTexto, !string.IsNullOrWhiteSpace(_prospeccion?.FechaPropuestaTexto), _prospeccion?.Estado == "E" || _prospeccion?.Estado == "S");
            yield return new PasoProspeccion("Captacion", Txt(_prospeccion?.CaptacionCodigo), _prospeccion?.CaptacionCodigo, !string.IsNullOrWhiteSpace(_prospeccion?.CaptacionCodigo), _prospeccion?.Estado == "T");
        }
    }

    private string EtapaMasAvanzada => _prospeccion?.Estado switch
    {
        "T" => "Captada",
        "S" => "En seguimiento",
        "E" => "Propuesta entregada",
        "R" => "Reunion",
        "C" => "Contactado",
        "D" => "Descartado",
        "P" => "Prospecto",
        _ => _l.Estado,
    };

    private string EstadoProspeccionTexto => _prospeccion is null ? "Sin prospeccion vinculada" : _prospeccion.Estado switch
    {
        "T" => "Captado",
        "S" => "En seguimiento",
        "E" => "Propuesta entregada",
        "R" => "Reunion registrada",
        "C" => "Contactado",
        "D" => "Descartado",
        _ => "Prospecto",
    };

    private string EstadoPropuesta => string.IsNullOrWhiteSpace(_prospeccion?.FechaPropuestaTexto)
        ? "Pendiente"
        : $"Entregada {_prospeccion.FechaPropuestaTexto}";

    private string ResultadoPropuestaTexto => _prospeccion?.ResultadoPropuesta switch
    {
        "A" => "Aceptada",
        "R" => "Rechazada",
        "S" => $"Recontactar {Txt(_prospeccion.FechaRecontactoTexto)}",
        "P" => "Pendiente",
        _ => "",
    };

    private string FechaRegistroTexto => _l.FechaRegistro?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
    private string FechaPrecioInicial => _prospeccion?.FechaPropuestaTexto
        ?? _prospeccion?.FechaContactoTexto
        ?? FechaRegistroTexto;
    private string PrecioInicialTexto => string.IsNullOrWhiteSpace(_l.PrecioReferencialTexto) ? "-" : _l.PrecioReferencialTexto;

    private static int RangoEstado(string? estado) => estado switch
    {
        "T" => 6,
        "S" => 5,
        "E" => 4,
        "R" => 3,
        "C" => 2,
        "P" => 1,
        _ => 0,
    };

    private static bool Igual(string? a, string? b) =>
        string.Equals((a ?? "").Trim(), (b ?? "").Trim(), StringComparison.OrdinalIgnoreCase);

    private static string Txt(string? valor) => string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    private static string Num(int? valor) => valor?.ToString() ?? "-";
    private static string Dec(decimal? valor) =>
        valor?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "-";
    private static string SiNo(bool? valor) => valor is null ? "-" : valor.Value ? "Si" : "No";

    private static string Etiqueta(IReadOnlyList<ControlLocal.Web.Models.Shared.EnumOption> opciones, string? code) =>
        string.IsNullOrEmpty(code) ? "-" : opciones.FirstOrDefault(o => o.Code == code)?.Label ?? code;

    private record PasoProspeccion(string Titulo, string Fecha, string? Detalle, bool Completado, bool Activo);
}
