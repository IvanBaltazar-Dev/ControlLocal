@page "/local-form"
@page "/local-form/{IdParam?}"
@inject AppState App
@inject ILocalService LocalSvc
@inject IPropietarioService PropSvc
@inject IProspeccionService ProspeccionSvc

<PageTitle>@(_isEdit ? "Editar local" : "Registrar local") · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Locales comerciales", _isEdit ? _l.CodigoLocal : "Nuevo local" })"
          Title="@(_isEdit ? "Editar local comercial" : "Registrar local comercial")"
          Subtitle="@(_isEdit ? $"Edita datos del local {_l.CodigoLocal}" : "Alta del inmueble, su propietario y la ficha base para iniciar una captación")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("locales"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Propietario del local" Sub="Vincula un propietario ya registrado o crea uno nuevo">
                    <div class="cl-grid c2">
                        <Field Label="Propietario" Required="true">
                            @if (_isEdit && PropietarioSeleccionado is not null)
                            {
                                <div style="@PropPickStyle(true)">
                                    <span class="cl-avatar" style="width:26px;height:26px;font-size:10px;flex:0 0 26px;">@PropIniciales(PropietarioSeleccionado.Nombre)</span>
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;">@PropietarioSeleccionado.Nombre</div>
                                        <div class="cl-muted" style="font-size:11px;">@PropietarioSeleccionado.TipoPersona · @PropietarioSeleccionado.NumeroDocumento</div>
                                    </div>
                                    <Icon Name="check" Size="15" Color="#005BFF" />
                                </div>
                                <div class="cl-muted" style="font-size:11px;margin-top:6px;">No se puede cambiar el propietario. Contacta con administración si necesitas reasignar.</div>
                            }
                            else
                            {
                                <input class="cl-input search" type="search"
                                       placeholder="Escribe para buscar por nombre, razón social o documento…"
                                       value="@_busquedaPropietario"
                                       @oninput="OnBusquedaPropietario"
                                       @onfocus="@(() => _desplegarPropietarios = true)" />

                                <div style="margin-top:6px;max-height:230px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;">
                                    @if (_desplegarPropietarios || _propietarioId == 0)
                                    {
                                        @foreach (var p in PropietariosDisponibles)
                                        {
                                            var sel = _propietarioId == p.Id;
                                            <div role="button" tabindex="0"
                                                 style="@PropPickStyle(sel)"
                                                 @onclick="@(() => SeleccionarPropietario(p.Id))">
                                                <span class="cl-avatar" style="width:26px;height:26px;font-size:10px;flex:0 0 26px;">@PropIniciales(p.Nombre)</span>
                                                <div style="flex:1;min-width:0;">
                                                    <div style="font-weight:600;font-size:13px;">@p.Nombre</div>
                                                    <div class="cl-muted" style="font-size:11px;">@p.TipoPersona · @p.NumeroDocumento</div>
                                                </div>
                                                @if (sel)
                                                {
                                                    <Icon Name="check" Size="15" Color="#005BFF" />
                                                }
                                            </div>
                                        }
                                        @if (!PropietariosDisponibles.Any())
                                        {
                                            <div class="cl-help">No hay propietarios que coincidan con la búsqueda.</div>
                                        }
                                    }
                                    else if (PropietarioSeleccionado is not null)
                                    {
                                        <div role="button" tabindex="0"
                                             style="@PropPickStyle(true)"
                                             @onclick="@(() => _desplegarPropietarios = true)">
                                            <span class="cl-avatar" style="width:26px;height:26px;font-size:10px;flex:0 0 26px;">@PropIniciales(PropietarioSeleccionado.Nombre)</span>
                                            <div style="flex:1;min-width:0;">
                                                <div style="font-weight:600;font-size:13px;">@PropietarioSeleccionado.Nombre</div>
                                                <div class="cl-muted" style="font-size:11px;">@PropietarioSeleccionado.TipoPersona · @PropietarioSeleccionado.NumeroDocumento</div>
                                            </div>
                                            <Icon Name="check" Size="15" Color="#005BFF" />
                                        </div>
                                    }
                                </div>
                            }
                        </Field>
                        <Field Label="&nbsp;">
                            <button class="cl-btn" @onclick="@(() => App.Navigate("owner-form"))" disabled="@_isEdit"><Icon Name="plus" Size="13" /> Nuevo propietario</button>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="2" Title="Ubicación" Sub="Dirección exacta y distrito del local comercial">
                    <div class="cl-grid c2">
                        <Field Label="Dirección" Required="true"><input placeholder="Av. / Calle, número" @bind="_direccion" @bind:event="oninput" /></Field>
                        <Field Label="Zona o urbanización"><input placeholder="Urbanización, sector o referencia" @bind="_zonaUrbanizacion" /></Field>
                        <Field Label="Distrito" Required="true">
                            <input class="cl-input search" type="search"
                                   placeholder="Escribe para buscar distrito…"
                                   value="@(_desplegarDistritos ? _busquedaDistrito : _distrito)"
                                   @oninput="OnBusquedaDistrito"
                                   @onfocus="@(() => { _busquedaDistrito = string.Empty; _desplegarDistritos = true; })" />

                            @if (_desplegarDistritos)
                            {
                                <div style="margin-top:6px;max-height:230px;overflow-y:auto;display:flex;flex-direction:column;gap:4px;border:1px solid var(--c-border);border-radius:10px;background:#fff;padding:6px;">
                                    @foreach (var d in DistritosDisponibles)
                                    {
                                        var sel = _distrito == d;
                                        <div role="button" tabindex="0"
                                             style="@DistritoPickStyle(sel)"
                                             @onclick="@(() => SeleccionarDistrito(d))">
                                            <span style="flex:1;min-width:0;font-size:13px;@(sel ? "font-weight:600;" : "")">@d</span>
                                            @if (sel)
                                            {
                                                <Icon Name="check" Size="14" Color="#005BFF" />
                                            }
                                        </div>
                                    }
                                    @if (!DistritosDisponibles.Any())
                                    {
                                        <div class="cl-help" style="padding:8px;">No hay distritos que coincidan.</div>
                                    }
                                </div>
                            }
                        </Field>
                        <Field Label="Provincia"><input value="Lima" disabled="true" /></Field>
                        <Field Label="Latitud"><input type="number" step="0.0000001" @bind="_geoLat" placeholder="-12.1234567" /></Field>
                        <Field Label="Longitud"><input type="number" step="0.0000001" @bind="_geoLong" placeholder="-77.1234567" /></Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Características del local" Sub="Datos que verán los clientes interesados en la ficha">
                    <div class="cl-grid c3">
                        <Field Label="Área (m²)" Required="true"><input placeholder="Ej. 80" @bind="_areaMts" @bind:event="oninput" type="number" /></Field>
                        <Field Label="Rubro sugerido">
                            <select @bind="_rubro">
                                @foreach (var rubro in Rubros)
                                {
                                    <option value="@rubro">@rubro</option>
                                }
                            </select>
                        </Field>
                        <Field Label="Precio referencial (USD/mes)" Required="true"><input placeholder="1 500" @bind="_precioRef" @bind:event="oninput" type="number" /></Field>
                        <Field Label="Disponibilidad"><select @bind="_estado"><option>Disponible</option><option>No disponible</option><option>Inactivo</option></select></Field>
                        <Field Label="Tipo de inmueble"><select @bind="_tipoInmueble">@foreach (var opcion in EnumCatalog.TiposInmueble) { <option value="@opcion.Code">@opcion.Label</option> }</select></Field>
                        <Field Label="Uso"><input value="Comercial" disabled /></Field>
                        <Field Label="Antigüedad (en años)"><input placeholder="Ej. 5" @bind="_antiguedad" /></Field>
                        <Field Label="N.° de ambientes"><input placeholder="Ej. 3" @bind="_ambientes" /></Field>
                    </div>
                    <div style="margin-top:14px;">
                        <Field Label="Descripción y referencias" Hint="Características adicionales y referencias para ubicar el inmueble">
                            <textarea rows="3" @bind="_descripcion" @bind:event="oninput"></textarea>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="4" Title="Ficha técnica" Sub="Datos del inmueble para la evaluación y la ficha comercial (opcionales)">
                    <div class="cl-grid c3">
                        <Field Label="Frente (m)"><input type="number" step="0.01" @bind="_frente" placeholder="Ej. 6.5" /></Field>
                        <Field Label="Zonificación"><input @bind="_zonificacion" placeholder="Ej. CZ, RDM, I2" /></Field>
                        <Field Label="N.° de estacionamientos"><input type="number" @bind="_numEstacionamientos" placeholder="Ej. 2" /></Field>
                        <Field Label="Carga eléctrica (kW)"><input type="number" step="0.01" @bind="_cargaElectrica" placeholder="Ej. 15" /></Field>
                        <Field Label="Cuota de mantenimiento (USD/mes)"><input type="number" step="0.01" @bind="_cuotaMantenimiento" placeholder="Ej. 120" /></Field>
                        <Field Label="Apto para licencia de funcionamiento">
                            <select @bind="_aptoLicencia">
                                <option value="">Sin especificar</option>
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        </Field>
                    </div>
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;">
                        <Icon Name="alert" Size="15" /><span>@_err</span>
                    </div>
                }

                @if (_isEdit)
                {
                    <FormFooterBar OnCancel="@(() => App.Navigate("locales"))" OnSave="@GuardarEdicion" SaveLabel="Guardar cambios"
                                   Busy="@_procesando" BusyLabel="Guardando..." />
                }
                else
                {
                    <FormFooterBar OnCancel="@(() => App.Navigate("locales"))" OnSave="@OnOnlyRegister" SaveLabel="Registrar local"
                                   Busy="@_procesando" BusyLabel="Guardando...">
                        <Extra>
                            <button class="cl-btn ghost" disabled="@_procesando" @onclick="GuardarYProspectar"><Icon Name="activity" Size="13" /> Guardar y comenzar prospección</button>
                            <button class="cl-btn ghost" disabled="@_procesando" @onclick="GuardarYCaptar"><Icon Name="pin" Size="13" /> Continuar a captación</button>
                        </Extra>
                    </FormFooterBar>
                }
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Registrar el local <b>no lo publica</b>. Luego puedes <b>comenzar su prospección</b> (contacto con el propietario) o <b>continuar a captación</b>.</span>
                </div>
            </div>
        </div>

        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? IdParam { get; set; }

    private LocalComercialDto _l = new();
    private bool _isEdit = false;
    private bool _procesando;

    private long _propietarioId;
    private string _direccion = "";
    private string _descripcion = "";
    private string _distrito = "Miraflores";
    private string _zonaUrbanizacion = "";
    private string _geoLat = "";
    private string _geoLong = "";
    private string _areaMts = "";
    private string _rubro = EnumCatalog.RubrosComerciales[0];
    private string _precioRef = "";
    private string _estado = "Disponible";
    private string _antiguedad = "";
    private string _ambientes = "";
    private string _tipoInmueble = "L";
    private string _uso = "C";
    private string _estadoPublicacion = "B";
    private string _frente = "";
    private string _zonificacion = "";
    private string _aptoLicencia = "";
    private string _cargaElectrica = "";
    private string _numEstacionamientos = "";
    private string _cuotaMantenimiento = "";

    private IReadOnlyList<string> Distritos => OpcionConValorActual(EnumCatalog.DistritosLima, _distrito);
    private IReadOnlyList<string> Rubros => OpcionConValorActual(EnumCatalog.RubrosComerciales, _rubro);

    private bool _toast;
    private string _toastMsg = "Local registrado correctamente";
    private string? _err;
    private IReadOnlyList<PropietarioDto> _propietarios = new List<PropietarioDto>();

    private string _busquedaPropietario = "";
    private bool _desplegarPropietarios = false;

    private string _busquedaDistrito = "";
    private bool _desplegarDistritos = false;

    private IEnumerable<string> DistritosDisponibles =>
        Distritos.Where(d => TextoFiltro.Contiene(d, _busquedaDistrito));

    private void OnBusquedaDistrito(ChangeEventArgs e)
    {
        _busquedaDistrito = e.Value?.ToString() ?? "";
        _desplegarDistritos = true;
    }

    private void SeleccionarDistrito(string distrito)
    {
        _distrito = distrito;
        _busquedaDistrito = "";
        _desplegarDistritos = false;
    }

    private static string DistritoPickStyle(bool sel)
    {
        var bg = sel ? "#EAF1FF" : "transparent";
        return $"display:flex;align-items:center;gap:8px;padding:7px 10px;border-radius:8px;background:{bg};cursor:pointer;";
    }

    private IEnumerable<PropietarioDto> PropietariosDisponibles =>
        _propietarios
            .Where(p => TextoFiltro.Contiene(p.Nombre, _busquedaPropietario)
                || TextoFiltro.Contiene(p.NumeroDocumento, _busquedaPropietario)
                || TextoFiltro.Contiene(p.TipoPersona, _busquedaPropietario))
            .OrderBy(p => p.Nombre);

    private PropietarioDto? PropietarioSeleccionado =>
        _propietarios.FirstOrDefault(p => p.Id == _propietarioId);

    private void OnBusquedaPropietario(ChangeEventArgs e)
    {
        _busquedaPropietario = e.Value?.ToString() ?? "";
        _desplegarPropietarios = true;
    }

    private void SeleccionarPropietario(long id)
    {
        _propietarioId = id;
        _desplegarPropietarios = false;
        _busquedaPropietario = "";
    }

    private static string PropPickStyle(bool sel)
    {
        var border = sel ? "#005BFF" : "var(--c-border)";
        var bg = sel ? "#EAF1FF" : "#fff";
        return $"display:flex;align-items:center;gap:10px;padding:9px 11px;border:1.5px solid {border};border-radius:10px;background:{bg};cursor:pointer;";
    }

    private static string PropIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    protected override async Task OnInitializedAsync()
    {
        _propietarios = await PropSvc.RefrescarAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (long.TryParse(IdParam, out var id))
        {
            _l = await LocalSvc.ByIdAsync(id) ?? new();
            _isEdit = _l.Id > 0;

            if (_isEdit)
            {
                _propietarioId = _l.PropietarioId ?? 0;
                _direccion = _l.Direccion;
                _distrito = _l.Distrito;
                _areaMts = _l.AreaM2.ToString();
                _rubro = _l.Rubro;
                _precioRef = _l.PrecioReferencial.ToString();
                _estado = _l.Estado;
                _descripcion = _l.Descripcion;
                _antiguedad = _l.AntiguedadAnios?.ToString() ?? "";
                _ambientes = _l.Ambientes?.ToString() ?? "";
                _tipoInmueble = _l.TipoInmueble ?? "L";
                _uso = "C";
                _estadoPublicacion = _l.EstadoPublicacion ?? "B";
                _zonaUrbanizacion = _l.ZonaUrbanizacion ?? "";
                _geoLat = _l.GeoLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
                _geoLong = _l.GeoLong?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
                _frente = _l.Frente?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
                _zonificacion = _l.Zonificacion ?? "";
                _aptoLicencia = _l.AptoLicenciaFuncionamiento is bool apto ? (apto ? "true" : "false") : "";
                _cargaElectrica = _l.CargaElectricaKw?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
                _numEstacionamientos = _l.NumeroEstacionamientos?.ToString() ?? "";
                _cuotaMantenimiento = _l.CuotaMantenimiento?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
            }
        }
    }

    // Progreso interactivo de las secciones del formulario.
    private bool IsStep1Complete => _propietarioId > 0;
    private bool IsStep2Complete => !string.IsNullOrWhiteSpace(_direccion) && !string.IsNullOrWhiteSpace(_distrito);
    private bool IsStep3Complete => !string.IsNullOrWhiteSpace(_areaMts) && !string.IsNullOrWhiteSpace(_precioRef);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Propietario", "Dueño del local", IsStep1Complete),
        new FormStepsSidebar.Step("Ubicación", "Dirección y distrito", IsStep2Complete),
        new FormStepsSidebar.Step("Características", "Área, rubro, precio", IsStep3Complete),
    };

    private async Task OnOnlyRegister()
    {
        if (_procesando) return;
        try
        {
            _procesando = true;
            StateHasChanged();
            if (!await GuardarLocalAsync()) return;
            _toastMsg = "Local registrado correctamente";
            _toast = true;
            StateHasChanged();
            await Task.Delay(300);
            App.Navigate("locales");
        }
        finally { _procesando = false; StateHasChanged(); }
    }

    private async Task GuardarEdicion()
    {
        if (_procesando) return;
        try
        {
            _procesando = true;
            StateHasChanged();
            if (!await GuardarLocalAsync()) return;
            _toastMsg = "Cambios guardados correctamente";
            _toast = true;
            StateHasChanged();
            await Task.Delay(300);
            App.Navigate("locales");
        }
        finally { _procesando = false; StateHasChanged(); }
    }

    // Registrar un local NO lo publica; nace como borrador. Estas dos acciones encadenan el siguiente
    // paso del flujo. El backend crea la prospeccion inicial al registrar el local, así que la
    // buscamos (tras refrescar) para abrirla o para captar desde ella.
    private async Task GuardarYProspectar()
    {
        if (_procesando) return;
        try
        {
            _procesando = true;
            StateHasChanged();
            if (!await GuardarLocalAsync()) return;
            await Task.Yield();
            await ProspeccionSvc.RefrescarAsync();
            var prospeccion = (await ProspeccionSvc.AllAsync()).FirstOrDefault(item => item.LocalId == _l.Id);
            App.Navigate(prospeccion is not null ? $"prospeccion-detail/{prospeccion.Id}" : "prospecciones");
        }
        finally { _procesando = false; StateHasChanged(); }
    }

    private async Task GuardarYCaptar()
    {
        if (_procesando) return;
        try
        {
            _procesando = true;
            StateHasChanged();
            if (!await GuardarLocalAsync()) return;
            await Task.Yield();
            await ProspeccionSvc.RefrescarAsync();
            var prospeccion = (await ProspeccionSvc.AllAsync()).FirstOrDefault(item => item.LocalId == _l.Id);
            App.Navigate(prospeccion is null ? $"captacion-form/local/{_l.Id}" : $"captacion-form/captar/{prospeccion.Id}");
        }
        finally { _procesando = false; StateHasChanged(); }
    }

    private async Task<bool> GuardarLocalAsync()
    {
        if (_propietarioId <= 0)
        {
            _err = "Selecciona un propietario.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_direccion) || string.IsNullOrWhiteSpace(_distrito))
        {
            _err = "La direccion y el distrito son obligatorios.";
            return false;
        }
        if (!int.TryParse(_areaMts, out var area) || area <= 0)
        {
            _err = "Ingresa un area valida.";
            return false;
        }
        if (!decimal.TryParse(_precioRef, out var precio) || precio < 0)
        {
            _err = "Ingresa un precio referencial valido.";
            return false;
        }
        if (_uso != "C")
        {
            _err = "ControlLocal solo admite inmuebles de uso comercial.";
            return false;
        }
        if (!EnumCatalog.TiposInmueble.Any(opcion => opcion.Code == _tipoInmueble))
        {
            _err = "Selecciona un tipo de inmueble comercial valido.";
            return false;
        }
        if (!EnteroOpcional(_ambientes, out var ambientes) || ambientes is <= 0)
        {
            _err = "El numero de ambientes debe ser mayor que cero.";
            return false;
        }
        if (!EnteroOpcional(_antiguedad, out var antiguedad) || antiguedad is < 0)
        {
            _err = "La antiguedad no puede ser negativa.";
            return false;
        }
        if (!DecimalOpcional(_geoLat, out var geoLat) || geoLat is < -90 or > 90)
        {
            _err = "La latitud debe estar entre -90 y 90.";
            return false;
        }
        if (!DecimalOpcional(_geoLong, out var geoLong) || geoLong is < -180 or > 180)
        {
            _err = "La longitud debe estar entre -180 y 180.";
            return false;
        }
        if (!DecimalOpcional(_frente, out var frente) || frente is < 0)
        {
            _err = "El frente no puede ser negativo.";
            return false;
        }
        if (!DecimalOpcional(_cargaElectrica, out var cargaElectrica) || cargaElectrica is < 0)
        {
            _err = "La carga eléctrica no puede ser negativa.";
            return false;
        }
        if (!DecimalOpcional(_cuotaMantenimiento, out var cuotaMantenimiento) || cuotaMantenimiento is < 0)
        {
            _err = "La cuota de mantenimiento no puede ser negativa.";
            return false;
        }
        if (!EnteroOpcional(_numEstacionamientos, out var numEstacionamientos) || numEstacionamientos is < 0)
        {
            _err = "El número de estacionamientos no puede ser negativo.";
            return false;
        }
        bool? aptoLicencia = string.IsNullOrEmpty(_aptoLicencia) ? null : _aptoLicencia == "true";

        try
        {
            var local = new LocalComercialDto
            {
                Id = _l.Id,
                CodigoLocal = _isEdit ? _l.CodigoLocal : $"LC-{DateTime.UtcNow:yyMMddHHmmss}",
                Direccion = _direccion.Trim(),
                Distrito = _distrito,
                AreaM2 = area,
                Rubro = _rubro,
                PrecioReferencial = precio,
                Estado = _estado,
                PropietarioId = _propietarioId,
                PropietarioNombre = _propietarios.FirstOrDefault(p => p.Id == _propietarioId)?.Nombre ?? "",
                TipoInmueble = _tipoInmueble,
                Uso = _uso,
                Ambientes = ambientes,
                AntiguedadAnios = antiguedad,
                ZonaUrbanizacion = string.IsNullOrWhiteSpace(_zonaUrbanizacion) ? null : _zonaUrbanizacion.Trim(),
                GeoLat = geoLat,
                GeoLong = geoLong,
                EstadoPublicacion = _estadoPublicacion,
                Descripcion = _descripcion.Trim(),
                Frente = frente,
                Zonificacion = string.IsNullOrWhiteSpace(_zonificacion) ? null : _zonificacion.Trim(),
                AptoLicenciaFuncionamiento = aptoLicencia,
                CargaElectricaKw = cargaElectrica,
                NumeroEstacionamientos = numEstacionamientos,
                CuotaMantenimiento = cuotaMantenimiento,
            };
            _l = _isEdit ? await LocalSvc.ActualizarAsync(local) : await LocalSvc.AgregarAsync(local);
            _isEdit = true;
            _err = null;
            return true;
        }
        catch (Exception error)
        {
            _err = error.Message;
            return false;
        }
    }

    private static bool EnteroOpcional(string valor, out int? resultado)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            resultado = null;
            return true;
        }
        if (int.TryParse(valor, out var numero))
        {
            resultado = numero;
            return true;
        }
        resultado = null;
        return false;
    }

    private static bool DecimalOpcional(string valor, out decimal? resultado)
    {
        if (string.IsNullOrWhiteSpace(valor))
        {
            resultado = null;
            return true;
        }
        if (decimal.TryParse(valor, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var numero))
        {
            resultado = numero;
            return true;
        }
        resultado = null;
        return false;
    }

    private static IReadOnlyList<string> OpcionConValorActual(IReadOnlyList<string> opciones, string valorActual)
    {
        if (string.IsNullOrWhiteSpace(valorActual) || opciones.Contains(valorActual))
            return opciones;
        return opciones.Concat([valorActual]).ToList();
    }
}
