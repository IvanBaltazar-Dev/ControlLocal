@page "/locales"
@inherits SafeComponentBase
@inject AppState App
@inject IProspeccionService ProspeccionSvc

<PageTitle>Locales comerciales - ControlLocal</PageTitle>

<AppShell Active="Locales comerciales" Crumbs="@(new[] { "ControlLocal", "Registro", "Locales comerciales" })"
          Title="Gestion de locales"
          Subtitle="Inventario de propiedades y su ciclo comercial">
    <Actions>
        @if (App.Role == Roles.Agente)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("local-form"))"><Icon Name="plus" Size="13" /> Registrar local</button>
        }
        else
        {
            <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="store" Label="Activos" Value="@Activos.ToString()" Tone="blue" Footer="En cartera, sin alquilar"
                        Active="@(_estadoBucket == "ACTIVOS")" OnClick="@(() => ToggleBucket("ACTIVOS"))" />
            <MetricCard Icon="activity" Label="Por captar" Value="@PorCaptar.ToString()" Tone="amber" Footer="En prospeccion"
                        Active="@(_estadoBucket == "POR_CAPTAR")" OnClick="@(() => ToggleBucket("POR_CAPTAR"))" />
            <MetricCard Icon="pin" Label="Captados" Value="@Captados.ToString()" Tone="green" Footer="Captacion lograda"
                        Active="@(_estadoBucket == "CAPTADOS")" OnClick="@(() => ToggleBucket("CAPTADOS"))" />
            <MetricCard Icon="handshake" Label="@AlquiladosLabel" Value="@Alquilados.ToString()" Tone="green" Footer="Cierre exitoso"
                        Active="@(_estadoBucket == "ALQUILADOS")" OnClick="@(() => ToggleBucket("ALQUILADOS"))" />
        </div>

        <FilterBar Search="Buscar por direccion, codigo, propietario..."
                   @bind-Value="_query" ResultCount="Filtradas().Count()"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <select class="cl-select" @bind="_estadoBucket">
                <option value="">Todos los estados</option>
                <option value="ACTIVOS">Activos</option>
                <option value="POR_CAPTAR">Por captar</option>
                <option value="CAPTADOS">Captados</option>
                <option value="ALQUILADOS">Alquilados</option>
                <option value="INACTIVOS">Inactivos</option>
            </select>
            <select class="cl-select" @bind="_etapa">
                <option value="">Todas las etapas</option>
                @foreach (var etapa in EtapasPipeline)
                {
                    <option value="@etapa.Code">@etapa.Label</option>
                }
            </select>
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
            <select class="cl-select" @bind="_disponibilidad">
                <option value="">Disponibilidad</option>
                @foreach (var disp in EnumCatalog.EstadosLocalComercial)
                {
                    <option value="@disp.Code">@disp.Label</option>
                }
            </select>
            @if (App.Role is Roles.Broker or Roles.Admin)
            {
                <select class="cl-select" @bind="_idAgente">
                    <option value="0">Todos los agentes</option>
                    @foreach (var agente in _agentes)
                    {
                        <option value="@agente.Id">@agente.Nombre</option>
                    }
                </select>
            }
        </FilterBar>

        @{
            var localesFiltrados = Filtradas().ToList();
            var localesVisibles = Paginador.Pagina(localesFiltrados, ref _pagina);
        }

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Codigo</th><th>Direccion</th><th>Distrito</th><th>Propietario</th>
                            <th>Disponibilidad</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in localesVisibles)
                        {
                            <tr>
                                <td><span class="mono">@p.LocalCodigo</span></td>
                                <td style="font-weight:600;">@p.Direccion</td>
                                <td>@p.Distrito</td>
                                <td>@p.PropietarioNombre</td>
                                <td><span class="cl-badge @DisponibilidadTono(p.Disponibilidad)">@DisponibilidadLabel(p.Disponibilidad)</span></td>
                                <td><StatusBadge Label="@EstadoComercial(p)" /></td>
                                <td>
                                    <div class="cl-flex" style="gap:6px;justify-content:flex-end;flex-wrap:wrap;">
                                        <button class="cl-btn sm" @onclick="@(() => App.Navigate($"prospeccion-detail/{p.Id}"))"><Icon Name="eye" Size="12" /> Prospección</button>
                                        <button class="cl-btn sm ghost" @onclick="@(() => App.Navigate($"local-detail/{p.LocalId}"))"><Icon Name="eye" Size="12" /> Local</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <LoadingBlock Framed="false" Title="Actualizando locales..." />
                }
                else if (_loadError is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_loadError</span></div>
                }
                else if (localesFiltrados.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="store" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin locales en este filtro</div>
                        <div style="font-size:12px;">Ajusta los filtros o registra un local para iniciar su prospeccion.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="localesFiltrados.Count" @bind-Page="_pagina" />
    </ChildContent>
</AppShell>

@code {
    private string _estadoBucket = "";
    private string _etapa = "";
    private string _query = "";
    private string _distrito = "";
    private string _disponibilidad = "";
    private long _idAgente;
    private int _pagina = 1;
    private IReadOnlyList<ProspeccionDto> _locales = [];
    private bool _cargando = true;
    private string? _loadError;

    // Cada local tiene una prospeccion 1:1 (creada al registrarlo), ya acotada por rol en el backend.
    // Sobre ese set derivamos el ciclo del local: por captar -> captado -> alquilado.
    private IReadOnlyList<string> _distritos => _locales.Select(p => p.Distrito)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();
    private IReadOnlyList<(long Id, string Nombre)> _agentes => _locales
        .Where(p => p.AgenteId > 0 && !string.IsNullOrWhiteSpace(p.NombreAgente))
        .Select(p => (Id: p.AgenteId, Nombre: p.NombreAgente))
        .DistinctBy(x => x.Id).OrderBy(x => x.Nombre).ToList();

    private bool HayFiltros => !string.IsNullOrEmpty(_estadoBucket) || !string.IsNullOrEmpty(_etapa)
        || !string.IsNullOrEmpty(_query) || !string.IsNullOrEmpty(_distrito)
        || !string.IsNullOrEmpty(_disponibilidad) || _idAgente > 0;

    private string AlquiladosLabel => App.Role == Roles.Agente ? "Alquilados por mí" : "Alquileres exitosos";

    // Disponibilidad "N" (No disponible) = local alquilado tras el cierre del contrato.
    private static bool EsAlquilado(ProspeccionDto p) => p.Disponibilidad == "N";
    private static bool EsCaptado(ProspeccionDto p) => p.Estado == "T" && !EsAlquilado(p);
    private static bool EsPorCaptar(ProspeccionDto p) => p.Estado is "P" or "C" or "R" or "E" or "S" && !EsAlquilado(p);
    private static bool EsInactivo(ProspeccionDto p) => !EsAlquilado(p) && (p.Estado == "D" || p.Disponibilidad == "I");
    private static bool EsActivo(ProspeccionDto p) => EsPorCaptar(p) || EsCaptado(p);

    private int Activos => _locales.Count(EsActivo);
    private int PorCaptar => _locales.Count(EsPorCaptar);
    private int Captados => _locales.Count(EsCaptado);
    private int Alquilados => _locales.Count(EsAlquilado);

    private static IEnumerable<EnumOption> EtapasPipeline =>
        EnumCatalog.EstadosProspeccion.Where(e => e.Code is not ("T" or "D"));

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            // Lo más reciente primero (id desc): el local recién registrado aparece al inicio,
            // también en la vista de agente (cuya consulta backend viene en orden ascendente).
            _locales = (await ProspeccionSvc.RefrescarAsync(DisposedToken))
                .OrderByDescending(p => p.Id).ToList();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private IEnumerable<ProspeccionDto> Filtradas() =>
        _locales.Where(p =>
            CoincideBucket(p)
            && (string.IsNullOrEmpty(_etapa) || p.Estado == _etapa)
            && (string.IsNullOrEmpty(_distrito) || p.Distrito == _distrito)
            && (string.IsNullOrEmpty(_disponibilidad) || p.Disponibilidad == _disponibilidad)
            && (_idAgente == 0 || p.AgenteId == _idAgente)
            && (string.IsNullOrEmpty(_query) || Coincide(p, _query)));

    private bool CoincideBucket(ProspeccionDto p) => _estadoBucket switch
    {
        "ACTIVOS" => EsActivo(p),
        "POR_CAPTAR" => EsPorCaptar(p),
        "CAPTADOS" => EsCaptado(p),
        "ALQUILADOS" => EsAlquilado(p),
        "INACTIVOS" => EsInactivo(p),
        _ => true,
    };

    private static bool Coincide(ProspeccionDto p, string q) =>
        TextoFiltro.Contiene(p.Direccion, q)
        || TextoFiltro.Contiene(p.LocalCodigo, q)
        || TextoFiltro.Contiene(p.PropietarioNombre, q);

    private void ToggleBucket(string bucket) =>
        _estadoBucket = _estadoBucket == bucket ? "" : bucket;

    private void LimpiarFiltros()
    {
        _estadoBucket = "";
        _etapa = "";
        _query = "";
        _distrito = "";
        _disponibilidad = "";
        _idAgente = 0;
    }

    private static string EstadoComercial(ProspeccionDto p) =>
        EsAlquilado(p) ? "Alquilado"
        : EsCaptado(p) ? "Captado"
        : EsPorCaptar(p) ? "Por captar"
        : "Inactivo";

    private static string DisponibilidadLabel(string? code) =>
        EnumCatalog.LabelFor(EnumCatalog.EstadosLocalComercial, code);

    private static string DisponibilidadTono(string? code) => code switch
    {
        "D" => "green",
        "N" => "blue",
        _ => "gray",
    };
}
