@page "/locales"
@inherits SafeComponentBase
@inject AppState App
@inject IProspeccionService ProspeccionSvc

<PageTitle>Locales en prospección · ControlLocal</PageTitle>

<AppShell Active="Locales comerciales" Crumbs="@(new[] { "ControlLocal", "Captación", "Locales comerciales" })"
          Title="Prospección de locales"
          Subtitle="Seguimiento de inmuebles hasta captarlos · contacto con el propietario, propuesta y decisión">
    <Actions>
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("local-form"))"><Icon Name="plus" Size="13" /> Registrar local</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="store" Label="En prospección" Value="@EnProspeccion.ToString()" Tone="blue" />
            <MetricCard Icon="clock" Label="Por recontactar" Value="@_porRecontactar.Count.ToString()" Tone="blue" Footer="Seguimiento ≤ 15 días" />
            <MetricCard Icon="pin" Label="Captados" Value="@Contar("T").ToString()" Tone="green"
                        Active="@(_filtroEstado == "T")" OnClick="@(() => _filtroEstado = _filtroEstado == "T" ? "" : "T")" />
            <MetricCard Icon="x" Label="Descartados" Value="@Contar("D").ToString()" Tone="red"
                        Active="@(_filtroEstado == "D")" OnClick="@(() => _filtroEstado = _filtroEstado == "D" ? "" : "D")" />
        </div>

        @if (_porRecontactar.Count > 0)
        {
            var vencidos = _porRecontactar.Count(p => EsVencido(p));
            <div class="cl-alert @(vencidos > 0 ? "red" : "blue")" style="margin-bottom:16px;">
                <Icon Name="clock" Size="15" />
                <span>
                    Tienes <b>@_porRecontactar.Count</b> local(es) en seguimiento por recontactar@(vencidos > 0 ? $" · {vencidos} vencido(s)" : "").
                    No dejes vencer la ventana de 15 días: cada recontacto a tiempo es una captación que no pierdes.
                </span>
            </div>
        }

        <FilterBar Search="Buscar por dirección, código, propietario…"
                   @bind-Value="_query" ResultCount="Filtradas().Count()"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <select class="cl-select" @bind="_filtroEstado">
                <option value="">Todas las etapas</option>
                @foreach (var e in EnumCatalog.EstadosProspeccion)
                {
                    <option value="@e.Code">@e.Label</option>
                }
            </select>
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Código</th><th>Dirección</th><th>Distrito</th><th>Propietario</th>
                            <th>Etapa</th><th>Seguimiento</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Filtradas())
                        {
                            <tr>
                                <td><span class="mono">@p.LocalCodigo</span></td>
                                <td style="font-weight:600;">@p.Direccion</td>
                                <td>@p.Distrito</td>
                                <td>@p.PropietarioNombre</td>
                                <td><StatusBadge Label="@EnumCatalog.LabelFor(EnumCatalog.EstadosProspeccion, p.Estado)" /></td>
                                <td>
                                    @if (p.Estado == "S" && p.FechaRecontacto is not null)
                                    {
                                        var vencido = EsVencido(p);
                                        <span class="cl-badge @(vencido ? "red" : "blue")">@(vencido ? $"Vencido · {p.FechaRecontactoTexto}" : $"Recontactar {p.FechaRecontactoTexto}")</span>
                                    }
                                    else
                                    {
                                        <span class="cl-muted" style="font-size:12px;">@UltimoHito(p)</span>
                                    }
                                </td>
                                <td>
                                    <div class="cl-flex" style="gap:6px;justify-content:flex-end;">
                                        @if (p.Estado == "P")
                                        {
                                            <button class="cl-btn sm primary" @onclick="@(() => Avanzar(p, ProspeccionSvc.Contactar, "Propietario contactado"))"><Icon Name="phone" Size="12" /> Contactar</button>
                                        }
                                        else if (p.Estado == "C")
                                        {
                                            <button class="cl-btn sm primary" @onclick="@(() => Avanzar(p, ProspeccionSvc.RegistrarReunion, "Reunión registrada"))"><Icon Name="users" Size="12" /> Reunión</button>
                                        }
                                        else if (p.Estado == "R")
                                        {
                                            <button class="cl-btn sm primary" @onclick="@(() => Avanzar(p, ProspeccionSvc.EntregarPropuesta, "Propuesta entregada"))"><Icon Name="fileText" Size="12" /> Entregar propuesta</button>
                                        }
                                        else if (p.Estado is "E" or "S")
                                        {
                                            <button class="cl-btn sm primary" @onclick="@(() => App.Navigate($"captacion-form/captar/{p.Id}"))"><Icon Name="pin" Size="12" /> Captar</button>
                                            <button class="cl-btn sm" @onclick="@(() => AbrirPosponer(p))"><Icon Name="clock" Size="12" /> Posponer</button>
                                            <button class="cl-btn sm ghost" @onclick="@(() => AbrirRechazar(p))"><Icon Name="x" Size="12" /> Rechazar</button>
                                        }
                                        else if (p.Estado == "T")
                                        {
                                            <span class="cl-badge green plain"><Icon Name="check" Size="11" /> @p.CaptacionCodigo</span>
                                        }
                                        <button class="cl-btn sm ghost" @onclick="@(() => App.Navigate($"local-detail/{p.LocalId}"))"><Icon Name="eye" Size="12" /> Ver</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Filtradas().Any())
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="store" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin locales en este filtro</div>
                        <div style="font-size:12px;">Registra un local para iniciar su prospección.</div>
                    </div>
                }
            </div>
        </div>

        @* ---------- Modal: Posponer (recontactar ≤15 días) ---------- *@
        <Modal Open="_modalPosponer" Tone="blue" Icon="clock"
               Title="Posponer · por ahora no"
               Desc="@($"El propietario de {_target?.Direccion} pidió tiempo. Agenda el recontacto (máx. 15 días).")"
               OnClose="@(() => _modalPosponer = false)">
            <ChildContent>
                <Field Label="Fecha de recontacto" Required="true"><input type="date" @bind="_fechaRecontactoPick" /></Field>
                <div class="cl-help" style="margin-top:6px;">No puede superar 15 días desde hoy. El local quedará en <b>seguimiento</b> y aparecerá en la alerta de recontacto.</div>
                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" @onclick="@(() => _modalPosponer = false)">Cancelar</button>
                <button class="cl-btn primary" @onclick="ConfirmarPosponer">Agendar recontacto</button>
            </Footer>
        </Modal>

        @* ---------- Modal: Rechazar ---------- *@
        <Modal Open="_modalRechazar" Tone="red" Icon="x"
               Title="Rechazo del propietario"
               Desc="@($"Registra por qué {_target?.PropietarioNombre} no acepta la captación de {_target?.Direccion}.")"
               OnClose="@(() => _modalRechazar = false)">
            <ChildContent>
                <Field Label="Motivo del rechazo" Required="true">
                    <textarea rows="3" placeholder="Ej. No acepta la comisión, prefiere alquilar por su cuenta…" @bind="_motivoTmp"></textarea>
                </Field>
                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" @onclick="@(() => _modalRechazar = false)">Volver</button>
                <button class="cl-btn primary" @onclick="ConfirmarRechazar">Registrar rechazo</button>
            </Footer>
        </Modal>

        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    private string _filtroEstado = "";
    private string _query = "";
    private string _distrito = "";
    private IReadOnlyList<ProspeccionDto> _porRecontactar = new List<ProspeccionDto>();

    private IReadOnlyList<string> _distritos => ProspeccionSvc.All().Select(p => p.Distrito)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();

    private bool HayFiltros => !string.IsNullOrEmpty(_filtroEstado) || !string.IsNullOrEmpty(_query) || !string.IsNullOrEmpty(_distrito);

    private void LimpiarFiltros() { _filtroEstado = ""; _query = ""; _distrito = ""; }

    private bool _modalPosponer, _modalRechazar, _toast;
    private ProspeccionDto? _target;
    private DateOnly? _fechaRecontactoPick;
    private string _motivoTmp = "", _toastMsg = "";
    private string? _err;

    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    protected override void OnInitialized() => Recalcular();

    private int EnProspeccion => ProspeccionSvc.All().Count(p => p.Estado is "P" or "C" or "R" or "E" or "S");
    private int Contar(string estado) => ProspeccionSvc.All().Count(p => p.Estado == estado);

    private IEnumerable<ProspeccionDto> Filtradas() =>
        ProspeccionSvc.All().Where(p =>
            (string.IsNullOrEmpty(_filtroEstado) || p.Estado == _filtroEstado) &&
            (string.IsNullOrEmpty(_distrito) || p.Distrito == _distrito) &&
            (string.IsNullOrEmpty(_query) || Coincide(p, _query)));

    private static bool Coincide(ProspeccionDto p, string q) =>
        (p.Direccion?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (p.LocalCodigo?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (p.PropietarioNombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);

    private static bool EsVencido(ProspeccionDto p) =>
        p.Estado == "S" && p.FechaRecontacto is { } f && f < Hoy;

    private void Recalcular() => _porRecontactar = ProspeccionSvc.PorRecontactar(15);

    private static string UltimoHito(ProspeccionDto p) => p.Estado switch
    {
        "P" => "Sin contactar",
        "C" => $"Contactado {p.FechaContactoTexto}",
        "R" => $"Reunión {p.FechaReunionTexto}",
        "E" => $"Propuesta {p.FechaPropuestaTexto}",
        "T" => "Captado",
        "D" => p.Observaciones ?? "Descartado",
        _ => "—",
    };

    private void AbrirPosponer(ProspeccionDto p) { _target = p; _fechaRecontactoPick = null; _err = null; _modalPosponer = true; }
    private void AbrirRechazar(ProspeccionDto p) { _target = p; _motivoTmp = ""; _err = null; _modalRechazar = true; }

    // Avanza una etapa simple del embudo (contactar / reunión / propuesta).
    private void Avanzar(ProspeccionDto p, Func<long, ProspeccionDto> accion, string mensaje)
    {
        try
        {
            accion(p.Id);
            Recalcular();
            Notificar(mensaje);
        }
        catch (InvalidOperationException ex) { Notificar(ex.Message); }
    }

    private void ConfirmarPosponer()
    {
        if (_target is null) return;
        if (_fechaRecontactoPick is null) { _err = "Indica la fecha de recontacto."; return; }
        try
        {
            ProspeccionSvc.Posponer(_target.Id, _fechaRecontactoPick.Value);
            _modalPosponer = false;
            Recalcular();
            Notificar("Recontacto agendado. Quedó en seguimiento.");
        }
        catch (InvalidOperationException ex) { _err = ex.Message; }
    }

    private void ConfirmarRechazar()
    {
        if (_target is null) return;
        try
        {
            ProspeccionSvc.Rechazar(_target.Id, _motivoTmp);
            _modalRechazar = false;
            Recalcular();
            Notificar("Prospección descartada por rechazo del propietario.");
        }
        catch (InvalidOperationException ex) { _err = ex.Message; }
    }

    private void Notificar(string mensaje)
    {
        _toastMsg = mensaje;
        _toast = true;
        _ = DelayThenRenderAsync(2600, () => _toast = false);
    }
}
