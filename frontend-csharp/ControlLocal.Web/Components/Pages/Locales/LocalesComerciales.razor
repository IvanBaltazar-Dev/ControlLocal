@page "/locales-comerciales"
@rendermode InteractiveServer
@inject LocalComercialService Service
@inject RoleState RoleState

<PageTitle>Locales comerciales - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">@RoleState.CurrentRole</div>
        <div class="cl-page-title">Locales comerciales</div>
        <div class="cl-page-subtitle">Ficha comercial del inmueble y datos base para captaciones.</div>
    </div>
    @if (RoleState.CurrentRole == Roles.Agente)
    {
        <button class="btn btn-primary cl-btn-primary" @onclick="OpenNewAsync">Registrar local</button>
    }
</div>

@if (RoleState.CurrentRole != Roles.Agente)
{
    <div class="alert alert-warning">
        Los brokers consultan o supervisan locales desde las operaciones de su alcance; el registro lo realiza el agente inmobiliario.
    </div>
}

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-7">
                <input class="form-control" placeholder="Buscar por direccion, distrito o estado" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-lg-3">
                <select class="form-select" @bind="_estado">
                    <option value="">Todos los estados</option>
                    @foreach (var estado in EnumCatalog.EstadosLocalComercial)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <button class="btn btn-outline-secondary w-100">Exportar</button>
            </div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Local</th>
                    <th>Area</th>
                    <th>Precio</th>
                    <th>Propietario</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Filtrados)
                {
                    <tr>
                        <td class="fw-semibold text-primary">@item.Codigo</td>
                        <td>
                            <strong>@item.Direccion</strong>
                            <div class="small text-secondary">@item.Distrito</div>
                        </td>
                        <td>@item.AreaM2 m2</td>
                        <td>USD @item.PrecioAlquiler</td>
                        <td>@item.NombrePropietario</td>
                        <td><StatusBadge Label="@item.Estado" /></td>
                        <td class="text-end">
                            @if (RoleState.CurrentRole == Roles.Agente)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEditAsync(item)">Editar</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled>Solo lectura</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<ControlLocalDialog @ref="_dialog" Title="@DialogTitle" Subtitle="Formulario corto; la ficha extendida puede crecer a pantalla completa.">
    <EditForm Model="_form" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Direccion</label>
                <InputText class="form-control" @bind-Value="_form.Direccion" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Distrito</label>
                <InputText class="form-control" @bind-Value="_form.Distrito" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Area m2</label>
                <InputNumber class="form-control" @bind-Value="_form.AreaM2" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Precio</label>
                <InputNumber class="form-control" @bind-Value="_form.PrecioAlquiler" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Propietario Id</label>
                <InputNumber class="form-control" @bind-Value="_form.PropietarioId" />
            </div>
            <div class="col-md-8">
                <label class="form-label">Nombre propietario</label>
                <InputText class="form-control" @bind-Value="_form.NombrePropietario" />
            </div>
            <div class="col-12">
                <label class="form-label">Estado</label>
                <InputSelect class="form-select" @bind-Value="_form.Estado">
                    @foreach (var estado in EnumCatalog.EstadosLocalComercial)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button class="btn btn-outline-secondary" type="button" @onclick="CloseAsync">Cancelar</button>
            <button class="btn btn-primary cl-btn-primary" type="submit">Guardar</button>
        </div>
    </EditForm>
</ControlLocalDialog>

@code {
    private ControlLocalDialog? _dialog;
    private List<LocalComercialDto> _items = [];
    private LocalComercialDto _form = new();
    private string _search = string.Empty;
    private string _estado = string.Empty;
    private bool _editing;

    private string DialogTitle => _editing ? "Editar local comercial" : "Registrar local comercial";

    private IEnumerable<LocalComercialDto> Filtrados => _items.Where(x =>
        (string.IsNullOrWhiteSpace(_search)
            || x.Direccion.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.Distrito.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.Estado.Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_estado) || x.Estado == _estado));

    protected override async Task OnInitializedAsync() => _items = await Service.GetAllAsync();

    private async Task OpenNewAsync()
    {
        _editing = false;
        _form = new LocalComercialDto { Codigo = "LC-NUEVO", Estado = "Disponible" };
        if (_dialog is not null) await _dialog.ShowAsync();
    }

    private async Task OpenEditAsync(LocalComercialDto item)
    {
        _editing = true;
        _form = new LocalComercialDto
        {
            Id = item.Id,
            Codigo = item.Codigo,
            Direccion = item.Direccion,
            Distrito = item.Distrito,
            AreaM2 = item.AreaM2,
            PrecioAlquiler = item.PrecioAlquiler,
            Estado = item.Estado,
            PropietarioId = item.PropietarioId,
            NombrePropietario = item.NombrePropietario
        };
        if (_dialog is not null) await _dialog.ShowAsync();
    }

    private async Task GuardarAsync()
    {
        if (_editing)
        {
            var index = _items.FindIndex(x => x.Id == _form.Id);
            if (index >= 0) _items[index] = _form;
        }
        else
        {
            _form.Id = _items.Count == 0 ? 1 : _items.Max(x => x.Id) + 1;
            _form.Codigo = $"LC-{_form.Id:0000}";
            _items.Insert(0, _form);
        }
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_dialog is not null) await _dialog.CloseAsync();
    }
}
