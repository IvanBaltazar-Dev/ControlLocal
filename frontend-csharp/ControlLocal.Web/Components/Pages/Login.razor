@page "/"
@page "/login"
@inject AppState App

<PageTitle>Inicio de sesión · ControlLocal</PageTitle>

<div style="width:100%;min-height:100vh;display:flex;font-family:'Inter',-apple-system,sans-serif;color:#221F1B;background:radial-gradient(1200px 700px at 12% 10%, #F4E7DA 0%, rgba(244,231,218,0) 55%), radial-gradient(1000px 800px at 95% 100%, #E7DECF 0%, rgba(231,222,207,0) 60%), linear-gradient(150deg, #EBEFEE 0%, #F2EBE2 48%, #E9DECF 100%);">

    @* Left brand panel *@
    <div style="width:44%;background:linear-gradient(165deg, #4A413C 0%, #3C342F 60%, #5A4A3D 100%);color:#EBEFEE;padding:52px 48px;display:flex;flex-direction:column;position:relative;overflow:hidden;">
        <div style="display:flex;align-items:center;gap:12px;position:relative;z-index:1;">
            <BrandMark Size="42" Variant="walnut" />
            <div>
                <div style="font-weight:600;font-size:19px;color:#fff;">ControlLocal</div>
                <div style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#CCB499;">Corretaje comercial</div>
            </div>
        </div>
        <div style="margin-top:auto;position:relative;z-index:1;">
            <div style="font-size:29px;font-weight:600;line-height:1.18;letter-spacing:-0.022em;max-width:400px;color:#fff;">
                Gestión integral del proceso de alquiler comercial.
            </div>
            <div style="font-size:13.5px;color:#D8C9B4;margin-top:16px;max-width:390px;line-height:1.55;">
                Gestiona captaciones, agentes, brokers y oportunidades comerciales desde una plataforma centralizada.
            </div>
            <div style="display:flex;gap:28px;margin-top:30px;font-size:11px;color:#B7A488;">
                <div><div style="color:#fff;font-size:17px;font-weight:600;">248</div>Locales activos</div>
                <div><div style="color:#fff;font-size:17px;font-weight:600;">96</div>Captaciones activas</div>
                <div><div style="color:#fff;font-size:17px;font-weight:600;">14</div>Alquileres cerrados</div>
            </div>
        </div>
        <div style="position:absolute;right:-120px;top:-80px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle, rgba(200,144,109,0.45), rgba(200,144,109,0));"></div>
        <div style="position:absolute;left:-90px;bottom:-110px;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle, rgba(187,108,67,0.30), rgba(187,108,67,0));"></div>
        <svg style="position:absolute;right:-40px;top:120px;opacity:0.08;" width="360" height="360" viewBox="0 0 400 400">
            @for (var i = 0; i < 18; i++)
            {
                <line x1="@(i * 32)" y1="0" x2="0" y2="@(i * 32)" stroke="#EBEFEE" stroke-width="1" />
            }
        </svg>
    </div>

    @* Right form *@
    <div style="flex:1;display:grid;place-items:center;padding:48px 40px;">
        <div style="width:432px;background:rgba(255,255,255,0.82);backdrop-filter:blur(10px) saturate(1.3);border:1px solid rgba(255,255,255,0.7);border-radius:20px;box-shadow:0 30px 70px rgba(74,65,60,0.16), 0 8px 20px rgba(74,65,60,0.08);padding:34px 34px 28px;">
            <div style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#BB6C43;font-weight:600;">Bienvenido</div>
            <div style="font-size:25px;font-weight:650;letter-spacing:-0.02em;margin-top:5px;">Inicio de sesión</div>
            <div style="font-size:13px;color:#5A554D;margin-top:6px;line-height:1.5;">
                Selecciona tu perfil de prueba e ingresa con tus credenciales de la corredora.
            </div>

            @* Profile cards *@
            <div style="margin-top:20px;">
                <div style="font-size:10.5px;letter-spacing:0.09em;text-transform:uppercase;color:#948D81;font-weight:600;margin-bottom:9px;">Perfil de acceso</div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    @foreach (var (key, icon, sub) in _roles)
                    {
                        <button type="button" class="cl-rolecard@(_picked == key ? " sel" : "")" @onclick="@(() => _picked = key)">
                            <span class="cl-rolecard-ic"><Icon Name="@icon" Size="18" /></span>
                            <span style="flex:1;">
                                <span class="cl-rolecard-name">@Roles.Label(key)</span>
                                <span class="cl-rolecard-desc">@sub</span>
                            </span>
                            <span class="cl-rolecard-check"><Icon Name="checkCircle" Size="18" /></span>
                        </button>
                    }
                </div>
            </div>

            @* Credentials *@
            <div style="margin-top:18px;display:flex;flex-direction:column;gap:12px;">
                <div>
                    <label class="cl-label">Usuario o correo corporativo</label>
                    <input class="cl-login-input" value="vmora@@controllocal.pe" />
                </div>
                <div>
                    <label class="cl-label">Contraseña</label>
                    <div style="position:relative;">
                        <input class="cl-login-input" type="password" value="••••••••••" style="padding-right:40px;" />
                        <div style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#948D81;cursor:pointer;display:inline-flex;">
                            <Icon Name="eye" Size="16" />
                        </div>
                    </div>
                </div>
            </div>

            <button @onclick="Ingresar" style="width:100%;margin-top:20px;padding:13px 16px;justify-content:center;display:inline-flex;align-items:center;gap:8px;cursor:pointer;background:linear-gradient(135deg, #BB6C43, #A85B36);color:#fff;border:0;border-radius:11px;font:inherit;font-size:14px;font-weight:600;box-shadow:0 8px 20px rgba(187,108,67,0.32);">
                Ingresar al sistema
                <Icon Name="arrowRight" Size="15" />
            </button>

            <div style="margin-top:14px;font-size:11.5px;color:#5A554D;display:flex;gap:8px;align-items:flex-start;">
                <Icon Name="lock" Size="14" Color="#948D81" />
                <span>¿No recuerdas tu contraseña? <a @onclick="@(() => App.Navigate("recover"))" style="color:#BB6C43;font-weight:600;cursor:pointer;">Solicita un restablecimiento</a> al equipo de soporte interno.</span>
            </div>

            <div style="margin-top:18px;padding-top:16px;border-top:1px solid #EFEBE3;font-size:11px;color:#948D81;text-align:center;">
                v2.5.0 · Soporte interno: soporte@@controllocal.pe
            </div>
        </div>
    </div>
</div>

@code {
    private string _picked = Roles.Agente;

    private readonly (string Key, string Icon, string Sub)[] _roles =
    {
        (Roles.Agente, "user", "Gestiona propietarios, locales, captaciones y oportunidades."),
        (Roles.Broker, "users", "Supervisa agentes, revisa operaciones y acompaña el proceso comercial."),
        (Roles.Admin, "briefcase", "Administra brokers, asignaciones y configuración general del sistema."),
    };

    private void Ingresar() => App.Navigate("dashboard", _picked);
}
