@page "/"
@page "/login"
@inject AppState App
@inject IAuthService Auth

<PageTitle>Inicio de sesión · ControlLocal</PageTitle>

<div class="cl-login">
    @* Escena a pantalla completa (cover) + glow que respira sobre el render 3D *@
    <div class="cl-login__bg"></div>
    <div class="cl-login__glow"></div>
    <div class="cl-login__scrim"></div>
    <div class="cl-login__orb cl-login__orb--a"></div>
    <div class="cl-login__orb cl-login__orb--b"></div>
    <div class="cl-login__sheen"></div>

    <div class="cl-login__stage">
        <div class="cl-loginbox">
            <span class="cl-loginbox__shield" title="Conexión protegida">
                <Icon Name="lock" Size="15" Color="#5b6b86" />
            </span>

            @* Marca tipo "app icon" (glifo de circuito ControlLocal) *@
            <div class="cl-loginbox__logo">
                <svg width="34" height="34" viewBox="0 0 40 40" fill="none"
                     stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M27 9.5a13 13 0 1 0 0 21" />
                    <path d="M23.2 15a7 7 0 1 0 0 10" />
                    <path d="M20 5.5V18" />
                    <circle cx="20" cy="20" r="2.5" fill="#fff" stroke="none" />
                    <circle cx="20" cy="5.5" r="2.4" fill="#fff" stroke="none" />
                    <circle cx="27" cy="9.5" r="2.1" fill="#fff" stroke="none" />
                    <circle cx="27" cy="30.5" r="2.1" fill="#fff" stroke="none" />
                    <circle cx="10.5" cy="27" r="2.1" fill="#fff" stroke="none" />
                </svg>
            </div>

            <div class="cl-loginbox__hello">Bienvenido</div>
            <h1 class="cl-loginbox__title">Iniciar sesión</h1>
            <div class="cl-loginbox__rule"></div>
            <div class="cl-loginbox__sub">Ingresa con tu cuenta corporativa</div>

            @if (_error is not null)
            {
                <div class="cl-loginbox__error@(_shake ? " shake" : "")">
                    <Icon Name="alert" Size="15" />
                    <span>@_error</span>
                </div>
            }

            <div class="cl-loginfield" style="animation-delay:.52s">
                <span class="cl-loginfield__ic"><Icon Name="user" Size="17" /></span>
                <input class="cl-loginfield__in" placeholder="Usuario o correo corporativo"
                       value="@_usuario" @oninput="OnUser" @onkeydown="OnKey"
                       autocomplete="username" aria-label="Usuario o correo corporativo" />
                <span class="cl-loginfield__ok@(_userOk ? " is-on" : "")"><Icon Name="checkCircle" Size="16" /></span>
            </div>

            <div class="cl-loginfield" style="animation-delay:.58s">
                <span class="cl-loginfield__ic"><Icon Name="lock" Size="16" /></span>
                <input class="cl-loginfield__in" placeholder="Contraseña"
                       type="@(_showPass ? "text" : "password")"
                       value="@_password" @oninput="OnPass" @onkeydown="OnKey"
                       autocomplete="current-password" aria-label="Contraseña" />
                <button type="button" class="cl-loginfield__eye" @onclick="TogglePass" tabindex="-1"
                        aria-label="@(_showPass ? "Ocultar contraseña" : "Mostrar contraseña")">
                    <Icon Name="eye" Size="16" />
                </button>
            </div>

            <button type="button" class="cl-loginbox__cta" @onclick="Ingresar" disabled="@_loading">
                @if (_loading)
                {
                    <span class="cl-spin"></span>
                    <span>Verificando…</span>
                }
                else
                {
                    <span>Ingresar al sistema</span>
                    <span class="cl-loginbox__cta-go"><Icon Name="arrowRight" Size="15" /></span>
                }
            </button>

            <div class="cl-loginbox__help">
                ¿No recuerdas tu contraseña?
                <a @onclick="@(() => App.Navigate("recover"))">Solicita un restablecimiento</a>
            </div>

            <div class="cl-loginbox__foot">
                <span class="cl-loginbox__sec">
                    <Icon Name="lock" Size="13" Color="#6b7689" />
                    Conexión segura y protegida
                </span>
                <span class="cl-livedot"></span>
            </div>
        </div>
    </div>
</div>

@code {
    private string _usuario = "";
    private string _password = "";
    private bool _showPass;
    private bool _userOk;
    private bool _loading;
    private bool _shake;
    private string? _error;

    private void OnUser(ChangeEventArgs e)
    {
        _usuario = e.Value?.ToString() ?? "";
        _userOk = _usuario.Trim().Length >= 3;
        _error = null;
    }

    private void OnPass(ChangeEventArgs e)
    {
        _password = e.Value?.ToString() ?? "";
        _error = null;
    }

    private void TogglePass() => _showPass = !_showPass;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            await Ingresar();
    }

    private async Task Ingresar()
    {
        if (_loading) return;

        _error = null;
        _loading = true;

        var result = await Auth.LoginAsync(_usuario, _password);

        _loading = false;

        if (result.Success && result.User is not null)
        {
            App.SignIn(result.User);
            App.Navigate("dashboard");
            return;
        }

        _error = result.Error ?? "No se pudo iniciar sesión.";
        _shake = true;
        StateHasChanged();
        await Task.Delay(450);
        _shake = false;
    }
}
