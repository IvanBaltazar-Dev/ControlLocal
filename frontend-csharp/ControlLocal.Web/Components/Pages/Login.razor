@page "/"
@page "/login"
@inject AppState App
@inject IAuthService Auth

<PageTitle>Inicio de sesión · ControlLocal</PageTitle>

<div class="cl-login">
    @* Escena a pantalla completa (cover) + glow que respira sobre el render 3D *@
    <div class="cl-login__bg"></div>
    <div class="cl-login__glow"></div>
    <div class="cl-login__scrim"></div>
    <div class="cl-login__orb cl-login__orb--a"></div>
    <div class="cl-login__orb cl-login__orb--b"></div>
    <div class="cl-login__sheen"></div>

    <div class="cl-login__stage">
        @* ===== Columna de marca (izquierda) sobre la imagen ===== *@
        <aside class="cl-login__brand">
            <div class="cl-brand__logo">
                <img src="img/logo.webp?v=2" alt="ControlLocal" />
            </div>

            <h2 class="cl-brand__tagline">
                <span>Gestión y trazabilidad</span>
                <span class="cl-brand__tagline-2">del alquiler de locales comerciales.</span>
            </h2>

            <div class="cl-brand__demos">
                <div class="cl-brand__demos-head">
                    <Icon Name="user" Size="13" />
                    <span>Cuentas de demostración</span>
                    <span class="cl-brand__demos-hint">clic para autocompletar</span>
                </div>

                <button type="button" class="cl-democard@(_cuentaSel == "admin" ? " is-active" : "")"
                        style="animation-delay:.50s" @onclick='() => UsarCuenta("admin", "admin@controllocal.test", "Admin2026")'>
                    <span class="cl-democard__ic"><Icon Name="settings" Size="18" /></span>
                    <span class="cl-democard__body">
                        <span class="cl-democard__role">Broker Administrador</span>
                        <span class="cl-democard__user">admin@controllocal.test</span>
                        <span class="cl-democard__pass"><Icon Name="unlock" Size="11" Color="#ff5d5d" /> Admin2026</span>
                    </span>
                    <span class="cl-democard__go"><Icon Name="arrowRight" Size="15" /></span>
                </button>

                <button type="button" class="cl-democard@(_cuentaSel == "super" ? " is-active" : "")"
                        style="animation-delay:.58s" @onclick='() => UsarCuenta("super", "rsalas", "Broker2026")'>
                    <span class="cl-democard__ic"><Icon Name="users" Size="18" /></span>
                    <span class="cl-democard__body">
                        <span class="cl-democard__role">Broker supervisor</span>
                        <span class="cl-democard__user">rsalas</span>
                        <span class="cl-democard__pass"><Icon Name="unlock" Size="11" Color="#ff5d5d" /> Broker2026</span>
                    </span>
                    <span class="cl-democard__go"><Icon Name="arrowRight" Size="15" /></span>
                </button>

                <button type="button" class="cl-democard@(_cuentaSel == "agente" ? " is-active" : "")"
                        style="animation-delay:.66s" @onclick='() => UsarCuenta("agente", "vmora", "Agente2026")'>
                    <span class="cl-democard__ic"><Icon Name="user" Size="18" /></span>
                    <span class="cl-democard__body">
                        <span class="cl-democard__role">Agente Inmobiliario</span>
                        <span class="cl-democard__user">vmora</span>
                        <span class="cl-democard__pass"><Icon Name="unlock" Size="11" Color="#ff5d5d" /> Agente2026</span>
                    </span>
                    <span class="cl-democard__go"><Icon Name="arrowRight" Size="15" /></span>
                </button>
            </div>

            <ul class="cl-brand__benefits" aria-label="Beneficios principales">
                <li style="--d:.92s">
                    <span class="cl-benefit__ic cl-benefit__ic--ops"><Icon Name="component" Size="18" /></span>
                    <span class="cl-benefit__text">Organización eficiente</span>
                </li>
                <li style="--d:1.00s">
                    <span class="cl-benefit__ic cl-benefit__ic--track"><Icon Name="chartBar" Size="18" /></span>
                    <span class="cl-benefit__text">Seguimiento centralizado</span>
                </li>
                <li style="--d:1.08s">
                    <span class="cl-benefit__ic cl-benefit__ic--control"><Icon Name="history" Size="18" /></span>
                    <span class="cl-benefit__text">Trazabilidad y control</span>
                </li>
            </ul>

            @* Línea con destello de luz que la recorre (ultra premium). *@
            <div class="cl-brand__beam" aria-hidden="true"></div>
        </aside>

        <div class="cl-loginbox">
            <span class="cl-loginbox__shield" title="Conexión protegida">
                <Icon Name="lock" Size="15" Color="#5b6b86" />
            </span>

            @* Marca corporativa. *@
            <div class="cl-loginbox__logo">
                <ControlLocalLogo Class="cl-loginbox__logo-mark" Size="48" />
            </div>

            <div class="cl-loginbox__hello">Bienvenido</div>
            <h1 class="cl-loginbox__title">Iniciar sesión</h1>
            <div class="cl-loginbox__rule"></div>
            <div class="cl-loginbox__sub">Ingresa con tu cuenta corporativa</div>

            @if (_error is not null)
            {
                <div class="cl-loginbox__error@(_shake ? " shake" : "")">
                    <Icon Name="alert" Size="15" />
                    <span>@_error</span>
                </div>
            }

            <div class="cl-loginfield" style="animation-delay:.52s">
                <span class="cl-loginfield__ic"><Icon Name="user" Size="17" /></span>
                <input class="cl-loginfield__in" placeholder="Usuario"
                       value="@_usuario" @oninput="OnUser" @onkeydown="OnKey"
                       autocomplete="username" aria-label="Ingresa tu Usuario" />
                <span class="cl-loginfield__ok@(_userOk ? " is-on" : "")"><Icon Name="checkCircle" Size="16" /></span>
            </div>

            <div class="cl-loginfield" style="animation-delay:.58s">
                <span class="cl-loginfield__ic"><Icon Name="lock" Size="16" /></span>
                <input class="cl-loginfield__in" placeholder="Contraseña"
                       type="@(_showPass ? "text" : "password")"
                       value="@_password" @oninput="OnPass" @onkeydown="OnKey"
                       autocomplete="current-password" aria-label="Contraseña" />
                <button type="button" class="cl-loginfield__eye" @onclick="TogglePass" tabindex="-1"
                        aria-label="@(_showPass ? "Ocultar contraseña" : "Mostrar contraseña")">
                    <Icon Name="eye" Size="16" />
                </button>
            </div>

            <button type="button" class="cl-loginbox__cta" @onclick="Ingresar" disabled="@_loading">
                @if (_loading)
                {
                    <span class="cl-spin"></span>
                    <span>Verificando…</span>
                }
                else
                {
                    <span>Ingresar al sistema</span>
                    <span class="cl-loginbox__cta-go"><Icon Name="arrowRight" Size="15" /></span>
                }
            </button>

            <div class="cl-loginbox__help">
                ¿No recuerdas tu contraseña?
                <a @onclick="@(() => App.Navigate("recover"))">Solicita un restablecimiento</a>
            </div>

            <div class="cl-loginbox__foot">
                <span class="cl-loginbox__sec">
                    <Icon Name="lock" Size="13" Color="#6b7689" />
                    Conexión segura y protegida
                </span>
                <span class="cl-livedot"></span>
            </div>
        </div>
    </div>
</div>

@code {
    private string _usuario = "";
    private string _password = "";
    private bool _showPass;
    private bool _userOk;
    private bool _loading;
    private bool _shake;
    private string? _error;
    private string? _cuentaSel;

    // Autocompleta el formulario al hacer clic en una tarjeta de cuenta demo.
    private void UsarCuenta(string key, string usuario, string password)
    {
        _cuentaSel = key;
        _usuario = usuario;
        _password = password;
        _userOk = _usuario.Trim().Length >= 3;
        _error = null;
    }

    private void OnUser(ChangeEventArgs e)
    {
        _usuario = e.Value?.ToString() ?? "";
        _userOk = _usuario.Trim().Length >= 3;
        _error = null;
        _cuentaSel = null;
    }

    private void OnPass(ChangeEventArgs e)
    {
        _password = e.Value?.ToString() ?? "";
        _error = null;
    }

    private void TogglePass() => _showPass = !_showPass;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter")
            await Ingresar();
    }

    private async Task Ingresar()
    {
        if (_loading) return;

        _error = null;
        _loading = true;

        var result = await Auth.LoginAsync(_usuario, _password);

        _loading = false;

        if (result.Success && result.User is not null)
        {
            await App.SignInAsync(result.User, result.Token);
            App.Navigate("dashboard");
            return;
        }

        _error = result.Error ?? "No se pudo iniciar sesión.";
        _shake = true;
        StateHasChanged();
        await Task.Delay(450);
        _shake = false;
    }
}
