@page "/oportunidad-form"
@page "/oportunidad-form/{CaptacionCodigo}"
@inherits SafeComponentBase
@inject AppState App
@inject IOportunidadService OportunidadSvc
@inject IClienteService ClienteSvc
@inject ICaptacionService CaptacionSvc

<PageTitle>Nueva oportunidad - ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Oportunidades comerciales", "Nueva oportunidad" })"
          Title="Nueva oportunidad comercial"
          Subtitle="Vincula un cliente interesado con una captacion activa para iniciar el seguimiento">
    <Actions>
        <button class="cl-btn ghost" disabled="@_procesando" @onclick="@(() => App.Navigate("oportunidades"))">
            <Icon Name="chevronLeft" Size="13" /> Volver
        </button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Cliente interesado" Sub="Persona o empresa que quiere evaluar el local">
                    <Field Label="Cliente" Required="true">
                        <input class="cl-input search" type="search" placeholder="Escribe para buscar cliente por nombre o rubro…"
                               value="@_busquedaCliente"
                               @oninput="OnBusquedaCliente"
                               @onfocus="@(() => _desplegarClientes = true)"
                               disabled="@(_cargando || _procesando)" />
                               
                        <div style="margin-top:6px;max-height:230px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;">
                            @if (_desplegarClientes || _clienteId == 0)
                            {
                                @foreach (var cliente in ClientesDisponibles)
                                {
                                    var sel = _clienteId == cliente.Id;
                                    <div role="button" tabindex="0"
                                         style="@PickStyle(sel)"
                                         @onclick="@(() => SeleccionarCliente(cliente.Id))">
                                        <span class="cl-avatar" style="width:26px;height:26px;font-size:10px;flex:0 0 26px;">@Iniciales(cliente.Nombre)</span>
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-weight:600;font-size:13px;">@cliente.Nombre</div>
                                            <div class="cl-muted" style="font-size:11px;">@cliente.RubroInteres</div>
                                        </div>
                                        @if (sel)
                                        {
                                            <Icon Name="check" Size="15" Color="#005BFF" />
                                        }
                                    </div>
                                }
                                @if (!ClientesDisponibles.Any())
                                {
                                    <div class="cl-help">No hay clientes que coincidan con la búsqueda.</div>
                                }
                            }
                            else if (ClienteSeleccionado is not null)
                            {
                                <div role="button" tabindex="0"
                                     style="@PickStyle(true)"
                                     @onclick="@(() => _desplegarClientes = true)">
                                    <span class="cl-avatar" style="width:26px;height:26px;font-size:10px;flex:0 0 26px;">@Iniciales(ClienteSeleccionado.Nombre)</span>
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;">@ClienteSeleccionado.Nombre</div>
                                        <div class="cl-muted" style="font-size:11px;">@ClienteSeleccionado.RubroInteres</div>
                                    </div>
                                    <Icon Name="check" Size="15" Color="#005BFF" />
                                </div>
                            }
                        </div>
                    </Field>
                </FormSection>

                <FormSection Num="2" Title="Captacion activa" Sub="Propiedad disponible para seguimiento comercial">
                    <Field Label="Captacion" Required="true">
                        <input class="cl-input search" type="search" placeholder="Escribe para buscar por código, dirección o distrito…"
                               value="@_busquedaCaptacion"
                               @oninput="OnBusquedaCaptacion"
                               @onfocus="@(() => _desplegarCaptaciones = true)"
                               disabled="@(_cargando || _procesando)" />
                               
                        <div style="margin-top:6px;max-height:230px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;">
                            @if (_desplegarCaptaciones || _captacionId == 0)
                            {
                                @foreach (var captacion in CaptacionesActivas)
                                {
                                    var sel = _captacionId == captacion.Id;
                                    <div role="button" tabindex="0"
                                         style="@PickStyle(sel)"
                                         @onclick="@(() => SeleccionarCaptacion(captacion.Id))">
                                        <div style="flex:1;min-width:0;">
                                            <div style="font-weight:600;font-size:13px;">@captacion.CodigoCaptacion · @captacion.DireccionLocal</div>
                                            <div class="cl-muted" style="font-size:11px;">@captacion.DistritoLocal</div>
                                        </div>
                                        @if (sel)
                                        {
                                            <Icon Name="check" Size="15" Color="#005BFF" />
                                        }
                                    </div>
                                }
                                @if (!CaptacionesActivas.Any())
                                {
                                    <div class="cl-help">No hay captaciones activas que coincidan con la búsqueda.</div>
                                }
                            }
                            else if (CaptacionSeleccionada is not null)
                            {
                                <div role="button" tabindex="0"
                                     style="@PickStyle(true)"
                                     @onclick="@(() => _desplegarCaptaciones = true)">
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;">@CaptacionSeleccionada.CodigoCaptacion · @CaptacionSeleccionada.DireccionLocal</div>
                                        <div class="cl-muted" style="font-size:11px;">@CaptacionSeleccionada.DistritoLocal</div>
                                    </div>
                                    <Icon Name="check" Size="15" Color="#005BFF" />
                                </div>
                            }
                        </div>
                    </Field>
                </FormSection>

                <FormSection Num="3" Title="Primer contexto" Sub="Notas iniciales del interes del cliente">
                    <Field Label="Observaciones">
                        <textarea rows="4" @bind="_observaciones" @bind:event="oninput"
                                  placeholder="Ej. Cliente interesado en visitar el local esta semana."></textarea>
                    </Field>
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("oportunidades"))"
                               OnSave="@GuardarAsync"
                               SaveLabel="Crear oportunidad"
                               Busy="@_procesando"
                               BusyLabel="Creando..." />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Resumen</div></div>
                    <div class="cl-card-body">
                        <dl class="cl-kv">
                            <dt>Cliente</dt>
                            <dd>@(ClienteSeleccionado?.Nombre ?? "-")</dd>
                            <dt>Captacion</dt>
                            <dd>@(CaptacionSeleccionada?.CodigoCaptacion ?? "-")</dd>
                            <dt>Local</dt>
                            <dd>@(CaptacionSeleccionada?.DireccionLocal ?? "-")</dd>
                        </dl>
                    </div>
                </div>
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>La oportunidad abre el seguimiento comercial del cliente. Desde ahi podras registrar interacciones, visitas, solicitud y cierre.</span>
                </div>
            </div>
        </div>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CaptacionCodigo { get; set; }

    private IReadOnlyList<ClienteInteresadoDto> _clientes = [];
    private IReadOnlyList<CaptacionDto> _captaciones = [];
    
    private long _clienteId;
    private long _captacionId;
    
    // Banderas para controlar el estado de "desplegado" de las listas
    private bool _desplegarClientes = false;
    private bool _desplegarCaptaciones = false;
    
    private string _observaciones = "";
    private string _busquedaCliente = "";
    private string _busquedaCaptacion = "";
    private bool _clientePickerAbierto = true;
    private bool _captacionPickerAbierto = true;
    private bool _cargando = true;
    private bool _procesando;
    private string? _err;

    private IEnumerable<ClienteInteresadoDto> ClientesDisponibles =>
        _clientes.Where(item => item.Estado is "Activo" or "A")
            .Where(item => TextoFiltro.Contiene(item.Nombre, _busquedaCliente)
                || TextoFiltro.Contiene(item.RubroInteres, _busquedaCliente))
            .OrderBy(item => item.Nombre);

    private IEnumerable<CaptacionDto> CaptacionesActivas =>
        _captaciones.Where(item => item.Estado is "Activa" or "A")
            .Where(item => TextoFiltro.Contiene(item.CodigoCaptacion, _busquedaCaptacion)
                || TextoFiltro.Contiene(item.DireccionLocal, _busquedaCaptacion)
                || TextoFiltro.Contiene(item.DistritoLocal, _busquedaCaptacion))
            .OrderByDescending(item => item.FechaCaptacion);

    private static string PickStyle(bool sel)
    {
        var border = sel ? "#005BFF" : "var(--c-border)";
        var bg = sel ? "#EAF1FF" : "#fff";
        return $"display:flex;align-items:center;gap:10px;padding:9px 11px;border:1.5px solid {border};border-radius:10px;background:{bg};cursor:pointer;";
    }

    private static string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private ClienteInteresadoDto? ClienteSeleccionado =>
        _clientes.FirstOrDefault(item => item.Id == _clienteId);

    private CaptacionDto? CaptacionSeleccionada =>
        _captaciones.FirstOrDefault(item => item.Id == _captacionId);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Cliente", "Interesado", _clienteId > 0),
        new FormStepsSidebar.Step("Captacion", "Propiedad activa", _captacionId > 0),
        new FormStepsSidebar.Step("Contexto", "Notas iniciales", true),
    };
    
    
    private void OnBusquedaCliente(ChangeEventArgs e)
    {
        _busquedaCliente = e.Value?.ToString() ?? "";
        _desplegarClientes = true; 
    }

    private void SeleccionarCliente(long id)
    {
        _clienteId = id;
        _desplegarClientes = false; 
        _busquedaCliente = ""; 
    }

    private void OnBusquedaCaptacion(ChangeEventArgs e)
    {
        _busquedaCaptacion = e.Value?.ToString() ?? "";
        _desplegarCaptaciones = true;
    }

    private void SeleccionarCaptacion(long id)
    {
        _captacionId = id;
        _desplegarCaptaciones = false;
        _busquedaCaptacion = "";
    }

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _err = null;
        try
        {
            var clientesTask = ClienteSvc.RefrescarAsync(DisposedToken);
            var captacionesTask = CaptacionSvc.RefrescarAsync(DisposedToken);
            _clientes = await clientesTask;
            _captaciones = await captacionesTask;

            if (!string.IsNullOrWhiteSpace(CaptacionCodigo))
            {
                var captacion = _captaciones.FirstOrDefault(item =>
                    item.CodigoCaptacion.Equals(CaptacionCodigo, StringComparison.OrdinalIgnoreCase));
                if (captacion is not null)
                    SeleccionarCaptacion(captacion.Id);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private void AbrirPickerCliente() => _clientePickerAbierto = true;

    private void AbrirPickerCaptacion() => _captacionPickerAbierto = true;

    private void OnBusquedaCliente(ChangeEventArgs e)
    {
        _busquedaCliente = e.Value?.ToString() ?? "";
        _clientePickerAbierto = true;
    }

    private void OnBusquedaCaptacion(ChangeEventArgs e)
    {
        _busquedaCaptacion = e.Value?.ToString() ?? "";
        _captacionPickerAbierto = true;
    }

    private void SeleccionarCliente(long id)
    {
        _clienteId = id;
        _clientePickerAbierto = false;
        if (_clientes.FirstOrDefault(item => item.Id == id) is { } cliente)
            _busquedaCliente = cliente.Nombre;
    }

    private void SeleccionarCaptacion(long id)
    {
        _captacionId = id;
        _captacionPickerAbierto = false;
        if (_captaciones.FirstOrDefault(item => item.Id == id) is { } captacion)
            _busquedaCaptacion = $"{captacion.CodigoCaptacion} · {captacion.DireccionLocal}";
    }

    private async Task GuardarAsync()
    {
        if (_procesando) return;
        if (_clienteId <= 0) { _err = "Selecciona un cliente interesado."; return; }
        if (_captacionId <= 0) { _err = "Selecciona una captacion activa."; return; }

        try
        {
            _procesando = true;
            _err = null;
            await RenderIfAliveAsync();
            var oportunidad = await OportunidadSvc.CrearAsync(new OportunidadFormRequest
            {
                ClienteId = _clienteId,
                CaptacionId = _captacionId,
                Observaciones = _observaciones,
            }, DisposedToken);
            App.Navigate($"oportunidad-detail/{oportunidad.Id}");
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }
}