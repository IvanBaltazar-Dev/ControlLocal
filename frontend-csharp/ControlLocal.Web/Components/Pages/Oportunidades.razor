@page "/oportunidades"
@inject AppState App
@inject ExportacionService Exportar
@inject IOportunidadService OportunidadSvc
@inject ISolicitudService SolicitudSvc

<PageTitle>@_title - ControlLocal</PageTitle>

<AppShell Active="@_sideActive" Crumbs="@_crumbs"
          Title="@_title"
          Subtitle="@_subtitle">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCsv"><Icon Name="download" Size="13" /> Exportar</button>
        @if (_isBroker)
        {
            <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
        else
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("oportunidad-form"))"><Icon Name="plus" Size="13" /> Nueva oportunidad</button>
        }
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <div style="display:grid;grid-template-columns:repeat(@(_etapas.Length + 1),1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="target" Label="Total" Value="@_ops.Count.ToString()" Tone="gray"
                        Active="@(_tab == "Todas")" OnClick="@(() => _tab = "Todas")" />
            @foreach (var e in _etapas)
            {
                <MetricCard Icon="activity" Label="@e" Value="@CuentaEtapa(e).ToString()" Tone="@TonoEtapa(e)"
                            Active="@(_tab == e)" OnClick="@(() => _tab = e)" />
            }
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

        <FilterBar Search="Buscar por operación, cliente, local, agente…"
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Todos los agentes" Options="_agentes" @bind-Value="_agente" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Operación</th><th>Captación</th><th>Cliente</th><th>Local</th>
                            <th>Agente</th><th>Etapa</th><th>Monto/mes</th><th>Actualizada</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in visibles)
                        {
                            <tr>
                                <td><span class="mono">@o.Op</span></td>
                                <td><span class="mono">@o.Cap</span></td>
                                <td style="font-weight:600;">@o.Client</td>
                                <td>@o.Local</td>
                                <td>
                                    <div class="cl-flex">
                                        <span class="cl-avatar" style="width:24px;height:24px;font-size:10px;background:@o.Color;">@o.Ini</span>
                                        <span>@o.Agent</span>
                                    </div>
                                </td>
                                <td><StatusBadge Label="@o.Stage" /></td>
                                <td>@(o.Amount == "—" ? "—" : $"USD {o.Amount}")</td>
                                <td><span class="cl-muted" style="font-size:12px;">@o.Updated</span></td>
                                <td><button class="cl-btn sm" @onclick="@(() => App.Navigate($"oportunidad-detail/{o.Id}"))">Ver seguimiento</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Actualizando operaciones…</div>
                }
                else if (_error is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="target" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin operaciones en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />

        @if (_isBroker)
        {
            <div class="cl-alert blue" style="margin-top:14px;">
                <Icon Name="info" Size="15" />
                <span>Como supervisor consultas las operaciones en <b>solo lectura</b>. El registro de interacciones, visitas y solicitudes lo realiza el agente a cargo.</span>
            </div>
        }
    </ChildContent>
</AppShell>

@code {
    private string _tab = "Todas";
    private string _query = "";
    private string _agente = "";
    private int _pagina = 1;
    private bool _isBroker => App.Role == Roles.Broker;
    private string _title => _isBroker ? "Operaciones del equipo" : "Oportunidades comerciales";
    private string _sideActive => _isBroker ? "Operaciones del equipo" : "Oportunidades comerciales";
    private string _subtitle => _isBroker
        ? "Seguimiento de las operaciones comerciales de los agentes que supervisas"
        : "Clientes interesados vinculados a tus captaciones activas";
    private string[] _crumbs => _isBroker
        ? new[] { "ControlLocal", "Seguimiento", "Operaciones del equipo" }
        : new[] { "ControlLocal", "Operacion", "Oportunidades comerciales" };

    // Dimensiones derivadas de los datos (sin valores hardcodeados).
    private string[] _etapas => _ops.Select(o => o.Stage).Distinct().OrderBy(x => x).ToArray();
    private IReadOnlyList<string> _agentes => _ops.Select(o => o.Agent).Distinct().OrderBy(x => x).ToList();

    private int CuentaEtapa(string e) => _ops.Count(o => o.Stage == e);

    private Tabs.TabItem[] _tabs => new[] { new Tabs.TabItem("Todas", _ops.Count) }
        .Concat(_etapas.Select(e => new Tabs.TabItem(e, CuentaEtapa(e))))
        .ToArray();

    private bool HayFiltros => _tab != "Todas" || !string.IsNullOrEmpty(_query) || !string.IsNullOrEmpty(_agente);

    private void LimpiarFiltros() { _tab = "Todas"; _query = ""; _agente = ""; _pagina = 1; }

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("operaciones_equipo",
            new[] { "Operación", "Captación", "Cliente", "Local", "Agente", "Etapa", "Monto mensual USD", "Actualizada" },
            Filtradas().Select(o => (IReadOnlyList<string?>)new[]
            {
                o.Op, o.Cap, o.Client, o.Local, o.Agent, o.Stage, o.Amount, o.Updated,
            }));
    }

    private IEnumerable<OpRow> Filtradas() => _ops.Where(o =>
        (_tab == "Todas" || o.Stage == _tab) &&
        (string.IsNullOrEmpty(_agente) || o.Agent == _agente) &&
        (string.IsNullOrEmpty(_query) || Coincide(o, _query)));

    private static bool Coincide(OpRow o, string q) =>
        o.Op.Contains(q, StringComparison.OrdinalIgnoreCase)
        || o.Client.Contains(q, StringComparison.OrdinalIgnoreCase)
        || o.Local.Contains(q, StringComparison.OrdinalIgnoreCase)
        || o.Agent.Contains(q, StringComparison.OrdinalIgnoreCase)
        || o.Cap.Contains(q, StringComparison.OrdinalIgnoreCase);

    private static string TonoEtapa(string e) => e switch
    {
        "Alquilada" => "green",
        "Captada" => "blue",
        "En evaluación" => "info",
        _ => "blue",
    };

    private record OpRow(long Id, string Op, string Cap, string Client, string Local, string Ini, string Color, string Agent, string Stage, string Amount, string Updated);

    private IReadOnlyList<OpRow> _ops = [];
    private bool _cargando = true;
    private string? _error;

    // Recarga oportunidades y solicitudes frescas del backend, luego construye las
    // filas combinadas (no bloquea el circuito).
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await OportunidadSvc.RefrescarAsync();
            await SolicitudSvc.RefrescarAsync();
            _ops = Construir();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private IReadOnlyList<OpRow> Construir() => OportunidadSvc.All().Select(o =>
    {
        var solicitud = SolicitudSvc.All().FirstOrDefault(s =>
            s.OportunidadId == o.Id
            || s.CodigoOperacion == o.CodigoOportunidad
            || o.ClienteNombre.Contains(s.ClienteNombre)
            || s.ClienteNombre.Contains(o.ClienteNombre));
        var nombre = string.IsNullOrWhiteSpace(o.NombreAgenteResponsable) ? "Sin asignar" : o.NombreAgenteResponsable;
        var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(parte => char.ToUpperInvariant(parte[0])));
        var etapa = solicitud?.Estado switch
        {
            "En revision" => "En evaluación",
            "Observada" => "Solicitud observada",
            "Aprobada" => "Solicitud aprobada",
            "Rechazada" => "Solicitud rechazada",
            _ => o.Estado,
        };
        return new OpRow(
            o.Id,
            o.CodigoOportunidad,
            o.CaptacionCodigo,
            o.ClienteNombre,
            o.DireccionLocal,
            iniciales,
            "#3A6BB5",
            nombre,
            etapa,
            solicitud?.MontoMensualTexto ?? "—",
            o.FechaRegistroTexto);
    }).ToList();
}
