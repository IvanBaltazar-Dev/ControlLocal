@page "/oportunidades"
@inject AppState App
@inject ExportacionService Exportar
@inject IOportunidadService OportunidadSvc
@inject ISolicitudService SolicitudSvc
@inject ICaptacionService CaptacionSvc

<PageTitle>Oportunidades comerciales - ControlLocal</PageTitle>

<AppShell Active="Oportunidades comerciales" Crumbs="@(new[] { "ControlLocal", "Operacion", "Oportunidades comerciales" })"
          Title="Oportunidades comerciales"
          Subtitle="Clientes interesados vinculados a tus captaciones activas">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCsv"><Icon Name="download" Size="13" /> Exportar</button>
        @if (App.Role == Roles.Agente)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("oportunidad-form"))"><Icon Name="plus" Size="13" /> Nueva oportunidad</button>
        }
        else
        {
            <span class="cl-badge blue"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <div style="display:grid;grid-template-columns:repeat(@(_etapas.Length + 1),1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="target" Label="Total" Value="@_ops.Count.ToString()" Tone="gray"
                        Active="@(_tab == "Todas")" OnClick="@(() => _tab = "Todas")" />
            @foreach (var e in _etapas)
            {
                <MetricCard Icon="activity" Label="@e" Value="@CuentaEtapa(e).ToString()" Tone="@TonoEtapa(e)"
                            Active="@(_tab == e)" OnClick="@(() => _tab = e)" />
            }
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

        <FilterBar Search="Buscar por operacion, cliente, local, agente, propietario..."
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros" />

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Operacion</th><th>Cliente</th><th>Local</th><th>Agente</th>
                            <th>Propietario</th><th>Etapa</th><th>Monto/mes</th><th>Ultima operacion</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in visibles)
                        {
                            <tr>
                                <td><span class="mono">@o.Op</span></td>
                                <td style="font-weight:600;">@o.Client</td>
                                <td>@o.Local</td>
                                <td>
                                    <div class="cl-flex">
                                        <span class="cl-avatar" style="width:24px;height:24px;font-size:10px;background:@o.Color;">@o.Ini</span>
                                        <span>@o.Agent</span>
                                    </div>
                                </td>
                                <td>@o.Owner</td>
                                <td><StatusBadge Label="@o.Stage" /></td>
                                <td>@(o.Amount == "-" ? "-" : $"USD {o.Amount}")</td>
                                <td>
                                    <div style="font-weight:600;font-size:12.5px;">@o.LastAction</div>
                                    <span class="cl-muted" style="font-size:11.5px;">@o.Updated</span>
                                </td>
                                <td><a class="cl-btn sm" href="@($"/oportunidad-detail/{o.Id}")">Ver seguimiento</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Actualizando operaciones...</div>
                }
                else if (_error is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="target" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin operaciones en este filtro</div>
                        <div style="font-size:12px;">Ajusta la busqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />
    </ChildContent>
</AppShell>

@code {
    private string _tab = "Todas";
    private string _query = "";
    private int _pagina = 1;

    private string[] _etapas => _ops.Select(o => o.Stage).Distinct().OrderBy(x => x).ToArray();
    private int CuentaEtapa(string e) => _ops.Count(o => o.Stage == e);

    private Tabs.TabItem[] _tabs => new[] { new Tabs.TabItem("Todas", _ops.Count) }
        .Concat(_etapas.Select(e => new Tabs.TabItem(e, CuentaEtapa(e))))
        .ToArray();

    private bool HayFiltros => _tab != "Todas" || !string.IsNullOrEmpty(_query);

    private void LimpiarFiltros() { _tab = "Todas"; _query = ""; _pagina = 1; }

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("oportunidades_comerciales",
            new[] { "Operacion", "Cliente", "Local", "Agente", "Propietario", "Etapa", "Monto mensual USD", "Ultima operacion", "Actualizada" },
            Filtradas().Select(o => (IReadOnlyList<string?>)new[]
            {
                o.Op, o.Client, o.Local, o.Agent, o.Owner, o.Stage, o.Amount, o.LastAction, o.Updated,
            }));
    }

    private IEnumerable<OpRow> Filtradas() => _ops.Where(o =>
        (_tab == "Todas" || o.Stage == _tab) &&
        (string.IsNullOrEmpty(_query) || Coincide(o, _query)));

    private static bool Coincide(OpRow o, string q) =>
        TextoFiltro.Contiene(o.Op, q)
        || TextoFiltro.Contiene(o.Cap, q)
        || TextoFiltro.Contiene(o.Client, q)
        || TextoFiltro.Contiene(o.Local, q)
        || TextoFiltro.Contiene(o.Agent, q)
        || TextoFiltro.Contiene(o.Owner, q);

    private static string TonoEtapa(string e) => e switch
    {
        "Alquilada" => "green",
        "Captada" => "blue",
        "En evaluacion" => "info",
        _ => "blue",
    };

    private record OpRow(long Id, string Op, string Cap, string Client, string Local, string Ini, string Color, string Agent, string Owner, string Stage, string Amount, string Updated, string LastAction);

    private IReadOnlyList<OpRow> _ops = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var oportunidades = await OportunidadSvc.RefrescarAsync();
            var solicitudes = await SolicitudSvc.RefrescarAsync();
            var captaciones = await CaptacionSvc.RefrescarAsync();
            _ops = Construir(oportunidades, solicitudes, captaciones);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private IReadOnlyList<OpRow> Construir(IReadOnlyList<OportunidadComercialDto> oportunidades, IReadOnlyList<SolicitudAlquilerDto> solicitudes, IReadOnlyList<CaptacionDto> captaciones) => oportunidades.Select(o =>
    {
        var captacion = captaciones.FirstOrDefault(c => c.CodigoCaptacion.Equals(o.CaptacionCodigo, StringComparison.OrdinalIgnoreCase));
        var solicitud = solicitudes.FirstOrDefault(s =>
            s.OportunidadId == o.Id
            || s.CodigoOperacion == o.CodigoOportunidad
            || o.ClienteNombre.Contains(s.ClienteNombre)
            || s.ClienteNombre.Contains(o.ClienteNombre));
        var nombre = string.IsNullOrWhiteSpace(o.NombreAgenteResponsable) ? "Sin asignar" : o.NombreAgenteResponsable;
        var iniciales = string.Concat(nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(parte => char.ToUpperInvariant(parte[0])));
        var etapa = solicitud?.Estado switch
        {
            "En revision" => "En evaluacion",
            "Observada" => "Solicitud observada",
            "Aprobada" => "Solicitud aprobada",
            "Rechazada" => "Solicitud rechazada",
            _ => o.Estado,
        };
        var (ultimaOp, fechaEvento) = UltimaOperacion(o, solicitud);
        return new OpRow(
            o.Id,
            o.CodigoOportunidad,
            o.CaptacionCodigo,
            o.ClienteNombre,
            o.DireccionLocal,
            iniciales,
            "#3A6BB5",
            nombre,
            string.IsNullOrWhiteSpace(captacion?.PropietarioNombre) ? "-" : captacion.PropietarioNombre,
            etapa,
            solicitud?.MontoMensualTexto ?? "-",
            FormatearFecha(fechaEvento, o.FechaRegistroTexto),
            ultimaOp);
    }).ToList();

    private static (string Label, DateTime? Fecha) UltimaOperacion(OportunidadComercialDto o, SolicitudAlquilerDto? solicitud)
    {
        if (solicitud is not null)
        {
            var label = solicitud.Estado switch
            {
                "Aprobada" => "Aprobacion de solicitud",
                "Rechazada" => "Rechazo de solicitud",
                "Observada" => "Observacion de solicitud",
                "En revision" => "Solicitud en evaluacion",
                "Cerrada" => "Cierre de operacion",
                _ => "Solicitud registrada",
            };
            return (label, solicitud.FechaActualizacionEstado ?? o.FechaActualizacion);
        }
        var opLabel = o.Estado switch
        {
            "Alquilada" => "Operacion cerrada",
            "Captada" => "Oportunidad abierta",
            "En evaluacion" => "Oportunidad en evaluacion",
            _ => "Oportunidad actualizada",
        };
        return (opLabel, o.FechaActualizacion);
    }

    private static string FormatearFecha(DateTime? fecha, string fallback) =>
        fecha?.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)
        ?? (string.IsNullOrWhiteSpace(fallback) ? "-" : fallback);
}
