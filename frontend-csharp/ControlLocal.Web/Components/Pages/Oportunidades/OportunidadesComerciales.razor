@page "/oportunidades-comerciales"
@rendermode InteractiveServer
@inject OportunidadComercialService Service
@inject RoleState RoleState
@inject NavigationManager Navigation

<PageTitle>Oportunidades comerciales - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">@RoleState.CurrentRole</div>
        <div class="cl-page-title">@Title</div>
        <div class="cl-page-subtitle">@Subtitle</div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary">Vista tablero</button>
        @if (RoleState.CurrentRole == Roles.Agente)
        {
            <a class="btn btn-primary cl-btn-primary" href="/agente/oportunidades/nueva">Nueva oportunidad</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="cl-metric">
            <div class="cl-metric-label">Abiertas</div>
            <div class="cl-metric-value">@_items.Count(x => x.Estado.Contains("Abierta", StringComparison.OrdinalIgnoreCase))</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="cl-metric">
            <div class="cl-metric-label">Con solicitud</div>
            <div class="cl-metric-value">@_items.Count(x => x.Estado.Contains("Solicitud", StringComparison.OrdinalIgnoreCase))</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="cl-metric">
            <div class="cl-metric-label">Finalizadas</div>
            <div class="cl-metric-value">@_items.Count(x => x.Estado.Contains("Finalizada", StringComparison.OrdinalIgnoreCase))</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="cl-metric">
            <div class="cl-metric-label">Monto estimado</div>
            <div class="cl-metric-value">USD @_items.Sum(x => x.MontoEstimado)</div>
        </div>
    </div>
</div>

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-lg-3">
                <select class="form-select" @bind="_estado">
                    <option value="">Todos los estados</option>
                    @foreach (var estado in EnumCatalog.EstadosOportunidad)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </select>
            </div>
            <div class="col-lg-9">
                <input class="form-control" placeholder="Buscar por cliente, local o estado" @bind="_search" @bind:event="oninput" />
            </div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Local</th>
                    <th>Fecha</th>
                    <th>Monto estimado</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Filtradas)
                {
                    <tr>
                        <td><strong>@item.Cliente</strong></td>
                        <td>
                            @item.DireccionLocal
                            <div class="small text-secondary">Local #@item.LocalComercialId</div>
                        </td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>USD @item.MontoEstimado</td>
                        <td><span class="cl-status @StatusClass(item.Estado)">@item.Estado</span></td>
                        <td class="text-end">
                            @if (RoleState.CurrentRole == Roles.Agente)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenDetail">Detalle 360</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<OportunidadComercialDto> _items = [];
    private string _search = string.Empty;
    private string _estado = string.Empty;

    private string Title => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Oportunidades - auditoria global",
        Roles.Broker => "Operaciones del equipo",
        _ => "Mis oportunidades comerciales"
    };

    private string Subtitle => RoleState.CurrentRole switch
    {
        Roles.BrokerAdministrador => "Vista de lectura para control global; la operacion diaria no se registra desde administracion.",
        Roles.Broker => "Seguimiento de oportunidades de agentes bajo tu supervision.",
        _ => "Seguimiento de clientes interesados sobre captaciones activas."
    };

    private IEnumerable<OportunidadComercialDto> Filtradas => _items.Where(x =>
        (string.IsNullOrWhiteSpace(_estado) || x.Estado == _estado)
        && (string.IsNullOrWhiteSpace(_search)
            || x.Cliente.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.DireccionLocal.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.Estado.Contains(_search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync() => _items = await Service.GetAllAsync();

    private static string StatusClass(string status) => status.ToLowerInvariant().Replace(" ", "-");

    private void OpenDetail() => Navigation.NavigateTo("/agente/oportunidades/detalle");
}
