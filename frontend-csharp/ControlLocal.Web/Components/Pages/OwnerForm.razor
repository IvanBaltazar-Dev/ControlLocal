@page "/owner-form"
@page "/owner-form/{IdParam?}"
@inject AppState App
@inject IPropietarioService OwnerSvc

<PageTitle>@(_isEdit ? "Editar propietario" : "Registrar propietario") · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Propietarios", _isEdit ? _nombre : "Nuevo propietario" })"
          Title="@(_isEdit ? "Editar propietario" : "Registrar propietario")"
          Subtitle="@(_isEdit
              ? "Actualiza los datos de contacto. Los datos de identidad no se pueden modificar."
              : "Persona que posee el local · podrás vincularlo a un local comercial al darlo de alta")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("owners"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 250px;gap:14px;max-width:1100px;">
            <div>
                <FormSection Num="1" Title="Tipo de propietario" Sub="@(_isEdit ? "No se puede cambiar tras el registro" : "Determina los campos de identificación requeridos")">
                <div class="cl-seg" role="tablist">
                    <button class="@(_tipo == "juridica" ? "active" : "")" disabled="@_isEdit" @onclick="@(() => { if (!_isEdit) { _tipo = "juridica"; _tipoDocumento = "R"; _err = null; } })">Persona jurídica</button>
                    <button class="@(_tipo == "natural" ? "active" : "")" disabled="@_isEdit" @onclick="@(() => { if (!_isEdit) { _tipo = "natural"; _tipoDocumento = ""; _err = null; } })">Persona natural</button>
                </div>
                @if (_isEdit)
                {
                    <div class="cl-muted" style="font-size:11px;margin-top:8px;display:flex;align-items:center;gap:6px;">
                        <Icon Name="lock" Size="12" /> El tipo de propietario quedó fijado al registrarlo.
                    </div>
                }
            </FormSection>

            <FormSection Num="2" Title="Identificación" Sub="@(_tipo == "juridica" ? "Datos de la empresa" : "Datos personales del propietario")">
                @if (_tipo == "juridica")
                {
                    <div class="cl-grid c2">
                        <Field Label="Razón social" Required="true"><input @bind="_nombre" placeholder="Ej. Inmobiliaria del Sur S.A.C." @oninput="@(() => _err = null)" /></Field>
                        <Field Label="RUC" Required="true">
                            <input value="@_numeroDocumento" inputmode="numeric" maxlength="@DocumentoMaxLength"
                                   placeholder="20XXXXXXXX" disabled="@_isEdit" @oninput="OnDocumentoInput" />
                            @if (_isEdit)
                            {
                                <div class="cl-muted" style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:6px;"><Icon Name="lock" Size="11" /> El RUC no se puede modificar.</div>
                            }
                        </Field>
                    </div>
                }
                else
                {
                    <div class="cl-grid c2">
                        <Field Label="Nombres" Required="true"><input @bind="_nombre" placeholder="Nombres" @oninput="@(() => _err = null)" /></Field>
                        <DocumentTypeSelector PersonType="natural" SelectedDocType="@_tipoDocumento" OnChange="OnTipoDocChange" Disabled="@_isEdit" />
                        <Field Label="Número de documento" Required="true">
                            <input value="@_numeroDocumento" inputmode="numeric" maxlength="@DocumentoMaxLength"
                                   placeholder="XXXXXXXX" disabled="@_isEdit" @oninput="OnDocumentoInput" />
                            @if (_isEdit)
                            {
                                <div class="cl-muted" style="font-size:11px;margin-top:6px;display:flex;align-items:center;gap:6px;"><Icon Name="lock" Size="11" /> El documento de identidad no se puede modificar.</div>
                            }
                        </Field>
                    </div>
                }
            </FormSection>

            <FormSection Num="3" Title="Contacto" Sub="Teléfono y correo para coordinación">
                <div class="cl-grid c2">
                    <Field Label="Teléfono" Required="true"><input value="@_telefono" inputmode="numeric" maxlength="9" placeholder="999999999" @oninput="OnTelefonoInput" /></Field>
                    <Field Label="Correo electrónico" Required="true"><input @bind="_correo" placeholder="propietario@@correo.com" @oninput="@(() => _err = null)" /></Field>
                </div>
                <label style="display:flex;align-items:center;gap:8px;margin-top:14px;font-size:13px;">
                    <input type="checkbox" @bind="_consentimientoUsoDato" style="width:auto;" />
                    Autoriza el uso de sus datos para la gestión inmobiliaria.
                </label>
            </FormSection>

            @if (_isEdit)
            {
                <FormSection Num="4" Title="Estado" Sub="Un propietario inactivo no aparece disponible para nuevas captaciones">
                    <div class="cl-seg" role="tablist">
                        <button class="@(_estado == "Activo" ? "active" : "")" @onclick="@(() => { _estado = "Activo"; _err = null; })">Activo</button>
                        <button class="@(_estado == "Inactivo" ? "active" : "")" @onclick="@(() => { _estado = "Inactivo"; _err = null; })">Inactivo</button>
                    </div>
                </FormSection>
            }

            @if (_err is not null)
            {
                <div class="cl-alert red" style="margin-bottom:14px;">
                    <Icon Name="alert" Size="15" /><span>@_err</span>
                </div>
            }

            <FormFooterBar OnCancel="@(() => App.Navigate("owners"))" OnSave="@TryConfirm"
                           SaveLabel="@(_isEdit ? "Guardar cambios" : "Registrar propietario")"
                           Busy="@_procesando" BusyLabel="Guardando..." />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="@(_isEdit ? "edit" : "user")"
                       Title="@(_isEdit ? "¿Guardar cambios?" : "¿Registrar propietario?")"
                       Desc="@(_isEdit
                           ? "Se actualizarán los datos de contacto y el estado del propietario. La identidad permanece sin cambios."
                           : "Se creará el propietario en tu registro. Quedará disponible para vincular a la captación de un local comercial.")"
                       ConfirmLabel="@(_isEdit ? "Guardar" : "Registrar")" CancelLabel="Revisar datos"
                       Busy="@_procesando"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">@(_isEdit ? "Cambios guardados correctamente" : "Propietario registrado correctamente")</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? IdParam { get; set; }

    private bool _isEdit;
    private string _tipo = "juridica";
    private string _nombre = "";
    private string _tipoDocumento = "R"; // R=RUC para juridica, D/C/P para natural
    private string _numeroDocumento = "";
    private string _telefono = "";
    private string _correo = "";
    private string _estado = "Activo";
    private bool _consentimientoUsoDato = true;
    private bool _confirm;
    private bool _toast;
    private bool _procesando;
    private string? _err;

    // Progreso interactivo de las secciones del formulario.
    private bool IsStep1Complete => !string.IsNullOrEmpty(_tipo);
    private bool IsStep2Complete => !string.IsNullOrWhiteSpace(_nombre) && !string.IsNullOrWhiteSpace(_numeroDocumento)
                                    && (_tipo == "juridica" || !string.IsNullOrWhiteSpace(_tipoDocumento));
    private bool IsStep3Complete => !string.IsNullOrWhiteSpace(_telefono) && !string.IsNullOrWhiteSpace(_correo);
    private bool IsStep4Complete => !_isEdit || !string.IsNullOrEmpty(_estado);
    private string DocumentoActualTipo => _tipo == "juridica" ? "R" : _tipoDocumento;
    private int DocumentoMaxLength => PeruInputRules.DocumentoMaxLength(DocumentoActualTipo);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos
    {
        get
        {
            var pasos = new List<FormStepsSidebar.Step>
            {
                new("Tipo", "Natural o Jurídica", IsStep1Complete),
                new("Identificación", "Documento y nombre", IsStep2Complete),
                new("Contacto", "Teléfono y correo", IsStep3Complete),
            };
            if (_isEdit)
            {
                pasos.Add(new FormStepsSidebar.Step("Estado", "Activo o inactivo", IsStep4Complete));
            }
            return pasos;
        }
    }

    private void OnTipoDocChange(string val)
    {
        _tipoDocumento = val;
        _numeroDocumento = PeruInputRules.Documento(_numeroDocumento, DocumentoActualTipo);
        _err = null;
    }

    private void OnDocumentoInput(ChangeEventArgs e)
    {
        _numeroDocumento = PeruInputRules.Documento(e.Value?.ToString(), DocumentoActualTipo);
        _err = null;
    }

    private void OnTelefonoInput(ChangeEventArgs e)
    {
        _telefono = PeruInputRules.Telefono(e.Value?.ToString());
        _err = null;
    }

    protected override void OnParametersSet()
    {
        if (long.TryParse(IdParam, out var id) && OwnerSvc.ById(id) is { } owner)
        {
            _isEdit = true;
            _nombre = owner.Nombre;
            _numeroDocumento = PeruInputRules.Documento(owner.NumeroDocumento, ResolveTipoDocumento(owner));
            _telefono = PeruInputRules.Telefono(owner.Telefono);
            _correo = owner.Correo;
            _estado = string.IsNullOrEmpty(owner.Estado) ? "Activo" : owner.Estado;
            _consentimientoUsoDato = owner.ConsentimientoUsoDato ?? false;
            _tipo = TextoFiltro.Contiene(owner.TipoPersona, "jur") ? "juridica" : "natural";
            _tipoDocumento = ResolveTipoDocumento(owner);
        }
        else
        {
            _isEdit = false;
            _tipoDocumento = "R"; // RUC por defecto para personas jurídicas
        }
    }

    // Deriva el tipo de documento desde el DTO (campo explícito o texto "Persona … · XXX").
    private static string ResolveTipoDocumento(Models.Propietarios.PropietarioDto owner)
    {
        if (!string.IsNullOrWhiteSpace(owner.TipoDocumento))
            return owner.TipoDocumento;

        var tp = owner.TipoPersona;
        if (tp.Contains("RUC", StringComparison.OrdinalIgnoreCase)) return "R";
        if (tp.Contains("Carné", StringComparison.OrdinalIgnoreCase) || tp.Contains("extranjería", StringComparison.OrdinalIgnoreCase)) return "C";
        if (tp.Contains("Pasaporte", StringComparison.OrdinalIgnoreCase)) return "P";
        return "D";
    }

    private void TryConfirm()
    {
        if (string.IsNullOrWhiteSpace(_nombre)) { _err = "El nombre o razón social es obligatorio."; return; }

        if (!_isEdit && _tipo == "natural" && string.IsNullOrWhiteSpace(_tipoDocumento))
        {
            _err = "Debes seleccionar un tipo de documento.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_numeroDocumento)) { _err = "El número de documento es obligatorio."; return; }
        if (PeruInputRules.ValidarDocumento(DocumentoActualTipo, _numeroDocumento) is { } documentoError) { _err = documentoError; return; }
        if (string.IsNullOrWhiteSpace(_telefono)) { _err = "El teléfono es obligatorio."; return; }
        if (PeruInputRules.ValidarTelefono(_telefono) is { } telefonoError) { _err = telefonoError; return; }
        if (string.IsNullOrWhiteSpace(_correo)) { _err = "El correo es obligatorio."; return; }

        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        if (_procesando) return;
        _confirm = false;
        try
        {
            _procesando = true;
            _err = null;
            StateHasChanged();
            var propietario = new Models.Propietarios.PropietarioDto
            {
                Id = _isEdit && long.TryParse(IdParam, out var id) ? id : 0,
                Nombre = _nombre.Trim(),
                TipoPersona = _tipo == "juridica" ? "Persona juridica" : "Persona natural",
                TipoDocumento = _tipo == "juridica" ? "R" : _tipoDocumento,
                NumeroDocumento = PeruInputRules.Documento(_numeroDocumento, _tipo == "juridica" ? "R" : _tipoDocumento),
                Telefono = PeruInputRules.Telefono(_telefono),
                Correo = _correo.Trim(),
                Estado = _estado,
                ConsentimientoUsoDato = _consentimientoUsoDato,
            };
            if (_isEdit) await OwnerSvc.ActualizarAsync(propietario);
            else await OwnerSvc.AgregarAsync(propietario);

            _toast = true;
            StateHasChanged();
            await Task.Delay(300);
            App.Navigate("owners");
        }
        catch (Exception error)
        {
            _err = error.Message;
        }
        finally
        {
            _procesando = false;
            StateHasChanged();
        }
    }
}
