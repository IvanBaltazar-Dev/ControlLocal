@page "/owners"
@inject AppState App
@inject IPropietarioService OwnerSvc

<PageTitle>Propietarios · ControlLocal</PageTitle>

<AppShell Active="Propietarios" Crumbs="@(new[] { "ControlLocal", "Captación", "Propietarios" })"
          Title="Propietarios"
          Subtitle="Propietarios que registré para vincular a captaciones">
    <Actions>
        @*Implementacion proximamente*@
        @*<button class="cl-btn"><Icon Name="upload" Size="13" /> Importar</button>*@
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("owner-form"))"><Icon Name="plus" Size="13" /> Registrar propietario</button>
    </Actions>
    <ChildContent>
        @{ var filtrados = Filtrados().ToList(); }
        <FilterBar Search="Buscar por nombre, razón social, documento…"
                   @bind-Value="_query" ResultCount="filtrados.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Tipo de persona" Options="_tipos" @bind-Value="_tipo" />
            <FilterSelect Placeholder="Estado" Options="_estados" @bind-Value="_estado" />
        </FilterBar>
        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Propietario</th><th>Documento</th><th>Teléfono</th>
                            <th>Correo</th><th>Locales</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in filtrados)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600;">@o.Nombre</div>
                                    <div class="cl-muted" style="font-size:11px;">@o.TipoPersona</div>
                                </td>
                                <td><span class="mono">@o.NumeroDocumento</span></td>
                                <td><span class="mono">@o.Telefono</span></td>
                                <td><span class="cl-muted">@o.Correo</span></td>
                                <td><span><b>@o.CantidadLocales</b></span></td>
                                <td><StatusBadge Label="@o.Estado" /></td>
                                <td><RowActions Items="@(new[] { "view", "edit" })"
                                                OnView="@(() => App.Navigate($"owner-detail/{o.Id}"))"
                                                OnEdit="@(() => App.Navigate($"owner-form/{o.Id}"))" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (filtrados.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="user" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin propietarios en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtrados.Count" />
    </ChildContent>
</AppShell>

@code {
    private string _query = "", _tipo = "", _estado = "";

    private IReadOnlyList<PropietarioDto> Todos => OwnerSvc.All();

    private readonly IReadOnlyList<string> _tipos = new[] { "Natural", "Jurídica" };
    private readonly IReadOnlyList<string> _estados = new[] { "Activo", "Inactivo" };

    private bool HayFiltros => new[] { _query, _tipo, _estado }.Any(s => !string.IsNullOrEmpty(s));

    private void LimpiarFiltros() { _query = _tipo = _estado = ""; }

    private IEnumerable<PropietarioDto> Filtrados() => Todos.Where(o =>
        (string.IsNullOrEmpty(_tipo) || (o.TipoPersona?.Contains(_tipo, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrEmpty(_estado) || o.Estado == _estado) &&
        (string.IsNullOrEmpty(_query) || Coincide(o, _query)));

    private static bool Coincide(PropietarioDto o, string q) =>
        (o.Nombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (o.NumeroDocumento?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
}
