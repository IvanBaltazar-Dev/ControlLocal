@page "/profile"
@inherits SafeComponentBase
@inject AppState App

<PageTitle>Mi perfil · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mi perfil" })"
          Title="Mi perfil"
          Subtitle="Administra tu identidad, datos de contacto y seguridad de acceso.">
    <section class="profile-hero">
        <div class="profile-hero-glow one"></div>
        <div class="profile-hero-glow two"></div>

        <div class="profile-identity">
            <div class="profile-avatar-wrap">
                @if (!string.IsNullOrWhiteSpace(_fotoUrl))
                {
                    <img class="profile-avatar-image" src="@_fotoUrl" alt="Foto de perfil de @User.Nombre" />
                }
                else
                {
                    <div class="profile-avatar">@User.Iniciales</div>
                }
                <span class="profile-presence" title="Cuenta activa"></span>
            </div>

            <div class="profile-heading">
                <div class="profile-eyebrow">
                    <span class="profile-status-dot"></span>
                    Cuenta activa
                </div>
                <h2>@User.Nombre</h2>
                <div class="profile-meta">
                    <span class="profile-role">@Roles.Label(User.Role)</span>
                    <span class="profile-meta-separator"></span>
                    <span>@($"@{User.Usuario}")</span>
                </div>
            </div>
        </div>

        <div class="profile-hero-actions">
            <label for="foto-perfil" class="cl-btn on-dark profile-upload">
                <Icon Name="upload" Size="14" />
                Cambiar foto
            </label>
            <div class="profile-file-input">
                <InputFile id="foto-perfil" OnChange="CambiarFoto" accept=".png,.jpg,.jpeg" />
            </div>
            <button type="button" class="cl-btn on-light" @onclick="@(() => App.Navigate("cambiar-contrasena"))">
                <Icon Name="lock" Size="14" />
                Seguridad
            </button>
        </div>
    </section>

    @if (_fotoErr is not null)
    {
        <div class="cl-alert red profile-feedback">
            <Icon Name="alert" Size="15" />
            <span>@_fotoErr</span>
        </div>
    }

    <div class="profile-layout">
        <main class="profile-main">
            <section class="profile-card">
                <header class="profile-card-header">
                    <div class="profile-card-icon"><Icon Name="user" Size="18" /></div>
                    <div>
                        <h3>Información de cuenta</h3>
                        <p>Datos asociados a tu acceso en ControlLocal.</p>
                    </div>
                </header>

                <div class="profile-info-grid">
                    <div class="profile-info-item">
                        <span class="profile-info-icon"><Icon Name="user" Size="16" /></span>
                        <div>
                            <span class="profile-info-label">Nombre completo</span>
                            <strong>@User.Nombre</strong>
                        </div>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-info-icon"><Icon Name="briefcase" Size="16" /></span>
                        <div>
                            <span class="profile-info-label">Rol de acceso</span>
                            <strong>@Roles.Label(User.Role)</strong>
                        </div>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-info-icon"><Icon Name="mail" Size="16" /></span>
                        <div>
                            <span class="profile-info-label">Correo corporativo</span>
                            <strong>@EmailVisible</strong>
                        </div>
                    </div>
                    <div class="profile-info-item">
                        <span class="profile-info-icon"><Icon Name="checkCircle" Size="16" /></span>
                        <div>
                            <span class="profile-info-label">Estado</span>
                            <strong class="profile-active-text">Activo y verificado</strong>
                        </div>
                    </div>
                </div>
            </section>

            <section class="profile-card">
                <header class="profile-card-header">
                    <div class="profile-card-icon"><Icon Name="phone" Size="18" /></div>
                    <div>
                        <h3>Datos de contacto</h3>
                        <p>Actualiza el teléfono utilizado para coordinaciones comerciales.</p>
                    </div>
                </header>

                <div class="profile-contact-form">
                    <label for="telefono">Teléfono de contacto</label>
                    <div class="profile-phone-row">
                        <div class="profile-phone-input">
                            <span>+51</span>
                            <input id="telefono"
                                   @bind="_telefono"
                                   inputmode="tel"
                                   autocomplete="tel"
                                   placeholder="999 999 999" />
                        </div>
                        <button type="button" class="cl-btn primary" @onclick="GuardarTelefono">
                            <Icon Name="save" Size="14" />
                            Guardar cambios
                        </button>
                    </div>
                    <p class="profile-help">Usaremos este número únicamente para coordinaciones de la operación comercial.</p>
                    @if (_telefonoErr is not null)
                    {
                        <div class="cl-alert red profile-inline-error">
                            <Icon Name="alert" Size="15" />
                            <span>@_telefonoErr</span>
                        </div>
                    }
                </div>
            </section>

            <section class="profile-card security-card">
                <header class="profile-card-header">
                    <div class="profile-card-icon"><Icon Name="lock" Size="18" /></div>
                    <div>
                        <h3>Seguridad y acceso</h3>
                        <p>Protege tu cuenta y revisa el estado de tu sesión.</p>
                    </div>
                </header>

                <div class="security-content">
                    <div class="security-copy">
                        <span class="security-check"><Icon Name="check" Size="16" /></span>
                        <div>
                            <strong>Sesión protegida</strong>
                            <p>Tu identidad y permisos corresponden al rol @Roles.Label(User.Role).</p>
                        </div>
                    </div>
                    <button type="button" class="cl-btn" @onclick="@(() => App.Navigate("cambiar-contrasena"))">
                        Cambiar contraseña
                        <Icon Name="arrowRight" Size="14" />
                    </button>
                </div>
            </section>
        </main>

        <aside class="profile-side">
            <section class="profile-card scope-card">
                <span class="scope-kicker">Perfil operativo</span>
                <div class="scope-icon"><Icon Name="@ScopeIcon" Size="22" /></div>
                <h3>@ScopeTitle</h3>
                <p>@ScopeDescription</p>

                <div class="scope-divider"></div>

                <div class="scope-detail">
                    <span>Tipo de operación</span>
                    <strong>Alquiler comercial</strong>
                </div>
                <div class="scope-detail">
                    <span>Cobertura</span>
                    <strong>@ScopeCoverage</strong>
                </div>
                <div class="scope-detail">
                    <span>Último acceso</span>
                    <strong>Sesión actual</strong>
                </div>
            </section>

            <section class="profile-card support-card">
                <div class="support-icon"><Icon Name="info" Size="18" /></div>
                <div>
                    <h3>¿Necesitas cambiar otro dato?</h3>
                    <p>Los nombres, el correo y el rol se gestionan desde la administración para proteger la trazabilidad.</p>
                </div>
            </section>
        </aside>
    </div>

    <Toast Show="_toast">@_toastMsg</Toast>
</AppShell>

@code {
    private AuthUser User
    {
        get
        {
            if (App.CurrentUser is { } current)
                return current;

            return new AuthUser("", "", "Usuario sin sesion", "--", App.Role);
        }
    }

    private string EmailVisible =>
        !string.IsNullOrWhiteSpace(User.Email)
            ? User.Email
            : User.Usuario.Contains('@') ? User.Usuario : "No registrado";

    private string ScopeIcon => App.Role switch
    {
        Roles.Admin => "settings",
        Roles.Broker => "users",
        _ => "briefcase",
    };

    private string ScopeTitle => App.Role switch
    {
        Roles.Admin => "Gestión global",
        Roles.Broker => "Supervisión comercial",
        _ => "Operación comercial",
    };

    private string ScopeDescription => App.Role switch
    {
        Roles.Admin => "Administración de brokers, asignaciones y configuración general.",
        Roles.Broker => "Seguimiento del equipo y de las operaciones comerciales asignadas.",
        _ => "Gestión de alquileres comerciales, clientes, inmuebles y visitas.",
    };

    private string ScopeCoverage => App.Role switch
    {
        Roles.Admin => "Toda la organización",
        Roles.Broker => "Equipo asignado",
        _ => "Cartera asignada",
    };

    private string _telefono = "";
    private string? _telefonoErr;
    private string? _fotoErr;
    private string? _fotoUrl;
    private bool _toast;
    private string _toastMsg = "";

    private void GuardarTelefono()
    {
        _telefonoErr = null;
        var digitos = _telefono.Count(char.IsDigit);
        if (digitos is < 6 or > 15)
        {
            _telefonoErr = "Ingresa un teléfono válido de entre 6 y 15 dígitos.";
            return;
        }

        Notificar("Teléfono actualizado correctamente.");
    }

    private async Task CambiarFoto(InputFileChangeEventArgs e)
    {
        _fotoErr = null;
        var archivo = e.File;
        byte[] contenido;

        try
        {
            await using var stream = archivo.OpenReadStream(ValidadorArchivos.TamanoMaximo);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria, DisposedToken);
            contenido = memoria.ToArray();
        }
        catch (IOException)
        {
            _fotoErr = $"La imagen supera el máximo de {ValidadorArchivos.TamanoMaximo / 1024 / 1024} MB.";
            return;
        }

        var cabecera = contenido.Take(8).ToArray();
        var validacion = ValidadorArchivos.Validar(
            archivo.Name,
            archivo.ContentType,
            archivo.Size,
            cabecera,
            ".png",
            ".jpg",
            ".jpeg");

        if (!validacion.EsValido)
        {
            _fotoErr = validacion.Error;
            return;
        }

        _fotoUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(contenido)}";
        Notificar("Foto de perfil actualizada.");
    }

    private void Notificar(string mensaje)
    {
        _toastMsg = mensaje;
        _toast = true;
        _ = DelayThenRenderAsync(2600, () => _toast = false);
    }
}
