@page "/profile"
@inject AppState App

<PageTitle>Mi perfil · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Mi perfil" })" Title="Mi perfil"
          Subtitle="Datos de tu cuenta de usuario en ControlLocal">
    <div style="display:grid;grid-template-columns:300px 1fr;gap:14px;">
        <div class="cl-card" style="text-align:center;padding:22px;">
            <div class="cl-avatar" style="width:88px;height:88px;font-size:28px;margin:0 auto;">@User.Initials</div>
            <div style="font-size:16px;font-weight:600;margin-top:12px;">@User.Name</div>
            <div style="font-size:12px;color:#7E8794;">@App.Role</div>
            <div style="margin-top:10px;"><StatusBadge Label="Activo" /></div>
            <button class="cl-btn" style="width:100%;margin-top:18px;justify-content:center;">
                <Icon Name="upload" Size="13" /> Cambiar foto
            </button>
            <div class="cl-divider"></div>
            <div style="text-align:left;">
                <div style="font-size:11px;color:#7E8794;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Resumen</div>
                <dl class="cl-kv">
                    @if (IsAdmin)
                    {
                        <dt>Alcance</dt><dd>Global — todos los brokers</dd>
                        <dt>Brokers a cargo</dt><dd>8</dd>
                        <dt>Ingreso</dt><dd>01 Oct 2023</dd>
                        <dt>Último acceso</dt><dd>Hoy 07:48</dd>
                    }
                    else if (IsBroker)
                    {
                        <dt>Agentes a cargo</dt><dd>7 activos</dd>
                        <dt>Zona</dt><dd>Lima Centro / Sur</dd>
                        <dt>Ingreso</dt><dd>11 Ene 2024</dd>
                        <dt>Último acceso</dt><dd>Hoy 07:55</dd>
                    }
                    else
                    {
                        <dt>Broker</dt><dd>Ricardo Salas</dd>
                        <dt>Zona</dt><dd>Lima Centro / Sur</dd>
                        <dt>Ingreso</dt><dd>14 Feb 2024</dd>
                        <dt>Último acceso</dt><dd>Hoy 08:12</dd>
                    }
                </dl>
            </div>
        </div>
        <div class="cl-stack">
            @if (IsAdmin)
            {
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>Como administrador global, solo tienes acceso de lectura a tu perfil. Contacta al equipo de soporte para cambios.</span>
                </div>
            }
            else
            {
                <FormSection Num="1" Title="Datos personales" Sub="Solo puedes editar tu teléfono. Otros datos se editan mediante el broker">
                    <div class="cl-grid c2">
                        <Field Label="Nombres"><input value="Valentina" disabled="true" /></Field>
                        <Field Label="Apellidos"><input value="Mora Quispe" disabled="true" /></Field>
                        <Field Label="Documento (DNI)"><input value="45 893 211" disabled="true" /></Field>
                        <Field Label="Teléfono" Hint="El único campo que puedes editar"><input value="+51 987 412 008" style="border-color:#005BFF;" /></Field>
                        <Field Label="Correo corporativo"><input value="vmora@@controllocal.pe" disabled="true" /></Field>
                        <Field Label="Zona asignada"><select disabled="true"><option>Lima Centro / Sur</option></select></Field>
                    </div>
                    <button class="cl-btn primary" style="margin-top:16px;">Guardar teléfono</button>
                </FormSection>

                <FormSection Num="2" Title="Seguridad" Sub="Gestión de contraseña">
                    <div class="cl-stack" style="gap:14px;">
                        <div style="padding:12px;background:#F7F8FA;border-radius:8px;border-left:3px solid #005BFF;">
                            <div style="font-size:13px;color:#515B6B;">Tu contraseña se cambió por última vez hace 45 días. Recomendamos cambiarla regularmente por seguridad.</div>
                        </div>
                        <button class="cl-btn primary" @onclick="@(() => App.Navigate("cambiar-contrasena"))"><Icon Name="lock" Size="13" /> Cambiar contraseña</button>
                    </div>
                </FormSection>
            }
        </div>
    </div>
</AppShell>

@code {
    private bool IsAdmin => App.Role == Roles.Admin;
    private bool IsBroker => App.Role == Roles.Broker;
    private RoleUser User => Navigation.UserFor(App.Role);
}
