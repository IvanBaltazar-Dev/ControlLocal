@page "/propiedades-alquiladas"
@inject AppState App
@inject IContratoService ContratoSvc
@inject ExportacionService Exportar

<PageTitle>Cierres exitosos · ControlLocal</PageTitle>

<AppShell Active="Cierres exitosos" Crumbs="@_crumbs"
          Title="Cierres exitosos"
          Subtitle="Operaciones cerradas con éxito: locales alquilados con contrato registrado">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCsv"><Icon Name="download" Size="13" /> Exportar</button>
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="store" Label="Cierres exitosos" Value="@_todos.Count.ToString()" Tone="green" />
            <MetricCard Icon="activity" Label="Comisión generada (USD)" Value="@ComisionTotalTexto" Tone="blue" />
            <MetricCard Icon="fileText" Label="Comisión por liquidar" Value="@PorLiquidar.ToString()" Tone="info" />
        </div>

        <FilterBar Search="Buscar por local, inquilino, operación…"
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Local</th><th>Distrito</th><th>Inquilino</th><th>Operación</th>
                            <th>Renta/mes</th><th>Plazo</th><th>Comisión</th><th>Liquidación</th>
                            <th>Cierre</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in visibles)
                        {
                            <tr>
                                <td style="font-weight:600;">@c.DireccionLocal</td>
                                <td>@c.DistritoLocal</td>
                                <td>@c.ClienteNombre</td>
                                <td><span class="mono">@c.CodigoOportunidad</span></td>
                                <td>USD <b>@c.RentaMensualTexto</b></td>
                                <td>@c.PlazoMeses m</td>
                                <td>USD @c.ComisionGeneradaTexto</td>
                                <td><span class="cl-muted" style="font-size:12px;">@(string.IsNullOrWhiteSpace(c.ComisionEstado) ? "—" : c.ComisionEstado)</span></td>
                                <td><span class="cl-muted" style="font-size:12px;">@c.FechaCierreTexto</span></td>
                                <td><StatusBadge Label="Alquilado" /></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(c.CodigoSolicitud))
                                    {
                                        <button class="cl-btn sm" @onclick="@(() => App.Navigate($"solicitud-detail/{c.CodigoSolicitud}"))">Ver detalle</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Actualizando cierres…</div>
                }
                else if (_error is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="store" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin cierres exitosos</div>
                        <div style="font-size:12px;">Cuando cierres un alquiler desde una solicitud aprobada, aparecerá aquí.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />
    </ChildContent>
</AppShell>

@code {
    private string _query = "", _distrito = "";
    private int _pagina = 1;

    private bool _cargando = true;
    private string? _error;
    private IReadOnlyList<ContratoAlquilerDto> _todos = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _todos = await ContratoSvc.RefrescarAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private IReadOnlyList<string> _distritos => _todos.Select(c => c.DistritoLocal)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();

    // Métricas data-driven del cierre (sin valores fijos).
    private string ComisionTotalTexto => _todos.Sum(c => c.ComisionGenerada)
        .ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-PE"));
    private int PorLiquidar => _todos.Count(c => c.ComisionEstado == "Pendiente");

    private bool HayFiltros => !string.IsNullOrEmpty(_query) || !string.IsNullOrEmpty(_distrito);

    private void LimpiarFiltros() { _query = ""; _distrito = ""; _pagina = 1; }

    private IEnumerable<ContratoAlquilerDto> Filtradas() => _todos.Where(c =>
        (string.IsNullOrEmpty(_distrito) || c.DistritoLocal == _distrito) &&
        (string.IsNullOrEmpty(_query) || Coincide(c, _query)));

    private static bool Coincide(ContratoAlquilerDto c, string q) =>
        TextoFiltro.Contiene(c.DireccionLocal, q)
        || TextoFiltro.Contiene(c.ClienteNombre, q)
        || TextoFiltro.Contiene(c.CodigoOportunidad, q)
        || TextoFiltro.Contiene(c.CodigoCaptacion, q);

    private string[] _crumbs => new[] { "ControlLocal", "Operación", "Cierres exitosos" };

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("cierres_exitosos",
            new[] { "Local", "Distrito", "Inquilino", "Operación", "Renta mensual USD", "Plazo (meses)", "Comisión USD", "Liquidación", "Cierre", "Estado" },
            Filtradas().Select(c => (IReadOnlyList<string?>)new[]
            {
                c.DireccionLocal, c.DistritoLocal, c.ClienteNombre, c.CodigoOportunidad,
                c.RentaMensualTexto, c.PlazoMeses.ToString(), c.ComisionGeneradaTexto,
                string.IsNullOrWhiteSpace(c.ComisionEstado) ? "—" : c.ComisionEstado, c.FechaCierreTexto, "Alquilado",
            }));
    }
}
