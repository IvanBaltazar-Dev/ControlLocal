@page "/propietarios"
@rendermode InteractiveServer
@inject PropietarioService Service
@inject RoleState RoleState

<PageTitle>Propietarios - ControlLocal</PageTitle>

<div class="cl-page-hero">
    <div>
        <div class="cl-page-kicker">@RoleState.CurrentRole</div>
        <div class="cl-page-title">@Title</div>
        <div class="cl-page-subtitle">@Subtitle</div>
    </div>
    @if (RoleState.CurrentRole == Roles.Agente)
    {
        <button class="btn btn-primary cl-btn-primary" @onclick="OpenNewAsync">Registrar propietario</button>
    }
</div>

@if (RoleState.CurrentRole != Roles.Agente)
{
    <div class="alert alert-warning">
        Esta pantalla queda en modo consulta para roles de supervision. El registro de propietarios pertenece al agente inmobiliario.
    </div>
}

<div class="card cl-card">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-lg-7">
                <input class="form-control" placeholder="Buscar por nombre, documento o correo" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-lg-3">
                <select class="form-select" @bind="_estado">
                    <option value="">Todos los estados</option>
                    <option>Activo</option>
                    <option>Inactivo</option>
                </select>
            </div>
            <div class="col-lg-2 text-lg-end">
                <button class="btn btn-outline-secondary w-100">Exportar</button>
            </div>
        </div>
    </div>
    <div class="table-responsive cl-table-card">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Propietario</th>
                    <th>Documento</th>
                    <th>Contacto</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Filtrados)
                {
                    <tr>
                        <td>
                            <strong>@item.NombreCompleto</strong>
                            <div class="small text-secondary">@item.TipoDocumento</div>
                        </td>
                        <td>@item.NumeroDocumento</td>
                        <td>
                            <div>@item.Correo</div>
                            <div class="small text-secondary">@item.Telefono</div>
                        </td>
                        <td><StatusBadge Label="@item.Estado" /></td>
                        <td class="text-end">
                            @if (RoleState.CurrentRole == Roles.Agente)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEditAsync(item)">Editar</button>
                            }
                            else
                            {
                                <button class="btn btn-outline-secondary btn-sm" disabled>Solo lectura</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<ControlLocalDialog @ref="_dialog" Title="@DialogTitle" Subtitle="Formulario breve en modal con showModal().">
    <EditForm Model="_form" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Tipo</label>
                <InputSelect class="form-select" @bind-Value="_form.TipoDocumento">
                    @foreach (var tipo in EnumCatalog.TiposDocumentoIdentidad)
                    {
                        <option value="@tipo.Label">@tipo.Label</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-8">
                <label class="form-label">Documento</label>
                <InputText class="form-control" @bind-Value="_form.NumeroDocumento" />
            </div>
            <div class="col-12">
                <label class="form-label">Nombres / razon social</label>
                <InputText class="form-control" @bind-Value="_form.Nombres" />
            </div>
            <div class="col-12">
                <label class="form-label">Apellidos</label>
                <InputText class="form-control" @bind-Value="_form.Apellidos" />
            </div>
            <div class="col-md-7">
                <label class="form-label">Correo</label>
                <InputText class="form-control" @bind-Value="_form.Correo" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Telefono</label>
                <InputText class="form-control" @bind-Value="_form.Telefono" />
            </div>
            <div class="col-12">
                <label class="form-label">Estado</label>
                <InputSelect class="form-select" @bind-Value="_form.Estado">
                    @foreach (var estado in EnumCatalog.EstadosActivoInactivo)
                    {
                        <option value="@estado.Label">@estado.Label</option>
                    }
                </InputSelect>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button class="btn btn-outline-secondary" type="button" @onclick="CloseAsync">Cancelar</button>
            <button class="btn btn-primary cl-btn-primary" type="submit">Guardar</button>
        </div>
    </EditForm>
</ControlLocalDialog>

@code {
    private ControlLocalDialog? _dialog;
    private List<PropietarioDto> _items = [];
    private PropietarioDto _form = new();
    private string _search = string.Empty;
    private string _estado = string.Empty;
    private bool _editing;

    private string Title => RoleState.CurrentRole == Roles.Agente ? "Propietarios" : "Propietarios - consulta";
    private string Subtitle => RoleState.CurrentRole == Roles.Agente
        ? "Propietarios registrados por el agente para vincular locales y captaciones."
        : "Vista de supervision sin registro operativo.";
    private string DialogTitle => _editing ? "Editar propietario" : "Registrar propietario";

    private IEnumerable<PropietarioDto> Filtrados => _items.Where(x =>
        (string.IsNullOrWhiteSpace(_search)
            || x.NombreCompleto.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.NumeroDocumento.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || x.Correo.Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrWhiteSpace(_estado) || x.Estado == _estado));

    protected override async Task OnInitializedAsync() => _items = await Service.GetAllAsync();

    private async Task OpenNewAsync()
    {
        _editing = false;
        _form = new PropietarioDto();
        if (_dialog is not null) await _dialog.ShowAsync();
    }

    private async Task OpenEditAsync(PropietarioDto item)
    {
        _editing = true;
        _form = new PropietarioDto
        {
            Id = item.Id,
            TipoDocumento = item.TipoDocumento,
            NumeroDocumento = item.NumeroDocumento,
            Nombres = item.Nombres,
            Apellidos = item.Apellidos,
            Correo = item.Correo,
            Telefono = item.Telefono,
            Estado = item.Estado
        };
        if (_dialog is not null) await _dialog.ShowAsync();
    }

    private async Task GuardarAsync()
    {
        if (_editing)
        {
            var index = _items.FindIndex(x => x.Id == _form.Id);
            if (index >= 0) _items[index] = _form;
        }
        else
        {
            _form.Id = _items.Count == 0 ? 1 : _items.Max(x => x.Id) + 1;
            _items.Insert(0, _form);
        }
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (_dialog is not null) await _dialog.CloseAsync();
    }
}
