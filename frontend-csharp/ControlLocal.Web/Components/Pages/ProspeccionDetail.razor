@page "/prospeccion-detail/{IdParam:long}"
@inherits SafeComponentBase
@inject AppState App
@inject IProspeccionService ProspeccionSvc
@inject IInteraccionService InteraccionSvc
@inject ILocalService LocalSvc
@inject ICoincidenciaCarteraService CoincidenciaSvc

<PageTitle>Seguimiento de prospeccion - @(_p?.CodigoProspeccion ?? "ControlLocal")</PageTitle>

@if (_cargando)
{
    <AppShell Title="Seguimiento de prospeccion" Crumbs="@(new[] { "ControlLocal", "Prospecciones" })">
        <ChildContent>
            <LoadingBlock Title="Cargando seguimiento..." Subtitle="Preparando propietario, propiedad e interacciones." />
        </ChildContent>
    </AppShell>
}
else if (_p is null)
{
    <AppShell Title="Seguimiento de prospeccion" Crumbs="@(new[] { "ControlLocal", "Prospecciones" })">
        <ChildContent>
            <div class="cl-alert amber">
                <Icon Name="alert" Size="15" />
                <span>@(_error ?? "No se encontro la prospeccion solicitada.")</span>
            </div>
        </ChildContent>
    </AppShell>
}
else
{
    <AppShell Crumbs="@_crumbs"
              Title="@($"Seguimiento de prospeccion - {_p.CodigoProspeccion}")"
              Subtitle="@($"{_p.Direccion} - {_p.Distrito}")">
        <Actions>
            <button class="cl-btn ghost" @onclick="@(() => App.Navigate("prospecciones"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
            @if (_readOnly)
            {
                <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
            }
        </Actions>
        <ChildContent>
            @if (_error is not null)
            {
                <div class="cl-alert red" style="margin-bottom:14px;">
                    <Icon Name="alert" Size="15" />
                    <span>@_error</span>
                </div>
            }

            <DetailHero Eyebrow="@($"Prospeccion - {_p.CodigoProspeccion}")"
                        EyebrowIcon="store"
                        Title="@_p.Direccion"
                        Subtitle="@($"{_p.Distrito} - propietario: {_p.PropietarioNombre}")"
                        SubtitleIcon="mapPin"
                        Status="@EstadoTexto"
                        Stats="@_heroStats" />

            @if (EsDescartada)
            {
                <div class="cl-alert red" style="margin:14px 0;">
                    <Icon Name="flag" Size="15" />
                    <span><b>Prospeccion descartada.</b> @Txt(_p.Observaciones)</span>
                </div>
            }
            else if (EsCaptada)
            {
                <div class="cl-alert green" style="margin:14px 0;">
                    <Icon Name="checkCircle" Size="15" />
                    <span><b>Propiedad captada.</b> La captacion vinculada conserva el paso a expediente comercial.</span>
                </div>
            }
            else if (RecontactoVencido)
            {
                <div class="cl-alert red" style="margin:14px 0;">
                    <Icon Name="clock" Size="15" />
                    <span><b>Recontacto pendiente.</b> Han pasado @DiasSinAccionTexto sin una nueva accion con el propietario.</span>
                </div>
            }

            <div class="cl-stage" style="margin:14px 0;">
                @for (var i = 0; i < _stages.Length; i++)
                {
                    var cls = i < _currentStage ? "done" : (i == _currentStage ? "active" : "");
                    <div class="cl-stage-step @cls">
                        <div class="cl-stage-k"><span class="cl-stage-dot"></span> Etapa @(i + 1)</div>
                        <div class="cl-stage-v">@_stages[i]</div>
                    </div>
                }
            </div>

            <div style="display:grid;grid-template-columns:minmax(0,1fr) minmax(310px,360px);gap:16px;align-items:start;">
                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div>
                                <div class="cl-card-title">Propietario y propiedad</div>
                                <div class="cl-card-sub">Origen comercial de la futura captacion</div>
                            </div>
                            <StatusBadge Label="@EstadoTexto" />
                        </div>
                        <div class="cl-card-body">
                            <div class="cl-specs">
                                <Spec Icon="user" K="Propietario" V="@_p.PropietarioNombre" />
                                <Spec Icon="store" K="Local" V="@_p.LocalCodigo" />
                                <Spec Icon="mapPin" K="Direccion" V="@_p.Direccion" />
                                <Spec Icon="map" K="Distrito" V="@_p.Distrito" />
                                <Spec Icon="building" K="Area" V="@($"{_p.AreaM2} m2")" />
                                <Spec Icon="briefcase" K="Rubro" V="@Txt(_p.Rubro)" />
                                <Spec Icon="chart" K="Precio ref." V="@($"USD {Txt(_p.PrecioReferencialTexto)}")" />
                                <Spec Icon="users" K="Agente" V="@Txt(_p.NombreAgente)" />
                            </div>
                        </div>
                    </div>

                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div>
                                <div class="cl-card-title">Interacciones</div>
                                <div class="cl-card-sub">Llamadas, reuniones y acuerdos con el propietario</div>
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span class="cl-badge blue">+ @_interacciones.Count</span>
                                <button class="cl-btn sm" type="button" @onclick="RefrescarInteracciones" disabled="@_recargandoInteracciones">
                                    <Icon Name="refresh" Size="12" /> @(_recargandoInteracciones ? "Cargando..." : "Recargar")
                                </button>
                            </div>
                        </div>
                        @if (_errorInteracciones is not null)
                        {
                            <div class="cl-alert amber" style="margin:8px 0;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                                <span>@_errorInteracciones</span>
                                <button class="cl-btn sm" type="button" @onclick="RefrescarInteracciones" disabled="@_recargandoInteracciones">
                                    Reintentar
                                </button>
                            </div>
                        }
                        <div style="overflow:auto;">
                            <table class="cl-table">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Canal</th>
                                        <th>Resultado</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var interaccion in _interacciones)
                                    {
                                        <tr>
                                            <td style="font-size:12px;">@interaccion.FechaHoraTexto</td>
                                            <td>@EnumCatalog.LabelFor(EnumCatalog.CanalesContacto, interaccion.CanalContacto)</td>
                                            <td><ResultadoBadge Resultado="@interaccion.Resultado" Contexto="@interaccion.Contexto" /></td>
                                            <td>@Txt(interaccion.Observaciones)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (_interacciones.Count == 0 && _errorInteracciones is null)
                            {
                                <div style="padding:28px;text-align:center;color:#7E8794;font-size:12.5px;">Aun no hay interacciones con este propietario.</div>
                            }
                        </div>
                    </div>

                    @if (!EsDescartada)
                    {
                        @if (!_coincidenciasOpen)
                        {
                            <div class="cl-card">
                                <div class="cl-card-head">
                                    <div>
                                        <div class="cl-card-title"><Icon Name="users" Size="14" /> Clientes que buscan algo asi</div>
                                        <div class="cl-card-sub">Carga la demanda compatible solo cuando la necesites.</div>
                                    </div>
                                    <button class="cl-btn sm" @onclick="AbrirCoincidencias"><Icon Name="chevronRight" Size="12" /> Ver clientes</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <PanelCoincidencias Titulo="Clientes que buscan algo asi"
                                                Icono="users"
                                                Descripcion="Clientes de tu cartera con requerimiento activo compatible con esta propiedad. Es una senal de demanda para decidir la captacion."
                                                Items="_coincidencias?.Items"
                                                Total="@(_coincidencias?.Total ?? 0)"
                                                Page="@_coinPage"
                                                PageSize="@_coinPageSize"
                                                PageChanged="CambiarPaginaCoincidencias"
                                                Cargando="_cargandoCoin"
                                                Error="@_errCoin"
                                                EtiquetaAccion="Proponer"
                                                TextoVacio="Ningun cliente de tu cartera busca algo asi por ahora." />
                            <button class="cl-btn sm ghost" @onclick="CerrarCoincidencias"><Icon Name="chevronLeft" Size="12" /> Ocultar clientes</button>
                        }
                    }

                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div>
                                <div class="cl-card-title">Documentos y fichas</div>
                                <div class="cl-card-sub">Accesos utiles para revisar la propiedad y el propietario</div>
                            </div>
                        </div>
                        <div class="cl-card-body cl-stack">
                            <FilaExpediente Icon="store" Titulo="Ficha del local" Estado="@_p.LocalCodigo">
                                <Accion>
                                    @if (_local is not null)
                                    {
                                        <a class="cl-btn sm" href="@($"/local-detail/{_local.Id}")"><Icon Name="eye" Size="12" /> Ver local</a>
                                    }
                                </Accion>
                            </FilaExpediente>
                            <FilaExpediente Icon="user" Titulo="Ficha del propietario" Estado="@_p.PropietarioNombre">
                                <Accion>
                                    <FichaLink Kind="owner" Id="@_local?.PropietarioId" Text="Abrir ficha" Variant="button" />
                                </Accion>
                            </FilaExpediente>
                            <FilaExpediente Icon="fileText" Titulo="Propuesta al propietario" Estado="@EstadoPropuestaTexto" />
                            @if (!string.IsNullOrWhiteSpace(_p.CaptacionCodigo))
                            {
                                <FilaExpediente Icon="pin" Titulo="Captacion vinculada" Estado="@_p.CaptacionCodigo">
                                    <Accion>
                                        <a class="cl-btn sm primary" href="@($"/captacion-detail/{_p.CaptacionCodigo}")"><Icon Name="arrowRight" Size="12" /> Abrir</a>
                                    </Accion>
                                </FilaExpediente>
                            }
                        </div>
                    </div>
                </div>

                <div class="cl-stack">
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div>
                                <div class="cl-card-title">Lectura comercial</div>
                                <div class="cl-card-sub">Senales para decidir el siguiente paso</div>
                            </div>
                        </div>
                        <div class="cl-card-body">
                            <dl class="cl-kv" style="grid-template-columns:1fr auto;">
                                <dt>Estado</dt><dd><StatusBadge Label="@EstadoTexto" /></dd>
                                <dt>Ultima accion</dt><dd>@UltimaAccionTexto</dd>
                                <dt>Dias sin accion</dt><dd>@DiasSinAccionTexto</dd>
                                <dt>Interacciones</dt><dd>@_interacciones.Count</dd>
                                <dt>Recontacto</dt><dd>@EstadoRecontactoTexto</dd>
                                <dt>Captacion</dt><dd>@Txt(_p.CaptacionCodigo)</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="cl-alert @(RecontactoVencido ? "red" : EsCaptada ? "green" : "blue")">
                        <Icon Name="@PanelIcon" Size="15" />
                        <span><b>@PanelTitulo</b><br />@PanelDetalle</span>
                    </div>

                    @if (!_readOnly && !EsDescartada && (!EsCaptada || !string.IsNullOrWhiteSpace(_p.CaptacionCodigo)))
                    {
                        <div class="cl-card">
                            <div class="cl-card-head"><div class="cl-card-title">Acciones de prospeccion</div></div>
                            <div class="cl-card-body">
                                <div style="display:flex;flex-direction:column;gap:8px;">
                                    @if (!EsCaptada)
                                    {
                                        <button class="cl-btn primary" disabled="@_procesando" @onclick="AbrirInteraccion"><Icon Name="activity" Size="13" /> Registrar interaccion</button>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(_p.CaptacionCodigo))
                                    {
                                        <button class="cl-btn primary" disabled="@_procesando" @onclick="@(() => App.Navigate($"captacion-detail/{_p.CaptacionCodigo}"))"><Icon Name="pin" Size="13" /> Abrir captacion</button>
                                    }
                                    @if (!EsCaptada && _p.Estado == "P")
                                    {
                                        <button class="cl-btn" disabled="@_procesando" @onclick="@(() => Avanzar(ProspeccionSvc.ContactarAsync, "Propietario contactado"))"><Icon Name="phone" Size="13" /> Contactar propietario</button>
                                    }
                                    @if (!EsCaptada && _p.Estado == "C")
                                    {
                                        <button class="cl-btn" disabled="@_procesando" @onclick="@(() => Avanzar(ProspeccionSvc.RegistrarReunionAsync, "Reunion registrada"))"><Icon Name="users" Size="13" /> Registrar reunion</button>
                                    }
                                    @if (!EsCaptada && _p.Estado == "R")
                                    {
                                        <button class="cl-btn" disabled="@_procesando" @onclick="@(() => Avanzar(ProspeccionSvc.EntregarPropuestaAsync, "Propuesta entregada"))"><Icon Name="fileText" Size="13" /> Entregar propuesta</button>
                                    }
                                    @if (!EsCaptada && (_p.Estado is "E" or "S"))
                                    {
                                        <button class="cl-btn success" disabled="@_procesando" @onclick="@(() => App.Navigate($"captacion-form/captar/{_p.Id}"))"><Icon Name="pin" Size="13" /> Crear captacion</button>
                                    }
                                    @if (!EsCaptada)
                                    {
                                        <button class="cl-btn danger" disabled="@_procesando" @onclick="AbrirDescartar"><Icon Name="flag" Size="13" /> Descartar</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <Modal Open="_modalDescartar" Tone="red" Icon="flag"
                   Title="Descartar prospeccion"
                   Desc="@($"Registra por que no continuara la prospeccion de {_p.PropietarioNombre}.")"
                   OnClose="@(() => _modalDescartar = false)">
                <ChildContent>
                    <Field Label="Motivo" Required="true">
                        <textarea rows="3" placeholder="Motivo comercial, objecion o decision del propietario..." @bind="_motivo"></textarea>
                    </Field>
                    @if (_modalError is not null)
                    {
                        <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_modalError</span></div>
                    }
                </ChildContent>
                <Footer>
                    <button class="cl-btn ghost" disabled="@_procesando" @onclick="@(() => _modalDescartar = false)">Volver</button>
                    <button class="cl-btn primary" disabled="@_procesando" @onclick="ConfirmarDescartar">
                        @(_procesando ? "Guardando..." : "Registrar descarte")
                    </button>
                </Footer>
            </Modal>

            @* Registro rápido de interacción sin salir del expediente: reutiliza el cuerpo del formulario. *@
            <Modal Open="_modalInteraccion" Tone="blue" Icon="activity"
                   Title="Registrar interacción con el propietario"
                   Desc="@($"Contacto con {_p.PropietarioNombre} sobre {_p.Direccion}")"
                   OnClose="CerrarInteraccion">
                <ChildContent>
                    @if (_modalError is not null)
                    {
                        <div class="cl-alert red" style="margin-bottom:14px;">
                            <Icon Name="alert" Size="15" />
                            <span>@_modalError</span>
                        </div>
                    }
                    <InteraccionEditor @key="_interaccionEditorKey" @ref="_interaccionEditor" Contexto="PROSPECCION" EntidadId="_p.Id"
                                       Compacto="true" NumContacto="1" NumDetalle="2" OnCambio="StateHasChanged" />
                </ChildContent>
                <Footer>
                    <button class="cl-btn ghost" disabled="@_guardandoInteraccion" @onclick="CerrarInteraccion">Cancelar</button>
                    <button class="cl-btn primary" disabled="@_guardandoInteraccion" @onclick="GuardarInteraccion">
                        @(_guardandoInteraccion ? "Registrando..." : "Registrar interacción")
                    </button>
                </Footer>
            </Modal>

            <Toast Show="_toast">@_toastMsg</Toast>
        </ChildContent>
    </AppShell>
}

@code {
    [Parameter] public long IdParam { get; set; }

    private const int DiasRecontacto = 7;
    private readonly string[] _stages = ["Prospecto", "Contactado", "Reunion", "Propuesta", "Seguimiento", "Captado"];

    private ProspeccionDto? _p;
    private LocalComercialDto? _local;
    private List<InteraccionComercialDto> _interacciones = [];
    private CoincidenciasDto? _coincidencias;
    private bool _cargandoCoin;
    private string? _errCoin;
    private bool _coincidenciasOpen;
    private int _coinPage = 1;
    private readonly int _coinPageSize = 6;
    private bool _cargando = true;
    private bool _procesando;
    private bool _modalDescartar;
    private bool _modalInteraccion;
    private int _interaccionEditorKey;
    private InteraccionEditor? _interaccionEditor;
    private bool _guardandoInteraccion;
    private bool _recargandoInteracciones;
    private string? _errorInteracciones;
    private bool _toast;
    private string _motivo = "";
    private string _toastMsg = "";
    private string? _error;
    private string? _modalError;

    private bool _readOnly => App.Role == Roles.Broker || App.Role == Roles.Admin;
    private bool EsCaptada => _p?.Estado == "T";
    private bool EsDescartada => _p?.Estado == "D";
    private bool RecontactoVencido => _p?.FechaRecontacto is { } fecha
        && _p.Estado is "C" or "R" or "E" or "S"
        && fecha <= DateOnly.FromDateTime(DateTime.Today).AddDays(-DiasRecontacto);

    private int _currentStage => _p?.Estado switch
    {
        "P" => 0,
        "C" => 1,
        "R" => 2,
        "E" => 3,
        "S" => 4,
        "T" => 5,
        _ => 0,
    };

    private string[] _crumbs => App.Role switch
    {
        Roles.Admin => ["ControlLocal", "Operaciones globales", _p?.CodigoProspeccion ?? ""],
        Roles.Broker => ["ControlLocal", "Operaciones del equipo", _p?.CodigoProspeccion ?? ""],
        _ => ["ControlLocal", "Prospecciones", _p?.CodigoProspeccion ?? ""],
    };

    private List<DetailHero.Stat> _heroStats => new()
    {
        new("Propietario", Txt(_p?.PropietarioNombre)),
        new("Agente", Txt(_p?.NombreAgente)),
        new("Interacciones", _interacciones.Count.ToString()),
        new("Recontacto", EstadoRecontactoTexto),
    };

    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        _error = null;
        _errorInteracciones = null;
        // Reset duro: si la nueva carga falla con 403/500, no podemos dejar
        // visible la prospeccion previa (era la fuente del banner rojo con datos
        // antiguos que confundian al usuario).
        _p = null;
        _local = null;
        _interacciones = new List<InteraccionComercialDto>();
        try
        {
            _p = await ProspeccionSvc.ObtenerAsync(IdParam, DisposedToken);
            if (_p is not null)
            {
                _local = _p.LocalId > 0 ? await LocalSvc.ByIdAsync(_p.LocalId, DisposedToken) : null;
                // El listado de interacciones tiene su propio manejo de errores: aunque
                // el backend tarde o falle, la prospeccion y el local ya se renderizan.
                await CargarInteraccionesAsync(silencioso: true);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }

        _coincidenciasOpen = false;
        _coincidencias = null;
        _coinPage = 1;
    }

    private async Task CargarInteraccionesAsync(bool silencioso)
    {
        if (_p is null) return;
        _errorInteracciones = null;
        try
        {
            _interacciones = (await InteraccionSvc.ListarPorProspeccionAsync(_p.Id, DisposedToken)).ToList();
        }
        catch (OperationCanceledException) when (DisposedToken.IsCancellationRequested)
        {
            // Cancelacion real (navego a otra pagina). No es un error visible.
        }
        catch (TaskCanceledException)
        {
            _errorInteracciones = "El servidor tardo en responder. Pulsa Reintentar para volver a cargar las interacciones.";
        }
        catch (Exception ex) when (silencioso)
        {
            _errorInteracciones = $"No se pudieron cargar las interacciones: {ex.Message}";
        }
    }

    private async Task RefrescarInteracciones()
    {
        if (_p is null || _recargandoInteracciones) return;
        _recargandoInteracciones = true;
        try
        {
            await CargarInteraccionesAsync(silencioso: false);
        }
        finally
        {
            _recargandoInteracciones = false;
            await RenderIfAliveAsync();
        }
    }

    private async Task AbrirCoincidencias()
    {
        _coincidenciasOpen = true;
        await CargarCoincidencias(1);
    }

    private void CerrarCoincidencias() => _coincidenciasOpen = false;

    private Task CambiarPaginaCoincidencias(int page) => CargarCoincidencias(page);

    private async Task CargarCoincidencias(int page)
    {
        if (_p is null || EsDescartada)
        {
            _coincidencias = null;
            return;
        }
        _coinPage = Math.Max(1, page);
        _cargandoCoin = true;
        _errCoin = null;
        try
        {
            _coincidencias = await CoincidenciaSvc.ClientesParaProspeccionAsync(_p.Id, _coinPage, _coinPageSize, DisposedToken);
            _coinPage = _coincidencias.Page;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errCoin = ex.Message;
        }
        finally
        {
            _cargandoCoin = false;
        }
    }

    private string EstadoTexto => EnumCatalog.LabelFor(EnumCatalog.EstadosProspeccion, _p?.Estado);

    private string EstadoPropuestaTexto => _p?.ResultadoPropuesta is { Length: > 0 } resultado
        ? EnumCatalog.LabelFor(EnumCatalog.ResultadosPropuesta, resultado)
        : string.IsNullOrWhiteSpace(_p?.FechaPropuestaTexto) ? "Pendiente" : "Propuesta pendiente de respuesta";

    private string EstadoRecontactoTexto
    {
        get
        {
            if (_p is null)
                return "-";
            if (EsCaptada)
                return "Captada";
            if (EsDescartada)
                return "Cerrada";
            if (_p.FechaRecontacto is null)
                return "Sin seguimiento";
            return RecontactoVencido ? "Recontacto pendiente" : "Seguimiento vigente";
        }
    }

    private string DiasSinAccionTexto
    {
        get
        {
            if (_p?.FechaRecontacto is not { } fecha)
                return "-";
            var dias = Math.Max(0, DateOnly.FromDateTime(DateTime.Today).DayNumber - fecha.DayNumber);
            return $"{dias}d";
        }
    }

    private string UltimaAccionTexto => _interacciones.FirstOrDefault()?.FechaHoraTexto switch
    {
        { Length: > 0 } fecha => fecha,
        _ => _p switch
        {
            null => "-",
            { Estado: "T" } => "Captacion lograda",
            { Estado: "D" } => "Descartada",
            { FechaRecontactoTexto: { Length: > 0 } fecha } => fecha,
            { FechaPropuestaTexto: { Length: > 0 } fecha } => fecha,
            { FechaReunionTexto: { Length: > 0 } fecha } => fecha,
            { FechaContactoTexto: { Length: > 0 } fecha } => fecha,
            _ => "Sin contacto",
        },
    };

    private string PanelIcon => RecontactoVencido ? "clock" : EsCaptada ? "checkCircle" : "target";

    private string PanelTitulo => _p?.Estado switch
    {
        "P" => "Primer contacto pendiente",
        "C" => "Convertir contacto en reunion",
        "R" => "Formalizar propuesta",
        "E" => RecontactoVencido ? "Recontactar al propietario" : "Esperando decision",
        "S" => RecontactoVencido ? "Seguimiento vencido" : "Seguimiento activo",
        "T" => "Captacion validable",
        "D" => "Motivo de descarte",
        _ => "Seguimiento comercial",
    };

    private string PanelDetalle => _p?.Estado switch
    {
        "P" => "Registra una llamada o contacto inicial para empezar a medir el seguimiento.",
        "C" => "Ya existe contacto inicial; el siguiente hito saludable es una reunion o una nueva interaccion documentada.",
        "R" => "La reunion permite cerrar condiciones y entregar una propuesta clara al propietario.",
        "E" => RecontactoVencido ? "La propuesta necesita una nueva accion para no enfriar la captacion." : "La propuesta esta vigente; conviene mantener trazabilidad de cada respuesta.",
        "S" => RecontactoVencido ? "El reloj de siete dias vencio; toca recontactar, captar o descartar con motivo." : "El seguimiento sigue vivo y con reloj operativo.",
        "T" => "El broker puede revisar como se obtuvo la propiedad y abrir la captacion vinculada.",
        "D" => Txt(_p.Observaciones),
        _ => "La vista resume como se trabajo la propiedad con su propietario.",
    };

    private async Task Avanzar(Func<long, CancellationToken, Task<ProspeccionDto>> accion, string mensaje)
    {
        if (_p is null || _procesando)
            return;
        try
        {
            _procesando = true;
            _error = null;
            await RenderIfAliveAsync();
            _p = await accion(_p.Id, DisposedToken);
            if (_p.LocalId > 0)
                _local = await LocalSvc.ByIdAsync(_p.LocalId, DisposedToken);
            _interacciones = (await InteraccionSvc.ListarPorProspeccionAsync(_p.Id, DisposedToken)).ToList();
            Notificar(mensaje);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }

    private void AbrirInteraccion()
    {
        _modalError = null;
        _interaccionEditorKey++;
        _modalInteraccion = true;
    }

    private void CerrarInteraccion()
    {
        if (_guardandoInteraccion)
            return;

        _modalError = null;
        _interaccionEditor?.Reiniciar();
        _modalInteraccion = false;
    }

    private async Task GuardarInteraccion()
    {
        if (_p is null || _interaccionEditor is null || _guardandoInteraccion)
            return;

        // Conteo previo: si el backend timeoutea pero la interaccion SI quedo registrada,
        // verificamos contra el conteo despues de refrescar y damos la operacion por exitosa.
        var conteoPrevio = _interacciones.Count;
        var estadoPrevio = _p.Estado;
        try
        {
            _guardandoInteraccion = true;
            _modalError = null;
            await RenderIfAliveAsync();
            var ok = await _interaccionEditor.GuardarAsync(DisposedToken);

            // Refresco siempre: el conteo/estado nos dice si quedo guardado aunque el POST haya timeouteado.
            try
            {
                _p = await ProspeccionSvc.ObtenerAsync(_p.Id, DisposedToken) ?? _p;
                _interacciones = (await InteraccionSvc.ListarPorProspeccionAsync(_p.Id, DisposedToken)).ToList();
            }
            catch (OperationCanceledException) { }
            catch { /* si el refresh tambien timeoutea, seguimos con lo que tenemos en memoria */ }

            var quedoGuardada = _interacciones.Count > conteoPrevio || (_p?.Estado != estadoPrevio);

            if (ok || quedoGuardada)
            {
                _modalInteraccion = false;
                _interaccionEditor?.Reiniciar();
                Notificar("Interacción registrada.");
            }
            else
            {
                // El editor ya muestra su propio mensaje de error. Si fue por timeout,
                // lo convertimos a un texto mas claro para el usuario.
                _interaccionEditor?.DescribirTimeoutFriendly();
                _modalError = _interaccionEditor?.Error ?? "No se pudo registrar la interaccion. Revisa los datos.";
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _guardandoInteraccion = false;
            await RenderIfAliveAsync();
        }
    }

    private void AbrirDescartar()
    {
        _motivo = "";
        _modalError = null;
        _modalDescartar = true;
    }

    private async Task ConfirmarDescartar()
    {
        if (_p is null || _procesando)
            return;
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _modalError = "Registra el motivo del descarte.";
            return;
        }
        try
        {
            _procesando = true;
            _modalError = null;
            await RenderIfAliveAsync();
            _p = _p.Estado is "E" or "S"
                ? await ProspeccionSvc.RechazarAsync(_p.Id, _motivo.Trim(), DisposedToken)
                : await ProspeccionSvc.DescartarAsync(_p.Id, _motivo.Trim(), DisposedToken);
            _modalDescartar = false;
            Notificar("Prospeccion descartada.");
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }

    private void Notificar(string mensaje)
    {
        _toastMsg = mensaje;
        _toast = true;
        _ = DelayThenRenderAsync(2600, () => _toast = false);
    }

    private static string Txt(string? valor) => string.IsNullOrWhiteSpace(valor) ? "-" : valor;
}
