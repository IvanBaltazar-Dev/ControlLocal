@page "/prospecciones"
@inherits SafeComponentBase
@inject AppState App
@inject IProspeccionService ProspeccionSvc
@inject IBrokerService BrokerSvc

<PageTitle>Prospecciones - ControlLocal</PageTitle>

<AppShell Active="Prospecciones" Crumbs="@(new[] { "ControlLocal", "Operacion", "Prospecciones" })"
          Title="Prospecciones"
          Subtitle="Seguimiento previo a captación: propietario, propiedad, interacciones y decisión">
    <Actions>
        @if (App.Role == Roles.Agente)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("local-form"))"><Icon Name="plus" Size="13" /> Nueva prospección</button>
        }
        else
        {
            <span class="cl-badge info plain"><Icon Name="lock" Size="12" /> Solo lectura</span>
        }
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="activity" Label="Activas" Value="@_totalGestion.ToString()" Tone="blue" Footer="@GestionFooter"
                        Active="@(_filtroEstado == "GESTION")" OnClick="@(() => CambiarEstadoAsync(_filtroEstado == "GESTION" ? "" : "GESTION"))" />
            <MetricCard Icon="clock" Label="Recontacto pendiente" Value="@_totalRecontactar.ToString()" Tone="red" Footer="Alerta desde dia 8"
                        Active="@(_filtroEspecial == "RECONTACTAR")" OnClick="@ToggleRecontactarAsync" />
            <MetricCard Icon="pin" Label="Captadas" Value="@_totalCaptadas.ToString()" Tone="green"
                        Active="@(_filtroEstado == "T")" OnClick="@(() => CambiarEstadoAsync(_filtroEstado == "T" ? "" : "T"))" />
            <MetricCard Icon="x" Label="Inactivas" Value="@_totalDescartadas.ToString()" Tone="gray"
                        Active="@(_filtroEstado == "D")" OnClick="@(() => CambiarEstadoAsync(_filtroEstado == "D" ? "" : "D"))" />
        </div>

        @if (_totalRecontactar > 0)
        {
            <div class="cl-alert red" style="margin-bottom:16px;">
                <Icon Name="clock" Size="15" />
                <span>Hay <b>@_totalRecontactar</b> prospeccion(es) con recontacto pendiente. Registra una interacción, crea captación o descarta con motivo.</span>
            </div>
        }

        <FilterBar Search="Buscar por dirección, código, propietario..."
                   Value="@_query" ValueChanged="CambiarBusquedaAsync" DebounceMs="300" ResultCount="@((int)_total)"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltrosAsync">
            <select class="cl-select" value="@_filtroEstado" @onchange="CambiarEstadoSelectAsync">
                <option value="">Todos los estados</option>
                <option value="GESTION">Activas</option>
                <option value="T">Captadas</option>
                <option value="D">Inactivas</option>
            </select>
            <select class="cl-select" value="@_etapa" @onchange="CambiarEtapaAsync">
                <option value="">Todas las etapas</option>
                @foreach (var etapa in EtapasPipeline)
                {
                    <option value="@etapa.Code">@etapa.Label</option>
                }
            </select>
            <FilterSelect Placeholder="Distrito visible" Options="_distritos" Value="@_distrito" ValueChanged="CambiarDistritoAsync" />
            @if (App.Role == Roles.Admin)
            {
                <select class="cl-select" value="@_idBroker" @onchange="CambiarBrokerAsync">
                    <option value="0">Todos los brokers</option>
                    @foreach (var broker in _brokers)
                    {
                        <option value="@broker.Id">@broker.Nombre</option>
                    }
                </select>
            }
            @if (App.Role is Roles.Broker or Roles.Admin)
            {
                <select class="cl-select" value="@_idAgente" @onchange="CambiarAgenteAsync">
                    <option value="0">Todos los agentes</option>
                    @foreach (var agente in _agentes)
                    {
                        <option value="@agente.Id">@agente.Nombre</option>
                    }
                </select>
            }
            <select class="cl-select" value="@_orden" @onchange="CambiarOrdenAsync" title="Cambia el orden de la lista (no filtra)">
                <option value="">Ordenar: más recientes primero</option>
                <option value="ultimo_contacto">Ordenar: último contacto primero</option>
            </select>
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                @if (_cargando)
                {
                    <LoadingBlock Framed="false" Title="Actualizando prospecciones..." />
                }
                else if (_loadError is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_loadError</span></div>
                }
                else if (_prospecciones.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="store" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin prospecciones en este filtro</div>
                        <div style="font-size:12px;">Ajusta la busqueda o registra un local para iniciar una prospección.</div>
                    </div>
                }
                else
                {
                    <table class="cl-table">
                        <thead>
                            <tr>
                                <th>Prospeccion</th>
                                <th>Propiedad</th>
                                <th>Propietario</th>
                                <th>Etapa</th>
                                <th>Ultimo Contacto</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _prospecciones)
                            {
                                var vencido = EsVencido(p);
                                <tr>
                                    <td><span class="mono">@p.CodigoProspeccion</span></td>
                                    <td>
                                        <div style="font-weight:600;">@p.Direccion</div>
                                        <div class="cl-muted" style="font-size:12px;">@p.Distrito - @p.LocalCodigo</div>
                                    </td>
                                    <td>@p.PropietarioNombre</td>
                                    <td><StatusBadge Label="@EnumCatalog.LabelFor(EnumCatalog.EstadosProspeccion, p.Estado)" /></td>
                                    <td>
                                        @if (p.Estado is "C" or "R" or "E" or "S")
                                        {
                                            <span class="cl-badge @(vencido ? "red" : "blue")">@UltimoContactoTexto(p)</span>
                                        }
                                        else
                                        {
                                            <span class="cl-muted" style="font-size:12px;">@UltimoContactoTexto(p)</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="cl-flex" style="gap:6px;justify-content:flex-end;flex-wrap:wrap;">
                                            <button class="cl-btn sm primary" @onclick="@(() => App.Navigate($"prospeccion-detail/{p.Id}"))"><Icon Name="activity" Size="12" /> Seguimiento</button>
                                            @if (App.Role == Roles.Agente && p.Estado != "D" && p.Estado != "T")
                                            {
                                                <button class="cl-btn sm" @onclick="@(() => App.Navigate($"interaccion-form/prospeccion/{p.Id}"))"><Icon Name="plus" Size="12" /> Interaccion</button>
                                            }
                                            @if (p.Estado == "T" && !string.IsNullOrWhiteSpace(p.CaptacionCodigo))
                                            {
                                                <button class="cl-btn sm success" @onclick="@(() => App.Navigate($"captacion-detail/{p.CaptacionCodigo}"))"><Icon Name="pin" Size="12" /> Captación</button>
                                            }
                                            @if (App.Role == Roles.Agente && (p.Estado is "E" or "S"))
                                            {
                                                <button class="cl-btn sm success" @onclick="@(() => App.Navigate($"captacion-form/captar/{p.Id}"))"><Icon Name="pin" Size="12" /> Crear captación</button>
                                            }
                                            <button class="cl-btn sm ghost" @onclick="@(() => App.Navigate($"local-detail/{p.LocalId}"))"><Icon Name="eye" Size="12" /> Local</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        @if (!_cargando)
        {
            <Pagination Total="@((int)_total)" PageSize="@PageSize" Page="@_pagina" PageChanged="CambiarPaginaAsync" />
        }
    </ChildContent>
</AppShell>

@code {
    private const int DiasRecontacto = 7;
    private const int PageSize = 8;
    private string _filtroEstado = "";
    private string _etapa = "";
    private string _filtroEspecial = "";
    private string _query = "";
    private string _distrito = "";
    // Orden de la lista: "" = más recientes creadas primero (por defecto); "ultimo_contacto" = por fecha de contacto.
    private string _orden = "";
    private long _idAgente;
    private long _idBroker;
    private IReadOnlyList<(long Id, string Nombre)> _agentes = [];
    private IReadOnlyList<BrokerDto> _brokers = [];
    private IReadOnlyList<ProspeccionDto> _prospecciones = [];
    private long _total;
    private long _totalGestion;
    private long _totalRecontactar;
    private long _totalCaptadas;
    private long _totalDescartadas;
    private int _pagina = 1;
    private bool _cargando = true;
    private string? _loadError;

    private IReadOnlyList<string> _distritos => _prospecciones.Select(p => p.Distrito)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();
    private bool HayFiltros => !string.IsNullOrEmpty(_filtroEstado) || !string.IsNullOrEmpty(_etapa)
        || !string.IsNullOrEmpty(_filtroEspecial) || !string.IsNullOrEmpty(_query)
        || !string.IsNullOrEmpty(_distrito) || _idAgente > 0 || _idBroker > 0;
    private static DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);

    // Etapa = paso del pipeline (sin Captado/Descartado, que son estados de cierre, no etapas vivas).
    private static IEnumerable<EnumOption> EtapasPipeline =>
        EnumCatalog.EstadosProspeccion.Where(e => e.Code is not ("T" or "D"));

    // El backend recibe un unico parametro "estado": la etapa especifica manda; si no, el bucket de estado.
    private string EstadoParam()
    {
        if (_filtroEstado is "T" or "D") return _filtroEstado;
        if (!string.IsNullOrEmpty(_etapa)) return _etapa;
        return _filtroEstado;
    }
    // Las tarjetas usan titulos uniformes por rol (Activas / Recontacto pendiente / Captadas / Inactivas);
    // el footer de "Activas" si conserva el matiz por rol como contexto secundario.
    private string GestionFooter => App.Role switch
    {
        Roles.Admin => "Todas las propiedades activas",
        Roles.Broker => "Propiedades del equipo",
        _ => "Propietarios por convertir",
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricasAsync();
        await CargarAsync();
        // Opciones de los selectores de rol: en segundo plano, no bloquean la tabla.
        if (App.Role is Roles.Broker or Roles.Admin)
            _ = CargarOpcionesFiltroAsync();
    }

    // Agentes (broker/admin) derivados del set ya acotado por rol; brokers (admin) desde el catalogo.
    private async Task CargarOpcionesFiltroAsync()
    {
        try
        {
            var todas = await ProspeccionSvc.RefrescarAsync(DisposedToken);
            _agentes = todas
                .Where(p => p.AgenteId > 0 && !string.IsNullOrWhiteSpace(p.NombreAgente))
                .Select(p => (Id: p.AgenteId, Nombre: p.NombreAgente))
                .DistinctBy(x => x.Id)
                .OrderBy(x => x.Nombre)
                .ToList();
            if (App.Role == Roles.Admin)
                _brokers = (await BrokerSvc.AllAsync(DisposedToken)).OrderBy(b => b.Nombre).ToList();
        }
        catch (OperationCanceledException) { }
        catch { /* opciones de filtro best-effort */ }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CambiarPaginaAsync(int pagina)
    {
        _pagina = pagina;
        await CargarAsync();
    }

    private async Task CambiarBusquedaAsync(string valor)
    {
        _query = valor;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarEstadoSelectAsync(ChangeEventArgs e) =>
        await CambiarEstadoAsync(e.Value?.ToString() ?? "");

    private async Task CambiarEstadoAsync(string estado)
    {
        _filtroEstado = estado;
        // Captada/Inactiva no son etapas vivas: la etapa deja de aplicar.
        if (estado is "T" or "D") _etapa = "";
        _filtroEspecial = "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarEtapaAsync(ChangeEventArgs e)
    {
        _etapa = e.Value?.ToString() ?? "";
        // Una etapa concreta solo tiene sentido sobre prospecciones activas.
        if (!string.IsNullOrEmpty(_etapa) && _filtroEstado is "T" or "D") _filtroEstado = "";
        _filtroEspecial = "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarAgenteAsync(ChangeEventArgs e)
    {
        _idAgente = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarBrokerAsync(ChangeEventArgs e)
    {
        _idBroker = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task ToggleRecontactarAsync()
    {
        _filtroEspecial = _filtroEspecial == "RECONTACTAR" ? "" : "RECONTACTAR";
        if (!string.IsNullOrEmpty(_filtroEspecial))
            _filtroEstado = "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarDistritoAsync(string distrito)
    {
        _distrito = distrito;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarOrdenAsync(ChangeEventArgs e)
    {
        _orden = e.Value?.ToString() ?? "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        _filtroEstado = "";
        _etapa = "";
        _filtroEspecial = "";
        _query = "";
        _distrito = "";
        _idAgente = 0;
        _idBroker = 0;
        _orden = "";
        _pagina = 1;
        await CargarAsync();
    }

    private static bool EsVencido(ProspeccionDto p) =>
        p.Estado is "C" or "R" or "E" or "S"
        && p.FechaRecontacto is { } fecha
        && fecha <= Hoy.AddDays(-DiasRecontacto);

    private async Task CargarAsync()
    {
        try
        {
            _cargando = true;
            _loadError = null;
            var pagina = _filtroEspecial == "RECONTACTAR"
                ? await ProspeccionSvc.ListarRecontactarPaginaAsync(_pagina, PageSize, DiasRecontacto, DisposedToken)
                : await ProspeccionSvc.ListarPaginaAsync(_pagina, PageSize, EstadoParam(), _distrito, _query, DisposedToken,
                    idAgente: _idAgente > 0 ? _idAgente : null,
                    idBrokerSupervisor: _idBroker > 0 ? _idBroker : null,
                    orden: string.IsNullOrEmpty(_orden) ? null : _orden);
            _prospecciones = pagina.Items;
            _total = pagina.TotalRecords;
            _pagina = pagina.Page;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarMetricasAsync()
    {
        try
        {
            var estadosGestion = new[] { "P", "C", "R", "E", "S" };
            var conteosGestion = estadosGestion.Select(e => ProspeccionSvc.ContarAsync(e, ct: DisposedToken)).ToArray();
            await Task.WhenAll(conteosGestion);
            _totalGestion = conteosGestion.Sum(t => t.Result);
            _totalRecontactar = await ProspeccionSvc.ContarRecontactarAsync(DiasRecontacto, DisposedToken);
            _totalCaptadas = await ProspeccionSvc.ContarAsync("T", ct: DisposedToken);
            _totalDescartadas = await ProspeccionSvc.ContarAsync("D", ct: DisposedToken);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            _totalGestion = _totalRecontactar = _totalCaptadas = _totalDescartadas = 0;
        }
    }

    private static string UltimoContactoTexto(ProspeccionDto p) => p.Estado switch
    {
        "P" => "Sin contacto",
        "C" => $"Contacto {FechaCorta(p.FechaContactoTexto)}",
        "R" => $"Reunion {FechaCorta(p.FechaReunionTexto)}",
        "E" => $"Propuesta {FechaCorta(p.FechaPropuestaTexto)}",
        "S" => $"Seguim. {FechaCorta(p.FechaRecontactoTexto)}",
        "T" => "En captación",
        "D" => "Descartada",
        _ => "-",
    };

    private static string FechaCorta(string? fecha) =>
        string.IsNullOrWhiteSpace(fecha) ? "-" : fecha;
}
