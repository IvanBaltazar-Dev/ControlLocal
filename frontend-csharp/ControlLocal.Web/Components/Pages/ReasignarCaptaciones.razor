@page "/reasignar-captaciones"
@inherits SafeComponentBase
@inject AppState App
@inject ICaptacionService Captaciones
@inject IAgenteService Agentes

<PageTitle>Reasignar captaciones - ControlLocal</PageTitle>

<AppShell Active="Reasignar captaciones" Crumbs="@(new[] { "ControlLocal", "Mi equipo", "Reasignar captaciones" })"
          Title="Reasignar captacion a otro agente"
          Subtitle="Selecciona una captacion de tu equipo y reasignala a un agente disponible bajo tu supervision.">
    <Actions>
        <button class="cl-btn" @onclick="@(() => App.Navigate("historial-reasignaciones-captaciones"))"><Icon Name="history" Size="13" /> Ver historial completo</button>
    </Actions>
    <ChildContent>
        @if (_cargando)
        {
            <div class="cl-card"><div class="cl-card-body">Cargando datos del equipo...</div></div>
        }
        else
        {
            <div class="cl-alert blue" style="margin-bottom:14px;">
                <Icon Name="info" Size="15" />
                <span>Como <b>broker responsable</b> reasignas una captacion a otro agente de tu equipo. Solo se permiten agentes <b>activos y disponibles</b>; el cambio queda registrado en la trazabilidad.</span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">1 - Captacion a reasignar</div></div>
                    <div class="cl-card-body" style="display:flex;flex-direction:column;gap:8px;">
                        <input class="cl-input search" type="search" placeholder="Buscar por código, dirección, distrito o agente…"
                               value="@_buscarCaptacion" @oninput="OnBuscarCaptacion" />
                        <div style="display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto;">
                            @foreach (var c in ReasignablesFiltradas)
                            {
                                var sel = _captacion == c.Id;
                                var border = sel ? "#005BFF" : "var(--c-border)";
                                var bg = sel ? "#EAF1FF" : "#fff";
                                var style = $"display:flex;gap:11px;align-items:center;padding:11px 12px;border:1.5px solid {border};border-radius:11px;background:{bg};cursor:pointer;";
                                <label style="@style">
                                    <input type="radio" name="reasignar-captacion" checked="@sel"
                                           @onchange="@(() => { _captacion = c.Id; _agente = 0; _err = null; })" />
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;">@c.CodigoCaptacion - @c.DireccionLocal</div>
                                        <div class="cl-muted" style="font-size:11px;">@c.DistritoLocal - Agente actual: @c.NombreAgenteResponsable</div>
                                    </div>
                                    <StatusBadge Label="@c.Estado" />
                                </label>
                            }
                            @if (!Reasignables.Any() && string.IsNullOrWhiteSpace(_buscarCaptacion))
                            {
                                <div class="cl-help">No hay captaciones disponibles para reasignar.</div>
                            }
                            else if (!Reasignables.Any())
                            {
                                <div class="cl-help">Ninguna captación coincide con la búsqueda.</div>
                            }
                            else
                            {
                                <div class="cl-help">
                                    Solo se muestran captaciones activas. Las pendientes de revisión, observadas, rechazadas, cerradas o vencidas no deben reasignarse desde este flujo.
                                </div>
                            }
                        </div>
                        <Pagination Total="_totalCaptaciones" PageSize="TamanoCaptaciones" Page="_paginaCaptaciones" PageChanged="CambiarPaginaCaptaciones" />
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">2 - Nuevo agente responsable</div></div>
                    <div class="cl-card-body" style="display:flex;flex-direction:column;gap:8px;">
                        <input class="cl-input search" type="search" placeholder="Buscar agente por nombre, DNI o zona…"
                               value="@_buscarAgente" @oninput="@(e => _buscarAgente = e.Value?.ToString() ?? "")" />
                        <div style="display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto;">
                            @foreach (var a in AgentesFiltrados)
                            {
                                var esActual = C is not null && a.Id == C.AgenteResponsableId;
                                var disponible = a.EstadoAdministrativo == "Activo" && a.EstadoOperativo == "Disponible";
                                var selectable = disponible && !esActual;
                                var sel = _agente == a.Id;
                                var border = sel && selectable ? "#005BFF" : "var(--c-border)";
                                var bg = !selectable ? "var(--c-bg-2)" : sel ? "#EAF1FF" : "#fff";
                                var cursor = selectable ? "pointer" : "not-allowed";
                                var opacity = selectable ? "1" : "0.72";
                                var style = $"display:flex;gap:11px;align-items:center;padding:11px 12px;border:1.5px solid {border};border-radius:11px;background:{bg};cursor:{cursor};opacity:{opacity};";
                                var motivo = esActual ? "La captacion ya esta asignada a este agente" : !disponible ? "Agente no disponible para asignacion" : "";
                                <label title="@motivo" style="@style">
                                    <input type="radio" name="reasignar-agente" disabled="@(!selectable)" checked="@sel"
                                           @onchange="@(() => { _agente = a.Id; _err = null; })" />
                                    <span class="cl-avatar" style="width:30px;height:30px;font-size:11px;flex:0 0 30px;background:@a.Color;">@a.Iniciales</span>
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;">@a.Nombre</div>
                                        <div class="cl-muted" style="font-size:11px;">DNI: @a.NumeroDocumento<br />@a.Zona</div>
                                    </div>
                                    <div style="display:flex;flex-direction:column;gap:4px;align-items:flex-end;">
                                        <StatusBadge Label="@a.EstadoAdministrativo" />
                                        <StatusBadge Label="@a.EstadoOperativo" />
                                    </div>
                                </label>
                            }
                            @if (!_agentes.Any())
                            {
                                <div class="cl-help">No se encontraron agentes del equipo para reasignar.</div>
                            }
                            else if (!AgentesFiltrados.Any())
                            {
                                <div class="cl-help">Ningún agente coincide con la búsqueda.</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 360px;gap:14px;margin-top:14px;">
                <FormSection Num="3" Title="Motivo de la reasignacion" Sub="Obligatorio - queda registrado junto a la operacion">
                    <Field Label="Motivo" Required="true">
                        <textarea rows="3" value="@_motivo" @oninput="@(e => { _motivo = e.Value?.ToString() ?? ""; _err = null; })"
                                  placeholder="Ej. Balance de carga del equipo tras nuevas captaciones"></textarea>
                    </Field>
                    @if (_err is not null)
                    {
                        <div class="cl-alert red" style="margin-top:12px;">
                            <Icon Name="alert" Size="15" /><span>@_err</span>
                        </div>
                    }
                </FormSection>

                <div class="cl-card" style="align-self:start;">
                    <div class="cl-card-head"><div class="cl-card-title">Comparacion</div></div>
                    <div class="cl-card-body">
                        <div style="display:flex;align-items:center;gap:10px;justify-content:space-between;">
                            <div style="flex:1;">
                                <div class="cl-def-k">Agente actual</div>
                                <div style="font-size:13px;font-weight:600;margin-top:4px;">@(C?.NombreAgenteResponsable ?? "-")</div>
                            </div>
                            <Icon Name="arrowRight" Size="18" Color="#005BFF" />
                            <div style="flex:1;text-align:right;">
                                <div class="cl-def-k">Agente nuevo</div>
                                <div style="font-size:13px;font-weight:600;margin-top:4px;color:#005BFF;">@(A?.Nombre ?? "-")</div>
                            </div>
                        </div>
                        <div class="cl-divider"></div>
                        <dl class="cl-kv" style="grid-template-columns:1fr auto;">
                            <dt>Captacion</dt><dd>@(C?.CodigoCaptacion ?? "-")</dd>
                            <dt>Local</dt><dd>@(C?.DireccionLocal ?? "-")</dd>
                            <dt>Fecha del cambio</dt><dd>@DateTime.Today.ToString("dd/MM/yyyy")</dd>
                            <dt>Responsable</dt><dd>@(App.CurrentUser?.Nombre ?? "Broker en sesion")</dd>
                        </dl>
                        <button class="cl-btn primary" disabled="@_procesando" style="width:100%;margin-top:14px;justify-content:center;" @onclick="TryConfirm">
                            <Icon Name="swap" Size="14" /> @(_procesando ? "Reasignando..." : "Confirmar reasignacion")
                        </button>
                        <button class="cl-btn ghost" disabled="@_procesando" style="width:100%;margin-top:6px;justify-content:center;color:var(--c-text-2);" @onclick="@(() => App.Navigate("captaciones"))">Cancelar</button>
                    </div>
                </div>
            </div>

            <div class="cl-card" style="margin-top:14px;">
                <div class="cl-card-head"><div class="cl-card-title">Reasignaciones recientes</div></div>
                <div class="cl-card-body" style="padding:0;">
                    <table class="cl-table">
                        <thead><tr><th>Fecha</th><th>Captacion</th><th>Local</th><th>Agente anterior</th><th>Agente nuevo</th><th>Responsable</th><th>Motivo</th></tr></thead>
                        <tbody>
                            @foreach (var h in _historial)
                            {
                                <tr>
                                    <td class="muted">@h.Fecha</td>
                                    <td><span class="mono">@h.CodigoCaptacion</span></td>
                                    <td>@h.Local</td>
                                    <td>@h.AgenteAnterior</td>
                                    <td>@h.AgenteNuevo</td>
                                    <td class="muted">@h.Responsable</td>
                                    <td style="color:var(--c-text-2);">@h.Motivo</td>
                                </tr>
                            }
                            @if (!_historial.Any())
                            {
                                <tr><td colspan="7" class="muted">Aun no hay reasignaciones en esta sesion.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="swap"
                       Title="Confirmar reasignacion de captacion"
                       Desc="@($"Estas por reasignar la captacion {C?.CodigoCaptacion} de {C?.NombreAgenteResponsable} a {A?.Nombre}.")"
                       ConfirmLabel="Confirmar reasignacion" CancelLabel="Cancelar"
                       Busy="@_procesando"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    private long _captacion;
    private long _agente;
    private string _motivo = "";
    private string _buscarCaptacion = "";
    private string _buscarAgente = "";
    private bool _confirm;
    private bool _toast;
    private bool _cargando = true;
    private bool _procesando;
    private string _toastMsg = "";
    private string? _err;
    private IReadOnlyList<CaptacionDto> _captaciones = [];
    private IReadOnlyList<AgenteDto> _agentes = [];
    private readonly List<ReasignacionVista> _historial = [];
    private const int TamanoCaptaciones = 8;
    private int _paginaCaptaciones = 1;
    private int _totalCaptaciones;

    private IEnumerable<CaptacionDto> Reasignables =>
        _captaciones
            .OrderBy(c => c.FechaFinVigencia ?? DateOnly.MaxValue)
            .ThenBy(c => c.CodigoCaptacion);

    private static bool EsCaptacionListaParaReasignar(CaptacionDto captacion)
    {
              var estado = NormalizarEstado(captacion.Estado);
          
              return estado is "ACTIVA" or "APROBADA" or "A";
    }
          
    private static string NormalizarEstado(string? estado)
    {
              return (estado ?? "")
                  .Trim()
                  .ToUpperInvariant()
                  .Replace("Á", "A")
                  .Replace("É", "E")
                  .Replace("Í", "I")
                  .Replace("Ó", "O")
                  .Replace("Ú", "U");
    }

    // La lista se mantiene tal cual; el buscador solo la reduce (mixto: lista + búsqueda).
    private IEnumerable<CaptacionDto> ReasignablesFiltradas =>
        Reasignables;

    private IEnumerable<AgenteDto> AgentesFiltrados =>
        _agentes.Where(a =>
            TextoFiltro.Contiene(a.Nombre, _buscarAgente)
            || TextoFiltro.Contiene(a.NumeroDocumento, _buscarAgente)
            || TextoFiltro.Contiene(a.Zona, _buscarAgente));

    private CaptacionDto? C => Reasignables.FirstOrDefault(x => x.Id == _captacion);
    private AgenteDto? A => _agentes.FirstOrDefault(x => x.Id == _agente);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CargarAsync();
            _captacion = Reasignables.FirstOrDefault()?.Id ?? 0;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _err = ex.Message;
            _captaciones = [];
            _totalCaptaciones = 0;
            _agentes = await Agentes.AllAsync(DisposedToken);
            _captacion = Reasignables.FirstOrDefault()?.Id ?? 0;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task CargarAsync()
    {
        var captacionesTask = CargarCaptacionesAsync();
        var agentesTask = Agentes.RefrescarAsync(DisposedToken);
        await captacionesTask;
        _agentes = await agentesTask;
    }

    private async Task CargarCaptacionesAsync()
    {
        var pagina = await Captaciones.ListarReasignablesAsync(
            _paginaCaptaciones,
            TamanoCaptaciones,
            _buscarCaptacion,
            DisposedToken);

        _captaciones = pagina.Items;
        _totalCaptaciones = (int)pagina.TotalRecords;

        if (_captacion == 0 || !_captaciones.Any(c => c.Id == _captacion))
            _captacion = Reasignables.FirstOrDefault()?.Id ?? 0;
    }

    private async Task OnBuscarCaptacion(ChangeEventArgs e)
    {
        _buscarCaptacion = e.Value?.ToString() ?? "";
        _paginaCaptaciones = 1;
        await CargarCaptacionesAsync();
    }

    private async Task CambiarPaginaCaptaciones(int pagina)
    {
        _paginaCaptaciones = pagina;
        await CargarCaptacionesAsync();
    }

    private void TryConfirm()
    {
              if (C is null)
              {
                  _err = "Selecciona una captacion activa para reasignar.";
                  return;
              }
          
              if (!EsCaptacionListaParaReasignar(C))
              {
                  _err = "Solo puedes reasignar captaciones activas. Primero debe pasar por revision y aprobacion del broker.";
                  return;
              }
          
              if (A is null)
              {
                  _err = "Selecciona el agente que continuara la atencion de la captacion.";
                  return;
              }
          
              if (A.EstadoAdministrativo != "Activo" || A.EstadoOperativo != "Disponible")
              {
                  _err = "El agente seleccionado no esta disponible. Elige un agente activo y disponible.";
                  return;
              }
          
              if (A.Id == C.AgenteResponsableId)
              {
                  _err = "La captacion ya esta asignada a ese agente. Selecciona un agente distinto.";
                  return;
              }
          
              _motivo = _motivo.Trim();
          
              if (string.IsNullOrWhiteSpace(_motivo))
              {
                  _err = "Ingresa el motivo de la reasignacion para mantener trazabilidad.";
                  return;
              }
          
              if (_motivo.Length < 10)
              {
                  _err = "El motivo es muy corto. Indica brevemente por que se mueve esta captacion.";
                  return;
              }
          
              _err = null;
              _confirm = true;
      }

    private async Task OnConfirm()
    {
        if (C is null || A is null || _procesando) return;

        _confirm = false;
        _procesando = true;
        await RenderIfAliveAsync();

          var codigoCaptacion = C.CodigoCaptacion;
          var direccionLocal = C.DireccionLocal;
          var anterior = C.NombreAgenteResponsable;
          var nuevoAgente = A.Nombre;
          var motivo = _motivo.Trim();
          
          try
          {
              await Captaciones.ReasignarBandejaAsync(codigoCaptacion, A.Id, motivo, DisposedToken);
          
              _historial.Insert(0, new ReasignacionVista(
                  $"Hoy - {DateTime.Now:HH:mm}",
                  codigoCaptacion,
                  direccionLocal,
                  anterior,
                  nuevoAgente,
                  App.CurrentUser?.Nombre ?? "Broker en sesion",
                  motivo));
          
              await CargarCaptacionesAsync();
          
              _toastMsg = $"{codigoCaptacion} reasignada a {nuevoAgente}.";
                    
            _agente = 0;
            _motivo = "";
            _toast = true;
            await RenderIfAliveAsync();
            await DelayThenRenderAsync(2400, () => _toast = false);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _procesando = false;
        }
    }

    private sealed record ReasignacionVista(
        string Fecha,
        string CodigoCaptacion,
        string Local,
        string AgenteAnterior,
        string AgenteNuevo,
        string Responsable,
        string Motivo);
}
