@page "/solicitud-detail/{CodigoParam?}"
@inject AppState App
@inject ISolicitudService SolicitudSvc
@inject IOportunidadService OportunidadSvc
@inject ICaptacionService CaptacionSvc

<PageTitle>Solicitud @_s.CodigoSolicitud · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Solicitudes de alquiler", _s.CodigoSolicitud })"
          Title="@($"{_s.CodigoSolicitud} · {_s.ClienteNombre}")"
          Subtitle="@($"Solicitud de alquiler · operación {_s.CodigoOperacion} · {_s.DireccionLocal}, {_s.DistritoLocal}")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("solicitudes"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        <button class="cl-btn" @onclick="@(() => App.Navigate($"documentos/{_s.CodigoSolicitud}"))"><Icon Name="folder" Size="13" /> Gestionar documentos</button>
    </Actions>
    <ChildContent>
        <div class="cl-stage" style="margin-bottom:14px;">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var cls = i < _current ? "done" : (i == _current ? "active" : "");
                <div class="cl-stage-step @cls">
                    <div class="cl-stage-k"><span class="cl-stage-dot"></span> @_stages[i].K</div>
                    <div class="cl-stage-v">@_stages[i].V</div>
                </div>
            }
        </div>

        <div style="display:grid;grid-template-columns:1fr 320px;gap:14px;">
            <div class="cl-stack">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Condiciones solicitadas</div></div>
                        <div class="cl-card-body">
                            <dl class="cl-kv">
                                <dt>Monto mensual</dt><dd>USD @_s.MontoMensualTexto</dd>
                                <dt>Plazo tentativo</dt><dd>@PlazoSolicitud</dd>
                                <dt>Observaciones</dt><dd>@Texto(_s.Observaciones)</dd>
                                <dt>Fecha de registro</dt><dd>@Texto(_s.FechaRegistroTexto)</dd>
                            </dl>
                        </div>
                    </div>
                    <div class="cl-card">
                        <div class="cl-card-head"><div class="cl-card-title">Local y propietario</div></div>
                        <div class="cl-card-body">
                            <dl class="cl-kv">
                                <dt>Local</dt><dd>@_s.DireccionLocal</dd>
                                <dt>Distrito</dt><dd>@Texto(_captacion?.DistritoLocal ?? _s.DistritoLocal)</dd>
                                <dt>Área</dt><dd>@AreaLocal</dd>
                                <dt>Propietario</dt><dd>@Texto(_captacion?.PropietarioNombre)</dd>
                                <dt>Captación</dt><dd>@Texto(_oportunidad?.CaptacionCodigo)</dd>
                                <dt>Comisión</dt><dd>@ComisionCaptacion</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Documentos de la solicitud</div><span class="cl-badge green">@_s.DocumentosTexto completos</span></div>
                    <div class="cl-card-body" style="padding:0;">
                        @for (var i = 0; i < _docs.Length; i++)
                        {
                            var top = i == 0 ? "0" : "1px solid #E2E6EC";
                            var doc = _docs[i];
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-top:@top;">
                                <div class="cl-flex"><Icon Name="fileText" Size="16" /> <span style="font-size:12.5px;">@doc.Name</span></div>
                                <div class="cl-flex" style="gap:10px;">
                                    <StatusBadge Label="@doc.Status" />
                                    <button class="cl-btn sm" @onclick="@(() => _docVer = doc)"><Icon Name="eye" Size="13" /> Ver</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Estado actual</div></div>
                    <div class="cl-card-body">
                        <div style="text-align:center;padding:6px 0;">
                            <StatusBadge Label="@_s.Estado" />
                            <div class="cl-muted" style="font-size:12px;margin-top:8px;">Registrada el @_s.FechaRegistroTexto · operación @_s.CodigoOperacion</div>
                        </div>
                    </div>
                </div>
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Cliente</div></div>
                    <div class="cl-card-body">
                        <div class="cl-flex" style="gap:10px;">
                            <span class="cl-avatar" style="width:34px;height:34px;font-size:12px;background:#2F7D52;">@Initials(_s.ClienteNombre)</span>
                            <div>
                                <div style="font-weight:600;font-size:13px;">@_s.ClienteNombre</div>
                                <div class="cl-muted" style="font-size:11px;">Operación @_s.CodigoOperacion</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>La solicitud conserva únicamente oportunidad, monto propuesto, plazo tentativo, observaciones, documentos, evaluaciones y estado.</span>
                </div>
            </div>
        </div>

        <DocViewerModal Open="@(_docVer is not null)" Nombre="@(_docVer?.Name ?? "")"
                        Estado="@(_docVer?.Status ?? "")" Expediente="@_s.CodigoSolicitud" Actualizado="23 May 2026"
                        OnClose="@(() => _docVer = null)" />
    </ChildContent>
</AppShell>

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private Doc? _docVer;

    private SolicitudAlquilerDto _s = new();
    private OportunidadComercialDto? _oportunidad;
    private CaptacionDto? _captacion;

    protected override void OnParametersSet()
    {
        _s = (string.IsNullOrEmpty(CodigoParam) ? null : SolicitudSvc.ByCodigo(CodigoParam)) ?? SolicitudSvc.All().First();
        _oportunidad = _s.OportunidadId > 0
            ? OportunidadSvc.ById(_s.OportunidadId)
            : OportunidadSvc.All().FirstOrDefault(item => item.CodigoOportunidad == _s.CodigoOperacion);
        _captacion = _oportunidad is null ? null : CaptacionSvc.ByCodigo(_oportunidad.CaptacionCodigo);
    }

    private static string Initials(string name) =>
        string.Concat((name ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => char.ToUpper(w[0])));

    private record Stage(string K, string V);

    private readonly Stage[] _stages =
    {
        new("Etapa 1", "Registrada"),
        new("Etapa 2", "En revision"),
        new("Etapa 3", "Resuelta"),
    };
    private int _current => _s.Estado switch
    {
        "Registrada" => 0,
        "En revision" or "Observada" => 1,
        _ => 2,
    };

    private record Doc(string Name, string Status);

    private readonly Doc[] _docs = new[]
    {
        new Doc("Documento de identidad", "Validado"),
        new Doc("Ficha o constancia RUC", "Validado"),
        new Doc("Vigencia de poder", "Observado"),
        new Doc("Sustento economico", "Validado"),
        new Doc("Documento de garantia", "Registrado"),
        new Doc("Declaracion jurada", "Validado"),
    };

    private string PlazoSolicitud => string.IsNullOrWhiteSpace(_s.PlazoTentativo)
        ? $"{_s.PlazoMeses} meses"
        : _s.PlazoTentativo;
    private string AreaLocal => _captacion is null ? "No registrado" : $"{_captacion.AreaM2} m²";
    private string ComisionCaptacion => string.IsNullOrWhiteSpace(_captacion?.ComisionPactadaTexto)
        ? "No registrada"
        : $"{_captacion.ComisionPactadaTexto}%";
    private static string Texto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "No registrado" : valor;
}
