@page "/solicitud-detail/{CodigoParam?}"
@inherits SafeComponentBase
@inject AppState App
@inject ISolicitudService SolicitudSvc
@inject IDocumentoSolicitudService DocSvc
@inject ICaptacionService CaptacionSvc
@inject ILocalService LocalSvc
@inject IContratoService ContratoSvc

<PageTitle>Solicitud @_s.CodigoSolicitud · ControlLocal</PageTitle>

@if (_cargando)
{
    <AppShell Title="Solicitud de alquiler" Crumbs="@(new[] { "ControlLocal", "Solicitudes de alquiler" })">
        <ChildContent>
            <div class="cl-card"><div class="cl-card-body" style="padding:40px;text-align:center;color:#7E8794;">Cargando solicitud…</div></div>
        </ChildContent>
    </AppShell>
}
else
{
<AppShell Crumbs="@(new[] { "ControlLocal", "Solicitudes de alquiler", _s.CodigoSolicitud })"
          Title="@($"{_s.CodigoSolicitud} · {_s.ClienteNombre}")"
          Subtitle="@($"Solicitud de alquiler · operación {_s.CodigoOperacion} · {_s.DireccionLocal}, {_s.DistritoLocal}")">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate(App.Role == Roles.Agente ? "solicitudes" : "seguimiento-comercial"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
        @* Solo-lectura tras el cierre: con contrato registrado ya no se editan documentos. *@
        @if (_contrato is null && App.Role == Roles.Agente)
        {
            <button class="cl-btn" @onclick="@(() => App.Navigate($"documentos/{_s.CodigoSolicitud}"))"><Icon Name="folder" Size="13" /> Gestionar documentos</button>
        }
    </Actions>
    <ChildContent>
        <div class="cl-stage" style="margin-bottom:14px;">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var cls = i < _current ? "done" : (i == _current ? "active" : "");
                <div class="cl-stage-step @cls">
                    <div class="cl-stage-k"><span class="cl-stage-dot"></span> @_stages[i].K</div>
                    <div class="cl-stage-v">@_stages[i].V</div>
                </div>
            }
        </div>

        <div style="display:grid;grid-template-columns:1fr 320px;gap:14px;">
            <div class="cl-stack">
                @if (_contrato is not null)
                {
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div class="cl-card-title">Alquiler cerrado</div>
                            <span class="cl-badge green">@_contrato.Estado</span>
                        </div>
                        <div class="cl-card-body">
                            <div class="cl-alert green" style="margin-bottom:12px;">
                                <Icon Name="checkCircle" Size="15" />
                                <span>Esta propiedad fue <b>alquilada</b> a @_contrato.ClienteNombre. La operación quedó cerrada.</span>
                            </div>
                            <dl class="cl-kv">
                                <dt>Renta mensual</dt><dd>USD @_contrato.RentaMensualTexto</dd>
                                <dt>Plazo</dt><dd>@_contrato.PlazoMeses meses</dd>
                                <dt>Vigencia</dt><dd>@_contrato.FechaInicioTexto — @_contrato.FechaFinTexto</dd>
                                <dt>Comisión generada</dt><dd>USD @_contrato.ComisionGeneradaTexto</dd>
                                <dt>Liquidación de comisión</dt><dd>@(string.IsNullOrWhiteSpace(_contrato.ComisionEstado) ? "—" : _contrato.ComisionEstado)</dd>
                                <dt>Fecha de cierre</dt><dd>@_contrato.FechaCierreTexto</dd>
                            </dl>
                            <button class="cl-btn" style="margin-top:4px;" @onclick="@(() => App.Navigate("propiedades-alquiladas"))"><Icon Name="store" Size="13" /> Ver cierres exitosos</button>
                        </div>
                    </div>
                }
                else if (PuedeAlquilar)
                {
                    <div class="cl-card">
                        <div class="cl-card-head">
                            <div class="cl-card-title">Cerrar el alquiler</div>
                            <span class="cl-badge green">Aprobada por el broker</span>
                        </div>
                        <div class="cl-card-body">
                            <div class="cl-alert blue" style="margin-bottom:12px;">
                                <Icon Name="info" Size="15" />
                                <span>El broker aprobó la solicitud con estas condiciones. Al confirmar se registra el contrato, la propiedad queda <b>alquilada</b> y se genera la <b>comisión</b>.</span>
                            </div>
                            <dl class="cl-kv">
                                <dt>Renta mensual (oferta aprobada)</dt><dd>USD @_s.MontoMensualTexto /mes</dd>
                                <dt>Plazo del contrato</dt><dd>@(_s.PlazoMeses > 0 ? $"{_s.PlazoMeses} meses" : "—")</dd>
                                <dt>Fecha de inicio</dt><dd>@(string.IsNullOrWhiteSpace(_s.FechaInicioTexto) ? "—" : _s.FechaInicioTexto)</dd>
                                <dt>Forma de pago</dt><dd>@(string.IsNullOrWhiteSpace(_s.FormaPago) ? "—" : _s.FormaPago)</dd>
                                <dt>Garantía</dt><dd>@(_s.MesesGarantia is int mesesG ? $"{mesesG} mes(es)" : "—")</dd>
                                <dt>Adelanto</dt><dd>@(_s.MesesAdelanto is int mesesA ? $"{mesesA} mes(es)" : "—")</dd>
                            </dl>
                            <div class="cl-divider"></div>
                            <div class="cl-flex" style="justify-content:space-between;align-items:center;">
                                <div>
                                    <div class="cl-def-k">Comisión a generar (@ComisionPctTexto% de la renta)</div>
                                    <div style="font-weight:700;font-size:19px;color:var(--c-primary);margin-top:4px;">USD @ComisionEstimadaTexto</div>
                                </div>
                                <span class="cl-badge gray">Liquidación PENDIENTE</span>
                            </div>
                            @if (_errorContrato is not null)
                            {
                                <div class="cl-alert red" style="margin-top:10px;"><Icon Name="alert" Size="15" /><span>@_errorContrato</span></div>
                            }
                            <div style="margin-top:12px;display:flex;justify-content:flex-end;">
                                <button class="cl-btn success" disabled="@_procesandoContrato" @onclick="AbrirFormularioCierre"><Icon Name="checkCircle" Size="13" /> Cerrar el alquiler</button>
                            </div>
                        </div>
                    </div>
                }
                <div class="cl-card">
                    <div class="cl-card-head">
                        <div class="cl-card-title">Resumen del alquiler</div>
                        <StatusBadge Label="@_s.Estado" />
                    </div>
                    <div class="cl-card-body">
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;align-items:start;">
                            <div>
                                <div class="cl-def-k">Quién alquila (inquilino)</div>
                                <div class="cl-flex" style="gap:9px;margin-top:8px;">
                                    <span class="cl-avatar" style="width:30px;height:30px;font-size:11px;background:#2F7D52;">@Initials(_s.ClienteNombre)</span>
                                    <div>
                                        <div style="font-weight:600;font-size:13px;">
                                            <FichaLink Kind="cliente" Id="@_s.ClienteId" Text="@_s.ClienteNombre" />
                                        </div>
                                        <div class="cl-muted" style="font-size:11px;">Operación @_s.CodigoOperacion</div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="cl-def-k">Propuesta del cliente (oferta)</div>
                                <div style="font-weight:700;font-size:19px;margin-top:6px;color:var(--c-primary);">USD @_s.MontoMensualTexto <span class="cl-muted" style="font-weight:500;font-size:12px;">/mes</span></div>
                                <div class="cl-muted" style="font-size:11px;margin-top:2px;">Plazo @PlazoSolicitud</div>
                            </div>
                            <div>
                                <div class="cl-def-k">Lo que pide el propietario</div>
                                <div style="font-weight:700;font-size:19px;margin-top:6px;">@PrecioPropietarioTexto<span class="cl-muted" style="font-weight:500;font-size:12px;">@(TienePrecioReferencial ? " /mes" : "")</span></div>
                                <div class="cl-muted" style="font-size:11px;margin-top:2px;">Precio referencial del local</div>
                            </div>
                        </div>

                        @if (TienePrecioReferencial)
                        {
                            <div class="cl-flex" style="gap:9px;margin-top:14px;padding:10px 12px;border-radius:10px;background:@ComparacionBg;border:1px solid @ComparacionBorde;">
                                <Icon Name="@ComparacionIcono" Size="16" Color="@ComparacionColor" />
                                <span style="font-size:12.5px;font-weight:600;color:@ComparacionColor;">@ComparacionTexto</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(_s.Observaciones))
                        {
                            <div style="margin-top:14px;">
                                <div class="cl-def-k">Observaciones de la solicitud</div>
                                <div style="font-size:12.5px;color:var(--c-text-2);margin-top:4px;line-height:1.6;">@_s.Observaciones</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head">
                        <div class="cl-card-title">La propiedad</div>
                        <div class="cl-flex" style="gap:8px;">
                            <FichaLink Kind="owner" Id="@_local?.PropietarioId" Text="Ver propietario" Variant="button" />
                            @if (_local is not null && !string.IsNullOrWhiteSpace(_local.Estado))
                            {
                                <span class="cl-badge gray">@_local.Estado</span>
                            }
                        </div>
                    </div>
                    <div class="cl-card-body">
                        <div class="cl-specs">
                            <Spec Icon="mapPin" K="Dirección" V="@_s.DireccionLocal" />
                            <Spec Icon="mapPin" K="Distrito" V="@Texto(_captacion?.DistritoLocal ?? _s.DistritoLocal)" />
                            <Spec Icon="layers" K="Área" V="@AreaLocal" />
                            <Spec Icon="store" K="Rubro" V="@Texto(_local?.Rubro ?? _captacion?.Rubro)" />
                            <Spec Icon="user" K="Propietario" V="@Texto(_captacion?.PropietarioNombre)" />
                            <Spec Icon="activity" K="Comisión" V="@ComisionCaptacion" />
                            <Spec Icon="folder" K="Captación" V="@Texto(_captacion?.CodigoCaptacion)" />
                        </div>
                        <div style="margin-top:14px;">
                            <div class="cl-def-k" style="margin-bottom:6px;">Descripción</div>
                            <div style="font-size:13px;line-height:1.7;color:var(--c-text-2);">@DescripcionLocal</div>
                        </div>
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Documentos de la solicitud</div><span class="cl-badge @(_s.PorcentajeDocumentos == 100 ? "green" : "gray")">@_s.DocumentosTexto cargados</span></div>
                    <div class="cl-card-body" style="padding:0;">
                        @for (var i = 0; i < _docs.Count; i++)
                        {
                            var top = i == 0 ? "0" : "1px solid #E2E6EC";
                            var doc = _docs[i];
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-top:@top;">
                                <div class="cl-flex"><Icon Name="fileText" Size="16" /> <span style="font-size:12.5px;">@doc.Name</span></div>
                                <div class="cl-flex" style="gap:10px;">
                                    <StatusBadge Label="@doc.Status" />
                                    @if (!string.IsNullOrWhiteSpace(doc.Clave))
                                    {
                                        <button class="cl-btn sm" @onclick="@(() => _docVer = doc)"><Icon Name="eye" Size="13" /> Ver</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="cl-card">
                    <div class="cl-card-head">
                        <div class="cl-card-title">Historial de evaluaciones</div>
                        <span class="cl-badge gray">@_evaluaciones.Count</span>
                    </div>
                    <div class="cl-card-body" style="padding:0;">
                        @if (_evaluaciones.Count == 0)
                        {
                            <div style="padding:20px;text-align:center;color:#7E8794;font-size:12.5px;">
                                Aún no hay evaluaciones registradas para esta solicitud.
                            </div>
                        }
                        else
                        {
                            @for (var i = 0; i < _evaluaciones.Count; i++)
                            {
                                var top = i == 0 ? "0" : "1px solid #E2E6EC";
                                var ev = _evaluaciones[i];
                                <div style="padding:12px 16px;border-top:@top;">
                                    <div class="cl-flex" style="justify-content:space-between;gap:10px;">
                                        <div class="cl-flex" style="gap:8px;">
                                            <StatusBadge Label="@ResultadoEvalTexto(ev.Resultado)" />
                                            <span style="font-size:12.5px;font-weight:600;">@TipoEvalTexto(ev.TipoEvaluacion)</span>
                                        </div>
                                        <span class="cl-muted" style="font-size:11.5px;">@ev.FechaEvaluacionTexto</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ev.Observaciones))
                                    {
                                        <div style="font-size:12px;color:var(--c-text-2);margin-top:6px;line-height:1.5;">@ev.Observaciones</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ev.ResponsableEvaluacion))
                                    {
                                        <div class="cl-muted" style="font-size:11px;margin-top:4px;">Broker: @ev.ResponsableEvaluacion</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>

            <div class="cl-stack">
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Estado actual</div></div>
                    <div class="cl-card-body">
                        <div style="text-align:center;padding:6px 0;">
                            <StatusBadge Label="@_s.Estado" />
                            <div class="cl-muted" style="font-size:12px;margin-top:8px;">Registrada el @_s.FechaRegistroTexto · operación @_s.CodigoOperacion</div>
                        </div>
                    </div>
                </div>
                <div class="cl-card">
                    <div class="cl-card-head"><div class="cl-card-title">Cliente</div></div>
                    <div class="cl-card-body">
                        <div class="cl-flex" style="gap:10px;">
                            <span class="cl-avatar" style="width:34px;height:34px;font-size:12px;background:#2F7D52;">@Initials(_s.ClienteNombre)</span>
                            <div>
                                <div style="font-weight:600;font-size:13px;">
                                    <FichaLink Kind="cliente" Id="@_s.ClienteId" Text="@_s.ClienteNombre" />
                                </div>
                                <div class="cl-muted" style="font-size:11px;">Operación @_s.CodigoOperacion</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>La solicitud conserva únicamente oportunidad, monto propuesto, plazo tentativo, observaciones, documentos, evaluaciones y estado.</span>
                </div>
            </div>
        </div>

        <DocViewerModal Open="@(_docVer is not null)" Nombre="@(_docVer?.Name ?? "")"
                        Estado="@(_docVer?.Status ?? "")" Expediente="@_s.CodigoSolicitud" Actualizado="—"
                        Url="@UrlDoc" Incrustable="@IncrustableDoc"
                        OnClose="@(() => _docVer = null)" />

        <Modal Open="_confirmAlquiler" Size="lg" Tone="green" Icon="checkCircle"
               Title="Cerrar el alquiler"
               Desc="Formaliza el contrato a partir de la solicitud aprobada. El resumen no es editable."
               OnClose="@CerrarFormularioCierre">
            <ChildContent>
                @* Resumen NO editable: condiciones del trato + comisión calculada. *@
                <div class="cl-def-k" style="margin-bottom:6px;">Resumen de la operación</div>
                <dl class="cl-kv">
                    <dt>Inquilino</dt><dd>@_s.ClienteNombre</dd>
                    <dt>Local</dt><dd>@_s.DireccionLocal@(string.IsNullOrWhiteSpace(_s.DistritoLocal) ? "" : $" · {_s.DistritoLocal}")</dd>
                    <dt>Renta mensual</dt><dd>USD @_s.MontoMensualTexto /mes</dd>
                    <dt>Plazo</dt><dd>@(_s.PlazoMeses > 0 ? $"{_s.PlazoMeses} meses" : PlazoSolicitud)</dd>
                    <dt>Comisión pactada</dt><dd>@ComisionPctTexto%</dd>
                    <dt>Comisión bruta calculada</dt><dd><b>USD @ComisionEstimadaTexto</b></dd>
                </dl>

                <div class="cl-divider"></div>

                @* Campos editables de la formalización. *@
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <Field Label="Fecha de cierre" Required="true">
                        <input type="date" @bind="_fechaCierre" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </Field>
                    <Field Label="Estado del contrato" Required="true">
                        <select @bind="_estadoContrato">
                            <option value="V">Vigente</option>
                            <option value="D">Firmado</option>
                        </select>
                    </Field>
                </div>
                <Field Label="Incidencias" Hint="Opcional: observaciones de la formalización.">
                    <textarea rows="3" @bind="_incidencias" placeholder="Por ejemplo, condiciones pendientes o acuerdos verbales..."></textarea>
                </Field>

                @if (_errorContrato is not null)
                {
                    <div class="cl-alert red" style="margin-top:10px;"><Icon Name="alert" Size="15" /><span>@_errorContrato</span></div>
                }
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" disabled="@_procesandoContrato" @onclick="CerrarFormularioCierre">Cancelar</button>
                <button class="cl-btn success" disabled="@_procesandoContrato" @onclick="ConfirmarAlquilerAsync">
                    <Icon Name="checkCircle" Size="13" /> @(_procesandoContrato ? "Cerrando..." : "Confirmar cierre")
                </button>
            </Footer>
        </Modal>

        <CierreExitosoOverlay Open="_alquilada"
                              Icon="handshake"
                              Eyebrow="Operación finalizada"
                              Title="¡Propiedad alquilada!"
                              Subtitle="@_subtituloAlquiler"
                              Confirmacion="Contrato registrado y operación cerrada."
                              Resumen="_resumenAlquiler">
            <Acciones>
                <button class="cl-btn primary" @onclick="@(() => App.Navigate("propiedades-alquiladas"))"><Icon Name="store" Size="13" /> Ver cierres exitosos</button>
                <button class="cl-btn ghost" @onclick="@(() => _alquilada = false)">Entendido</button>
            </Acciones>
        </CierreExitosoOverlay>
    </ChildContent>
</AppShell>
}

@code {
    [Parameter] public string? CodigoParam { get; set; }

    private Doc? _docVer;
    private bool _cargando = true;

    // URL del contenido real del documento abierto en el visor (null si aún no hay archivo).
    private string? UrlDoc => string.IsNullOrEmpty(_docVer?.Clave)
        ? null
        : $"/documento?clave={Uri.EscapeDataString(_docVer.Clave)}";
    private bool IncrustableDoc => _docVer?.Clave is { } clave && TiposContenido.SePuedeIncrustar(clave);

    private SolicitudAlquilerDto _s = new();
    private OportunidadComercialDto? _oportunidad;
    private CaptacionDto? _captacion;
    private LocalComercialDto? _local;

    // Cierre del alquiler (hilo dentro de la solicitud).
    private ContratoAlquilerDto? _contrato;
    // Historial de evaluaciones de la solicitud (trazabilidad).
    private IReadOnlyList<EvaluacionSolicitudDto> _evaluaciones = Array.Empty<EvaluacionSolicitudDto>();
    private bool _confirmAlquiler, _procesandoContrato, _alquilada;
    private string? _errorContrato;
    private string _subtituloAlquiler = "";
    private IReadOnlyList<CierreExitosoOverlay.Fila> _resumenAlquiler = [];

    // Formulario de cierre (reemplaza la confirmación simple): formalización capturada por el agente.
    // El agente NO gestiona documentos aquí; esa validación la hace el broker en la evaluación.
    private DateOnly _fechaCierre = DateOnly.FromDateTime(DateTime.Today);
    private string _estadoContrato = "V";
    private string _incidencias = "";

    // Carga puntual: abrir desde tarea/notificacion no debe pedir listas globales.
    protected override async Task OnParametersSetAsync()
    {
        _cargando = true;
        try
        {
            _s = await ResolverSolicitudAsync(CodigoParam) ?? new();
            _oportunidad = null;
            _captacion = _s.CaptacionId > 0
                ? await CaptacionSvc.ObtenerPorIdAsync(_s.CaptacionId, DisposedToken)
                : null;
            // El precio referencial y la descripcion viven en el local; se resuelven
            // por el id de la captacion. Task.Run evita bloquear el circuito si la
            // cache de locales aun no esta tibia (ById dispara una carga sincrona).
            if (_captacion is { LocalId: > 0 } cap)
                _local = await LocalSvc.ObtenerAsync(cap.LocalId, DisposedToken);
            else
                _local = null;
            // Contrato ya registrado para esta operacion (si la propiedad ya se alquilo).
            _contrato = _s.OportunidadId > 0
                ? await ContratoSvc.ObtenerPorOportunidadAsync(_s.OportunidadId, DisposedToken)
                : null;
            await CargarDocumentosAsync();
            // Historial de evaluaciones (trazabilidad). Best-effort: no rompe el detalle.
            if (_s.Id > 0)
            {
                try { _evaluaciones = await SolicitudSvc.ListarEvaluacionesAsync(_s.Id, DisposedToken); }
                catch (OperationCanceledException) { }
                catch { /* el detalle se muestra aunque no carguen las evaluaciones */ }
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _cargando = false;
        }
    }

    // Trae los documentos reales de la solicitud y arma el checklist requerido.
    // Sin archivo, cada tipo queda "Pendiente de carga" (nada figura como validado).
    private async Task CargarDocumentosAsync()
    {
        IReadOnlyList<DocumentoSolicitudDto> reales = Array.Empty<DocumentoSolicitudDto>();
        if (_s.Id > 0)
        {
            // Si los documentos no cargan, el detalle igual se muestra (checklist en blanco).
            try { reales = await DocSvc.ListarAsync(_s.Id, DisposedToken); }
            catch (OperationCanceledException) { }
            catch { /* el detalle no debe romperse por un fallo al listar documentos */ }
        }
        _docs = _checklist.Select(plantilla =>
        {
            var real = reales.LastOrDefault(r => r.TipoDocumento == plantilla.Codigo);
            var estado = real is null || string.IsNullOrWhiteSpace(real.Estado)
                ? "Pendiente de carga"
                : real.Estado;
            return new Doc(plantilla.Codigo, plantilla.Nombre, estado, real?.RutaArchivo);
        }).ToList();
    }

    // El parámetro puede ser el código (SOL-...) o el id numérico (alerta del backend).
    private async Task<SolicitudAlquilerDto?> ResolverSolicitudAsync(string? param)
    {
        if (string.IsNullOrEmpty(param))
        {
            var pagina = await SolicitudSvc.ListarPaginaAsync(1, 1, DisposedToken);
            return pagina.Items.FirstOrDefault();
        }
        return await SolicitudSvc.ObtenerAsync(param, DisposedToken);
    }

    private static string Initials(string name) =>
        string.Concat((name ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => char.ToUpper(w[0])));

    private record Stage(string K, string V);

    private readonly Stage[] _stages =
    {
        new("Etapa 1", "Registrada"),
        new("Etapa 2", "En revision"),
        new("Etapa 3", "Resuelta"),
    };
    private int _current => _s.Estado switch
    {
        "Registrada" => 0,
        "En revision" or "Observada" => 1,
        _ => 2,
    };

    private record Doc(string Tipo, string Name, string Status, string? Clave);

    // Checklist de tipos requeridos (mismo conjunto que la pantalla de carga). El estado
    // de cada uno se resuelve contra los documentos reales en CargarDocumentosAsync.
    private static readonly (string Codigo, string Nombre)[] _checklist =
    {
        ("I", "Documento de identidad"),
        ("R", "Ficha o constancia RUC"),
        ("V", "Vigencia de poder"),
        ("E", "Sustento economico"),
        ("G", "Documento de garantia"),
        ("D", "Declaracion jurada"),
    };

    private List<Doc> _docs = new();

    private string PlazoSolicitud => string.IsNullOrWhiteSpace(_s.PlazoTentativo)
        ? $"{_s.PlazoMeses} meses"
        : _s.PlazoTentativo;
    private string AreaLocal => _captacion is null ? "No registrado" : $"{_captacion.AreaM2} m²";
    private string ComisionCaptacion => string.IsNullOrWhiteSpace(_captacion?.ComisionPactadaTexto)
        ? "No registrada"
        : $"{_captacion.ComisionPactadaTexto}%";

    // --- Propiedad: precio que pide el propietario y descripcion (vienen del local) ---
    private bool TienePrecioReferencial => _local is { PrecioReferencial: > 0 };
    private string PrecioPropietarioTexto => TienePrecioReferencial
        ? $"USD {_local!.PrecioReferencialTexto}"
        : "No registrado";
    private string DescripcionLocal => string.IsNullOrWhiteSpace(_local?.Descripcion)
        ? "Sin descripción registrada."
        : _local!.Descripcion;

    // --- Comparacion oferta del cliente vs. precio que pide el propietario ---
    // _diferencia > 0  => la oferta esta por debajo de lo pedido.
    private decimal _diferencia => (_local?.PrecioReferencial ?? 0m) - _s.MontoMensual;
    private int _diferenciaPct => TienePrecioReferencial && _local!.PrecioReferencial > 0
        ? (int)Math.Round(Math.Abs(_diferencia) / _local.PrecioReferencial * 100m)
        : 0;
    private bool _ofertaPorDebajo => _diferencia > 0;
    private bool _ofertaIgual => _diferencia == 0;

    private static string MontoEs(decimal valor) =>
        valor.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-PE"));

    private string ComparacionTexto => _ofertaIgual
        ? "La oferta iguala el precio que pide el propietario."
        : _ofertaPorDebajo
            ? $"La oferta está USD {MontoEs(Math.Abs(_diferencia))} por debajo de lo pedido (−{_diferenciaPct}%)."
            : $"La oferta supera lo pedido en USD {MontoEs(Math.Abs(_diferencia))} (+{_diferenciaPct}%).";
    private string ComparacionColor => _ofertaPorDebajo ? "var(--c-red)" : "var(--c-green)";
    private string ComparacionBg => _ofertaPorDebajo ? "var(--c-red-50)" : "var(--c-green-50)";
    private string ComparacionBorde => _ofertaPorDebajo ? "#F2C9CD" : "#C7E6D8";
    private string ComparacionIcono => _ofertaPorDebajo ? "alert" : "checkCircle";

    // --- Cierre del alquiler (hilo dentro de la solicitud) ---
    // Solo el agente, sobre una solicitud aprobada aun sin contrato y con la
    // oportunidad todavia abierta, puede concretar el alquiler.
    private bool PuedeAlquilar => App.Role == Roles.Agente
        && _s.Estado == "Aprobada"
        && _contrato is null
        && _s.OportunidadId > 0
        && (_oportunidad is null || _oportunidad.Estado is "Abierta" or "Solicitud creada");

    private decimal ComisionPct => _captacion?.ComisionPactada ?? 0m;
    private decimal ComisionEstimada => Math.Round(_s.MontoMensual * ComisionPct / 100m, 2);
    private string ComisionEstimadaTexto => MontoEs(ComisionEstimada);
    private string ComisionPctTexto => ComisionPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    // Abre el formulario de cierre con valores por defecto (cierre = hoy, estado = Vigente).
    private void AbrirFormularioCierre()
    {
        if (_procesandoContrato) return;
        _errorContrato = null;
        _fechaCierre = DateOnly.FromDateTime(DateTime.Today);
        _estadoContrato = "V";
        _incidencias = "";
        _confirmAlquiler = true;
    }

    private void CerrarFormularioCierre()
    {
        if (_procesandoContrato) return;
        _confirmAlquiler = false;
    }

    private async Task ConfirmarAlquilerAsync()
    {
        if (_procesandoContrato) return;
        try
        {
            _procesandoContrato = true;
            _errorContrato = null;
            await RenderIfAliveAsync();
            var creado = await ContratoSvc.RegistrarAsync(new ContratoFormRequest
            {
                SolicitudId = _s.Id,
                FechaCierre = _fechaCierre,
                EstadoContrato = _estadoContrato,
                Incidencias = string.IsNullOrWhiteSpace(_incidencias) ? null : _incidencias.Trim(),
            }, DisposedToken);
            _contrato = creado;
            _confirmAlquiler = false;
            ConstruirResumenAlquiler(creado);
            _alquilada = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _errorContrato = ex.Message;
            _confirmAlquiler = false;
        }
        finally
        {
            _procesandoContrato = false;
            await RenderIfAliveAsync();
        }
    }

    private void ConstruirResumenAlquiler(ContratoAlquilerDto c)
    {
        _subtituloAlquiler = $"Cerraste el alquiler de {c.DireccionLocal} con {c.ClienteNombre}. ¡Operación concretada!";
        _resumenAlquiler = new List<CierreExitosoOverlay.Fila>
        {
            new("Inquilino", c.ClienteNombre, "user"),
            new("Propiedad", $"{c.DireccionLocal} · {c.CodigoCaptacion}", "mapPin"),
            new("Renta mensual", $"USD {c.RentaMensualTexto}/mes", "activity", true),
            new("Plazo", $"{c.PlazoMeses} meses", "calendar"),
            new("Comisión generada", $"USD {c.ComisionGeneradaTexto}", "briefcase"),
        };
    }

    private static string Texto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "No registrado" : valor;

    // Traduce los códigos del backend (resultado A/R/O, tipo P/O/F) a texto legible.
    private static string ResultadoEvalTexto(string codigo) => codigo switch
    {
        "A" => "Aprobada",
        "R" => "Rechazada",
        "O" => "Observada",
        _ => string.IsNullOrWhiteSpace(codigo) ? "—" : codigo,
    };

    private static string TipoEvalTexto(string codigo) => codigo switch
    {
        "P" => "Preliminar",
        "O" => "Observación",
        "F" => "Final",
        _ => string.IsNullOrWhiteSpace(codigo) ? "—" : codigo,
    };
}
