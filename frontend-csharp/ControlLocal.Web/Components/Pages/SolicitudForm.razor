@page "/solicitud-form"
@page "/solicitud-form/{OportunidadIdParam:long}"
@inherits SafeComponentBase
@inject AppState App
@inject ISolicitudService SolicitudSvc
@inject IOportunidadService OportunidadSvc
@inject IDocumentoSolicitudService DocSvc
@inject INotificacionService Notificaciones
@using ControlLocal.Web.Models.Oportunidades
@using ControlLocal.Web.Models.Solicitudes

<PageTitle>Crear solicitud · ControlLocal</PageTitle>

<AppShell Crumbs="@(new[] { "ControlLocal", "Solicitudes de alquiler", "Nueva solicitud" })"
          Title="Crear solicitud de alquiler"
          Subtitle="Genera la solicitud desde una oportunidad comercial">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("solicitudes"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 300px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Oportunidad comercial" Sub="La oportunidad determina el cliente y la captación">
                    <Field Label="Oportunidad" Required="true">
                        <input class="cl-input search" type="search"
                               placeholder="Escribe para buscar por codigo, cliente, captacion o local..."
                               value="@_busquedaOportunidad"
                               @oninput="OnBusquedaOportunidad"
                               @onfocus="@(() => _desplegarOportunidades = true)"
                               disabled="@(_cargando || _procesando)" />

                        <div style="margin-top:6px;max-height:230px;overflow-y:auto;display:flex;flex-direction:column;gap:6px;">
                            @if (_desplegarOportunidades || _oportunidadId == 0)
                            {
                                @if (_cargando)
                                {
                                    <div class="cl-help">Cargando oportunidades...</div>
                                }
                                else
                                {
                                    @foreach (var oportunidad in OportunidadesDisponibles)
                                    {
                                        var sel = _oportunidadId == oportunidad.Id;
                                        <div role="button" tabindex="0"
                                             style="@PickStyle(sel)"
                                             @onclick="@(() => SeleccionarOportunidadAsync(oportunidad.Id))">
                                            <Icon Name="target" Size="17" Color="@(sel ? "#005BFF" : "var(--c-text-3)")" />
                                            <div style="flex:1;min-width:0;">
                                                <div style="font-weight:600;font-size:13px;">@oportunidad.CodigoOportunidad · @oportunidad.ClienteNombre</div>
                                                <div class="cl-muted" style="font-size:11px;">@oportunidad.CaptacionCodigo · @oportunidad.DireccionLocal</div>
                                            </div>
                                            @if (sel)
                                            {
                                                <Icon Name="check" Size="15" Color="#005BFF" />
                                            }
                                        </div>
                                    }
                                    @if (!OportunidadesDisponibles.Any())
                                    {
                                        <div class="cl-help">No hay oportunidades que coincidan con la busqueda.</div>
                                    }
                                }
                            }
                            else if (OportunidadSeleccionada is not null)
                            {
                                <div role="button" tabindex="0"
                                     style="@PickStyle(true)"
                                     @onclick="@(() => _desplegarOportunidades = true)">
                                    <Icon Name="target" Size="17" Color="#005BFF" />
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:13px;">@OportunidadSeleccionada.CodigoOportunidad · @OportunidadSeleccionada.ClienteNombre</div>
                                        <div class="cl-muted" style="font-size:11px;">@OportunidadSeleccionada.CaptacionCodigo · @OportunidadSeleccionada.DireccionLocal</div>
                                    </div>
                                    <Icon Name="check" Size="15" Color="#005BFF" />
                                </div>
                            }
                        </div>
                    </Field>
                    @if (OportunidadSeleccionada is not null)
                    {
                        <div class="cl-grid c2" style="margin-top:12px;">
                            <Field Label="Cliente"><input value="@OportunidadSeleccionada.ClienteNombre" disabled /></Field>
                            <Field Label="Local"><input value="@OportunidadSeleccionada.DireccionLocal" disabled /></Field>
                        </div>
                    }
                </FormSection>

                <FormSection Num="2" Title="Condiciones del alquiler" Sub="El broker evalúa la solicitud con estas condiciones; el contrato las hereda al cerrar">
                    <div class="cl-grid c2">
                        <Field Label="Monto propuesto (USD/mes)" Required="true"><input type="number" min="0.01" step="0.01" @bind="_montoPropuesto" /></Field>
                        <Field Label="Plazo del contrato (meses)" Required="true"><input type="number" min="1" @bind="_plazoMeses" /></Field>
                        <Field Label="Fecha de inicio" Required="true"><input type="date" @bind="_fechaInicio" /></Field>
                        <Field Label="Forma de pago">
                            <select @bind="_formaPago">
                                <option value="TRANSFERENCIA">Transferencia</option>
                                <option value="DEPOSITO_BANCARIO">Depósito bancario</option>
                                <option value="EFECTIVO">Efectivo</option>
                                <option value="CHEQUE">Cheque</option>
                                <option value="OTRO">Otro</option>
                            </select>
                        </Field>
                        <Field Label="Meses de garantía (opcional)"><input type="number" min="0" @bind="_mesesGarantia" /></Field>
                        <Field Label="Meses de adelanto (opcional)"><input type="number" min="0" @bind="_mesesAdelanto" /></Field>
                    </div>
                    <div style="margin-top:12px;">
                        <Field Label="Observaciones">
                            <textarea rows="4" @bind="_observaciones" placeholder="Condiciones o comentarios de la propuesta..."></textarea>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Documentos (opcional)" Sub="Adjunta los documentos ahora; se subirán automáticamente al crear la solicitud">
                    <div class="cl-grid c2">
                        <Field Label="Tipo de documento">
                            <select @bind="_tipoDocSeleccionado" disabled="@_procesando">
                                @foreach (var t in _tiposDoc)
                                {
                                    <option value="@t.Codigo">@t.Nombre</option>
                                }
                            </select>
                        </Field>
                        <Field Label="@($"Archivo (PDF, PNG o JPG · máx. {ValidadorArchivos.TamanoMaximo / 1024 / 1024} MB)")">
                            <InputFile OnChange="StageArchivo" accept=".pdf,.png,.jpg,.jpeg" class="cl-input" disabled="@_procesando" />
                        </Field>
                    </div>
                    @if (_docError is not null)
                    {
                        <div class="cl-alert red" style="margin-top:8px;"><Icon Name="alert" Size="14" /><span>@_docError</span></div>
                    }
                    @if (_docsEnEspera.Count > 0)
                    {
                        <div style="margin-top:10px;display:flex;flex-direction:column;gap:6px;">
                            @foreach (var t in _tiposDoc.Where(t => _docsEnEspera.ContainsKey(t.Codigo)))
                            {
                                var doc = _docsEnEspera[t.Codigo];
                                <div style="display:flex;align-items:center;gap:10px;padding:8px 11px;border:1px solid var(--c-border-2);border-radius:10px;background:#fff;">
                                    <Icon Name="fileText" Size="15" />
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-weight:600;font-size:12.5px;">@t.Nombre</div>
                                        <div class="cl-muted" style="font-size:11px;">@doc.Nombre</div>
                                    </div>
                                    <button type="button" class="cl-btn ghost sm" disabled="@_procesando" @onclick="@(() => _docsEnEspera.Remove(t.Codigo))"><Icon Name="x" Size="13" /> Quitar</button>
                                </div>
                            }
                        </div>
                        <div class="cl-help" style="margin-top:6px;">@_docsEnEspera.Count documento(s) listos · se subirán al crear la solicitud. Podrás agregar o subsanar el resto después.</div>
                    }
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("solicitudes"))"
                               OnSave="@EnviarAEvaluacion"
                               SaveLabel="Enviar a evaluación"
                               Busy="@_procesando"
                               BusyLabel="Enviando..." />
            </div>

            <div class="cl-stack">
                <div class="cl-card" style="position:sticky;top:14px;">
                    <div class="cl-card-head"><div class="cl-card-title">Resumen de la operación</div></div>
                    <div class="cl-card-body">
                        <dl class="cl-kv">
                            <dt>Operación</dt><dd>@(OportunidadSeleccionada?.CodigoOportunidad ?? "—")</dd>
                            <dt>Cliente</dt><dd>@(OportunidadSeleccionada?.ClienteNombre ?? "—")</dd>
                            <dt>Captación</dt><dd>@(OportunidadSeleccionada?.CaptacionCodigo ?? "—")</dd>
                            <dt>Monto</dt><dd>@(_montoPropuesto > 0 ? _montoPropuesto.ToString("N2") : "—")</dd>
                            <dt>Plazo</dt><dd>@(_plazoMeses > 0 ? $"{_plazoMeses} meses" : "—")</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="fileText"
                       Title="¿Enviar la solicitud a evaluación?"
                       Desc="La solicitud se registrará y pasará al estado En revision."
                       ConfirmLabel="Enviar solicitud" CancelLabel="Revisar datos"
                       Busy="@_procesando"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public long OportunidadIdParam { get; set; }

    private long _oportunidadId;
    private decimal _montoPropuesto;
    private int _plazoMeses;
    private DateOnly? _fechaInicio = DateOnly.FromDateTime(DateTime.Today);
    private string _formaPago = "TRANSFERENCIA";
    private int? _mesesGarantia;
    private int? _mesesAdelanto;
    private string _observaciones = "";
    private bool _confirm;
    private bool _toast;
    private bool _procesando;
    private bool _cargando = true;
    private string _toastMsg = "";
    private string? _err;
    private IReadOnlyList<OportunidadComercialDto> _oportunidades = [];
    private string _busquedaOportunidad = "";
    private bool _desplegarOportunidades;

    // Solicitud ya creada en un intento previo: se reutiliza para no duplicarla si la
    // subida de documentos o el envío fallan y el usuario reintenta.
    private SolicitudAlquilerDto? _creada;
    private string _tipoDocSeleccionado = "I";
    private string? _docError;
    // Documentos adjuntados en el formulario (en memoria) que se subirán al crear.
    private readonly Dictionary<string, (string Nombre, byte[] Contenido)> _docsEnEspera = new();

    private static readonly (string Codigo, string Nombre)[] _tiposDoc =
    {
        ("I", "Documento de identidad"),
        ("R", "Ficha o constancia RUC"),
        ("V", "Vigencia de poder"),
        ("E", "Sustento economico"),
        ("G", "Documento de garantia"),
        ("D", "Declaracion jurada"),
    };

    private OportunidadComercialDto? OportunidadSeleccionada =>
        _oportunidades.FirstOrDefault(item => item.Id == _oportunidadId);

    private IEnumerable<OportunidadComercialDto> OportunidadesDisponibles =>
        _oportunidades.Where(item => CoincideOportunidad(item, _busquedaOportunidad))
            .OrderByDescending(item => item.FechaActualizacion ?? DateTime.MinValue);

    private static bool CoincideOportunidad(OportunidadComercialDto item, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return true;
        var terminos = query.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return terminos.All(termino =>
            TextoFiltro.Contiene(item.CodigoOportunidad, termino)
            || TextoFiltro.Contiene(item.ClienteNombre, termino)
            || TextoFiltro.Contiene(item.CaptacionCodigo, termino)
            || TextoFiltro.Contiene(item.DireccionLocal, termino)
            || TextoFiltro.Contiene(item.Estado, termino));
    }

    private static string PickStyle(bool sel)
    {
        var border = sel ? "#005BFF" : "var(--c-border)";
        var bg = sel ? "#EAF1FF" : "#fff";
        return $"display:flex;align-items:center;gap:10px;padding:9px 11px;border:1.5px solid {border};border-radius:10px;background:{bg};cursor:pointer;";
    }

    protected override async Task OnInitializedAsync()
    {
        if (OportunidadIdParam > 0)
            _oportunidadId = OportunidadIdParam;

        try
        {
            await CargarOportunidadesAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnBusquedaOportunidad(ChangeEventArgs e)
    {
        _busquedaOportunidad = e.Value?.ToString() ?? "";
        _desplegarOportunidades = true;
        await CargarOportunidadesAsync();
    }

    private async Task SeleccionarOportunidadAsync(long id)
    {
        _oportunidadId = id;
        _desplegarOportunidades = false;
        _busquedaOportunidad = "";
        await CargarOportunidadesAsync();
    }

    private async Task CargarOportunidadesAsync()
    {
        var pagina = await OportunidadSvc.ListarPaginaAsync(
            1, 100, DisposedToken, _busquedaOportunidad);
        _oportunidades = pagina.Items;
        if (_oportunidadId > 0
            && _oportunidades.All(item => item.Id != _oportunidadId)
            && await OportunidadSvc.ByIdAsync(_oportunidadId, DisposedToken) is { } oportunidad)
        {
            _oportunidades = _oportunidades.Append(oportunidad).ToList();
        }
    }

    private bool Validar()
    {
        if (OportunidadSeleccionada is null) { _err = "Debes seleccionar una oportunidad comercial válida."; return false; }
        if (_montoPropuesto <= 0) { _err = "El monto propuesto debe ser mayor que cero."; return false; }
        if (_plazoMeses <= 0) { _err = "Indica el plazo del contrato en meses."; return false; }
        if (_fechaInicio is null) { _err = "Indica la fecha de inicio del contrato."; return false; }
        if (_mesesGarantia is < 0) { _err = "Los meses de garantía no pueden ser negativos."; return false; }
        if (_mesesAdelanto is < 0) { _err = "Los meses de adelanto no pueden ser negativos."; return false; }
        _err = null;
        return true;
    }

    private void EnviarAEvaluacion()
    {
        if (_procesando) return;
        if (Validar())
            _confirm = true;
    }

    private async Task OnConfirm()
    {
        if (_procesando) return;
        _confirm = false;
        if (!Validar())
            return;
        await GuardarYNavegarAsync(true, "Solicitud enviada a evaluación.");
    }

    private async Task GuardarYNavegarAsync(bool enviarAEvaluacion, string mensaje)
    {
        try
        {
            _procesando = true;
            _err = null;
            await RenderIfAliveAsync();

            // 1) Crea la solicitud SIN enviarla aún: necesitamos su id para adjuntar los
            //    documentos antes de la evaluación. Si ya se creó en un intento previo,
            //    se reutiliza (no se duplica).
            _creada ??= await SolicitudSvc.AgregarAsync(new SolicitudFormRequest
            {
                OportunidadId = _oportunidadId,
                MontoPropuesto = _montoPropuesto,
                PlazoMeses = _plazoMeses,
                FechaInicio = _fechaInicio,
                FormaPago = _formaPago,
                MesesGarantia = _mesesGarantia,
                MesesAdelanto = _mesesAdelanto,
                Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones.Trim(),
                EnviarAEvaluacion = false,
            }, DisposedToken);

            if (_creada is null || _creada.Id <= 0)
            {
                _err = "No se pudo registrar la solicitud.";
                return;
            }

            // 2) Sube los documentos adjuntados. Cada uno se retira de la cola al subirse,
            //    para no reintentar los ya cargados si algo falla a mitad de camino.
            foreach (var tipo in _docsEnEspera.Keys.ToList())
            {
                var doc = _docsEnEspera[tipo];
                await DocSvc.SubirAsync(_creada.Id, tipo, doc.Nombre, doc.Contenido, DisposedToken);
                _docsEnEspera.Remove(tipo);
            }

            // 3) Con los documentos ya cargados, envía la solicitud a evaluación.
            if (enviarAEvaluacion)
            {
                await SolicitudSvc.ReenviarAEvaluacionAsync(_creada.CodigoSolicitud, DisposedToken);
                NotificarBroker(_creada);
            }

            _toastMsg = mensaje;
            _toast = true;
            App.Navigate("solicitudes");
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception error)
        {
            // La solicitud pudo quedar creada con parte de los documentos subidos; el
            // usuario puede reintentar (no se duplica) o terminar la carga en el expediente.
            _err = _creada is not null
                ? $"La solicitud se registró ({_creada.CodigoSolicitud}), pero hubo un problema: {error.Message}. Reintenta o completa los documentos desde el expediente."
                : error.Message;
        }
        finally
        {
            _procesando = false;
            await RenderIfAliveAsync();
        }
    }

    // Lee y valida un archivo elegido y lo deja en espera bajo el tipo seleccionado.
    // No toca el backend: la subida real ocurre al crear la solicitud.
    private async Task StageArchivo(InputFileChangeEventArgs evento)
    {
        _docError = null;
        var archivo = evento.File;
        if (archivo is null)
        {
            _docError = "No se recibió ningún archivo.";
            return;
        }

        using var memoria = new MemoryStream();
        try
        {
            await using var stream = archivo.OpenReadStream(ValidadorArchivos.TamanoMaximo);
            await stream.CopyToAsync(memoria);
        }
        catch (IOException)
        {
            _docError = $"El archivo supera el máximo de {ValidadorArchivos.TamanoMaximo / 1024 / 1024} MB.";
            return;
        }
        catch (Exception ex)
        {
            _docError = $"No se pudo leer el archivo: {ex.Message}";
            return;
        }

        var primeros = memoria.GetBuffer().AsSpan(0, (int)Math.Min(8, memoria.Length));
        var validacion = ValidadorArchivos.Validar(
            archivo.Name, archivo.ContentType, memoria.Length, primeros,
            ".pdf", ".png", ".jpg", ".jpeg");
        if (!validacion.EsValido)
        {
            _docError = validacion.Error;
            return;
        }

        _docsEnEspera[_tipoDocSeleccionado] = (archivo.Name, memoria.ToArray());
    }

    // Avisa al broker supervisor que hay una solicitud nueva por evaluar y lo lleva
    // directo a la pantalla de evaluación de ESA solicitud (no a la lista genérica).
    private void NotificarBroker(SolicitudAlquilerDto? creada)
    {
        var op = OportunidadSeleccionada;
        var codigo = creada?.CodigoSolicitud;
        Notificaciones.Crear(new NotificacionDto
        {
            Tipo = "Solicitud por evaluar",
            Mensaje = op is null
                ? "Una nueva solicitud de alquiler espera tu evaluación."
                : $"Nueva solicitud de {op.ClienteNombre} ({op.CaptacionCodigo}) lista para evaluar.",
            Severidad = "MEDIA",
            Icono = "fileText",
            EntidadTipo = "Solicitud",
            EntidadRef = codigo ?? op?.CodigoOportunidad,
            Ruta = string.IsNullOrWhiteSpace(codigo) ? "solicitudes" : $"evaluacion/{codigo}",
            DestinatarioRol = Roles.Broker,
            Fecha = DateTime.Now,
        });
    }
}
