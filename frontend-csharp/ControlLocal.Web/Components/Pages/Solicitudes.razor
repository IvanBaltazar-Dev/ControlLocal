@page "/solicitudes"
@inject AppState App
@inject ISolicitudService SolicitudSvc
@inject ExportacionService Exportar

<PageTitle>Solicitudes de alquiler - ControlLocal</PageTitle>

<AppShell Active="Solicitudes de alquiler" Crumbs="@_crumbs" Title="Solicitudes de alquiler" Subtitle="@_subtitle">
    <Actions>
        @if (App.Role == Roles.Agente)
        {
            <button class="cl-btn primary" @onclick="@(() => App.Navigate("solicitud-form"))"><Icon Name="plus" Size="13" /> Nueva solicitud</button>
        }
        else
        {
            <button class="cl-btn" @onclick="ExportarCsv"><Icon Name="download" Size="13" /> Exportar</button>
            @if (App.Role == Roles.Admin)
            {
                <span class="cl-badge blue"><Icon Name="lock" Size="12" /> Solo lectura</span>
            }
        }
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }
        <div style="display:grid;grid-template-columns:repeat(@(_estados.Length + 1),1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="fileText" Label="Total" Value="@Todas.Count.ToString()" Tone="gray"
                        Active="@(_tab == "Todas")" OnClick="@(() => _tab = "Todas")" />
            @foreach (var e in _estados)
            {
                <MetricCard Icon="@IconoEstado(e)" Label="@e" Value="@CuentaEstado(e).ToString()" Tone="@TonoEstado(e)"
                            Active="@(_tab == e)" OnClick="@(() => _tab = e)" />
            }
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => _tab = t)" Items="_tabs" />

        <FilterBar Search="Buscar por código, cliente, local…"
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
            @if (App.Role is Roles.Broker or Roles.Admin)
            {
                <FilterSelect Placeholder="Agente" Options="_agentes" @bind-Value="_agente" />
            }
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Solicitud</th><th>Agente</th><th>Cliente</th><th>Local</th><th>Distrito</th>
                            <th>Monto/mes</th><th>Plazo</th><th>Documentos</th><th>Fecha</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in visibles)
                        {
                            <tr>
                                <td><span class="mono">@s.CodigoSolicitud</span></td>
                                <td>@(string.IsNullOrWhiteSpace(s.AgenteNombre) ? "—" : s.AgenteNombre)</td>
                                <td style="font-weight:600;">@s.ClienteNombre</td>
                                <td>@s.DireccionLocal</td>
                                <td>@s.DistritoLocal</td>
                                <td>USD <b>@s.MontoMensualTexto</b></td>
                                <td>@s.PlazoMeses m</td>
                                <td>
                                    <div class="cl-flex" style="gap:8px;">
                                        <div style="flex:1;min-width:54px;height:6px;background:#E2E6EC;border-radius:99px;overflow:hidden;">
                                            <div style="height:100%;width:@(s.PorcentajeDocumentos)%;background:@(s.PorcentajeDocumentos == 100 ? "var(--c-green)" : "var(--c-primary)");"></div>
                                        </div>
                                        <span class="cl-muted" style="font-size:11px;">@s.DocumentosTexto</span>
                                    </div>
                                </td>
                                <td><span class="cl-muted" style="font-size:12px;">@s.FechaRegistroTexto</span></td>
                                <td><StatusBadge Label="@s.Estado" /></td>
                                <td>
                                    @if (App.Role == Roles.Agente && s.Estado == "Observada")
                                    {
                                        <button class="cl-btn sm primary" @onclick="@(() => App.Navigate($"documentos/{s.CodigoSolicitud}"))">Subsanar</button>
                                    }
                                    else if (App.Role == Roles.Agente && s.Estado == "Aprobada")
                                    {
                                        @* Etapa 5 (trigger 2): la accion de cierre aflora aqui, donde vive la solicitud. *@
                                        <button class="cl-btn sm primary" @onclick="@(() => App.Navigate($"solicitud-detail/{s.CodigoSolicitud}"))"><Icon Name="checkCircle" Size="12" /> Cerrar</button>
                                    }
                                    else
                                    {
                                        <button class="cl-btn sm" @onclick="@(() => App.Navigate($"solicitud-detail/{s.CodigoSolicitud}"))">Ver</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Actualizando solicitudes…</div>
                }
                else if (_error is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="fileText" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin solicitudes en este filtro</div>
                        <div style="font-size:12px;">Ajusta la búsqueda o limpia los filtros.</div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />
    </ChildContent>
</AppShell>

@code {
    private const string _defaultTab = "Todas";
    private string _tab = "Todas";
    private string _query = "", _distrito = "", _agente = "";
    private int _pagina = 1;

    private bool _cargando = true;
    private string? _error;

    // Consulta general, separada de /solicitudes-revisar. Se recarga fresca para
    // mostrar el estado real despues de una evaluacion o subsanacion.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Lo más reciente primero (id desc): la solicitud recién registrada aparece al inicio.
            Todas = (await SolicitudSvc.RefrescarAsync()).OrderByDescending(s => s.Id).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private IReadOnlyList<SolicitudAlquilerDto> Todas = [];

    private string[] _estados => Todas.Select(s => s.Estado).Distinct().OrderBy(x => x).ToArray();
    private IReadOnlyList<string> _distritos => Todas.Select(s => s.DistritoLocal)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();
    private IReadOnlyList<string> _agentes => Todas.Select(s => s.AgenteNombre)
        .Where(a => !string.IsNullOrWhiteSpace(a)).Distinct().OrderBy(x => x).ToList();

    private int CuentaEstado(string e) => Todas.Count(s => s.Estado == e);

    private bool HayFiltros => _tab != _defaultTab
                               || !string.IsNullOrEmpty(_query) || !string.IsNullOrEmpty(_distrito)
                               || !string.IsNullOrEmpty(_agente);

    private void LimpiarFiltros() { _tab = _defaultTab; _query = ""; _distrito = ""; _agente = ""; _pagina = 1; }

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("solicitudes",
            new[] { "Solicitud", "Operación", "Cliente", "Local", "Distrito", "Monto mensual USD", "Plazo (meses)", "Documentos", "Fecha", "Estado" },
            Filtradas().Select(s => (IReadOnlyList<string?>)new[]
            {
                s.CodigoSolicitud, s.CodigoOperacion, s.ClienteNombre, s.DireccionLocal, s.DistritoLocal,
                s.MontoMensualTexto, s.PlazoMeses.ToString(), s.DocumentosTexto, s.FechaRegistroTexto, s.Estado,
            }));
    }

    private IEnumerable<SolicitudAlquilerDto> Filtradas() => Todas.Where(s =>
        (_tab == "Todas" || s.Estado == _tab) &&
        (string.IsNullOrEmpty(_distrito) || s.DistritoLocal == _distrito) &&
        (string.IsNullOrEmpty(_agente) || s.AgenteNombre == _agente) &&
        (string.IsNullOrEmpty(_query) || Coincide(s, _query)));

    private static bool Coincide(SolicitudAlquilerDto s, string q) =>
        TextoFiltro.Contiene(s.CodigoSolicitud, q)
        || TextoFiltro.Contiene(s.ClienteNombre, q)
        || TextoFiltro.Contiene(s.DireccionLocal, q)
        || TextoFiltro.Contiene(s.CodigoOperacion, q);

    private static string TonoEstado(string e) => e switch
    {
        "Aprobada" => "green",
        "Rechazada" => "red",
        "Desistida" => "red",
        "Observada" => "amber",
        "Pendiente de revision" => "amber",
        "Pendiente de revisión" => "amber",
        "En revision" => "blue",
        "Cerrada" => "green",
        _ => "blue",
    };

    private static string IconoEstado(string e) => e switch
    {
        "Aprobada" => "check",
        "Rechazada" => "x",
        "Observada" => "alert",
        "En revision" => "clock",
        "Cerrada" => "checkCircle",
        _ => "fileText",
    };

    // Misma página, dos accesos: la cola de revisión (Supervisión) y la lista (Consulta).
    // El item activo del sidebar depende de la ruta para no resaltar ambos.
    private string _subtitle => App.Role switch
    {
        Roles.Broker => "Consulta de solicitudes de alquiler enviadas por tu equipo",
        Roles.Admin => "Consulta global de solicitudes de alquiler en solo lectura",
        _ => "Solicitudes de alquiler que generé a partir de mis captaciones",
    };

    private string[] _crumbs => App.Role switch
    {
        Roles.Broker => new[] { "ControlLocal", "Consulta comercial", "Solicitudes de alquiler" },
        Roles.Admin => new[] { "ControlLocal", "Comercial", "Solicitudes de alquiler" },
        _ => new[] { "ControlLocal", "Operación", "Solicitudes de alquiler" },
    };

    private Tabs.TabItem[] _tabs => new[] { new Tabs.TabItem("Todas", Todas.Count) }
        .Concat(_estados.Select(e => new Tabs.TabItem(e, CuentaEstado(e))))
        .ToArray();
}
