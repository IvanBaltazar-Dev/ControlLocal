@page "/solicitudes-revisar"
@inject AppState App
@inject ISolicitudService SolicitudSvc
@inject ExportacionService Exportar

<PageTitle>Solicitudes por revisar - ControlLocal</PageTitle>

<AppShell Active="Solicitudes por revisar"
          Crumbs="@(new[] { "ControlLocal", "Supervision", "Solicitudes por revisar" })"
          Title="Solicitudes por revisar"
          Subtitle="Solicitudes pendientes de atencion del broker: registradas, en revision u observadas">
    <Actions>
        <button class="cl-btn" @onclick="ExportarCsv" disabled="@(Pendientes.Count == 0)">
            <Icon Name="download" Size="13" /> Exportar
        </button>
        <button class="cl-btn" @onclick="@(() => App.Navigate("solicitudes"))">
            <Icon Name="clipboardList" Size="13" /> Ver todas
        </button>
    </Actions>
    <ChildContent>
        @{
            var filtradas = Filtradas().ToList();
            var visibles = Paginador.Pagina(filtradas, ref _pagina);
        }

        <div style="display:grid;grid-template-columns:repeat(@(_estados.Length + 1),1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="clipboardCheck" Label="Pendientes" Value="@Pendientes.Count.ToString()" Tone="amber"
                        Active="@(_tab == TabPendientes)" OnClick="@(() => CambiarTab(TabPendientes))" />
            @foreach (var estado in _estados)
            {
                <MetricCard Icon="@IconoEstado(estado)" Label="@estado" Value="@CuentaEstado(estado).ToString()" Tone="@TonoEstado(estado)"
                            Active="@(_tab == estado)" OnClick="@(() => CambiarTab(estado))" />
            }
        </div>

        <Tabs Active="@_tab" OnSelect="@(t => CambiarTab(t))" Items="_tabs" />

        <FilterBar Search="Buscar por codigo, cliente, local..."
                   @bind-Value="_query" ResultCount="filtradas.Count"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
            <FilterSelect Placeholder="Agente" Options="_agentes" @bind-Value="_agente" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Solicitud</th><th>Agente</th><th>Cliente</th><th>Local</th><th>Distrito</th>
                            <th>Monto/mes</th><th>Plazo</th><th>Documentos</th><th>Fecha</th><th>Estado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in visibles)
                        {
                            <tr>
                                <td><span class="mono">@s.CodigoSolicitud</span></td>
                                <td>@Txt(s.AgenteNombre)</td>
                                <td style="font-weight:600;">@s.ClienteNombre</td>
                                <td>@s.DireccionLocal</td>
                                <td>@s.DistritoLocal</td>
                                <td>USD <b>@s.MontoMensualTexto</b></td>
                                <td>@s.PlazoMeses m</td>
                                <td>
                                    <div class="cl-flex" style="gap:8px;">
                                        <div style="flex:1;min-width:54px;height:6px;background:#E2E6EC;border-radius:99px;overflow:hidden;">
                                            <div style="height:100%;width:@(s.PorcentajeDocumentos)%;background:@(s.PorcentajeDocumentos == 100 ? "var(--c-green)" : "var(--c-primary)");"></div>
                                        </div>
                                        <span class="cl-muted" style="font-size:11px;">@s.DocumentosTexto</span>
                                    </div>
                                </td>
                                <td><span class="cl-muted" style="font-size:12px;">@s.FechaRegistroTexto</span></td>
                                <td><StatusBadge Label="@s.Estado" /></td>
                                <td>
                                    <button class="cl-btn sm primary" @onclick="@(() => App.Navigate($"evaluacion/{s.CodigoSolicitud}"))">
                                        Revisar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_cargando)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">Actualizando solicitudes...</div>
                }
                else if (_error is not null)
                {
                    <div class="cl-alert red" style="margin:14px;"><Icon Name="alert" Size="15" /><span>@_error</span></div>
                }
                else if (filtradas.Count == 0)
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="clipboardCheck" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">
                            @(Pendientes.Count == 0 ? "Sin solicitudes pendientes por revisar" : "Sin solicitudes en este filtro")
                        </div>
                        <div style="font-size:12px;">
                            @(Pendientes.Count == 0
                                ? "Cuando existan solicitudes registradas, en revision u observadas, apareceran aqui."
                                : "Ajusta la busqueda o limpia los filtros.")
                        </div>
                    </div>
                }
            </div>
        </div>
        <Pagination Total="filtradas.Count" @bind-Page="_pagina" />
    </ChildContent>
</AppShell>

@code {
    private const string TabPendientes = "Pendientes";
    private string _tab = TabPendientes;
    private string _query = "";
    private string _distrito = "";
    private string _agente = "";
    private int _pagina = 1;
    private bool _cargando = true;
    private string? _error;

    private IReadOnlyList<SolicitudAlquilerDto> Todas = [];
    private List<SolicitudAlquilerDto> Pendientes => Todas.Where(EsPendientePorRevisar).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Todas = await SolicitudSvc.RefrescarAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cargando = false;
        }
    }

    private string[] _estados => Pendientes
        .Select(s => s.Estado)
        .Distinct()
        .OrderBy(OrdenEstado)
        .ThenBy(x => x)
        .ToArray();

    private IReadOnlyList<string> _distritos => Pendientes.Select(s => s.DistritoLocal)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();

    private IReadOnlyList<string> _agentes => Pendientes.Select(s => s.AgenteNombre)
        .Where(a => !string.IsNullOrWhiteSpace(a)).Distinct().OrderBy(x => x).ToList();

    private int CuentaEstado(string estado) => Pendientes.Count(s => s.Estado == estado);

    private Tabs.TabItem[] _tabs => new[] { new Tabs.TabItem(TabPendientes, Pendientes.Count) }
        .Concat(_estados.Select(e => new Tabs.TabItem(e, CuentaEstado(e))))
        .ToArray();

    private bool HayFiltros => _tab != TabPendientes
        || !string.IsNullOrWhiteSpace(_query)
        || !string.IsNullOrWhiteSpace(_distrito)
        || !string.IsNullOrWhiteSpace(_agente);

    private void CambiarTab(string tab)
    {
        _tab = string.IsNullOrWhiteSpace(tab) ? TabPendientes : tab;
        _pagina = 1;
    }

    private void LimpiarFiltros()
    {
        _tab = TabPendientes;
        _query = "";
        _distrito = "";
        _agente = "";
        _pagina = 1;
    }

    private IEnumerable<SolicitudAlquilerDto> Filtradas() => Pendientes.Where(s =>
        (_tab == TabPendientes || s.Estado == _tab) &&
        (string.IsNullOrEmpty(_distrito) || s.DistritoLocal == _distrito) &&
        (string.IsNullOrEmpty(_agente) || s.AgenteNombre == _agente) &&
        (string.IsNullOrEmpty(_query) || Coincide(s, _query)));

    private async Task ExportarCsv()
    {
        await Exportar.DescargarCsvAsync("solicitudes_por_revisar",
            new[] { "Solicitud", "Operacion", "Agente", "Cliente", "Local", "Distrito", "Monto mensual USD", "Plazo (meses)", "Documentos", "Fecha", "Estado" },
            Filtradas().Select(s => (IReadOnlyList<string?>)new[]
            {
                s.CodigoSolicitud, s.CodigoOperacion, s.AgenteNombre, s.ClienteNombre, s.DireccionLocal,
                s.DistritoLocal, s.MontoMensualTexto, s.PlazoMeses.ToString(), s.DocumentosTexto,
                s.FechaRegistroTexto, s.Estado,
            }));
    }

    private static bool EsPendientePorRevisar(SolicitudAlquilerDto solicitud)
    {
        var estado = NormalizarEstado(solicitud.Estado);
        return estado is "EN REVISION" or "OBSERVADA" or "E" or "O";
    }

    private static bool Coincide(SolicitudAlquilerDto s, string q) =>
        TextoFiltro.Contiene(s.CodigoSolicitud, q)
        || TextoFiltro.Contiene(s.ClienteNombre, q)
        || TextoFiltro.Contiene(s.DireccionLocal, q)
        || TextoFiltro.Contiene(s.CodigoOperacion, q)
        || TextoFiltro.Contiene(s.AgenteNombre, q);

    private static string TonoEstado(string estado) => NormalizarEstado(estado) switch
    {
        "EN REVISION" or "E" => "blue",
        "OBSERVADA" or "O" => "amber",
        _ => "blue",
    };

    private static string IconoEstado(string estado) => NormalizarEstado(estado) switch
    {
        "OBSERVADA" or "O" => "alert",
        "EN REVISION" or "E" => "clock",
        _ => "fileText",
    };

    private static int OrdenEstado(string estado) => NormalizarEstado(estado) switch
    {
        "EN REVISION" or "E" => 0,
        "OBSERVADA" or "O" => 1,
        _ => 9,
    };

    private static string NormalizarEstado(string? estado) =>
        (estado ?? "")
            .Trim()
            .ToUpperInvariant()
            .Replace("Á", "A")
            .Replace("É", "E")
            .Replace("Í", "I")
            .Replace("Ó", "O")
            .Replace("Ú", "U");

    private static string Txt(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "-" : valor;
}
