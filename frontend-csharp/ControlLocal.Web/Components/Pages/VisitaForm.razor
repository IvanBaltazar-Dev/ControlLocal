@page "/visita-form"
@page "/visita-form/{OportunidadIdParam:long}"
@inject AppState App
@inject IVisitaService VisitaSvc
@inject IOportunidadService OportunidadSvc
@using System.Globalization
@using ControlLocal.Web.Models.Oportunidades
@using ControlLocal.Web.Models.Visitas

<PageTitle>Programar visita · ControlLocal</PageTitle>

<AppShell Active="Visitas" Crumbs="@(new[] { "ControlLocal", "Operación", "Visitas", "Programar visita" })"
          Title="Programar visita"
          Subtitle="Agenda la visita de una oportunidad comercial existente">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("visitas"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 250px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Oportunidad comercial" Sub="La oportunidad relaciona al cliente con la captación">
                    <Field Label="Oportunidad" Required="true">
                        <select @bind="_oportunidadId">
                            <option value="0">— Seleccionar —</option>
                            @foreach (var oportunidad in OportunidadSvc.All()
                                .Where(item => item.Estado is "Abierta" or "Solicitud creada"))
                            {
                                <option value="@oportunidad.Id">@oportunidad.CodigoOportunidad · @oportunidad.CaptacionCodigo · @oportunidad.ClienteNombre</option>
                            }
                        </select>
                    </Field>
                    @if (OportunidadSeleccionada is not null)
                    {
                        <div class="cl-grid c2" style="margin-top:12px;">
                            <Field Label="Local"><input value="@OportunidadSeleccionada.DireccionLocal" disabled /></Field>
                            <Field Label="Cliente"><input value="@OportunidadSeleccionada.ClienteNombre" disabled /></Field>
                        </div>
                    }
                </FormSection>

                <FormSection Num="2" Title="Fecha y hora" Sub="Cuándo se realizará la visita al local">
                    <div class="cl-grid c2">
                        <Field Label="Fecha" Required="true"><input type="date" @bind="_fecha" /></Field>
                        <Field Label="Hora" Required="true"><input type="time" @bind="_hora" /></Field>
                        <Field Label="Acompaña"><input value="@(App.CurrentUser?.Nombre ?? "Agente en sesión")" disabled /></Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Notas" Sub="Indicaciones opcionales para la visita">
                    <Field Label="Observaciones">
                        <textarea rows="3" placeholder="Indicaciones para la visita..." @bind="_observaciones"></textarea>
                    </Field>
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("visitas"))" OnSave="@TryConfirm" SaveLabel="Programar visita" />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>La visita queda en estado <b>Programada</b> y conserva la misma oportunidad, cliente y captación.</span>
                </div>
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="calendar"
                       Title="¿Programar la visita?"
                       Desc="@DescripcionConfirmacion"
                       ConfirmLabel="Programar" CancelLabel="Revisar datos"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">Visita programada correctamente</Toast>
    </ChildContent>
</AppShell>

@code {
    [Parameter] public long OportunidadIdParam { get; set; }

    private long _oportunidadId;
    private DateOnly? _fecha;
    private TimeOnly? _hora;
    private string _observaciones = "";
    private bool _confirm;
    private bool _toast;
    private string? _err;

    private OportunidadComercialDto? OportunidadSeleccionada => OportunidadSvc.ById(_oportunidadId);
    private string DescripcionConfirmacion => OportunidadSeleccionada is null
        ? "Revisa los datos de la visita."
        : $"Se agendará la visita de {OportunidadSeleccionada.ClienteNombre} para el {FormatFecha(_fecha)} a las {FormatHora(_hora)}.";

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Oportunidad", "Cliente y captación", _oportunidadId > 0),
        new FormStepsSidebar.Step("Fecha y hora", "Cuándo se visita", _fecha is not null && _hora is not null),
        new FormStepsSidebar.Step("Notas", "Indicaciones opcionales", true),
    };

    protected override void OnInitialized()
    {
        if (OportunidadIdParam > 0)
            _oportunidadId = OportunidadIdParam;
    }

    private static string FormatFecha(DateOnly? fecha) =>
        fecha?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "";

    private static string FormatHora(TimeOnly? hora) =>
        hora?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "";

    private void TryConfirm()
    {
        if (OportunidadSeleccionada is null) { _err = "Debes seleccionar una oportunidad comercial válida."; return; }
        if (_fecha is null || _hora is null) { _err = "La fecha y la hora de la visita son obligatorias."; return; }
        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        _confirm = false;
        try
        {
            VisitaSvc.Programar(new VisitaFormRequest
            {
                OportunidadId = _oportunidadId,
                FechaTexto = FormatFecha(_fecha),
                HoraTexto = FormatHora(_hora),
                Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones.Trim(),
            });
        }
        catch (InvalidOperationException error)
        {
            _err = error.Message;
            return;
        }

        _toast = true;
        StateHasChanged();
        await Task.Delay(300);
        App.Navigate("visitas");
    }
}
