@page "/visita-form"
@inject AppState App
@inject IVisitaService VisitaSvc
@inject ICaptacionService CaptacionSvc
@inject IClienteService ClienteSvc
@using System.Globalization
@using ControlLocal.Web.Models.Visitas

<PageTitle>Programar visita · ControlLocal</PageTitle>

<AppShell Active="Visitas" Crumbs="@(new[] { "ControlLocal", "Operación", "Visitas", "Programar visita" })"
          Title="Programar visita"
          Subtitle="Coordina la visita de un cliente interesado a un local de tus captaciones activas">
    <Actions>
        <button class="cl-btn ghost" @onclick="@(() => App.Navigate("visitas"))"><Icon Name="chevronLeft" Size="13" /> Volver</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:1fr 250px;gap:14px;">
            <div>
                <FormSection Num="1" Title="Captación y cliente" Sub="Qué local se visita y quién es el cliente interesado">
                    <div class="cl-grid c2">
                        <Field Label="Captación / local" Required="true">
                            <select @bind="_captacionCodigo">
                                <option value="">— Seleccionar captación —</option>
                                @foreach (var c in CaptacionSvc.All().Where(c => c.Estado == "Activa"))
                                {
                                    <option value="@c.CodigoCaptacion">@c.CodigoCaptacion · @c.DireccionLocal (@c.DistritoLocal)</option>
                                }
                            </select>
                        </Field>
                        <Field Label="Cliente interesado" Required="true">
                            <div style="display:flex;gap:8px;">
                                <select @bind="_clienteNombre" style="flex:1;">
                                    <option value="">— Seleccionar cliente —</option>
                                    @foreach (var cli in ClienteSvc.All().Where(c => c.Estado == "Activo"))
                                    {
                                        <option value="@cli.Nombre">@cli.Nombre</option>
                                    }
                                </select>
                                <button class="cl-btn ghost" style="flex:0 0 auto;" title="Registrar nuevo cliente" @onclick="@(() => App.Navigate("cliente-form"))">
                                    <Icon Name="plus" Size="14" />
                                </button>
                            </div>
                        </Field>
                    </div>
                </FormSection>

                <FormSection Num="2" Title="Fecha y hora" Sub="Cuándo se realizará la visita al local">
                    <div class="cl-grid c2">
                        <Field Label="Fecha" Required="true"><input type="date" @bind="_fecha" /></Field>
                        <Field Label="Hora" Required="true"><input type="time" @bind="_hora" /></Field>
                        <Field Label="Acompaña" Hint="El agente en sesión acompaña la visita"><input value="Valentina Mora (tú)" disabled /></Field>
                    </div>
                </FormSection>

                <FormSection Num="3" Title="Notas" Sub="Indicaciones para la visita (opcional)">
                    <Field Label="Observaciones">
                        <textarea rows="3" placeholder="Indicaciones para la visita…" @bind="_observaciones" @bind:event="oninput"></textarea>
                    </Field>
                </FormSection>

                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-bottom:14px;">
                        <Icon Name="alert" Size="15" /><span>@_err</span>
                    </div>
                }

                <FormFooterBar OnCancel="@(() => App.Navigate("visitas"))" OnSave="@TryConfirm" SaveLabel="Programar visita" />
            </div>

            <div class="cl-stack">
                <FormStepsSidebar Steps="_pasos" />
                <div class="cl-alert blue">
                    <Icon Name="info" Size="15" />
                    <span>La visita queda en estado <b>Programada</b>. Desde la agenda podrás reprogramarla, cancelarla o registrar su resultado.</span>
                </div>
            </div>
        </div>

        <ConfirmDialog Open="_confirm" Tone="blue" Icon="calendar"
                       Title="¿Programar la visita?"
                       Desc="@($"Se agendará la visita de {_clienteNombre} para el {FormatFecha(_fecha)} a las {FormatHora(_hora)}.")"
                       ConfirmLabel="Programar" CancelLabel="Revisar datos"
                       OnClose="@(() => _confirm = false)"
                       OnConfirm="@OnConfirm" />
        <Toast Show="_toast">Visita programada correctamente</Toast>
    </ChildContent>
</AppShell>

@code {
    private string _captacionCodigo = "";
    private string _clienteNombre = "";
    private DateOnly? _fecha;
    private TimeOnly? _hora;
    private string _observaciones = "";

    private bool _confirm;
    private bool _toast;
    private string? _err;

    // Progreso interactivo de las secciones del formulario.
    private bool IsStep1Complete => !string.IsNullOrWhiteSpace(_captacionCodigo) && !string.IsNullOrWhiteSpace(_clienteNombre);
    private bool IsStep2Complete => _fecha is not null && _hora is not null;
    private bool IsStep3Complete => !string.IsNullOrWhiteSpace(_observaciones);

    private IReadOnlyList<FormStepsSidebar.Step> _pasos => new[]
    {
        new FormStepsSidebar.Step("Captación y cliente", "Local y cliente", IsStep1Complete),
        new FormStepsSidebar.Step("Fecha y hora", "Cuándo se visita", IsStep2Complete),
        new FormStepsSidebar.Step("Notas", "Indicaciones (opcional)", IsStep3Complete),
    };

    // El contrato REST viaja como texto; formateamos los selectores al confirmar
    // (espeja Visitas.razor para mantener un único formato de fecha/hora).
    private static string FormatFecha(DateOnly? f) =>
        f?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "";
    private static string FormatHora(TimeOnly? h) =>
        h?.ToString("HH:mm", CultureInfo.InvariantCulture) ?? "";

    private void TryConfirm()
    {
        if (string.IsNullOrWhiteSpace(_captacionCodigo)) { _err = "Debes seleccionar una captación."; return; }
        if (string.IsNullOrWhiteSpace(_clienteNombre)) { _err = "Debes seleccionar un cliente interesado."; return; }
        if (_fecha is null || _hora is null) { _err = "La fecha y la hora de la visita son obligatorias."; return; }

        _err = null;
        _confirm = true;
    }

    private async Task OnConfirm()
    {
        _confirm = false;
        try
        {
            VisitaSvc.Programar(new VisitaFormRequest
            {
                CaptacionCodigo = _captacionCodigo,
                ClienteNombre = _clienteNombre,
                FechaTexto = FormatFecha(_fecha),
                HoraTexto = FormatHora(_hora),
                Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones,
            });
        }
        catch (InvalidOperationException ex)
        {
            _err = ex.Message;
            return;
        }

        _toast = true;
        StateHasChanged();
        await Task.Delay(900);
        App.Navigate("visitas");
    }
}
