@page "/visitas"
@inherits SafeComponentBase
@inject AppState App
@inject IVisitaService VisitaSvc

<PageTitle>Visitas · ControlLocal</PageTitle>

<AppShell Active="Visitas" Crumbs="@(new[] { "ControlLocal", "Operación", "Visitas" })"
          Title="Agenda de visitas"
          Subtitle="Visitas a locales coordinadas con tus clientes interesados">
    <Actions>
        @*IMPLEMENTACION PROXIMAMENTE*@
        @*<button class="cl-btn"><Icon Name="download" Size="13" /> Exportar agenda</button>*@
        <button class="cl-btn primary" @onclick="@(() => App.Navigate("visita-form"))"><Icon Name="plus" Size="13" /> Programar visita</button>
    </Actions>
    <ChildContent>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;">
            <MetricCard Icon="calendar" Label="Programadas" Value="@Contar("P").ToString()" Tone="blue"
                        Active="@(_filtroEstado == "P")" OnClick="@(() => ToggleEstado("P"))" />
            <MetricCard Icon="check" Label="Realizadas" Value="@Contar("R").ToString()" Tone="green"
                        Active="@(_filtroEstado == "R")" OnClick="@(() => ToggleEstado("R"))" />
            <MetricCard Icon="clock" Label="Reprogramadas" Value="@Contar("G").ToString()" Tone="blue"
                        Active="@(_filtroEstado == "G")" OnClick="@(() => ToggleEstado("G"))" />
            <MetricCard Icon="x" Label="Canceladas" Value="@Contar("C").ToString()" Tone="red"
                        Active="@(_filtroEstado == "C")" OnClick="@(() => ToggleEstado("C"))" />
        </div>

        <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:14px;margin-bottom:14px;">
            <div class="cl-card">
                <div class="cl-card-head">
                    <div class="cl-card-title">Mayo 2026</div>
                    <div class="cl-flex" style="gap:6px;">
                        <button class="cl-btn sm ghost"><Icon Name="chevronLeft" Size="13" /></button>
                        <button class="cl-btn sm ghost"><Icon Name="arrowRight" Size="13" /></button>
                    </div>
                </div>
                <div class="cl-card-body">
                    <div style="display:grid;grid-template-columns:repeat(7,1fr);gap:4px;">
                        @foreach (var d in _dow)
                        {
                            <div style="text-align:center;font-size:10px;font-weight:600;color:#7E8794;padding:4px 0;">@d</div>
                        }
                        @for (var i = 0; i < _offset; i++)
                        {
                            <div></div>
                        }
                        @for (var day = 1; day <= 31; day++)
                        {
                            var hasVisit = _visitDays.Contains(day);
                            var isToday = day == 28;
                            var bg = isToday ? "background:var(--c-primary-50);border-color:var(--c-primary);" : "";
                            <div style="aspect-ratio:1;border:1px solid #E2E6EC;border-radius:7px;padding:5px;display:flex;flex-direction:column;@bg">
                                <span style="font-size:11px;@(isToday ? "font-weight:700;color:var(--c-primary);" : "color:#515B6B;")">@day</span>
                                @if (hasVisit)
                                {
                                    <span style="margin-top:auto;align-self:flex-start;width:6px;height:6px;border-radius:50%;background:var(--c-primary);"></span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="cl-card">
                <div class="cl-card-head"><div class="cl-card-title">Próximas visitas</div><span class="cl-badge blue">@_proximas.Length</span></div>
                <div class="cl-card-body">
                    @if (_proximas.Length > 0)
                    {
                        <Timeline Items="_proximas" />
                    }
                    else
                    {
                        <div class="cl-muted" style="font-size:12px;">No hay visitas pendientes en agenda.</div>
                    }
                </div>
            </div>
        </div>

        <FilterBar Search="Buscar por cliente, local, captación, agente…"
                   @bind-Value="_query" ResultCount="VisitasFiltradas().Count()"
                   HasActiveFilters="HayFiltros" OnClear="LimpiarFiltros">
            <FilterSelect Placeholder="Distrito" Options="_distritos" @bind-Value="_distrito" />
        </FilterBar>

        <div class="cl-card">
            <div class="cl-card-body" style="padding:0;">
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th>Fecha</th><th>Hora</th><th>Captación</th><th>Cliente</th>
                            <th>Local</th><th>Distrito</th><th>Agente</th><th>Estado / Resultado</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in VisitasFiltradas())
                        {
                            <tr>
                                <td><span style="font-size:12px;">@v.FechaTexto</span></td>
                                <td><span class="mono">@v.HoraTexto</span></td>
                                <td><span class="mono">@v.CodigoCaptacion</span></td>
                                <td style="font-weight:600;">@v.ClienteNombre</td>
                                <td>@v.DireccionLocal</td>
                                <td>@v.DistritoLocal</td>
                                <td>@v.NombreAgente</td>
                                <td>
                                    <StatusBadge Label="@EnumCatalog.LabelFor(EnumCatalog.EstadosVisita, v.Estado)" />
                                    @if (!string.IsNullOrEmpty(v.Resultado))
                                    {
                                        <div style="margin-top:4px;"><ResultadoBadge Resultado="@v.Resultado" /></div>
                                    }
                                    @if (!string.IsNullOrEmpty(v.Observaciones))
                                    {
                                        <div class="cl-muted" style="font-size:11px;margin-top:3px;">@v.Observaciones</div>
                                    }
                                </td>
                                <td>
                                    <div class="cl-flex" style="gap:6px;justify-content:flex-end;">
                                        @if (EsModificable(v))
                                        {
                                            <button class="cl-btn sm primary" @onclick="@(() => AbrirResultado(v))"><Icon Name="check" Size="12" /> Resultado</button>
                                            <button class="cl-btn sm" @onclick="@(() => AbrirReprogramar(v))"><Icon Name="clock" Size="12" /> Reprogramar</button>
                                            <button class="cl-btn sm ghost" @onclick="@(() => AbrirCancelar(v))"><Icon Name="x" Size="12" /> Cancelar</button>
                                        }
                                        <button class="cl-btn sm ghost" @onclick="@(() => App.Navigate($"oportunidad-detail/{v.OportunidadId}"))">Seguimiento</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!VisitasFiltradas().Any())
                {
                    <div style="padding:40px;text-align:center;color:#7E8794;">
                        <Icon Name="calendar" Size="28" style="margin-bottom:10px;" />
                        <div style="font-weight:600;margin-bottom:4px;">Sin visitas en este filtro</div>
                        <div style="font-size:12px;">Programa una visita o cambia el filtro de estado.</div>
                    </div>
                }
            </div>
        </div>

        @* ---------- Modal: Reprogramar ---------- *@
        <Modal Open="_modalReprogramar" Tone="blue" Icon="clock"
               Title="Reprogramar visita"
               Desc="@($"Mueve la fecha y hora de la visita con {_target?.ClienteNombre}.")"
               OnClose="@(() => _modalReprogramar = false)">
            <ChildContent>
                <div class="cl-grid c2">
                    <Field Label="Nueva fecha" Required="true"><input type="date" @bind="_fechaPick" /></Field>
                    <Field Label="Nueva hora" Required="true"><input type="time" @bind="_horaPick" /></Field>
                </div>
                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" @onclick="@(() => _modalReprogramar = false)">Cancelar</button>
                <button class="cl-btn primary" @onclick="ConfirmarReprogramar">Reprogramar</button>
            </Footer>
        </Modal>

        @* ---------- Modal: Cancelar ---------- *@
        <Modal Open="_modalCancelar" Tone="red" Icon="x"
               Title="Cancelar visita"
               Desc="@($"Cancela la visita con {_target?.ClienteNombre}. Esta acción es definitiva.")"
               OnClose="@(() => _modalCancelar = false)">
            <ChildContent>
                <Field Label="Motivo de la cancelación" Required="true">
                    <textarea rows="3" placeholder="Ej. El cliente no podrá asistir…" @bind="_motivoTmp"></textarea>
                </Field>
                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" @onclick="@(() => _modalCancelar = false)">Volver</button>
                <button class="cl-btn primary" @onclick="ConfirmarCancelar">Cancelar visita</button>
            </Footer>
        </Modal>

        @* ---------- Modal: Registrar resultado ---------- *@
        <Modal Open="_modalResultado" Tone="green" Icon="check"
               Title="Registrar resultado de la visita"
               Desc="@($"Marca la visita con {_target?.ClienteNombre} como realizada y registra su desenlace.")"
               OnClose="@(() => _modalResultado = false)">
            <ChildContent>
                <Field Label="Resultado" Required="true">
                    <select @bind="_resultadoTmp">
                        <option value="">— Seleccionar resultado —</option>
                        <option value="I">Interesado</option>
                        <option value="S">Seguimiento</option>
                        <option value="N">No interesado</option>
                        <option value="D">Descartado</option>
                    </select>
                </Field>
                <div style="margin-top:12px;">
                    <Field Label="Observaciones"><textarea rows="2" placeholder="Detalle de lo conversado en la visita…" @bind="_obsTmp"></textarea></Field>
                </div>
                @if (ImplicaNoContinuidad(_resultadoTmp))
                {
                    <div style="margin-top:12px;">
                        <Field Label="Motivo de no continuidad" Required="true">
                            <select @bind="_razonTmp">
                                <option value="">— Seleccionar motivo —</option>
                                @foreach (var m in EnumCatalog.MotivosNoContinuidad)
                                {
                                    <option value="@m.Code">@m.Label</option>
                                }
                            </select>
                        </Field>
                    </div>
                    <div class="cl-alert blue" style="margin-top:12px;">
                        <Icon Name="info" Size="15" />
                        <span>El cliente <b>no continúa</b>: al registrar se guardará el motivo y la <b>oportunidad se cerrará</b> automáticamente.</span>
                    </div>
                }
                else if (MantieneAbierta(_resultadoTmp))
                {
                    <div class="cl-alert blue" style="margin-top:12px;">
                        <Icon Name="info" Size="15" />
                        <span>La oportunidad permanece <b>abierta</b> para seguimiento.</span>
                    </div>
                }
                @if (_err is not null)
                {
                    <div class="cl-alert red" style="margin-top:12px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
                }
            </ChildContent>
            <Footer>
                <button class="cl-btn ghost" @onclick="@(() => _modalResultado = false)">Cancelar</button>
                <button class="cl-btn primary" @onclick="ConfirmarResultado">Registrar resultado</button>
            </Footer>
        </Modal>

        <Toast Show="_toast">@_toastMsg</Toast>
    </ChildContent>
</AppShell>

@code {
    private readonly string[] _dow = { "L", "M", "M", "J", "V", "S", "D" };
    private const int _offset = 4; // 01/05/2026 cae viernes (lunes = 0)
    private int[] _visitDays = Array.Empty<int>();
    private Timeline.TimelineItem[] _proximas = Array.Empty<Timeline.TimelineItem>();

    // Estado de modales y acción en curso. Programar una visita vive en su propia
    // página (visita-form); aquí solo quedan las acciones por fila de la agenda.
    private bool _modalReprogramar, _modalCancelar, _modalResultado;
    private VisitaDto? _target;
    private DateOnly? _fechaPick;
    private TimeOnly? _horaPick;
    private string _motivoTmp = "", _resultadoTmp = "", _obsTmp = "", _razonTmp = "";
    private string? _err;

    // El contrato REST viaja como texto; formateamos los selectores al confirmar.
    private static string FormatFecha(DateOnly? f) =>
        f?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    private static string FormatHora(TimeOnly? h) =>
        h?.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "";

    private bool _toast;
    private string _toastMsg = "";

    private string _filtroEstado = "";

    protected override void OnInitialized() => Recalcular();

    private int Contar(string estado) => VisitaSvc.All().Count(v => v.Estado == estado);

    private static bool EsModificable(VisitaDto v) => v.Estado is "P" or "G";

    private static bool ImplicaNoContinuidad(string codigo) => codigo is "N" or "D";
    private static bool MantieneAbierta(string codigo) => codigo is "I" or "S" or "P";

    private string _query = "";
    private string _distrito = "";

    private IReadOnlyList<string> _distritos => VisitaSvc.All().Select(v => v.DistritoLocal)
        .Where(d => !string.IsNullOrWhiteSpace(d)).Distinct().OrderBy(x => x).ToList();

    private bool HayFiltros => !string.IsNullOrEmpty(_filtroEstado) || !string.IsNullOrEmpty(_query) || !string.IsNullOrEmpty(_distrito);

    private void LimpiarFiltros() { _filtroEstado = ""; _query = ""; _distrito = ""; }

    private void ToggleEstado(string code) => _filtroEstado = _filtroEstado == code ? "" : code;

    private IEnumerable<VisitaDto> VisitasFiltradas() =>
        VisitaSvc.All().Where(v =>
            (string.IsNullOrEmpty(_filtroEstado) || v.Estado == _filtroEstado) &&
            (string.IsNullOrEmpty(_distrito) || v.DistritoLocal == _distrito) &&
            (string.IsNullOrEmpty(_query) || Coincide(v, _query)));

    private static bool Coincide(VisitaDto v, string q) =>
        (v.ClienteNombre?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (v.DireccionLocal?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (v.CodigoCaptacion?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
        || (v.NombreAgente?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);

    // Recalcula la agenda (calendario + próximas) a partir de las visitas vivas.
    private void Recalcular()
    {
        var vivas = VisitaSvc.All().Where(EsModificable).ToList();
        _proximas = vivas
            .Select(v => new Timeline.TimelineItem(
                $"{v.FechaTexto} · {v.HoraTexto}", v.ClienteNombre, $"{v.DireccionLocal} · {v.CodigoCaptacion}"))
            .ToArray();
        _visitDays = vivas
            .Select(v => DiaDe(v.FechaTexto))
            .Where(d => d > 0)
            .Distinct()
            .ToArray();
    }

    // Extrae el día del mes de un texto "24 May 2026" o ISO "2026-05-24".
    private static int DiaDe(string fechaTexto)
    {
        if (string.IsNullOrWhiteSpace(fechaTexto)) return 0;
        var iso = fechaTexto.Split('-');
        if (iso.Length == 3 && iso[0].Length == 4 && int.TryParse(iso[2], out var dIso)) return dIso;
        var token = fechaTexto.Split(' ', '/').FirstOrDefault();
        return int.TryParse(token, out var d) ? d : 0;
    }

    private void AbrirReprogramar(VisitaDto v)
    {
        _target = v;
        _fechaPick = null; _horaPick = null; _err = null;
        _modalReprogramar = true;
    }

    private void AbrirCancelar(VisitaDto v)
    {
        _target = v;
        _motivoTmp = ""; _err = null;
        _modalCancelar = true;
    }

    private void AbrirResultado(VisitaDto v)
    {
        _target = v;
        _resultadoTmp = ""; _obsTmp = ""; _razonTmp = ""; _err = null;
        _modalResultado = true;
    }

    private void ConfirmarReprogramar()
    {
        if (_target is null) return;
        try
        {
            VisitaSvc.Reprogramar(_target.Id, FormatFecha(_fechaPick), FormatHora(_horaPick));
            _modalReprogramar = false;
            Recalcular();
            Notificar("Visita reprogramada correctamente.");
        }
        catch (InvalidOperationException ex) { _err = ex.Message; }
    }

    private void ConfirmarCancelar()
    {
        if (_target is null) return;
        try
        {
            VisitaSvc.Cancelar(_target.Id, _motivoTmp);
            _modalCancelar = false;
            Recalcular();
            Notificar("Visita cancelada.");
        }
        catch (InvalidOperationException ex) { _err = ex.Message; }
    }

    private void ConfirmarResultado()
    {
        if (_target is null) return;
        try
        {
            VisitaSvc.RegistrarResultado(_target.Id, _resultadoTmp, _obsTmp, _razonTmp);
            _modalResultado = false;
            Recalcular();
            var msg = ImplicaNoContinuidad(_resultadoTmp)
                ? "Resultado registrado. Motivo de no continuidad guardado y oportunidad cerrada."
                : "Resultado registrado. La oportunidad sigue en seguimiento.";
            Notificar(msg);
        }
        catch (InvalidOperationException ex) { _err = ex.Message; }
    }

    private void Notificar(string mensaje)
    {
        _toastMsg = mensaje;
        _toast = true;
        _ = DelayThenRenderAsync(2600, () => _toast = false);
    }
}
