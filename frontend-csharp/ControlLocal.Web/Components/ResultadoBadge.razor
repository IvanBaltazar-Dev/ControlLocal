@if (!string.IsNullOrEmpty(Resultado))
{
    var (tone, label) = Resultado switch
    {
        "I" or "INTERESADO" or "CONTACTADO" or "ACEPTA_CAPTAR" or "LISTO_PARA_PUBLICAR"
            or "BUSQUEDA_LEVANTADA" => ("green", Label),
        "VISITA_AGENDADA" or "REUNION_AGENDADA" or "OFERTA_SOLICITADA" or "DOCS_SOLICITADOS"
            or "PUBLICACION_COORDINADA" or "PROPUESTA_ENVIADA" => ("blue", Label),
        "S" or "SEGUIMIENTO" or "NEGOCIANDO" or "CONDICIONES_AJUSTADAS" or "RECONTACTAR"
            or "REQUIERE_OPCIONES" or "PROPIETARIO_OBSERVA" => ("blue", Label),
        "N" or "NO_INTERESADO" or "NO_ACEPTA" or "NO_RESPONDE" => ("red", Label),
        "D" or "DESCARTADO" or "PAUSAR_GESTION" => ("gray", Label),
        "P" => ("gray", "Pendiente"),
        _ => ("gray", Label)
    };

    <StatusBadge Label="@label" ToneOverride="@tone" />
}

@code {
    [Parameter]
    public string Resultado { get; set; } = string.Empty;

    [Parameter]
    public string Contexto { get; set; } = string.Empty;

    private string Label => EnumCatalog.LabelResultadoInteraccion(Contexto, Resultado);
}
