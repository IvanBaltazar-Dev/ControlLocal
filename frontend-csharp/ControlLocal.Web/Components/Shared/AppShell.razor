@* App shell — sidebar + topbar + page frame. Wraps every authenticated screen. *@
@inject AppState App
@inject NavigationManager Nav
<div class="cl-app">
    <Sidebar Active="@Active" Role="@App.Role" Route="@CurrentRoute" />
    <div class="cl-main">
        <Topbar Role="@App.Role" />
        @if (Page)
        {
            <div class="cl-page">
                @if (Crumbs is { Length: > 0 })
                {
                    <Breadcrumbs Items="@BuildBreadcrumbs()" />
                }
                @if (!string.IsNullOrEmpty(Title) || Actions != null)
                {
                    <div class="cl-page-head">
                        <div>
                            @if (!string.IsNullOrEmpty(Title))
                            {
                                <div class="cl-page-title">@Title</div>
                            }
                            @if (!string.IsNullOrEmpty(Subtitle))
                            {
                                <div class="cl-page-sub">@Subtitle</div>
                            }
                        </div>
                        @if (Actions != null)
                        {
                            <div class="cl-page-actions">@Actions</div>
                        }
                    </div>
                }
                @ChildContent
            </div>
        }
        else
        {
            @ChildContent
        }
    </div>
</div>

@code {
    [Parameter] public string? Active { get; set; }
    [Parameter] public string[]? Crumbs { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Page { get; set; } = true;

    private BreadcrumbItem[] BuildBreadcrumbs()
    {
        if (Crumbs is null || Crumbs.Length == 0)
            return [];

        return Crumbs.Select((label, index) =>
        {
            var isLast = index == Crumbs.Length - 1;

            if (isLast)
                return new BreadcrumbItem(label);

            var route = label switch
            {
                "ControlLocal" => "dashboard",
                "Brokers" => "brokers",
                "Agentes" => "agents",
                "Captaciones" => "captaciones",
                "Clientes" => "clientes",
                "Locales" => "locales",
                "Solicitudes" => "solicitudes",
                "Oportunidades" => "oportunidades",
                "Reportes" => "reportes",
                _ => null
            };

            return new BreadcrumbItem(label, route);
        }).ToArray();
    }

    private string CurrentRoute
    {
        get
        {
            var rel = Nav.ToBaseRelativePath(Nav.Uri);
            var path = rel.Split('?', '#')[0].Trim('/');
            return string.IsNullOrEmpty(path) ? "dashboard" : path.Split('/')[0];
        }
    }
}