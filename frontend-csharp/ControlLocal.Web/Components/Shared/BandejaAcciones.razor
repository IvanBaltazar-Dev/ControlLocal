@* Lista de acciones pendientes del agente. Superficie reutilizable (dashboard + modal "ver todas").
   El motor abstracto (TareaBusinessLogic.bandejaDe) es la fuente; este solo renderiza y enruta. *@
@inject AppState App

@if (Tareas.Count == 0)
{
    <div style="padding:30px 26px;text-align:center;color:#5B6472;">
        <div style="font-size:30px;line-height:1;margin-bottom:10px;">✅</div>
        <div style="font-weight:700;font-size:14px;margin-bottom:3px;color:var(--c-text);">¡Todo al día! No tienes acciones pendientes</div>
        <div style="font-size:12px;max-width:380px;margin:0 auto;">Aquí aparecerán solas cuando el flujo lo requiera: recontactos vencidos, solicitudes por cerrar, documentos observados, comisiones por cobrar, visitas próximas y reportes al propietario.</div>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:8px;">
        @foreach (var t in Tareas)
        {
            <div class="cl-flex" style="align-items:center;gap:12px;padding:10px 12px;border:1px solid var(--c-border);border-radius:10px;">
                <span class="cl-badge @PrioridadTono(t.Prioridad)" style="flex:0 0 auto;">@PrioridadLabel(t.Prioridad)</span>
                <div style="flex:1;min-width:0;">
                    <div style="font-weight:600;">@Titulo(t)</div>
                    <div class="cl-flex cl-muted" style="font-size:12px;gap:8px;flex-wrap:wrap;align-items:center;">
                        <span>@EntidadLabel(t.EntidadTipo)@(string.IsNullOrWhiteSpace(t.EntidadCodigo) ? "" : $" · {t.EntidadCodigo}")</span>
                        <span>· @DiasTexto(t.DiasSinAccion)</span>
                        @if (t.FechaVencimiento is not null)
                        {
                            <span class="cl-badge @(Vencida(t.FechaVencimiento) ? "red" : "gray")" style="font-size:11px;">@VencimientoTexto(t.FechaVencimiento)</span>
                        }
                    </div>
                </div>
                <div class="cl-flex" style="gap:6px;flex:0 0 auto;">
                    <button class="cl-btn sm primary" @onclick="@(() => App.Navigate(RutaResolver(t)))"><Icon Name="arrowDownRight" Size="12" /> Resolver</button>
                    <button class="cl-btn sm ghost" @onclick="@(() => OnCancelar.InvokeAsync(t))"><Icon Name="x" Size="12" /> Cancelar</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<TareaDto> Tareas { get; set; } = [];
    [Parameter] public EventCallback<TareaDto> OnCancelar { get; set; }

    // El backend ya calcula la ruta EXACTA al item que disparó la tarea (resuelve id-vs-código por
    // tipo). Preferimos esa; el switch queda solo como fallback defensivo si llegara vacía.
    private static string RutaResolver(TareaDto t) =>
        !string.IsNullOrWhiteSpace(t.RutaResolver) ? t.RutaResolver : RutaFallback(t);

    private static string RutaFallback(TareaDto t) => t.EntidadTipo switch
    {
        "PROSPECCION" => $"prospeccion-detail/{t.EntidadId}",
        "CLIENTE_INTERESADO" => $"cliente-detail/{t.EntidadId}",
        "PROPIETARIO" => $"owner-detail/{t.EntidadId}",
        "SOLICITUD_ALQUILER" => string.IsNullOrEmpty(t.EntidadCodigo) ? $"solicitud-detail/{t.EntidadId}" : $"solicitud-detail/{t.EntidadCodigo}",
        "CAPTACION" => string.IsNullOrEmpty(t.EntidadCodigo) ? "captaciones" : $"captacion-detail/{t.EntidadCodigo}",
        "CONTRATO_ALQUILER" => "comisiones",
        "VISITA" => $"visitas?focus={t.EntidadId}",
        "OPORTUNIDAD" => $"oportunidad-detail/{t.EntidadId}",
        _ => "dashboard",
    };

    // Texto de la acción que el agente debe resolver, en lenguaje claro. El backend ya genera
    // descripciones legibles ("Documentos observados: subsana la solicitud."); solo sustituimos las
    // técnicas heredadas del seed ("Accion CAR-2026 SUBIR_DOCUMENTOS para SOLICITUD_ALQUILER 415.")
    // por una instrucción entendible derivada del tipo de tarea. El código de la entidad aparece
    // en la línea de contexto de abajo, así que aquí no hace falta repetirlo.
    private static string Titulo(TareaDto t)
    {
        var desc = t.Descripcion?.Trim() ?? "";
        if (desc.Length > 0
            && !desc.StartsWith("Accion ", StringComparison.OrdinalIgnoreCase)
            && !desc.StartsWith("Acción ", StringComparison.OrdinalIgnoreCase))
            return desc;

        return t.Tipo switch
        {
            "RECONTACTO" => "Recontacta al propietario: registra una interacción, crea la captación o descártala con un motivo.",
            "SUBIR_DOCUMENTOS" => "Sube los documentos observados y vuelve a enviar la solicitud a revisión.",
            "ENVIAR_REVISION" => "Envía la captación a revisión del bróker.",
            "REPORTE_PROPIETARIO" => "Reporta al propietario los avances de su captación.",
            "PROPONER_OPORTUNIDAD" => "Propón una propiedad compatible de tu cartera al cliente interesado.",
            "REGISTRAR_CAPTACION" => "Registra la captación pendiente.",
            "REGISTRAR_INTERACCION" => "Registra la interacción pendiente.",
            "VISITA" => "Gestiona la visita: confírmala, reprográmala o registra su resultado.",
            "SEGUIMIENTO" => t.EntidadTipo switch
            {
                "SOLICITUD_ALQUILER" => "Cierra la solicitud aprobada para generar el contrato de alquiler.",
                "CONTRATO_ALQUILER" => "Registra el cobro de la comisión (ya tiene el monto del agente asignado).",
                _ => "Da seguimiento a esta oportunidad.",
            },
            _ => "Revisa y resuelve esta acción pendiente.",
        };
    }

    private static string EntidadLabel(string entidadTipo) => entidadTipo switch
    {
        "PROSPECCION" => "Prospección",
        "SOLICITUD_ALQUILER" => "Solicitud de alquiler",
        "CONTRATO_ALQUILER" => "Contrato / comisión",
        "CAPTACION" => "Captación",
        "OPORTUNIDAD" => "Oportunidad",
        "VISITA" => "Visita",
        "CLIENTE_INTERESADO" => "Cliente interesado",
        "PROPIETARIO" => "Propietario",
        _ => entidadTipo,
    };

    private static string PrioridadLabel(string prioridad) => prioridad switch
    {
        "ALTA" => "Alta",
        "MEDIA" => "Media",
        _ => "Baja",
    };

    private static string PrioridadTono(string prioridad) => prioridad switch
    {
        "ALTA" => "red",
        "MEDIA" => "amber",
        _ => "gray",
    };

    private static string FechaTexto(DateTime? fecha) => fecha?.ToString("dd MMM yyyy") ?? "-";

    // "Días sin acción": cuántos días lleva la operación esperando atención.
    private static string DiasTexto(int? dias) => dias switch
    {
        null => "sin registro",
        <= 0 => "sin demora",
        1 => "1 día sin acción",
        _ => $"{dias} días sin acción",
    };

    private static bool Vencida(DateTime? fecha) => fecha is not null && fecha.Value.Date < DateTime.Today;

    // Vencimiento: rojo si ya pasó, gris si está por venir.
    private static string VencimientoTexto(DateTime? fecha)
    {
        if (fecha is null)
            return "";
        var dias = (DateTime.Today - fecha.Value.Date).Days;
        return dias switch
        {
            > 0 => $"venció hace {dias} d",
            0 => "vence hoy",
            _ => $"vence {fecha.Value:dd MMM}",
        };
    }
}
