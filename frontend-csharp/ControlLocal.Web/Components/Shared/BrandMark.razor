@* Reusable logo glyph (storefront-shaped square). Variants: primary / light / dark / ghost / walnut. *@
<div style="width:@(Size)px;height:@(Size)px;border-radius:@(R)px;background:@P.Bg;color:@P.Fg;display:grid;place-items:center;font-weight:700;font-size:@(Math.Round(Size*0.42))px;letter-spacing:-0.02em;position:relative;@(Variant == "light" ? "border:1px solid #E5E0D7;" : "")flex:0 0 @(Size)px;">
    <div style="position:absolute;inset:@(Inset)px;border:1.5px solid @P.Ring;border-radius:@(Math.Max(2, R - Inset + 2))px;"></div>
    <svg width="@(Math.Round(Size*0.5))" height="@(Math.Round(Size*0.5))" viewBox="0 0 24 24" style="position:relative;z-index:1;">
        <path d="M6 11 L12 6 L18 11 L18 18 L13 18 L13 14 L11 14 L11 18 L6 18 Z" fill="none" stroke="@P.Fg" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
    </svg>
</div>

@code {
    [Parameter] public double Size { get; set; } = 36;
    [Parameter] public string Variant { get; set; } = "primary";
    [Parameter] public double? Radius { get; set; }

    private record Palette(string Bg, string Ring, string Fg);

    private static readonly Dictionary<string, Palette> Palettes = new()
    {
        ["primary"] = new("#2C5CA0", "rgba(255,255,255,0.45)", "#fff"),
        ["light"] = new("#fff", "rgba(14,91,255,0.35)", "#2C5CA0"),
        ["dark"] = new("#221F1B", "rgba(255,255,255,0.30)", "#fff"),
        ["ghost"] = new("transparent", "rgba(14,91,255,0.4)", "#2C5CA0"),
        ["walnut"] = new("#BB6C43", "rgba(255,255,255,0.5)", "#fff"),
    };

    private Palette P => Palettes.TryGetValue(Variant, out var p) ? p : Palettes["primary"];
    private double R => Radius ?? Math.Max(6, Math.Round(Size * 0.25));
    private double Inset => Math.Max(4, Math.Round(Size * 0.16));
}
