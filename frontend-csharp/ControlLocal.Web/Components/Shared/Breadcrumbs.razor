@* Migas de pan navegables — el último elemento representa la página actual. *@
@inject AppState App

<div class="cl-breadcrumbs">
    @for (var i = 0; i < Items.Length; i++)
    {
        var item = Items[i];
        var isLast = i == Items.Length - 1;

        if (i > 0)
        {
            <Icon Name="chevronRight" Size="11" Color="#C7C0B4" />
        }

        @if (!isLast && !string.IsNullOrWhiteSpace(item.Route))
        {
            <button type="button"
                    class="cl-breadcrumb-link"
                    @onclick="@(() => App.Navigate(item.Route))">
                @item.Label
            </button>
        }
        else
        {
            <span class="@(isLast ? "here" : "")">@item.Label</span>
        }
    }
</div>

@code {
    [Parameter] public BreadcrumbItem[] Items { get; set; } = [];
}