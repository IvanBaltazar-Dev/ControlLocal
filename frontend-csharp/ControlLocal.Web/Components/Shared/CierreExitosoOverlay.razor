@* Overlay premium de "cierre exitoso" — marca el fin del proceso de forma
   dinámica. Lo reutilizan el cierre de captación (broker) y el cierre de trato
   (agente). Reusa los keyframes de controllocal.css; no requiere librerías. *@

@if (Open)
{
    <div class="cl-success" role="dialog" aria-modal="true" aria-label="@Title">
        <div class="cl-confetti" aria-hidden="true">
            @foreach (var pieza in _confetti)
            {
                <i style="left:@(pieza.Left)%;background:@pieza.Color;animation-duration:@(pieza.Dur.ToString(Inv))s;animation-delay:@(pieza.Delay.ToString(Inv))s;"></i>
            }
        </div>

        <div class="cl-success-card">
            <div>
                <div class="cl-success-check"><Icon Name="@Icon" Size="42" /></div>
                <span class="cl-success-eyebrow"><Icon Name="check" Size="12" /> @Eyebrow</span>
            </div>
            <h2 class="cl-success-title">@Title</h2>
            <p class="cl-success-sub">@Subtitle</p>

            @if (!string.IsNullOrWhiteSpace(Confirmacion))
            {
                <div class="cl-success-confirm">
                    <Icon Name="check" Size="13" /> @Confirmacion
                </div>
            }

            @if (Resumen is { Count: > 0 })
            {
                <div class="cl-success-summary">
                    @foreach (var fila in Resumen)
                    {
                        <div class="cl-success-row">
                            <span class="k">
                                @if (!string.IsNullOrEmpty(fila.Icono))
                                {
                                    <Icon Name="@fila.Icono" Size="13" />
                                }
                                @fila.Etiqueta
                            </span>
                            <span class="v @(fila.Destacado ? "big" : "")">@fila.Valor</span>
                        </div>
                    }
                </div>
            }

            @if (Acciones is not null)
            {
                <div class="cl-success-actions">@Acciones</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Icon { get; set; } = "checkCircle";
    [Parameter] public string Eyebrow { get; set; } = "Proceso completado";
    [Parameter] public string Title { get; set; } = "¡Cierre exitoso!";
    [Parameter] public string Subtitle { get; set; } = "";
    // Línea de confirmación clara y breve (qué quedó hecho / a quién se notificó).
    [Parameter] public string? Confirmacion { get; set; }
    [Parameter] public IReadOnlyList<Fila>? Resumen { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }

    private static readonly System.Globalization.CultureInfo Inv =
        System.Globalization.CultureInfo.InvariantCulture;

    // Fila del resumen del cierre (etiqueta + valor, con icono opcional y énfasis).
    public sealed record Fila(string Etiqueta, string Valor, string? Icono = null, bool Destacado = false);

    private readonly Pieza[] _confetti = BuildConfetti();
    private sealed record Pieza(int Left, string Color, double Dur, double Delay);

    // Piezas de confeti deterministas (sin Math.random, seguro en prerender).
    private static Pieza[] BuildConfetti()
    {
        var colores = new[] { "#005BFF", "#1F9D6B", "#00AEEF", "#FACC15", "#FF7A59" };
        var piezas = new Pieza[20];
        for (var i = 0; i < piezas.Length; i++)
        {
            var left = (i * 53 + 7) % 100;
            var color = colores[i % colores.Length];
            var dur = 2.6 + (i % 5) * 0.5;
            var delay = (i % 7) * 0.35;
            piezas[i] = new Pieza(left, color, dur, delay);
        }
        return piezas;
    }
}
