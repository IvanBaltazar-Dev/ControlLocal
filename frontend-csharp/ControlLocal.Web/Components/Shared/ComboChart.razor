@* Histograma de cierres sobre captaciones + linea de conversion.
   Las barras y etiquetas son HTML por columnas (nitidas y siempre alineadas);
   la linea de conversion es un overlay SVG en coordenadas porcentuales. *@
<div class="cl-combo">
    <div class="cl-combo-head">
        @if (TieneTotales)
        {
            <div><span class="cl-combo-dot ghost"></span><span>@TotalsLabel</span></div>
        }
        <div><span class="cl-combo-dot bars"></span><span>@BarsLabel</span></div>
        @if (Line.Length > 0)
        {
            <div><span class="cl-combo-dot line"></span><span>@LineLabel</span></div>
        }
        @if (IndicePico >= 0)
        {
            <div class="cl-combo-peak">Máxima cantidad de cierres @($"{Bars[IndicePico]:0}")</div>
        }
    </div>

    <div class="cl-combo-plot" style="--cl-combo-h:@(PlotH)px;">
        <div class="cl-combo-axis">
            <span>@($"{MaxEscala:0}")</span>
            <span>@($"{MaxEscala / 2:0}")</span>
            <span>0</span>
        </div>
        <div class="cl-combo-stage">
            <div class="cl-combo-grid">
                <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="cl-combo-cols">
                @for (var i = 0; i < Bars.Length; i++)
                {
                    var esPico = i == IndicePico;
                    <div class="cl-combo-col">
                        <div class="cl-combo-track" title="@Tooltip(i)">
                            @if (TieneTotales)
                            {
                                <div class="cl-combo-ghost" style="height:@FP(Pct(GhostValor(i)))%;"></div>
                            }
                            <div class="cl-combo-bar @(esPico ? "is-peak" : "")" style="height:@FP(Pct(Bars[i]))%;"></div>
                            @if (Bars[i] > 0)
                            {
                                <span class="cl-combo-barval" style="bottom:@FP(Pct(Bars[i]))%;">@($"{Bars[i]:0}")</span>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (Line.Length > 0)
            {
                <svg class="cl-combo-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    <polyline points="@LinePoints" fill="none" stroke="@LineColor" stroke-width="2.4"
                              stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                </svg>
                @for (var i = 0; i < Line.Length && i < Bars.Length; i++)
                {
                    <span class="cl-combo-pt" style="left:@FP(Xpc(i))%;bottom:@FP(PctLinea(i))%;border-color:@LineColor;" title="@Tooltip(i)"></span>
                }
            }
        </div>
    </div>

    <div class="cl-combo-labels">
        <div></div>
        <div class="cl-combo-labels-track">
            @for (var i = 0; i < Bars.Length; i++)
            {
                var mostrar = i < Labels.Length && PasoEtiqueta > 0 && i % PasoEtiqueta == 0;
                <div class="@(i == IndicePico ? "is-peak" : "")">@(mostrar ? Labels[i] : "")</div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public double[] Bars { get; set; } = [];        // serie principal (cierres) — barra solida
    [Parameter] public double[] Totals { get; set; } = [];      // denominador (captaciones) — barra "fantasma" detras
    [Parameter] public double[] Line { get; set; } = [];        // conversion % (0..100)
    [Parameter] public string[] Labels { get; set; } = [];
    [Parameter] public int Height { get; set; } = 180;
    [Parameter] public string LineColor { get; set; } = "#0F766E";
    [Parameter] public string BarsLabel { get; set; } = "Cierres";
    [Parameter] public string TotalsLabel { get; set; } = "Captaciones";
    [Parameter] public string LineLabel { get; set; } = "Conversion";

    private int PlotH => Height;
    private bool TieneTotales => Totals.Length > 0;

    private double GhostValor(int i) => i < Totals.Length ? Totals[i] : 0;

    // Escala de las barras con "aire" para que quepan las etiquetas de valor sobre el pico,
    // tomando el mayor entre cierres y captaciones (asi la barra fantasma entra completa).
    private double MaxEscala
    {
        get
        {
            var maxBar = Bars.Length == 0 ? 0 : Bars.Max();
            var maxTot = Totals.Length == 0 ? 0 : Totals.Max();
            var bruto = Math.Max(maxBar, maxTot);
            if (bruto <= 0) return 1;
            var conAire = bruto * 1.15;
            var paso = conAire <= 5 ? 1 : conAire <= 20 ? 2 : conAire <= 50 ? 5 : 10;
            return Math.Ceiling(conAire / paso) * paso;
        }
    }

    private double Pct(double v) => Math.Clamp(v / MaxEscala * 100.0, 0, 100);
    private double Xpc(int i) => Bars.Length == 0 ? 0 : (i + 0.5) / Bars.Length * 100.0;
    private double PctLinea(int i) => Math.Clamp(i < Line.Length ? Line[i] : 0, 0, 100);

    private int PasoEtiqueta => Labels.Length == 0 ? 0 : Math.Max(1, (int)Math.Ceiling(Labels.Length / 9.0));

    private int IndicePico
    {
        get
        {
            if (Bars.Length == 0 || Bars.Max() <= 0) return -1;
            var idx = 0;
            for (var i = 1; i < Bars.Length; i++)
                if (Bars[i] > Bars[idx]) idx = i;
            return idx;
        }
    }

    private string LinePoints => string.Join(" ", Line.Take(Bars.Length).Select((v, i) =>
        $"{F(Xpc(i))},{F(100 - Math.Clamp(v, 0, 100))}"));

    private string Tooltip(int i)
    {
        var label = i < Labels.Length ? Labels[i] : $"Periodo {i + 1}";
        var cierres = i < Bars.Length ? Bars[i] : 0;
        var convText = i < Line.Length ? $" · {Line[i]:0}% conversion" : "";
        if (TieneTotales)
        {
            var caps = GhostValor(i);
            return $"{label}: {cierres:0} cierres de {caps:0} captaciones{convText}";
        }
        return $"{label}: {cierres:0} cierres{convText}";
    }

    // Porcentaje para estilos inline: siempre con punto decimal (cultura invariante).
    private static string FP(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string F(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
