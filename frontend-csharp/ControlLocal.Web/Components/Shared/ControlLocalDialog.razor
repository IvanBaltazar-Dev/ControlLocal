@inject IJSRuntime JS
@implements IAsyncDisposable

<dialog class="cl-dialog" @ref="_dialog">
    <div class="cl-dialog-head">
        <div>
            <div class="cl-dialog-title">@Title</div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="cl-dialog-subtitle">@Subtitle</div>
            }
        </div>
        <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseAsync"></button>
    </div>
    <div class="cl-dialog-body">
        @ChildContent
    </div>
</dialog>

@code {
    private ElementReference _dialog;

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    public async Task ShowAsync()
    {
        await JS.InvokeVoidAsync("controlLocalDialog.show", _dialog);
    }

    public async Task CloseAsync()
    {
        await JS.InvokeVoidAsync("controlLocalDialog.close", _dialog);
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
