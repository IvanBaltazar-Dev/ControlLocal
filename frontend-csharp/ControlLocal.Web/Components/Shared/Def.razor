@* Par de etiqueta y valor para vistas de detalle. *@
<div class="cl-def-item">
    <div class="cl-def-k">@K</div>
    <div class="cl-def-v">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @V
        }
    </div>
</div>

@code {
    [Parameter] public string? K { get; set; }
    [Parameter] public string? V { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
