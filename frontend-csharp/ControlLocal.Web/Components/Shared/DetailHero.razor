@* Cabecera "hero" reutilizable para vistas de detalle / ficha.
   Patrón común: eyebrow + título + subtítulo + badge de estado + chips de métricas
   y una zona de acciones. Pensada para reemplazar la cabecera plana de las pantallas detail. *@
<div class="cl-hero">
    <div class="cl-hero-top">
        <div style="min-width:0;">
            @if (!string.IsNullOrEmpty(Eyebrow))
            {
                <div class="cl-hero-eyebrow">
                    @if (!string.IsNullOrEmpty(EyebrowIcon))
                    {
                        <Icon Name="@EyebrowIcon" Size="13" />
                    }
                    @Eyebrow
                </div>
            }
            <div class="cl-hero-title">@Title</div>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <div class="cl-hero-sub">
                    @if (!string.IsNullOrEmpty(SubtitleIcon))
                    {
                        <Icon Name="@SubtitleIcon" Size="14" />
                    }
                    @Subtitle
                </div>
            }
        </div>
        <div class="cl-hero-actions">
            @if (!string.IsNullOrEmpty(Status))
            {
                <span class="cl-hero-badge">@Status</span>
            }
            @Actions
        </div>
    </div>

    @if (Stats is { Count: > 0 })
    {
        <div class="cl-hero-stats">
            @foreach (var s in Stats)
            {
                <div class="cl-hero-stat">
                    <div class="cl-hero-stat-k">@s.Label</div>
                    <div class="cl-hero-stat-v">@s.Value @if (!string.IsNullOrEmpty(s.Unit)) { <small>@s.Unit</small> }</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? EyebrowIcon { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? SubtitleIcon { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public List<Stat>? Stats { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    public record Stat(string Label, string Value, string? Unit = null);
}
