@* Visor de documentos del expediente. Si hay un archivo almacenado (Url), lo
   incrusta en línea (PDF/imagen); si no, muestra solo la ficha de metadatos. *@
<Modal Open="Open" Tone="blue" Icon="fileText" Size="lg"
       Title="@Nombre"
       Desc="Documento del expediente."
       OnClose="OnClose">
    <ChildContent>
        @if (!string.IsNullOrEmpty(Url) && Incrustable)
        {
            <iframe src="@Url" title="@Nombre"
                    style="width:100%;height:60vh;border:1px solid var(--c-border);border-radius:8px;background:#fff;"></iframe>
        }
        else if (!string.IsNullOrEmpty(Url))
        {
            <div class="cl-alert blue">
                <Icon Name="info" Size="15" />
                <span>Este tipo de archivo no se puede previsualizar en línea. Usa «Descargar» para abrirlo.</span>
            </div>
        }
        else
        {
            <div class="cl-alert blue">
                <Icon Name="info" Size="15" />
                <span>Aún no hay un archivo cargado para previsualizar. Sube el documento desde «Gestionar documentos».</span>
            </div>
        }

        <dl class="cl-kv" style="margin-top:12px;">
            <dt>Documento</dt><dd style="font-weight:600;">@Nombre</dd>
            @if (!string.IsNullOrEmpty(Estado))
            {
                <dt>Estado</dt><dd><StatusBadge Label="@Estado" /></dd>
            }
            <dt>Expediente</dt><dd>@(string.IsNullOrEmpty(Expediente) ? "—" : Expediente)</dd>
            <dt>Última revisión</dt><dd>@(string.IsNullOrEmpty(Actualizado) ? "—" : Actualizado)</dd>
        </dl>
        @if (!string.IsNullOrEmpty(Nota))
        {
            <div class="cl-alert blue" style="margin-top:12px;">
                <Icon Name="info" Size="15" /><span>@Nota</span>
            </div>
        }
    </ChildContent>
    <Footer>
        @if (!string.IsNullOrEmpty(Url))
        {
            <a class="cl-btn" href="@Url" target="_blank" rel="noopener"><Icon Name="download" Size="13" /> Descargar</a>
        }
        <button class="cl-btn primary" @onclick="OnClose">Cerrar</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Nombre { get; set; } = "";
    [Parameter] public string Estado { get; set; } = "";
    [Parameter] public string Expediente { get; set; } = "";
    [Parameter] public string Actualizado { get; set; } = "";
    [Parameter] public string? Nota { get; set; }
    // URL del contenido real (/documento?clave=...). Vacía = solo metadatos.
    [Parameter] public string? Url { get; set; }
    // true cuando el archivo es PDF o imagen y se puede incrustar en el iframe.
    [Parameter] public bool Incrustable { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
}
