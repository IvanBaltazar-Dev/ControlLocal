@* Selector de tipo de documento que se adapta al tipo de persona.
   Natural → DNI / Carné de extranjería / Pasaporte. Jurídica → RUC.
   Usa los códigos del backend (EnumCatalog.TiposDocumentoIdentidad): D/C/P/R. *@

<Field Label="Tipo de documento" Required="true">
    <select value="@SelectedDocType" disabled="@Disabled" @onchange="HandleChange">
        <option value="">— Seleccionar —</option>
        @foreach (var opt in Opciones())
        {
            <option value="@opt.Code">@opt.Label</option>
        }
    </select>
</Field>

@code {
    [Parameter] public string PersonType { get; set; } = "natural";
    [Parameter] public string SelectedDocType { get; set; } = "";
    [Parameter] public EventCallback<string> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string Tipo => (PersonType ?? "natural").ToLowerInvariant();

    private IEnumerable<EnumOption> Opciones() => Tipo == "natural"
        ? EnumCatalog.TiposDocumentoIdentidad.Where(o => o.Code is "D" or "C" or "P")
        : EnumCatalog.TiposDocumentoIdentidad.Where(o => o.Code == "R");

    private async Task HandleChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        // Rechazo silencioso de combinaciones incoherentes.
        if ((Tipo == "natural" && val == "R") || (Tipo == "juridica" && val is not ("" or "R"))) return;
        await OnChange.InvokeAsync(val);
    }
}
