@* Donut chart built from stroke-dasharray arc segments. *@
<svg width="@Size" height="@Size" viewBox="0 0 @Size @Size">
    <circle cx="@F(C)" cy="@F(C)" r="@F(R)" stroke="#E2E6EC" stroke-width="@Thickness" fill="none" />
    @{
        double offset = 0;
        var circ = 2 * System.Math.PI * R;
    }
    @foreach (var s in Segments)
    {
        var len = (s.Value / Sum) * circ;
        var dash = $"{F(len)} {F(circ - len)}";
        var off = F(-offset);
        <circle cx="@F(C)" cy="@F(C)" r="@F(R)" stroke="@s.Color" stroke-width="@Thickness"
                fill="none" stroke-dasharray="@dash" stroke-dashoffset="@off"
                transform="rotate(-90 @F(C) @F(C))" />
        offset += len;
    }
    @if (!string.IsNullOrWhiteSpace(CenterValue))
    {
        <g>
            <text x="@F(C)" y="@F(C)" text-anchor="middle" dominant-baseline="central"
                  font-size="@F(Size / 4.2)" font-weight="800" fill="#243043">@CenterValue</text>
            <text x="@F(C)" y="@F(C + Size / 4.4)" text-anchor="middle" dominant-baseline="central"
                  font-size="@F(Size / 12.0)" fill="#7E8794">@CenterLabel</text>
        </g>
    }
</svg>

@code {
    public record Segment(double Value, string Color, string? Label = null);

    [Parameter] public Segment[] Segments { get; set; } = System.Array.Empty<Segment>();
    [Parameter] public int Size { get; set; } = 130;
    [Parameter] public int Thickness { get; set; } = 22;
    [Parameter] public double? Total { get; set; }
    [Parameter] public string? CenterValue { get; set; }
    [Parameter] public string? CenterLabel { get; set; }

    private double R => (Size - Thickness) / 2.0;
    private double C => Size / 2.0;
    private double Sum
    {
        get
        {
            var s = Total ?? Segments.Sum(x => x.Value);
            return s == 0 ? 1 : s;
        }
    }

    private static string F(double d) => d.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
