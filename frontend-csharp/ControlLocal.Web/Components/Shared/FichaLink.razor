@* Boton premium para abrir la ficha comercial de un propietario o cliente.
   Reemplaza los enlaces <a href> por navegacion interactiva (App.Navigate),
   manteniendo el estilo corporativo del sistema. *@
@inject AppState App

@if (Id is > 0)
{
    @if (Variant == "button")
    {
        <button type="button" class="cl-btn sm @Class" title="@Title" @onclick="Abrir">
            <Icon Name="@Icono" Size="12" /> @Display
        </button>
    }
    else
    {
        <button type="button" class="cl-ficha-link @Class" title="@Title" @onclick="Abrir">
            <Icon Name="@Icono" Size="12" />
            <span>@Display</span>
        </button>
    }
}
else if (Variant != "button")
{
    <span class="cl-muted">@Fallback</span>
}

@code {
    [Parameter] public string Kind { get; set; } = "owner"; // owner | cliente
    [Parameter] public long? Id { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public string Variant { get; set; } = "inline"; // inline (chip) | button (cl-btn)
    [Parameter] public string? Class { get; set; }

    private bool EsCliente => string.Equals(Kind, "cliente", StringComparison.OrdinalIgnoreCase);
    private string Icono => EsCliente ? "user" : "user";
    private string Title => EsCliente ? "Ver ficha del cliente" : "Ver ficha del propietario";
    private string Ruta => (EsCliente ? "cliente-detail/" : "owner-detail/") + Id;

    private string Display => string.IsNullOrWhiteSpace(Text) || Text == "-"
        ? (EsCliente ? "Ver cliente" : "Ver propietario")
        : Text!;

    private string Fallback => string.IsNullOrWhiteSpace(Text) || Text == "-" ? "No registrado" : Text!;

    private void Abrir() => App.Navigate(Ruta);
}
