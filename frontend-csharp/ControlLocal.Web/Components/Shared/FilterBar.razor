@* Barra de filtros — búsqueda (two-way), filtros secundarios (ChildContent),
   contador de resultados, limpiar y exportar (cuando la pantalla lo provee). *@
@using System.Threading
@implements IDisposable
<div class="cl-filterbar">
    <input class="cl-input search" placeholder="@Search" style="width:280px;"
           value="@Value" @oninput="OnInput" />
    @ChildContent
    @if (OnClear.HasDelegate && HasActiveFilters)
    {
        <button class="cl-btn sm ghost" @onclick="OnClear" title="Limpiar filtros"><Icon Name="x" Size="12" /> Limpiar</button>
    }
    <div style="margin-left:auto;display:flex;align-items:center;gap:12px;">
        @if (ResultCount is not null)
        {
            <span class="cl-muted" style="font-size:12px;white-space:nowrap;">@ResultCount resultado@(ResultCount == 1 ? "" : "s")</span>
        }
        @if (Tail != null)
        {
            @Tail
        }
        else if (OnExport.HasDelegate)
        {
            <button class="cl-btn sm" @onclick="OnExport"><Icon Name="download" Size="13" /> Exportar</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Search { get; set; } = "Buscar…";

    // Texto de búsqueda (two-way: usar @bind-Value).
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    // Contador de resultados y limpieza de filtros (opcionales).
    [Parameter] public int? ResultCount { get; set; }
    [Parameter] public bool HasActiveFilters { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }

    // Exporta el resultado filtrado actual; el botón solo aparece si hay handler.
    [Parameter] public EventCallback OnExport { get; set; }

    [Parameter] public RenderFragment? Tail { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Antirebote de la búsqueda (ms). 0 = inmediato (por defecto, ideal para filtrado en memoria).
    // En pantallas con paginación en el servidor conviene 250–350 ms para no llamar al API por tecla.
    [Parameter] public int DebounceMs { get; set; }

    private CancellationTokenSource _debounceCts = new();

    private async Task OnInput(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString() ?? "";
        if (DebounceMs <= 0)
        {
            await ValueChanged.InvokeAsync(valor);
            return;
        }
        _debounceCts.Cancel();
        _debounceCts.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        try
        {
            await Task.Delay(DebounceMs, token);
            await ValueChanged.InvokeAsync(valor);
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        _debounceCts.Cancel();
        _debounceCts.Dispose();
    }
}
