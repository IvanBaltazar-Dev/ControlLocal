@* Un paso del formulario con círculo interactivo: vacío si falta, resaltado si
   es el paso actual, verde con check cuando se completa. *@

<div class="form-progress-step @(IsCurrent ? "current" : "") @(IsComplete ? "complete" : "")">
    <div class="step-circle">
        @if (IsComplete)
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        }
        else
        {
            <span>@StepNumber</span>
        }
    </div>
    <div class="step-content">
        <div class="step-title">@Title</div>
        <div class="step-description">@Description</div>
    </div>
</div>

<style>
.form-progress-step {
    display: flex;
    gap: 12px;
    padding: 10px;
    border-radius: 6px;
    transition: all 0.2s ease;
}

.form-progress-step.current {
    background-color: rgba(59, 130, 246, 0.06);
}

.form-progress-step.complete {
    opacity: 0.75;
}

.step-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    min-width: 30px;
    border-radius: 50%;
    font-weight: 600;
    font-size: 13px;
    border: 2px solid #ddd;
    color: #666;
    background: white;
    transition: all 0.3s ease;
}

.form-progress-step.current .step-circle {
    border-color: #3b82f6;
    background: #eff6ff;
    color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.form-progress-step.complete .step-circle {
    border-color: #10b981;
    background: #10b981;
    color: white;
}

.step-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.step-title {
    font-weight: 500;
    font-size: 13.5px;
    color: #111;
    margin-bottom: 1px;
}

.step-description {
    font-size: 11.5px;
    color: #666;
    line-height: 1.35;
}

.form-progress-step.current .step-title {
    color: #3b82f6;
}

.form-progress-step.complete .step-title {
    color: #10b981;
}
</style>

@code {
    [Parameter] public int StepNumber { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public bool IsComplete { get; set; }
    [Parameter] public bool IsCurrent { get; set; }
}
