@* Numbered form section with title/subtitle and a body grid. *@
<section class="cl-form-section">
    <div class="cl-form-section-head">
        <div class="cl-form-section-num">@Num</div>
        <div style="flex:1">
            <div class="cl-form-section-title">@Title</div>
            @if (!string.IsNullOrEmpty(Sub))
            {
                <div class="cl-form-section-sub">@Sub</div>
            }
        </div>
        @Foot
    </div>
    <div class="cl-form-section-body">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Num { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Sub { get; set; }
    [Parameter] public RenderFragment? Foot { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
