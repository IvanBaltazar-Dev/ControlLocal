@* Medidor de anillo: muestra un porcentaje (0-100) con relleno proporcional y el
   número grande en el centro. Se usa para la tasa de cierre ("Cierres por etapa"):
   qué parte de las captaciones llegó al cierre. *@
<svg width="@Size" height="@Size" viewBox="0 0 @Size @Size">
    <circle cx="@F(C)" cy="@F(C)" r="@F(R)" stroke="#E9ECF2" stroke-width="@Thickness" fill="none" />
    <circle cx="@F(C)" cy="@F(C)" r="@F(R)" stroke="@Color" stroke-width="@Thickness" fill="none"
            stroke-linecap="round" stroke-dasharray="@Dash" stroke-dashoffset="0"
            transform="rotate(-90 @F(C) @F(C))" />
    <text x="@F(C)" y="@F(C)" text-anchor="middle" dominant-baseline="central"
          font-size="@F(Size / 4.0)" font-weight="800" fill="#243043">@PctClamped<tspan font-size="@F(Size / 8.0)">%</tspan></text>
    <text x="@F(C)" y="@F(C + Size / 4.6)" text-anchor="middle" dominant-baseline="central"
          font-size="@F(Size / 11.5)" fill="#7E8794">@Label</text>
</svg>

@code {
    [Parameter] public int Pct { get; set; }
    [Parameter] public string Label { get; set; } = "cerradas";
    [Parameter] public int Size { get; set; } = 130;
    [Parameter] public int Thickness { get; set; } = 16;
    [Parameter] public string Color { get; set; } = "#16A34A";

    private int PctClamped => Math.Clamp(Pct, 0, 100);
    private double R => (Size - Thickness) / 2.0;
    private double C => Size / 2.0;
    private double Circ => 2 * System.Math.PI * R;

    private string Dash
    {
        get
        {
            var len = PctClamped / 100.0 * Circ;
            return $"{F(len)} {F(Circ - len)}";
        }
    }

    private static string F(double d) => d.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
