@* KPI metric card with optional icon, delta and footer. Clicable (OnClick) puede
   actuar como atajo de filtro; Active resalta el KPI seleccionado. *@
<div class="cl-metric @(OnClick.HasDelegate ? "cl-metric-clickable" : "")" @onclick="OnClick" style="@_style">
    <div class="cl-metric-row">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <div class="cl-metric-icon" style="background:@T.Bg;color:@T.Color;">
                <Icon Name="@Icon" Size="16" />
            </div>
        }
        <div class="cl-metric-label">@Label</div>
    </div>
    <div class="cl-metric-value">@Value</div>
    @if (!string.IsNullOrEmpty(Delta))
    {
        <div class="cl-metric-delta @DeltaDir">
            <Icon Name="@DeltaIcon" Size="11" />
            @Delta
        </div>
    }
    @if (!string.IsNullOrEmpty(Footer))
    {
        <div style="font-size:11px;color:#7E8794;margin-top:6px;">@Footer</div>
    }
</div>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Delta { get; set; }
    [Parameter] public string DeltaDir { get; set; } = "up";
    [Parameter] public string Tone { get; set; } = "blue";
    [Parameter] public string? Footer { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Active { get; set; }

    private string _style =>
        (OnClick.HasDelegate ? "cursor:pointer;" : "")
        + (Active ? "outline:2px solid #005BFF;outline-offset:-2px;box-shadow:0 0 0 4px rgba(0,91,255,0.08);" : "");

    private record ToneStyle(string Bg, string Color);

    // Tonos vívidos: verde = positivo, ámbar = precaución, rojo = descartado/negativo,
    // azul = en proceso, info = informativo, gris = neutro.
    private static readonly Dictionary<string, ToneStyle> Tones = new()
    {
        ["blue"] = new("#E4EEFF", "#0A57E7"),
        ["green"] = new("#DDF5E5", "#0E9F4E"),
        ["gray"] = new("#EEF1F6", "#5A6472"),
        ["red"] = new("#FCE4E1", "#E0322B"),
        ["info"] = new("#DEF3FB", "#0398D6"),
        ["amber"] = new("#FEEFD2", "#E08A00"),
        ["navy"] = new("#E5ECFB", "#1E3A8A"),
    };

    private ToneStyle T => Tones.TryGetValue(Tone, out var t) ? t : Tones["blue"];

    private string DeltaIcon => DeltaDir switch
    {
        "up" => "arrowUpRight",
        "down" => "arrowDownRight",
        _ => "arrowRight",
    };
}
