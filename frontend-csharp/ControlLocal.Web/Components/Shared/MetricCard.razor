<div class="cl-metric premium">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <div class="cl-metric-label">@Label</div>
            <div class="cl-metric-value">@Value</div>
        </div>
        <div class="cl-metric-icon @Tone">@Icon</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Footer))
    {
        <div class="cl-metric-foot">@Footer</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Footer { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "•";
    [Parameter] public string Tone { get; set; } = "blue";
}
