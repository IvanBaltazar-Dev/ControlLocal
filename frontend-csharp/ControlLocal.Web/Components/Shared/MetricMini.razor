<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;border:1px solid #E2E6EC;border-radius:8px;background:#fff;">
    <div class="cl-flex" style="gap:8px;min-width:0;">
        <Icon Name="@Icon" Size="15" />
        <span style="font-size:12px;color:var(--c-text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@Label</span>
    </div>
    <strong style="font-size:14px;">@Value</strong>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Icon { get; set; } = "activity";
}
