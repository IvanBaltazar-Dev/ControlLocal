@* Contador de resultados + selector de página (two-way: usar @bind-Page). *@
<div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:12px;color:#515B6B;">
    <span>Mostrando @ShownFrom–@ShownTo de @Total resultados</span>
    <div style="display:flex;gap:4px;">
        <button class="cl-btn sm" disabled="@(PaginaActual == 1)" @onclick="@(() => Ir(PaginaActual - 1))"><Icon Name="chevronLeft" Size="12" /></button>
        
        @foreach (var p in ObtenerPaginas())
        {
            if (p < 0)
            {
                <button class="cl-btn sm" disabled>…</button>
            }
            else
            {
                <button class="@(PaginaActual == p ? "cl-btn sm primary" : "cl-btn sm")" @onclick="@(() => Ir(p))">@p</button>
            }
        }
        
        <button class="cl-btn sm" disabled="@(PaginaActual == LastPage || LastPage == 0)" @onclick="@(() => Ir(PaginaActual + 1))"><Icon Name="chevronRight" Size="12" /></button>
    </div>
</div>

@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int PageSize { get; set; } = Paginador.TamanoPagina;
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private int LastPage => Math.Max(1, (int)Math.Ceiling(Total / (double)PageSize));
    private int PaginaActual => Math.Clamp(Page, 1, LastPage);
    private int ShownFrom => Total == 0 ? 0 : (PaginaActual - 1) * PageSize + 1;
    private int ShownTo => Math.Min(PaginaActual * PageSize, Total);

    private async Task Ir(int pagina)
    {
        var destino = Math.Clamp(pagina, 1, LastPage);
        if (destino == Page) return;
        Page = destino;
        await PageChanged.InvokeAsync(destino);
    }

    // Calcula dinámicamente qué botones dibujar
    private List<int> ObtenerPaginas()
    {
        var paginas = new List<int>();
        
        if (LastPage <= 5)
        {
            for (int i = 1; i <= LastPage; i++) paginas.Add(i);
            return paginas;
        }

        int inicio = PaginaActual - 1;
        int fin = PaginaActual + 1;

        if (PaginaActual == 1) fin = 3;
        else if (PaginaActual == LastPage) inicio = LastPage - 2;

        inicio = Math.Max(2, inicio);
        fin = Math.Min(LastPage - 1, fin);

        paginas.Add(1);

        if (inicio == 3) paginas.Add(2);
        else if (inicio > 3) paginas.Add(-1);

        for (int i = inicio; i <= fin; i++) paginas.Add(i);

        if (fin == LastPage - 2) paginas.Add(LastPage - 1);
        else if (fin < LastPage - 2) paginas.Add(-1);

        paginas.Add(LastPage);

        return paginas;
    }
}