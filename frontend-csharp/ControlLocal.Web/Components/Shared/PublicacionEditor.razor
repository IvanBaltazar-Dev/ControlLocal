@* Modal para publicar/editar un anuncio del local (Etapa 7). Conserva canal, URL y renta
   para que una oportunidad pueda atribuirse a su publicación de origen. *@
@inject IPublicacionService PublicacionSvc

<Modal Open="Open" Tone="blue" Icon="store"
       Title="@(_isEdit ? "Editar publicación" : "Publicar local")"
       Desc="Difunde el local en un canal. Se conservan canal, URL y renta del anuncio."
       OnClose="OnClose">
    <ChildContent>
        <div class="cl-grid c2">
            <Field Label="Canal" Required="true">
                <select @bind="_canal">
                    @foreach (var c in EnumCatalog.CanalesPublicacion)
                    {
                        <option value="@c.Code">@c.Label</option>
                    }
                </select>
            </Field>
            <Field Label="Renta publicada (USD/mes)">
                <input type="number" min="0" step="0.01" @bind="_renta" placeholder="Opcional" />
            </Field>
        </div>
        <Field Label="Título del anuncio"><input @bind="_titulo" placeholder="Opcional" /></Field>
        <Field Label="URL del anuncio"><input @bind="_url" placeholder="https://..." /></Field>
        @if (_err is not null)
        {
            <div class="cl-alert red" style="margin-top:10px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
        }
    </ChildContent>
    <Footer>
        <button class="cl-btn ghost" disabled="@_busy" @onclick="OnClose">Cancelar</button>
        <button class="cl-btn primary" disabled="@_busy" @onclick="Guardar">@(_busy ? "Guardando..." : (_isEdit ? "Guardar cambios" : "Publicar"))</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public long IdLocal { get; set; }
    [Parameter] public PublicacionDto? Existing { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _wasOpen;
    private bool _isEdit => Existing is not null && Existing.Id > 0;
    private string _canal = EnumCatalog.CanalesPublicacion[0].Code;
    private string _titulo = "";
    private string _url = "";
    private decimal? _renta;
    private bool _busy;
    private string? _err;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            if (Existing is null)
            {
                _canal = EnumCatalog.CanalesPublicacion[0].Code;
                _titulo = "";
                _url = "";
                _renta = null;
            }
            else
            {
                _canal = string.IsNullOrWhiteSpace(Existing.Canal) ? EnumCatalog.CanalesPublicacion[0].Code : Existing.Canal;
                _titulo = Existing.TituloAnuncio;
                _url = Existing.UrlPublicacion ?? "";
                _renta = Existing.RentaPublicada == 0 ? null : Existing.RentaPublicada;
            }
            _err = null;
        }
        _wasOpen = Open;
    }

    private async Task Guardar()
    {
        if (_busy)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_canal))
        {
            _err = "Selecciona un canal.";
            return;
        }
        _busy = true;
        _err = null;
        try
        {
            var dto = new PublicacionDto
            {
                Id = Existing?.Id ?? 0,
                Canal = _canal,
                TituloAnuncio = _titulo?.Trim() ?? "",
                UrlPublicacion = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim(),
                RentaPublicada = _renta ?? 0,
                Moneda = Existing?.Moneda ?? "PEN",
                Estado = Existing?.Estado ?? "P",
                CodigoOrigen = Existing?.CodigoOrigen ?? "",
            };
            if (_isEdit)
            {
                await PublicacionSvc.ActualizarAsync(IdLocal, dto);
            }
            else
            {
                await PublicacionSvc.CrearAsync(IdLocal, dto);
            }
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
