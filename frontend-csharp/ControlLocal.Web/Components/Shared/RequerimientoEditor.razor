@* Modal para crear/editar un requerimiento (perfil de busqueda) del cliente. Al guardar,
   el backend lo vincula al cliente y entra a la recomendacion de cartera. *@
@inject IRequerimientoService ReqSvc

<Modal Open="Open" Tone="blue" Icon="target"
       Title="@(_isEdit ? "Editar requerimiento" : "Nuevo requerimiento")"
       Desc="Perfil de busqueda del cliente. Al guardar se vincula al cliente y entra a la recomendacion de cartera."
       OnClose="OnClose">
    <ChildContent>
        <div class="cl-grid c2">
            <Field Label="Rubro de interes" Required="true">
                <select @bind="_rubro">
                    @foreach (var r in Rubros)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </Field>
            <Field Label="Tipo de inmueble">
                <select @bind="_tipo">
                    <option value="">Cualquiera</option>
                    @foreach (var t in _tipos)
                    {
                        <option value="@t.Value">@t.Label</option>
                    }
                </select>
            </Field>
        </div>

        <div class="cl-grid c2">
            <Field Label="Moneda">
                <select @bind="_moneda">
                    <option value="PEN">Soles (PEN)</option>
                    <option value="USD">Dolares (USD)</option>
                </select>
            </Field>
            @if (_isEdit)
            {
                <Field Label="Estado">
                    <select @bind="_estado">
                        <option value="ACTIVO">Activo</option>
                        <option value="PAUSADO">Pausado</option>
                        <option value="CERRADO">Cerrado</option>
                    </select>
                </Field>
            }
        </div>

        <div class="cl-grid c2">
            <Field Label="Renta minima"><input type="number" min="0" step="0.01" @bind="_rentaMin" placeholder="Opcional" /></Field>
            <Field Label="Renta maxima"><input type="number" min="0" step="0.01" @bind="_rentaMax" placeholder="Opcional" /></Field>
        </div>
        <div class="cl-grid c2">
            <Field Label="Area minima (m2)"><input type="number" min="0" step="0.01" @bind="_areaMin" placeholder="Opcional" /></Field>
            <Field Label="Area maxima (m2)"><input type="number" min="0" step="0.01" @bind="_areaMax" placeholder="Opcional" /></Field>
        </div>
        <div class="cl-grid c2">
            <Field Label="Frente minimo (m)"><input type="number" min="0" step="0.01" @bind="_frente" placeholder="Opcional" /></Field>
        </div>

        <Field Label="Distritos de interes">
            <div style="max-height:150px;overflow:auto;border:1px solid var(--c-border);border-radius:8px;padding:8px;display:grid;grid-template-columns:repeat(2,1fr);gap:4px;">
                @foreach (var d in EnumCatalog.DistritosLima)
                {
                    <label style="display:flex;align-items:center;gap:6px;font-size:12px;">
                        <input type="checkbox" style="width:auto;" checked="@_distritos.Contains(d)" @onchange="e => ToggleDistrito(d, e)" /> @d
                    </label>
                }
            </div>
        </Field>

        <Field Label="Observaciones">
            <textarea rows="2" @bind="_observaciones" placeholder="Notas del perfil de busqueda (opcional)"></textarea>
        </Field>

        @if (_err is not null)
        {
            <div class="cl-alert red" style="margin-top:10px;"><Icon Name="alert" Size="15" /><span>@_err</span></div>
        }
    </ChildContent>
    <Footer>
        <button class="cl-btn ghost" disabled="@_busy" @onclick="OnClose">Cancelar</button>
        <button class="cl-btn primary" disabled="@_busy" @onclick="Guardar">@(_busy ? "Guardando..." : "Guardar requerimiento")</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public long ClienteId { get; set; }
    [Parameter] public RequerimientoDto? Existing { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _wasOpen;
    private bool _isEdit => Existing is not null && Existing.Id > 0;

    private string _rubro = EnumCatalog.RubrosComerciales[0];
    private string _tipo = "";
    private string _moneda = "PEN";
    private string _estado = "ACTIVO";
    private decimal? _rentaMin;
    private decimal? _rentaMax;
    private decimal? _areaMin;
    private decimal? _areaMax;
    private decimal? _frente;
    private string _observaciones = "";
    private HashSet<string> _distritos = new();
    private bool _busy;
    private string? _err;

    private static readonly (string Value, string Label)[] _tipos =
    {
        ("LOCAL_COMERCIAL", "Local comercial"),
        ("OFICINA", "Oficina"),
        ("DEPOSITO_ALMACEN", "Deposito / Almacen"),
        ("STAND_MODULO", "Stand / Modulo"),
        ("TERRENO_COMERCIAL", "Terreno comercial"),
        ("OTRO", "Otro"),
    };

    private IReadOnlyList<string> Rubros => EnumCatalog.RubrosComerciales.Contains(_rubro)
        ? EnumCatalog.RubrosComerciales
        : EnumCatalog.RubrosComerciales.Concat([_rubro]).ToList();

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            CargarDesde(Existing);
            _err = null;
        }
        _wasOpen = Open;
    }

    private void CargarDesde(RequerimientoDto? r)
    {
        if (r is null)
        {
            _rubro = EnumCatalog.RubrosComerciales[0];
            _tipo = "";
            _moneda = "PEN";
            _estado = "ACTIVO";
            _rentaMin = _rentaMax = _areaMin = _areaMax = _frente = null;
            _observaciones = "";
            _distritos = new();
            return;
        }
        _rubro = string.IsNullOrWhiteSpace(r.Rubro) ? EnumCatalog.RubrosComerciales[0] : r.Rubro;
        _tipo = r.TipoInmueble ?? "";
        _moneda = string.IsNullOrWhiteSpace(r.Moneda) ? "PEN" : r.Moneda;
        _estado = string.IsNullOrWhiteSpace(r.Estado) ? "ACTIVO" : r.Estado;
        _rentaMin = r.RentaMin;
        _rentaMax = r.RentaMax;
        _areaMin = r.MetrajeMin;
        _areaMax = r.MetrajeMax;
        _frente = r.FrenteMinimo;
        _observaciones = r.Observaciones ?? "";
        _distritos = new(r.Distritos ?? new());
    }

    private void ToggleDistrito(string distrito, ChangeEventArgs e)
    {
        if (e.Value is bool marcado && marcado)
        {
            _distritos.Add(distrito);
        }
        else
        {
            _distritos.Remove(distrito);
        }
    }

    private async Task Guardar()
    {
        if (_busy)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_rubro))
        {
            _err = "El rubro de interes es obligatorio.";
            return;
        }
        if (_rentaMin is { } rmin && _rentaMax is { } rmax && rmax < rmin)
        {
            _err = "La renta maxima no puede ser menor que la minima.";
            return;
        }
        if (_areaMin is { } amin && _areaMax is { } amax && amax < amin)
        {
            _err = "El area maxima no puede ser menor que la minima.";
            return;
        }
        _busy = true;
        _err = null;
        try
        {
            var dto = new RequerimientoDto
            {
                Id = Existing?.Id ?? 0,
                ClienteId = ClienteId,
                Rubro = _rubro,
                TipoInmueble = string.IsNullOrWhiteSpace(_tipo) ? null : _tipo,
                RentaMin = _rentaMin,
                RentaMax = _rentaMax,
                Moneda = _moneda,
                MetrajeMin = _areaMin,
                MetrajeMax = _areaMax,
                FrenteMinimo = _frente,
                Estado = _isEdit ? _estado : "ACTIVO",
                Observaciones = string.IsNullOrWhiteSpace(_observaciones) ? null : _observaciones,
                Distritos = _distritos.ToList(),
            };
            if (_isEdit)
            {
                await ReqSvc.ActualizarAsync(dto);
            }
            else
            {
                await ReqSvc.CrearAsync(dto);
            }
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            _err = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
