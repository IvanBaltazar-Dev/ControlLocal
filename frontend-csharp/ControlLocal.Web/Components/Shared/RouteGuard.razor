@inject AppState App
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_permitido)
{
    <RouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)" />
}
else if (_esperandoSesion)
{
    <div style="padding:32px;color:#7E8794;font-size:13px;">Validando sesion...</div>
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    private bool _permitido;
    private bool _esperandoSesion;
    private DotNetObjectReference<RouteGuard>? _sessionRef;
    private string? _sessionSubscriptionId;

    protected override async Task OnParametersSetAsync()
    {
        if (RouteAccess.IsPublic(RouteData.PageType))
        {
            _permitido = true;
            return;
        }

        await App.EnsureInitializedAsync();
        ResolverAcceso(App.SessionInitialized);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await SuscribirSesionAsync();

        if (!_esperandoSesion) return;

        await App.EnsureInitializedAsync();
        ResolverAcceso(App.SessionInitialized);
        await InvokeAsync(StateHasChanged);
    }

    private void ResolverAcceso(bool redirigirSiFalla)
    {
        if (!App.SessionInitialized)
        {
            _permitido = false;
            _esperandoSesion = true;
            return;
        }

        _esperandoSesion = false;
        _permitido = App.IsAuthenticated && RouteAccess.CanAccess(RouteData.PageType, App.Role);
        if (!_permitido && redirigirSiFalla)
            NavigationManager.NavigateTo(App.IsAuthenticated ? "/acceso-denegado" : "/login");
    }

    private async Task SuscribirSesionAsync()
    {
        _sessionRef = DotNetObjectReference.Create(this);

        try
        {
            _sessionSubscriptionId = await JS.InvokeAsync<string>(
                "controlLocal.session.subscribe",
                _sessionRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    [JSInvokable]
    public async Task OnBrowserSessionChanged()
    {
        await InvokeAsync(async () =>
        {
            await App.ReloadSessionAsync();
            NavigationManager.NavigateTo(App.IsAuthenticated ? "/dashboard" : "/login");
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_sessionSubscriptionId is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("controlLocal.session.unsubscribe", _sessionSubscriptionId);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
            {
            }
        }

        _sessionRef?.Dispose();
    }
}
