@* Menu definido por la matriz de permisos de cada rol. *@
@inject AppState App
@inject ApiClient Api
@inject IIndicadorService Indicadores
@inject IContratoService Contratos

<aside class="cl-sidebar">
    <div class="cl-brand" style="cursor:pointer" @onclick="@(() => App.Navigate("dashboard"))">
        <ControlLocalLogo Class="cl-sidebar__logo" Size="36" />
        <div>
            <div class="cl-brand-name">ControlLocal</div>
            <div class="cl-brand-sub">Corretaje comercial</div>
        </div>
    </div>

    <nav class="cl-nav">
        @foreach (var sec in Sections)
        {
            @if (sec.Collapsible)
            {
                var collapsed = IsCollapsed(sec.Section);

                <div class="cl-nav-section">
                    <div class="cl-nav-group-head@(collapsed ? "" : " open")"
                         style="cursor:pointer" @onclick="@(() => ToggleCollapsed(sec.Section))">
                        <Icon Name="@IconoSeccion(sec.Section)" Size="15" Class="cl-ico" />
                        <span>@sec.Section</span>
                        <Icon Name="chevronRight" Size="14" Class="cl-nav-caret" />
                    </div>

                    @if (!collapsed)
                    {
                        @if (sec.Groups is not null)
                        {
                            @foreach (var grupo in sec.Groups)
                            {
                                <div class="cl-nav-subgroup">
                                    @if (grupo.Collapsible)
                                    {
                                        var grupoCollapsed = IsGroupCollapsed(sec.Section, grupo.Label);

                                        <div class="cl-nav-subgroup-head@(grupoCollapsed ? "" : " open")"
                                             @onclick="@(() => ToggleGroupCollapsed(sec.Section, grupo.Label))">
                                            <span class="cl-nav-subgroup-title">@grupo.Label</span>
                                            <Icon Name="chevronRight" Size="13" Class="cl-nav-subgroup-caret" />
                                        </div>

                                        @if (!grupoCollapsed)
                                        {
                                            @foreach (var it in grupo.Items)
                                            {
                                                @NavItemRow(it)
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <div class="cl-nav-label">@grupo.Label</div>

                                        @foreach (var it in grupo.Items)
                                        {
                                            @NavItemRow(it)
                                        }
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var it in sec.Items)
                            {
                                @NavItemRow(it)
                            }
                        }
                    }
                </div>
            }
            else
            {
                <div class="cl-nav-section">
                    <div class="cl-nav-label">@sec.Section</div>

                    @foreach (var it in sec.Items)
                    {
                        @NavItemRow(it)
                    }
                </div>
            }
        }
    </nav>

    <div class="cl-sidebar-foot">
        <div class="cl-avatar" style="cursor:pointer" @onclick="@(() => App.Navigate("profile"))">@User.Initials</div>

        <div style="flex:1;min-width:0;cursor:pointer" @onclick="@(() => App.Navigate("profile"))">
            <div class="cl-foot-name">@User.Name</div>
            <div class="cl-foot-role">@User.Short</div>
        </div>

        <span title="Cerrar sesión" style="cursor:pointer;display:inline-flex" @onclick="@(() => _logoutOpen = true)">
            <Icon Name="logout" Size="15" Color="#8C8377" />
        </span>
    </div>

    <ConfirmDialog Open="_logoutOpen" Tone="blue" Icon="logout" Size="sm"
                   Title="¿Cerrar sesión?"
                   Desc="Se cerrará tu sesión en ControlLocal y tendrás que volver a ingresar tus credenciales."
                   ConfirmLabel="Cerrar sesión" CancelLabel="Seguir trabajando"
                   OnClose="@(() => _logoutOpen = false)"
                   OnConfirm="@OnLogout" />
</aside>

@code {
    [Parameter] public string? Active { get; set; }
    [Parameter] public string Role { get; set; } = Roles.Agente;
    [Parameter] public string? Route { get; set; }

    private bool _logoutOpen;
    private IndicadoresDto? _ind;
    private int _cierresPendientesComision;

    // Secciones colapsables plegadas en esta vista. El Sidebar se recrea por navegacion,
    // asi que el estado nace limpio: las secciones colapsables empiezan plegadas salvo que
    // la ruta activa viva dentro (entonces se auto-despliega para ubicar al usuario).
    private readonly HashSet<string> _colapsadas = new();
    private bool _colapsadasInicializadas;

    // Subgrupos colapsables dentro de una seccion colapsable.
    // Ejemplo: Consulta comercial -> Consulta de Operaciones / Consulta de Registros.
    private readonly HashSet<string> _gruposColapsados = new();
    private bool _gruposColapsadosInicializados;

    // Pinta el menu de inmediato y carga los contadores de los pills en segundo plano.
    // Evita bloquear la navegacion con un fetch de indicadores + contratos en cada clic.
    protected override void OnInitialized()
    {
        _ind = Indicadores.Cacheado;
        _ = CargarContadoresAsync();
    }

    private async Task CargarContadoresAsync()
    {
        try { _ind ??= await Indicadores.ObtenerAsync(); }
        catch { /* el menu se muestra aunque los contadores no carguen */ }

        try
        {
            var contratos = await Contratos.RefrescarAsync();
            _cierresPendientesComision = contratos.Count(item => item.ComisionEstado == "Pendiente");
        }
        catch { _cierresPendientesComision = 0; }

        await InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (!_colapsadasInicializadas)
        {
            foreach (var sec in Sections.Where(s => s.Collapsible))
                _colapsadas.Add(sec.Section);

            _colapsadasInicializadas = true;
        }

        if (!_gruposColapsadosInicializados)
        {
            foreach (var sec in Sections.Where(s => s.Groups is not null))
            {
                foreach (var grupo in sec.Groups!.Where(g => g.Collapsible && g.StartCollapsed))
                    _gruposColapsados.Add(GroupKey(sec.Section, grupo.Label));
            }

            _gruposColapsadosInicializados = true;
        }

        // Si la opcion activa esta dentro de una seccion colapsable, despliegala.
        // Si ademas esta dentro de un subgrupo colapsable, despliega tambien ese subgrupo.
        foreach (var sec in Sections.Where(s => s.Collapsible))
        {
            if (sec.Groups is not null)
            {
                foreach (var grupo in sec.Groups)
                {
                    var activaDentroDelGrupo = grupo.Items.Any(IsActive);

                    if (activaDentroDelGrupo)
                    {
                        _colapsadas.Remove(sec.Section);
                        _gruposColapsados.Remove(GroupKey(sec.Section, grupo.Label));
                    }
                }
            }
            else
            {
                var activaDentro = sec.Items.Any(IsActive);

                if (activaDentro)
                    _colapsadas.Remove(sec.Section);
            }
        }
    }

    private static string IconoSeccion(string section) => section switch
    {
        "Consulta comercial" => "compass",
        "Consulta Operación" => "activity",
        "Consulta Registro" => "folder",
        _ => "briefcase",
    };

    private bool IsCollapsed(string section) => _colapsadas.Contains(section);

    private void ToggleCollapsed(string section)
    {
        if (!_colapsadas.Remove(section))
            _colapsadas.Add(section);
    }

    private static string GroupKey(string section, string group) =>
        $"{section}::{group}";

    private bool IsGroupCollapsed(string section, string group) =>
        _gruposColapsados.Contains(GroupKey(section, group));

    private void ToggleGroupCollapsed(string section, string group)
    {
        var key = GroupKey(section, group);

        if (!_gruposColapsados.Remove(key))
            _gruposColapsados.Add(key);
    }

    private bool IsActive(NavItem it) =>
        Active == it.Label || (EffectiveRoute is not null && EffectiveRoute == it.Route);

    private RenderFragment NavItemRow(NavItem it) => @<div class="cl-nav-item@(IsActive(it) ? " active" : "")"
                                                       style="cursor:pointer"
                                                       @onclick="@(() => App.Navigate(it.Route))">
        <Icon Name="@it.Icon" Size="15" Class="cl-ico" />
        <span>@it.Label</span>
        @if (PillFor(it) is { } pill)
        {
            <span class="cl-pill">@pill</span>
        }
    </div>;

    // Contador a mostrar junto a la opcion, segun rol + ruta. null = sin pill.
    private string? PillFor(NavItem item)
    {
        if (item.Route == "propiedades-alquiladas")
            return _cierresPendientesComision > 0 ? _cierresPendientesComision.ToString() : null;

        if (_ind is null) return null;

        var valor = item.Route switch
        {
            "bandeja-captaciones" => _ind.CaptacionesPorRevisar,
            "solicitudes-revisar" when Role == Roles.Broker => _ind.SolicitudesPorEvaluar,
            "captaciones" when Role == Roles.Agente => _ind.CaptacionesTotales,
            "interacciones" when Role == Roles.Agente => _ind.Interacciones,
            _ => 0,
        };

        return valor > 0 ? valor.ToString() : null;
    }

    private NavSection[] Sections =>
        Navigation.SideNavByRole.TryGetValue(Role, out var s) ? s : Navigation.SideNavByRole[Roles.Agente];

    private RoleUser User => App.CurrentUser is { } current
        ? new RoleUser(current.Iniciales, current.Nombre, Roles.Label(current.Role))
        : Navigation.UserFor(Role);

    private string? EffectiveRoute =>
        Route is null ? null : (Navigation.RouteToNav.TryGetValue(Route, out var r) ? r : Route);

    private void OnLogout()
    {
        _logoutOpen = false;
        Api.CerrarSesion();
        App.SignOut();
        App.Navigate("login");
    }
}