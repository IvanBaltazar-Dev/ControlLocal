@* Tiny trend line with optional area fill. *@
<svg width="@W" height="@H" viewBox="0 0 @W @H">
    @if (Fill)
    {
        <polygon points="@FillPoints" fill="@Color" opacity="0.12" />
    }
    <polyline points="@Points" fill="none" stroke="@Color" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>

@code {
    [Parameter] public double[] Data { get; set; } = new double[] { 4, 6, 5, 8, 7, 10, 9, 12, 11, 14, 13, 16 };
    [Parameter] public string Color { get; set; } = "#2C5CA0";
    [Parameter] public int Height { get; set; } = 40;
    [Parameter] public bool Fill { get; set; } = true;

    private const int W = 140;
    private const int Pad = 4;
    private int H => Height;

    private string Points => BuildPoints();
    private string FillPoints => $"{Pad},{H - Pad} {BuildPoints()} {W - Pad},{H - Pad}";

    private string BuildPoints()
    {
        if (Data.Length == 0) return "";
        double max = Data.Max(), min = Data.Min();
        double stepX = (W - Pad * 2) / (double)(Data.Length - 1 == 0 ? 1 : Data.Length - 1);
        double range = max - min == 0 ? 1 : max - min;
        var pts = Data.Select((v, i) =>
        {
            double x = Pad + i * stepX;
            double y = H - Pad - ((v - min) / range) * (H - Pad * 2);
            return $"{F(x)},{F(y)}";
        });
        return string.Join(' ', pts);
    }

    private static string F(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
