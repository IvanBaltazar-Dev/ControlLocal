@* Status pill — maps a label to its semantic tone. Mirrors STATUS_MAP. *@
<span class="@CssClass">@Label</span>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? ToneOverride { get; set; }
    [Parameter] public bool Plain { get; set; }

    private string Tone => ToneOverride ?? (StatusMap.TryGetValue(Label, out var t) ? t : "gray");

    private string CssClass => $"cl-badge {Tone}{(Plain ? " plain" : "")}";

    public static readonly Dictionary<string, string> StatusMap = new()
    {
        ["Borrador"] = "gray", ["En revisión"] = "blue", ["Pendiente"] = "blue",
        ["Observada"] = "blue", ["Activa"] = "green", ["Rechazada"] = "red", ["Cerrada"] = "gray",
        ["Alquilada"] = "green", ["Sin alquilar"] = "gray",
        ["Captada"] = "blue", ["Con interacciones"] = "info", ["Con solicitud"] = "info",
        ["En evaluación"] = "blue", ["No continúa"] = "gray",
        ["Registrada"] = "gray", ["Aprobada"] = "green", ["Observada · solicitud"] = "blue",
        ["Programada"] = "blue", ["Reprogramada"] = "blue", ["Realizada"] = "green", ["Cancelada"] = "red",
        ["Aprobado"] = "green", ["Observado"] = "blue",
        ["Activo"] = "green", ["Inactivo"] = "gray", ["Suspendido"] = "red",
        ["Disponible"] = "green", ["No disponible"] = "gray", ["En licencia"] = "blue",
        ["Asignación activa"] = "green", ["Supervisión activa"] = "green", ["Supervisión cerrada"] = "gray",
        ["Broker administrador"] = "info", ["Broker supervisor"] = "blue",
        ["Abierta"] = "blue", ["En seguimiento"] = "blue", ["Solicitud creada"] = "info",
        ["Prospecto"] = "gray", ["Contactado"] = "blue", ["Reunion"] = "info",
        ["Propuesta entregada"] = "blue", ["Captado"] = "green", ["Descartado"] = "red",
        ["Cerrada exitosa"] = "green", ["Cerrada no continúa"] = "gray", ["Cerrada no favorable"] = "red",
    };
}
