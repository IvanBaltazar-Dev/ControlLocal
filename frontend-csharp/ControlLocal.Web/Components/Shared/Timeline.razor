@* Vertical activity timeline. *@
<div class="cl-timeline">
    @foreach (var it in Items)
    {
        <div class="cl-tl-item">
            <div class="cl-tl-dot @(it.Tone ?? "")"></div>
            <div class="cl-tl-time">@it.Time</div>
            <div class="cl-tl-title">@it.Title</div>
            @if (!string.IsNullOrEmpty(it.Body))
            {
                <div class="cl-tl-body">@it.Body</div>
            }
        </div>
    }
</div>

@code {
    public record TimelineItem(string Time, string Title, string? Body = null, string? Tone = null);

    [Parameter] public TimelineItem[] Items { get; set; } = System.Array.Empty<TimelineItem>();
}
