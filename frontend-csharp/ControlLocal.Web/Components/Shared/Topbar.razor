@* Topbar — fecha, notificaciones y perfil *@
@inject AppState App
@inject ApiClient Api
@inject INotificacionService Notif

<header class="cl-topbar">
    <div class="cl-topbar-right">
        <span class="cl-date">@FechaHoy</span>

        <div class="cl-notif-wrap">
            <button class="cl-icon-btn" type="button" @onclick="ToggleNotifs"
                    aria-label="Notificaciones" title="Notificaciones">
                <Icon Name="bell" Size="18" Color="#515B6B" />
                @if (NoLeidas > 0)
                {
                    <span class="cl-notif-badge">@(NoLeidas > 9 ? "9+" : NoLeidas.ToString())</span>
                }
            </button>

            @if (_notifOpen)
            {
                <div class="cl-notif-menu">
                    <div class="cl-notif-menu-head">
                        <span>Notificaciones</span>
                        @if (NoLeidas > 0)
                        {
                            <button type="button" class="cl-notif-readall" @onclick="MarcarTodas">Marcar todas leídas</button>
                        }
                    </div>
                    <div class="cl-notif-list">
                        @if (_items.Count == 0)
                        {
                            <div class="cl-notif-empty">
                                <Icon Name="bell" Size="22" Color="#A6AEBC" />
                                <span>No tienes notificaciones</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var n in _items)
                            {
                                <button type="button" class="cl-notif-item @(n.Leida ? "" : "is-unread")"
                                        @onclick="@(() => Abrir(n))">
                                    <span class="cl-notif-ic sev-@n.Severidad.ToLowerInvariant()">
                                        <Icon Name="@n.Icono" Size="14" />
                                    </span>
                                    <span class="cl-notif-text">
                                        <span class="cl-notif-tipo">@n.Tipo</span>
                                        <span class="cl-notif-msg">@n.Mensaje</span>
                                        <span class="cl-notif-time">@n.FechaTexto</span>
                                    </span>
                                    @if (!n.Leida)
                                    {
                                        <span class="cl-notif-dot"></span>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <div class="cl-profile-wrap">
            <button class="cl-profile" type="button" @onclick="ToggleMenu">
                <div class="cl-avatar" style="width:28px;height:28px;">@User.Initials</div>
                <div>
                    <div class="cl-profile-name">@User.Name</div>
                    <div class="cl-profile-role">@Roles.Label(Role)</div>
                </div>
                <Icon Name="chevronDown" Size="14" Color="#7E8794" />
            </button>

            @if (_menuOpen)
            {
                <div class="cl-profile-menu">
                    <button type="button" @onclick="VerPerfil">
                        Ver perfil
                    </button>

                    @if (!IsAdmin)
                    {
                        <button type="button" @onclick="CambiarContrasena">
                            Cambiar contraseña
                        </button>
                    }

                    <div class="cl-profile-menu-sep"></div>

                    <button type="button" class="danger" @onclick="@(() => _logoutOpen = true)">
                        Cerrar sesión
                    </button>
                </div>
            }
        </div>
    </div>
</header>

<ConfirmDialog Open="_logoutOpen"
               Tone="blue"
               Icon="logout"
               Size="sm"
               Title="¿Cerrar sesión?"
               Desc="Se cerrará tu sesión en ControlLocal. Tendrás que volver a ingresar tus credenciales."
               ConfirmLabel="Cerrar sesión"
               CancelLabel="Seguir trabajando"
               OnClose="@(() => _logoutOpen = false)"
               OnConfirm="@Salir" />

@code {
    [Parameter] public string Role { get; set; } = Roles.Agente;

    private bool _menuOpen;
    private bool _logoutOpen;
    private bool _notifOpen;
    private List<NotificacionDto> _items = new();

    private int NoLeidas => _items.Count(n => !n.Leida);

    private RoleUser User => App.CurrentUser is { } current
        ? new RoleUser(current.Iniciales, current.Nombre, Roles.Label(current.Role))
        : Navigation.UserFor(Role);

    private bool IsAdmin => Role == Roles.Admin;

    private string FechaHoy =>
        DateTime.Today.ToString("dddd · dd MMMM yyyy", new System.Globalization.CultureInfo("es-PE"));

    protected override void OnInitialized() => Recargar();

    private void Recargar() => _items = Notif.MisNotificaciones().ToList();

    private void ToggleNotifs()
    {
        _notifOpen = !_notifOpen;
        if (_notifOpen)
        {
            _menuOpen = false;
            Recargar();
        }
    }

    private void MarcarTodas()
    {
        Notif.MarcarTodasLeidas();
        Recargar();
    }

    private void Abrir(NotificacionDto notificacion)
    {
        Notif.MarcarLeida(notificacion.Id);
        _notifOpen = false;
        if (!string.IsNullOrWhiteSpace(notificacion.Ruta))
            App.Navigate(notificacion.Ruta);
        else
            Recargar();
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        if (_menuOpen) _notifOpen = false;
    }

    private void VerPerfil()
    {
        _menuOpen = false;
        App.Navigate("profile");
    }

    private void CambiarContrasena()
    {
        _menuOpen = false;
        App.Navigate("cambiar-contrasena");
    }

    private void Salir()
    {
        _menuOpen = false;
        Api.CerrarSesion();
        App.SignOut();
        App.Navigate("login");
    }
}
