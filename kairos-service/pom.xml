<?xml version="1.0" encoding="UTF-8"?>
<!--
  KAIROS - el asistente conversacional de BROX.

  NO es un modulo del reactor de backend-spring, y eso es la decision, no un
  detalle de empaquetado. Es un proyecto propio con su ciclo de vida: se
  despliega, se reinicia y se le cambia el modelo de IA sin desplegar BROX, y
  BROX evoluciona sin depender de que este vivo.

  LO QUE NO DEPENDE
  Ni una sola clase de com.controllocal. Sin controllocal-domain, sin
  controllocal-service, sin driver de PostgreSQL. KAIROS no toca la base de
  BROX: habla con su API. Si algun dia aparece aqui una dependencia a
  controllocal-*, la frontera se rompio.

  LO QUE COMPARTE CON BROX
  El contrato, no la implementacion. KAIROS conoce las capacidades publicas de
  BROX; BROX no conoce nada de KAIROS.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.kairos</groupId>
    <artifactId>kairos-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>KAIROS</name>
    <description>Asistente conversacional sobre las capacidades publicas de BROX</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          El cliente HTTP contra BROX. Es la UNICA via: no hay aqui
          spring-boot-starter-data-jpa ni driver de base de datos, y su ausencia
          es intencionada — mientras no exista, nadie puede tomar el atajo de
          leer una tabla de BROX "solo para esta consulta".

          La persistencia propia de KAIROS (conversaciones, memoria, medios)
          llegara con su bloque, y sera SUYA.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
